stock TrunkCfg_GetVehicleWeightByModel(modelid)
{
    for(new i = 0; i < sizeof(g_trunk_model_weights); i++)
    {
        if(g_trunk_model_weights[i][TMW_MODEL_ID] == modelid)
        {
            return g_trunk_model_weights[i][TMW_WEIGHT_KG];
        }
    }
    return 1000;
}

stock TrunkCfg_GetItemWeightX10(item_id)
{
    if(item_id >= 0 && item_id < sizeof(g_inv_item_weight_x10))
    {
        new value = g_inv_item_weight_x10[item_id];
        if(value > 0)
        {
            return value;
        }
    }
    return 10;
}

