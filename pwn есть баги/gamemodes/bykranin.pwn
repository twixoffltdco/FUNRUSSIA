                format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "num_7"));
            }
            case 5:
            {
                SetPVarFloat(playerid, "num_4", GetPVarFloat(playerid, "num_4") + (val * 2.0));
                format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "num_4"));
            }
            case 6:
