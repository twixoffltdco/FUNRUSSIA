					GetVehicleInfo(model_id-400, VI_NAME),
					rang);

					Dialog(playerid, DIALOG_FAMILY_CAR_RANG_SET, DIALOG_STYLE_INPUT,"Транспорт семьи", query, "Далее", "Отмена");

					printf(query);
                    cache_delete(result);
                }
            }
