CMD:house(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new house_id; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /house [номер дома]");

	if(!(0 <= house_id <= g_house_loaded-1)) return SendClientMessage(playerid, 0xCECECEFF, "Данного дома не существует на сервере");

	new Float: x,
		Float: y,
		Float: z,
		Float: angle;

	if(GetHouseData(house_id, H_ENTRACE) != -1)
	{
		EnterPlayerToEntrance(playerid, GetHouseData(house_id, H_ENTRACE));

		x = GetHouseData(house_id, H_POS_X);
		y = GetHouseData(house_id, H_POS_Y);
		z = GetHouseData(house_id, H_POS_Z);
	}
					else
	{
		x = GetHouseData(house_id, H_EXIT_POS_X);
		y = GetHouseData(house_id, H_EXIT_POS_Y);
		z = GetHouseData(house_id, H_EXIT_POS_Z);
		angle = GetHouseData(house_id, H_EXIT_ANGLE);
	}
	SetPlayerPosEx(playerid, x, y, z, angle);

	new fmt_text[35];

	format(fmt_text, sizeof fmt_text, "Вы телепортировались к дому №%d", house_id);
	SendClientMessage(playerid, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, " к дому %d", house_id);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:nearhouse(playerid, params[])
{
	#pragma unused params
	if(!SRAdmin_Require(playerid, 13)) return 1;

	new nearest = -1;
	new Float:nearest_distance = 999999.0;
	for(new houseid; houseid < HOUSES_FOR_SALE_COUNT; houseid++)
	{
		if(gHouseDisabled[houseid]) continue;
		new Float:distance = GetPlayerDistanceFromPoint(playerid, gHousesForSale[houseid][0], gHousesForSale[houseid][1], gHousesForSale[houseid][2]);
		if(distance < nearest_distance)
		{
			nearest = houseid;
			nearest_distance = distance;
		}
	}

	if(nearest == -1 || nearest_distance > 50.0)
		return SendClientMessage(playerid, 0x999999FF, "Поблизости нет дома (радиус 50 метров)");

	new message[180];
	format(message, sizeof message, "Ближайший дом: ID %d (внутренний %d), расстояние %.1f м, владелец: %s", nearest + 3000, nearest, nearest_distance, gHouseOwned[nearest] ? gHouseOwner[nearest] : "государство");
	SendClientMessage(playerid, 0x66CCFFFF, message);
	return 1;
}

CMD:delhouse(playerid, params[])
{
	if(!SRAdmin_Require(playerid, 13)) return 1;

	if(!strcmp(params, "confirm", true))
	{
		new houseid = GetPVarInt(playerid, "delhouse_pending") - 1;
		new expire_time = GetPVarInt(playerid, "delhouse_expire");
		DeletePVar(playerid, "delhouse_pending");
		DeletePVar(playerid, "delhouse_expire");

		if(!(0 <= houseid < HOUSES_FOR_SALE_COUNT) || expire_time < gettime())
			return SendClientMessage(playerid, 0x999999FF, "Подтверждение устарело. Снова используйте /delhouse [ID]");
		if(gHouseDisabled[houseid])
			return SendClientMessage(playerid, 0x999999FF, "Этот дом уже удалён с карты");

		new old_owner = gHouseOwnerID[houseid];
		new query[256];
		mysql_format(mysql, query, sizeof query, "INSERT INTO disabled_houses (house_id,disabled_by,disabled_at) VALUES (%d,%d,%d) ON DUPLICATE KEY UPDATE disabled_by=%d,disabled_at=%d", houseid, GetPlayerAccountID(playerid), gettime(), GetPlayerAccountID(playerid), gettime());
		mysql_query(mysql, query, false);
		mysql_format(mysql, query, sizeof query, "DELETE FROM bought_houses WHERE house_id=%d AND (kv=0 OR kv IS NULL)", houseid);
		mysql_query(mysql, query, false);

		if(gHouseSalePickup[houseid] != 0)
		{
			DestroyPickup(gHouseSalePickup[houseid]);
			gHouseSalePickup[houseid] = 0;
		}

		gHouseDisabled[houseid] = true;
		gHouseOwned[houseid] = false;
		gHouseOwnerID[houseid] = 0;
		gHouseRentTime[houseid] = 0;
		g_house_new_opens[houseid] = false;
		g_house_new_apt[houseid] = false;
		g_house_new_remont[houseid] = false;
		g_house_new_shkaf[houseid] = false;
		format(gHouseOwner[houseid], 24, "Nobody");

		new owner_player = old_owner > 0 ? GetPlayerIDBySqlID(old_owner) : INVALID_PLAYER_ID;
		if(owner_player != INVALID_PLAYER_ID)
		{
			SetPlayerData(owner_player, P_HOUSE_SELECTED, 0);
			UpdatePlayerDatabaseInt(owner_player, "house_selected", 0);
			SendClientMessage(owner_player, 0xFF5533FF, "Ваш дом был удалён администрацией");
		}

		new message[180];
		format(message, sizeof message, "[A] %s[%d] удалил дом ID %d с карты", GetPlayerNameEx(playerid), playerid, houseid + 3000);
		SendMessageToAdmins(message, 0xFF5533FF);
		SendLog(playerid, LOG_TYPE_ADMIN_ACTION, message);
		return 1;
	}

	extract params -> new entered_id; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /delhouse [ID], затем /delhouse confirm");
	new houseid = entered_id >= 3000 ? entered_id - 3000 : entered_id;
	if(!(0 <= houseid < HOUSES_FOR_SALE_COUNT))
		return SendClientMessage(playerid, 0x999999FF, "Дом с таким ID не найден");
	if(gHouseDisabled[houseid])
		return SendClientMessage(playerid, 0x999999FF, "Этот дом уже удалён с карты");
	if(GetPlayerDistanceFromPoint(playerid, gHousesForSale[houseid][0], gHousesForSale[houseid][1], gHousesForSale[houseid][2]) > 50.0)
		return SendClientMessage(playerid, 0x999999FF, "Подойдите к удаляемому дому ближе чем на 50 метров");

	SetPVarInt(playerid, "delhouse_pending", houseid + 1);
	SetPVarInt(playerid, "delhouse_expire", gettime() + 30);
	new warning[200];
	format(warning, sizeof warning, "Дом ID %d, владелец: %s. Для окончательного удаления в течение 30 секунд: /delhouse confirm", houseid + 3000, gHouseOwned[houseid] ? gHouseOwner[houseid] : "государство");
	SendClientMessage(playerid, 0xFFCC00FF, warning);
	return 1;
}

CMD:delpadik(playerid, params[])
{
	if(!SRAdmin_Require(playerid, 13)) return 1;

	if(!strcmp(params, "confirm", true))
	{
		new entranceid = GetPVarInt(playerid, "delpadik_pending") - 1;
		new expire_time = GetPVarInt(playerid, "delpadik_expire");
		DeletePVar(playerid, "delpadik_pending");
		DeletePVar(playerid, "delpadik_expire");

		if(!(0 <= entranceid < g_entrance_loaded) || expire_time < gettime() || GetEntranceData(entranceid, E_SQL_ID) <= 0)
			return SendClientMessage(playerid, 0x999999FF, "Подтверждение устарело. Снова используйте /delpadik [номер]");

		new linked_houses, count_query[96];
		mysql_format(mysql, count_query, sizeof count_query, "SELECT COUNT(*) AS `count` FROM `houses` WHERE `entrance`=%d", entranceid);
		new Cache:count_result = mysql_query(mysql, count_query, true);
		if(cache_num_rows()) linked_houses = cache_get_field_content_int(0, "count");
		cache_delete(count_result);
		if(linked_houses > 0)
		{
			new error[144];
			format(error, sizeof error, "Подъезд удалить нельзя: к нему привязано квартир: %d", linked_houses);
			return SendClientMessage(playerid, 0xFF5533FF, error);
		}

		new sql_id = GetEntranceData(entranceid, E_SQL_ID);
		new query[96];
		mysql_format(mysql, query, sizeof query, "DELETE FROM `entrances` WHERE `id`=%d LIMIT 1", sql_id);
		mysql_query(mysql, query, false);

		if(GetEntranceData(entranceid, E_PICKUP_ID))
			DestroyPickup(GetEntranceData(entranceid, E_PICKUP_ID));
		if(IsValidDynamicMapIcon(GetEntranceData(entranceid, E_MAP_ICON)))
			DestroyDynamicMapIcon(GetEntranceData(entranceid, E_MAP_ICON));
		if(GetEntranceData(entranceid, E_LABEL) != Text3D:-1 && IsValidDynamic3DTextLabel(GetEntranceData(entranceid, E_LABEL)))
			DestroyDynamic3DTextLabel(GetEntranceData(entranceid, E_LABEL));

		SetEntranceData(entranceid, E_SQL_ID, 0);
		SetEntranceData(entranceid, E_PICKUP_ID, 0);
		SetEntranceData(entranceid, E_MAP_ICON, 0);
		SetEntranceData(entranceid, E_LABEL, Text3D:-1);
		SetEntranceData(entranceid, E_FLOORS, 0);
		SetEntranceData(entranceid, E_POS_X, 0.0);
		SetEntranceData(entranceid, E_POS_Y, 0.0);
		SetEntranceData(entranceid, E_POS_Z, 0.0);

		new message[180];
		format(message, sizeof message, "[A] %s[%d] удалил подъезд №%d (SQL ID %d)", GetPlayerNameEx(playerid), playerid, entranceid + 1, sql_id);
		SendMessageToAdmins(message, 0xFF5533FF);
		SendLog(playerid, LOG_TYPE_ADMIN_ACTION, message);
		return 1;
	}

	extract params -> new entered_id; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /delpadik [номер подъезда], затем /delpadik confirm");

	// The label shows entranceid + 1. Also accept the old internal ID when that
	// candidate is the one actually standing near the administrator.
	new entranceid = entered_id - 1;
	if(0 <= entered_id < g_entrance_loaded && GetEntranceData(entered_id, E_SQL_ID) > 0)
	{
		new Float:display_distance = 999999.0;
		if(0 <= entranceid < g_entrance_loaded && GetEntranceData(entranceid, E_SQL_ID) > 0)
			display_distance = GetPlayerDistanceFromPoint(playerid, GetEntranceData(entranceid, E_POS_X), GetEntranceData(entranceid, E_POS_Y), GetEntranceData(entranceid, E_POS_Z));
		new Float:internal_distance = GetPlayerDistanceFromPoint(playerid, GetEntranceData(entered_id, E_POS_X), GetEntranceData(entered_id, E_POS_Y), GetEntranceData(entered_id, E_POS_Z));
		if(internal_distance < display_distance) entranceid = entered_id;
	}

	if(!(0 <= entranceid < g_entrance_loaded) || GetEntranceData(entranceid, E_SQL_ID) <= 0)
		return SendClientMessage(playerid, 0x999999FF, "Подъезд с таким номером не найден");
	if(GetPlayerDistanceFromPoint(playerid, GetEntranceData(entranceid, E_POS_X), GetEntranceData(entranceid, E_POS_Y), GetEntranceData(entranceid, E_POS_Z)) > 50.0)
		return SendClientMessage(playerid, 0x999999FF, "Подойдите к удаляемому подъезду ближе чем на 50 метров");

	new linked_houses, count_query[96];
	mysql_format(mysql, count_query, sizeof count_query, "SELECT COUNT(*) AS `count` FROM `houses` WHERE `entrance`=%d", entranceid);
	new Cache:count_result = mysql_query(mysql, count_query, true);
	if(cache_num_rows()) linked_houses = cache_get_field_content_int(0, "count");
	cache_delete(count_result);
	if(linked_houses > 0)
	{
		new error[144];
		format(error, sizeof error, "Подъезд удалить нельзя: к нему привязано квартир: %d", linked_houses);
		return SendClientMessage(playerid, 0xFF5533FF, error);
	}

	SetPVarInt(playerid, "delpadik_pending", entranceid + 1);
	SetPVarInt(playerid, "delpadik_expire", gettime() + 30);
	new warning[180];
	format(warning, sizeof warning, "Подъезд №%d (SQL ID %d). Для удаления в течение 30 секунд: /delpadik confirm", entranceid + 1, GetEntranceData(entranceid, E_SQL_ID));
	SendClientMessage(playerid, 0xFFCC00FF, warning);
	return 1;
}

CMD:biz(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new biz_id; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /biz [номер бизнеса]");

	if(!(0 <= biz_id <= g_business_loaded-1)) return SendClientMessage(playerid, 0xCECECEFF, "Данного бизнеса не существует на сервере");

	SetPlayerPosEx
	(
		playerid,
		GetBusinessData(biz_id, B_EXIT_POS_X),
		GetBusinessData(biz_id, B_EXIT_POS_Y),
		GetBusinessData(biz_id, B_EXIT_POS_Z),
		GetBusinessData(biz_id, B_EXIT_ANGLE)
	);

	new fmt_text[35];

	format(fmt_text, sizeof fmt_text, "Вы телепортировались к бизнесу №%d", biz_id);
	SendClientMessage(playerid, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, "Телепортировался к бизнесу %d", biz_id);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:fuelstation(playerid, params[])
