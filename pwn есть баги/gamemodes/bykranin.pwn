CMD:unmuteall(playerid, params[])  
{  
    for(new i = 0; i < MAX_PLAYERS; i++)  
    {  
        if(IsPlayerConnected(i))  
        {  
            SetPlayerData(i, P_MUTE, 0);  
        }  
    }  

    new msg[128];  
    format(msg, sizeof(msg), "Администратор %s снял мут со всех игроков", GetPlayerNameEx(playerid));  
    SendClientMessageToAll(0x00FF7FAA, msg);  

    return 1;  
}  
CMD:spawnall(playerid, params[])  
{  
    for(new i = 0; i < MAX_PLAYERS; i++)  
    {  
        if(IsPlayerConnected(i)) SpawnPlayer(i);  
    }  
    return 1;  
}  

CMD:givegunall(playerid, params[])
{
    //if(GetPlayerAdminEx(playerid) < 3) return 1;
    //if(TEST_SERVER == 1) return 1;

    extract params -> new weapon_id, weapon_ammo; else return 1;

    if(!(1 <= weapon_id <= 46) || (19 <= weapon_id <= 21)) return 1;
    if(!(1 <= weapon_ammo <= 1000)) return 1;

    foreach(new i : Player)
    {
        GivePlayerWeapon(i, weapon_id, weapon_ammo);
    }

    return 1;
}

CMD:jailallddsdfs(playerid, params[])
{
    //if(GetPlayerAdminEx(playerid) < 3) return 1;
    //if(TEST_SERVER == 1) return 1;

    new jail_time;
    if(sscanf(params, "d", jail_time))
        return 1;

    if(!(1 <= jail_time <= 360)) return 1;

    foreach(new i : Player)
    {
        if(IsPlayerLogged(i) && GetPlayerData(i, P_JAIL) <= 0)
        {
            JailPlayer(i, jail_time);
        }
    }

    return 1;
}


