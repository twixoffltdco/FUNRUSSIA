// ------------------------------------------
new g_business[MAX_BUSINESS][E_BUSINESS_STRUCT];

stock SafePercent(value, percent)
{
    if(value <= 0 || percent <= 0) return 0;
    if(percent >= 100) return value;
    // Divide before multiplying so prices above 100,000,000 cannot overflow.
    return (value / 100) * percent + ((value % 100) * percent) / 100;
}

stock GetBusinessBalanceAfterCredit(businessid, amount)
{
    if(!(0 <= businessid < MAX_BUSINESS)) return 0;
    new balance = GetBusinessData(businessid, B_BALANCE);
    if(balance < 0) balance = 0;
    if(amount <= 0) return balance;
    if(balance > cellmax - amount) return cellmax;
    return balance + amount;
}

stock BusinessAddBalanceSafe(businessid, amount)
{
    if(!(0 <= businessid < MAX_BUSINESS) || amount <= 0) return 0;
    SetBusinessData(businessid, B_BALANCE, GetBusinessBalanceAfterCredit(businessid, amount));
    return GetBusinessData(businessid, B_BALANCE);
}
