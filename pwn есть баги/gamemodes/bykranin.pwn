							RemovePlayerFromVehicle(playerid);
							SendClientMessage(playerid, 0xCECECEFF, "Вы не работник службы доставки завода");
						}
					}
					/*case VEHICLE_ACTION_TYPE_BUS_DRIVER: // Водитель автобуса
