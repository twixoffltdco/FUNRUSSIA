CMD:testgui(playerid, params[])
{
    if(isnull(params))
    {
        SendClientMessage(playerid, -1, "Использование: /testgui [guiid]");
        SendClientMessage(playerid, -1, "Пример: /testgui 1 - вызов интерфейса с ID 1");
        return 1;
    }
    
    new guiid = strval(params);
    
    new JSON:json = JSON_Object();
    JSON_SetInt(json, "o", 1); // 
    ShowPlayerGUI(playerid, guiid, json);
    
    new msg[64];
    format(msg, sizeof(msg), "Вызван интерфейс с ID %d", guiid);
    SendClientMessage(playerid, -1, msg);
    
    return 1;
}

stock IsValidSkinModel(modelid)
{
    if (modelid < 0 || modelid > 10000000) return 0;
    if (modelid == 3 || modelid == 4 || modelid == 5 || modelid == 6 || modelid == 8) return 0;
    return 1;
}

stock ShowDonateCaseShop(playerid)
{
    new shop_text[2048];
    format(shop_text, sizeof shop_text, "Кейс\tЦена\tУ Вас");

    for(new case_id = 6; case_id <= MAX_CASES; case_id++)
    {
        format(shop_text[strlen(shop_text)], sizeof(shop_text) - strlen(shop_text),
            "\nКейс №%d\t%d BC\t%d шт.",
            case_id, DONATE_CASE_SHOP_PRICE, PlayerCase_GetAmount(playerid, case_id));
    }

    SetPlayerData(playerid, P_LAST_DIALOG, DIALOG_DONATE_CASE_SHOP);
    ShowPlayerDialog(playerid, DIALOG_DONATE_CASE_SHOP, DIALOG_STYLE_TABLIST_HEADERS,
        "{FFCD00}Магазин донатных кейсов", shop_text, "Купить", "Закрыть");
    return 1;
}

