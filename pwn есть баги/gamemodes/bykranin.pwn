            {
                format(g_styling_preview_vinyl[playerid], 32, "%s", vinyl);
                SetVehicleVinylForPlayer(playerid, veh, vinyl);
                printf("[STYLING][VINYL_PREVIEW] player=%d vehicle=%d model=%d vinyl=%s",
