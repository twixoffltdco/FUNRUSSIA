				if(response)
	            {
	                new price = strval(inputtext);
	                if(price && IsNumeric(inputtext))
	                {
	                    if(0 <= price <= 20000)
	                    {

	                        Config[sBonusDonate] = price;
	                        mysql_format(mysql, str, 256, "UPDATE server_settings SET BonusDonate = %d",price);
	                        mysql_query(mysql, str);
	                        return 1;
	                    }
