stock ProxDetectorS(Float:radi, playerid, targetid, spec = 0)
{
	new Float:p[3];

	if(!IsPlayerConnected(playerid)) return false;

	if(!IsPlayerConnected(targetid)) return false;

	if(!spec)
	{
		if(GetPlayerState(playerid) == 9) return false;

		if(GetPlayerState(targetid) == 9) return false;
	}
	if(!GetPlayerPos(targetid, p[0], p[1], p[2])) return false;
	if(!IsPlayerInRangeOfPoint(playerid, radi, p[0], p[1], p[2])) return false;

	return true;
}

stock SpawnDeathMatch(playerid)
{
    ResetPlayerWeapons(playerid);
    SetPlayerHealth(playerid, 100.0);

    if(GetPlayerData(playerid, P_DMZ_STATUS) == 2)
    {
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 2);
        switch(random(4))
        {
            case 0: SetPlayerPos(playerid, 719.488891, -1441.475463, 45.133670);
            case 1: SetPlayerPos(playerid, 724.488891, -1441.475463, 45.133670);
            case 2: SetPlayerPos(playerid, 719.488891, -1436.475463, 45.133670);
            case 3: SetPlayerPos(playerid, 714.488891, -1441.475463, 45.133670);
        }
        SetPlayerFacingAngle(playerid, 230.836486);
    }
    else
    {
        SetPlayerInterior(playerid, 1);
        SetPlayerVirtualWorld(playerid, 1);
        switch(random(4))
        {
            case 0: SetPlayerPos(playerid, 742.591735,1754.569946,1191.398559);
            case 1: SetPlayerPos(playerid, 721.075805,1747.330932,1192.843872);
            case 2: SetPlayerPos(playerid, 762.154357,1755.301635,1191.429687);
            case 3: SetPlayerPos(playerid, 775.674072,1751.479370,1191.429687);
        }
    }

    GivePlayerWeapon(playerid, 24, 999);
    Streamer_Update(playerid);
    return 1;
}

forward DMZRespawn(playerid, race);
public DMZRespawn(playerid, race)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 1;
    if(mysql_race[playerid] != race) return 1;
    if(GetPlayerData(playerid, P_DMZ_STATUS) <= 0) return 1;
    if(GetPVarInt(playerid, "dmz_respawn_pending") != 1) return 1;
    SpawnPlayer(playerid);
    // Some clients finish their regular death/hospital respawn after SpawnPlayer.
    // Re-apply the DM state after that transition so they cannot remain outside.
    SetTimerEx("DMZRespawnFinalize", 250, false, "ii", playerid, race);
    SetTimerEx("DMZRespawnFinalize", 1000, false, "ii", playerid, race);
    return 1;
}

forward DMZRespawnFinalize(playerid, race);
public DMZRespawnFinalize(playerid, race)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 1;
    if(mysql_race[playerid] != race) return 1;
    if(GetPlayerData(playerid, P_DMZ_STATUS) <= 0) return 1;

    SetPlayerData(playerid, P_HOSPITAL, false);
    SpawnDeathMatch(playerid);
    DeletePVar(playerid, "dmz_respawn_pending");
    return 1;
}

CMD:dmzexit(playerid)
{
    if(GetPlayerData(playerid, P_DMZ_STATUS) > 0)
	{
		DeletePVar(playerid, "dmz_respawn_pending");
		// These coordinates are the MP/DM lobby interior (the entrance pickup uses interior 1).
		SetPlayerPosEx(playerid, 1301.493896, 1704.872924, 1498.363159, 0.0, 1, 0, false);
        Streamer_Update(playerid);
        ResetPlayerWeapons(playerid);
        SetPlayerHealth(playerid, 100);

	    SetPlayerData(playerid, P_DMZ_STATUS, 0);
	    SendClientMessage(playerid, 0x66CC33FF, "Вы вышли из DM Zone");
	}
	else SendClientMessage(playerid, 0x999999FF, "Вы не находитесь в DM Zone");
	return 1;
}

