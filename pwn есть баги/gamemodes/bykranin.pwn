	F_RANG_UNINV,
	F_RANG_MUTE,
	F_RANG_UNMUTE,
	F_RANG_WARN,
	F_RANG_UNWARN,
	F_RANG_GIVER,
	F_FAMILY_CARS,//количество тс у семьи
	F_OCKIFARMA,
	F_OCZAVOD,
	F_VISHARZ,
	F_VISHKAR,
	F_VISBUS
};

