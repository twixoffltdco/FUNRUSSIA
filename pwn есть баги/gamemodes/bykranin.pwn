							new time = gettime();
							if(GetPVarInt(playerid, "biz_health_use") <= time)
							{
								new price = BIZ_HEALTH_SERVICE_PRICE;
								if(GetPlayerMoneyEx(playerid) >= price)
								{
									new query[255];

									format(query, sizeof query, "UPDATE accounts a,business b SET a.money=%d,b.products=10000,b.balance=%d WHERE a.id=%d AND b.id=%d", GetPlayerMoneyEx(playerid)-price, 10_000, GetBusinessData(businessid, B_PRODS) > 0 ? GetBusinessBalanceAfterCredit(businessid, price) : 0, GetPlayerAccountID(playerid), GetBusinessData(businessid, B_SQL_ID));
									mysql_query(mysql, query, false);

									if(!mysql_errno())
									{
										GivePlayerMoneyEx(playerid, -price, "Использование аптечки в бизнесе", false, true);

										if(GetBusinessData(businessid, B_PRODS) >= 1)
