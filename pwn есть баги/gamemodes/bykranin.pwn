	{
	    if(GetPVarType(i, "BBArea"))
	    {
	        if(areaid == GetPVarInt(i, "BBArea"))
	        {
	            StopStream(playerid);
	            SendClientMessage(playerid, -1, "Вы покинули зону бумбокса");
				return 1;
	        }
	    }
	}
	new player_last_pickup = GetPlayerData(playerid, P_LAST_PICKUP);

