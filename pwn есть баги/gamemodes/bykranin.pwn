							if(GetPlayerMoneyEx(playerid) >= 25000)
							{

								format(query, sizeof query, "UPDATE accounts a,business b SET a.money=%d,b.products=10000,b.balance=%d WHERE a.id=%d AND b.id=%d", GetPlayerMoneyEx(playerid)-25000, 10_000, GetBusinessData(GetPlayerInBiz(playerid), B_PRODS) > 0 ? GetBusinessBalanceAfterCredit(GetPlayerInBiz(playerid), 25000) : 0, GetPlayerAccountID(playerid), GetBusinessData(GetPlayerInBiz(playerid), B_SQL_ID));
								mysql_query(mysql, query, false);

