stock SetVehicleVinylForPlayer(playerid, vehicleid, const vinyl[])
{
    if(!IsPlayerConnected(playerid) || !IsValidVehicle(vehicleid)) return 0;
    new bounded_vinyl[32];
    format(bounded_vinyl, sizeof bounded_vinyl, "%s", vinyl);

    // Keep the original texture RPC for models that support remapbody directly.
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, 12);
    new len = strlen(bounded_vinyl);
    if(len > 31) len = 31;
    BS_WriteValue(bs, PR_UINT8, len);
    BS_WriteValue(bs, PR_STRING, bounded_vinyl);
    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);

    // Newer custom models restore their materials after the preview closes and
    // ignore the one-shot texture RPC. Mirror the same vinyl into the persistent
    // CUSTOM_VISUALS state (v_cust_body_N) used by this launcher.
    new vinyl_id = 0;
    for(new i; bounded_vinyl[i] != EOS; i++)
    {
        if(bounded_vinyl[i] >= '0' && bounded_vinyl[i] <= '9')
        {
            vinyl_id = strval(bounded_vinyl[i]);
            break;
        }
    }
    if(vinyl_id < 0) vinyl_id = 0;
    if(vinyl_id > 255) vinyl_id = 255;

    SetVehicleVinyls(vehicleid, vinyl_id, vinyl_id);
    return 1;
}



stock ApplyPoliceOrgVehicleVinylForPlayer(playerid, vehicleid)
{
    if(!IsPlayerConnected(playerid) || !IsValidVehicle(vehicleid)) return 0;
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_ORG_CAR) return 0;

    new teamid = GetVehicleData(vehicleid, V_ACTION_ID);
    if(teamid != TEAM_DPS && teamid != TEAM_PPS && teamid != TEAM_FBI) return 0;

    new vinyl_index;
    switch(GetVehicleModel(vehicleid))
    {
        // remapfbody1 is the military livery; police VAZ uses body2.
        case 597: vinyl_index = (teamid == TEAM_FBI) ? 4 : 2;
        case 598: vinyl_index = (teamid == TEAM_FBI) ? 2 : 5;
        // Police UAZ uses body6. body7 belongs to another police body/model.
        case 596: vinyl_index = (teamid == TEAM_FBI) ? 3 : 6;
		case 507, 533, 487:
		{
			if(teamid != TEAM_FBI) return 0;
			vinyl_index = 4;
		}
        default: return 0;
    }

    new vinyl_name[20];
    format(vinyl_name, sizeof vinyl_name, "remapfbody%d", vinyl_index);
    return SetVehicleVinylForPlayer(playerid, vehicleid, vinyl_name);
}

stock ApplyPoliceOrgVehicleBeaconForPlayer(playerid, vehicleid)
