								ShowPlayerATMDialog(playerid);
							}
						}
						case 7: // Безналичный перевод
						{
								Dialog
								(
									playerid, DIALOG_ATM_TRANSFER_MONEY_1, DIALOG_STYLE_INPUT,
									"{FFCD00}Безналичный перевод",
