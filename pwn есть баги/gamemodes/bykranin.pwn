                    mysql_format(mysql, fmt_text, sizeof fmt_text, "UPDATE family SET score='%d',exp='%d' WHERE id='%d' LIMIT 1", GetFamilyData(fam_id, F_LEVEL), GetFamilyData(fam_id, F_EXP), fam_id);
