#define REPORT_GUI_QUEUE_MAX       (128)
#define REPORT_GUI_TEXT_MAX        (144)

#define HELPER_QUEUE_MAX            (128)
#define HELPER_QUESTION_MAX         (144)
new g_helper_q_player[HELPER_QUEUE_MAX];
new g_helper_q_account[HELPER_QUEUE_MAX];
new g_helper_q_id[HELPER_QUEUE_MAX];
new g_helper_q_time[HELPER_QUEUE_MAX];
new g_helper_q_text[HELPER_QUEUE_MAX][HELPER_QUESTION_MAX];
new g_helper_q_head, g_helper_q_tail, g_helper_q_count, g_helper_q_next_id = 1;

stock bool:HelperQuestion_IsStaff(playerid)
{
    return IsPlayerConnected(playerid) && IsPlayerLogged(playerid) &&
        (GetPlayerHelperEx(playerid) > 0 || (GetPlayerAdminEx(playerid) > 0 && GetPlayerData(playerid, P_ADMIN_LOGGED)));
}

stock HelperQuestion_Init()
{
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS helper_stats_daily (account_id INT NOT NULL, stat_date DATE NOT NULL, answers INT NOT NULL DEFAULT 0, play_seconds INT NOT NULL DEFAULT 0, afk_seconds INT NOT NULL DEFAULT 0, PRIMARY KEY(account_id,stat_date))", false);
    mysql_query(mysql, "ALTER TABLE helper_stats_daily ADD COLUMN IF NOT EXISTS play_seconds INT NOT NULL DEFAULT 0", false);
    mysql_query(mysql, "ALTER TABLE helper_stats_daily ADD COLUMN IF NOT EXISTS afk_seconds INT NOT NULL DEFAULT 0", false);
    HelperQuestion_UpdateCounter();
    return 1;
}

stock HelperQuestion_UpdateCounter()
{
    new pending;
    for(new n; n < g_helper_q_count; n++)
    {
        new i = (g_helper_q_head + n) % HELPER_QUEUE_MAX;
        if(IsPlayerConnected(g_helper_q_player[i]) && GetPlayerAccountID(g_helper_q_player[i]) == g_helper_q_account[i]) pending++;
    }
    foreach(new i : Player) if(GetPVarInt(i, "HELPER_Q_ACTIVE")) pending++;
    new value[20];
    format(value, sizeof value, "ASK:_%d", pending);
    TextDrawSetString(ask_edit_TD, value);
    return pending;
}

stock bool:HelperQuestion_HasOpen(playerid)
{
    new account = GetPlayerAccountID(playerid);
    for(new n; n < g_helper_q_count; n++)
    {
        new i = (g_helper_q_head + n) % HELPER_QUEUE_MAX;
        if(g_helper_q_account[i] == account) return true;
    }
    foreach(new i : Player)
        if(GetPVarInt(i, "HELPER_Q_ACTIVE") && GetPVarInt(i, "HELPER_Q_ACCOUNT") == account) return true;
    return false;
}

stock HelperQuestion_Submit(playerid, const source[], bool:from_utf8 = false)
{
    if(HelperQuestion_HasOpen(playerid)) return SendClientMessage(playerid, 0xFFCC00FF, "У вас уже есть вопрос в очереди поддержки.");
    new text[HELPER_QUESTION_MAX]; format(text, sizeof text, "%s", source);
    if(from_utf8) utf8_to_cp1251(text);
    if(strlen(text) < 3 || strlen(text) >= HELPER_QUESTION_MAX)
        return SendClientMessage(playerid, 0xCECECEFF, "Вопрос должен содержать от 3 до 143 символов.");
    if(g_helper_q_count >= HELPER_QUEUE_MAX) return SendClientMessage(playerid, 0xFF3333FF, "Очередь вопросов переполнена. Попробуйте позже.");

    new i = g_helper_q_tail;
    g_helper_q_player[i] = playerid;
    g_helper_q_account[i] = GetPlayerAccountID(playerid);
    g_helper_q_id[i] = g_helper_q_next_id++;
    g_helper_q_time[i] = gettime();
    format(g_helper_q_text[i], HELPER_QUESTION_MAX, "%s", text);
    g_helper_q_tail = (g_helper_q_tail + 1) % HELPER_QUEUE_MAX;
    g_helper_q_count++;
    HelperQuestion_UpdateCounter();

    new msg[220];
    format(msg, sizeof msg, "{63C763}[H] Вопрос от %s[%d]: {FFF06A}%s", GetPlayerNameEx(playerid), playerid, text);
    SendMessageToHelpers(msg, -1);
    SendClientMessage(playerid, 0x66CC33FF, "Ваш вопрос отправлен агентам поддержки и добавлен в очередь.");
    SendLog(playerid, LOG_TYPE_REPORT, text);
    return 1;
}

stock HelperQuestion_ClearStaff(playerid, bool:requeue = false)
{
    if(requeue && GetPVarInt(playerid, "HELPER_Q_ACTIVE"))
    {
        new targetid = GetPVarInt(playerid, "HELPER_Q_PLAYER"), account = GetPVarInt(playerid, "HELPER_Q_ACCOUNT");
        new text[HELPER_QUESTION_MAX]; GetPVarString(playerid, "HELPER_Q_TEXT", text, sizeof text);
        if(IsPlayerConnected(targetid) && GetPlayerAccountID(targetid) == account && g_helper_q_count < HELPER_QUEUE_MAX)
        {
            new i = g_helper_q_tail;
            g_helper_q_player[i] = targetid; g_helper_q_account[i] = account;
            g_helper_q_id[i] = GetPVarInt(playerid, "HELPER_Q_ID"); g_helper_q_time[i] = GetPVarInt(playerid, "HELPER_Q_TIME");
            format(g_helper_q_text[i], HELPER_QUESTION_MAX, "%s", text);
            g_helper_q_tail = (g_helper_q_tail + 1) % HELPER_QUEUE_MAX; g_helper_q_count++;
        }
    }
    DeletePVar(playerid, "HELPER_Q_ACTIVE"); DeletePVar(playerid, "HELPER_Q_PLAYER");
    DeletePVar(playerid, "HELPER_Q_ACCOUNT"); DeletePVar(playerid, "HELPER_Q_ID");
    DeletePVar(playerid, "HELPER_Q_TIME"); DeletePVar(playerid, "HELPER_Q_TEXT");
    HelperQuestion_UpdateCounter();
    return 1;
}

stock HelperQuestion_ShowNext(playerid)
{
    if(!HelperQuestion_IsStaff(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "Команда доступна только агентам поддержки.");
    if(GetPVarInt(playerid, "HELPER_Q_ACTIVE")) return SendClientMessage(playerid, 0xCECECEFF, "Сначала ответьте или откажитесь от текущего вопроса.");
    while(g_helper_q_count > 0)
    {
        new i = g_helper_q_head; g_helper_q_head = (g_helper_q_head + 1) % HELPER_QUEUE_MAX; g_helper_q_count--;
        new targetid = g_helper_q_player[i];
        if(!IsPlayerConnected(targetid) || GetPlayerAccountID(targetid) != g_helper_q_account[i]) continue;
        SetPVarInt(playerid, "HELPER_Q_ACTIVE", 1); SetPVarInt(playerid, "HELPER_Q_PLAYER", targetid);
        SetPVarInt(playerid, "HELPER_Q_ACCOUNT", g_helper_q_account[i]); SetPVarInt(playerid, "HELPER_Q_ID", g_helper_q_id[i]);
        SetPVarInt(playerid, "HELPER_Q_TIME", g_helper_q_time[i]); SetPVarString(playerid, "HELPER_Q_TEXT", g_helper_q_text[i]);
        new date[32], body[600], yy, mm, dd, hh, mi, ss;
        timestamp_to_date(g_helper_q_time[i], yy, mm, dd, hh, mi, ss);
        format(date, sizeof date, "%04d-%02d-%02d %02d:%02d:%02d", yy, mm, dd, hh, mi, ss);
        format(body, sizeof body, "Вы собираетесь ответить на вопрос игрока: {FFF06A}%s[%d]\n\n{FFFFFF}| Текст: {FFF06A}%s\n{FFFFFF}| Дата и время подачи: %s.\n\nОставьте поле пустым, если хотите вернуть вопрос в очередь.", GetPlayerNameEx(targetid), targetid, g_helper_q_text[i], date);
        HelperQuestion_UpdateCounter();
        return Dialog(playerid, DIALOG_HELPER_ANSWER, DIALOG_STYLE_INPUT, "Вопрос агенту поддержки", body, "Ответить", "Отмена");
    }
    HelperQuestion_UpdateCounter();
    return SendClientMessage(playerid, 0xCECECEFF, "Очередь вопросов пуста.");
}

stock HelperQuestion_DirectAnswer(playerid, targetid, const answer[])
{
    if(!HelperQuestion_IsStaff(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "Команда доступна только агентам поддержки.");
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return SendClientMessage(playerid, 0xCECECEFF, "Игрок не найден.");
    if(strlen(answer) < 1 || strlen(answer) > 143) return SendClientMessage(playerid, 0xCECECEFF, "Ответ должен содержать от 1 до 143 символов.");
    new msg[260];
    format(msg, sizeof msg, "{FF9A33}[H] %s[%d] ответил %s[%d]: {FFFFFF}%s", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid, answer);
    SendMessageToHelpers(msg, -1); SendClientMessage(targetid, -1, msg);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, msg);
    mysql_format(mysql, msg, sizeof msg, "INSERT INTO helper_stats_daily(account_id,stat_date,answers) VALUES(%d,CURDATE(),1) ON DUPLICATE KEY UPDATE answers=answers+1", GetPlayerAccountID(playerid));
    mysql_tquery(mysql, msg, "", "");
    return 1;
}

new g_report_gui_player[REPORT_GUI_QUEUE_MAX];
new g_report_gui_account[REPORT_GUI_QUEUE_MAX];
new g_report_gui_text[REPORT_GUI_QUEUE_MAX][REPORT_GUI_TEXT_MAX];
new g_report_gui_head;
new g_report_gui_tail;
new g_report_gui_count;
new g_report_counter_last = -1;

stock ReportGUI_IsAdminAuthorized(playerid)
{
    return IsPlayerConnected(playerid)
        && GetPlayerAdminEx(playerid) >= 1
        && GetPlayerData(playerid, P_ADMIN_LOGGED);
}

stock ReportGUI_CountPending()
{
    new count;

    // Считаем только живые жалобы в очереди.
    for(new offset; offset < g_report_gui_count; offset++)
    {
        new queue_index = (g_report_gui_head + offset) % REPORT_GUI_QUEUE_MAX;
        new targetid = g_report_gui_player[queue_index];
        if(!IsPlayerConnected(targetid)) continue;
        if(GetPlayerAccountID(targetid) != g_report_gui_account[queue_index]) continue;
        count++;
    }

    // Жалоба, которую администратор уже открыл, всё ещё считается необработанной.
    foreach(new adminid : Player)
    {
        if(!GetPVarInt(adminid, "REPORT_GUI_ACTIVE")) continue;
        new targetid = GetPVarInt(adminid, "ANS_TARGET");
        if(!IsPlayerConnected(targetid)) continue;
        if(GetPlayerAccountID(targetid) != GetPVarInt(adminid, "ANS_TARGET_ACCOUNT")) continue;
        count++;
    }
    return count;
}

stock ReportGUI_UpdateCounter()
{
    new count = ReportGUI_CountPending();

    // Обновляем строку принудительно. В моде остались старые функции UpdateReportText*,
    // которые тоже меняют этот TextDraw; ежесекундная запись гарантирует, что REP
    // всегда показывает очередь новой системы репортов, а не устаревший счётчик.
    new counter_text[20];
    format(counter_text, sizeof counter_text, "REP:_%d", count);
    TextDrawSetString(report_edit_TD, counter_text);
    g_report_counter_last = count;
    return 1;
}

stock ReportGUI_ClearAdminState(playerid)
{
    DeletePVar(playerid, "REPORT_GUI_ACTIVE");
    DeletePVar(playerid, "REPORT_GUI_CUSTOM");
    DeletePVar(playerid, "ANS_TARGET");
    DeletePVar(playerid, "ANS_TARGET_ACCOUNT");
    DeletePVar(playerid, "ANS_TEXT");
    ReportGUI_UpdateCounter();
    return 1;
}

stock ReportGUI_Enqueue(playerid, const text[])
{
    if(g_report_gui_count >= REPORT_GUI_QUEUE_MAX) return 0;

    g_report_gui_player[g_report_gui_tail] = playerid;
    g_report_gui_account[g_report_gui_tail] = GetPlayerAccountID(playerid);
    format(g_report_gui_text[g_report_gui_tail], REPORT_GUI_TEXT_MAX, "%s", text);

    g_report_gui_tail = (g_report_gui_tail + 1) % REPORT_GUI_QUEUE_MAX;
    g_report_gui_count++;
    return 1;
}

stock ReportGUI_RequeueActive(playerid)
{
    if(!GetPVarInt(playerid, "REPORT_GUI_ACTIVE")) return 0;

    new targetid = GetPVarInt(playerid, "ANS_TARGET");
    new target_account = GetPVarInt(playerid, "ANS_TARGET_ACCOUNT");
    new report_text[REPORT_GUI_TEXT_MAX];
    GetPVarString(playerid, "ANS_TEXT", report_text, sizeof report_text);

    if(IsPlayerConnected(targetid)
        && GetPlayerAccountID(targetid) == target_account
        && strlen(report_text))
    {
        ReportGUI_Enqueue(targetid, report_text);
    }

    ReportGUI_ClearAdminState(playerid);
    return 1;
}

stock ReportGUI_Dequeue(&targetid, text[], len)
{
    while(g_report_gui_count > 0)
    {
        new queue_index = g_report_gui_head;
        g_report_gui_head = (g_report_gui_head + 1) % REPORT_GUI_QUEUE_MAX;
        g_report_gui_count--;

        targetid = g_report_gui_player[queue_index];
        if(!IsPlayerConnected(targetid)) continue;
        if(GetPlayerAccountID(targetid) != g_report_gui_account[queue_index]) continue;

        format(text, len, "%s", g_report_gui_text[queue_index]);
        return 1;
    }
    ReportGUI_UpdateCounter();
    return 0;
}

stock ReportGUI_Submit(playerid, const report_text[], bool:from_utf8 = false)
{
    if(!IsPlayerConnected(playerid) || GetPlayerAccountID(playerid) <= 0) return 0;
    if(IsPlayerMuted(playerid))
        return SendClientMessage(playerid, 0xFF6600FF, "У вас бан чата!");
    if(strlen(report_text) >= REPORT_GUI_TEXT_MAX)
        return SendClientMessage(playerid, 0xCECECEFF, "Максимальная длина жалобы — 143 символа.");

    new text[REPORT_GUI_TEXT_MAX];
    format(text, sizeof text, "%s", report_text);
    if(from_utf8) utf8_to_cp1251(text);

    new text_len = strlen(text);
    if(text_len < 1)
        return SendClientMessage(playerid, 0xCECECEFF, "Введите текст жалобы.");
    if(text_len >= REPORT_GUI_TEXT_MAX)
        return SendClientMessage(playerid, 0xCECECEFF, "Максимальная длина жалобы — 143 символа.");

    new now = gettime();
    new next_time = GetPVarInt(playerid, "REPORT_GUI_NEXT_TIME");
    if(next_time > now)
    {
        new cooldown_message[96];
        format(cooldown_message, sizeof cooldown_message, "Следующую жалобу можно подать через %d сек.", next_time - now);
        return SendClientMessage(playerid, 0xCECECEFF, cooldown_message);
    }

    if(!ReportGUI_Enqueue(playerid, text))
        return SendClientMessage(playerid, 0xFF3333FF, "Очередь жалоб переполнена. Попробуйте позже.");

    SetPVarInt(playerid, "REPORT_GUI_NEXT_TIME", now + 60);
    ReportGUI_UpdateCounter();

    new message[256];
    format(message, sizeof message, "{704214}[A] Игрок %s[%d] подал жалобу: {FFAE42}%s", GetPlayerNameEx(playerid), playerid, text);
    SendMessageToAdmins(message, 0xFFFFFFFF, 1);
    SendClientMessage(playerid, 0xFFFFFFFF, "{FFFF00}| {FFFFFF}Жалоба отправлена администрации и добавлена в очередь.");
    SendLog(playerid, LOG_TYPE_REPORT, text);
    return 1;
}

stock ReportGUI_Show(playerid, targetid, const report_text[])
{
    if(!ReportGUI_IsAdminAuthorized(playerid) || !IsPlayerConnected(targetid)) return 0;

    // Старые include требуют изменяемую строку в SetPVarString/JSON_SetString.
    new report_text_safe[REPORT_GUI_TEXT_MAX];
    format(report_text_safe, sizeof report_text_safe, "%s", report_text);

    SetPVarInt(playerid, "REPORT_GUI_ACTIVE", 1);
    SetPVarInt(playerid, "ANS_TARGET", targetid);
    SetPVarInt(playerid, "ANS_TARGET_ACCOUNT", GetPlayerAccountID(targetid));
    SetPVarString(playerid, "ANS_TEXT", report_text_safe);

    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 3);
    JSON_SetInt(json, "o", 1);
    JSON_SetInt(json, "id", targetid);
    JSON_SetString(json, "pn", GetPlayerNameEx(targetid));
    JSON_SetString(json, "tr", report_text_safe);
    OnPacketIncoming(playerid, REPORT_GUI_ID, json);
    JSON_Cleanup(json);
    ReportGUI_UpdateCounter();
    return 1;
}

stock ReportGUI_SendTemplates(playerid)
{
    if(!ReportGUI_IsAdminAuthorized(playerid) || !GetPVarInt(playerid, "REPORT_GUI_ACTIVE")) return 0;

    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 4);

    new Node:t1 = JSON_Object("bi", JSON_Int(1), "bn", JSON_String("Работа по жалобе"), "be", JSON_String("Здравствуйте, работаю по вашей жалобе. // Приятной игры"));
    new Node:t2 = JSON_Object("bi", JSON_Int(2), "bn", JSON_String("Не по теме"), "be", JSON_String("Здравствуйте, Ваша жалоба не по теме. // Приятной игры"));
    new Node:t3 = JSON_Object("bi", JSON_Int(3), "bn", JSON_String("RolePlay путем"), "be", JSON_String("Здравствуйте, решите ситуацию RolePlay путем. // Приятной игры"));
    JSON_SetArray(json, "bt", JSON_Array(t1, t2, t3));

    OnPacketIncoming(playerid, REPORT_GUI_ID, json);
    JSON_Cleanup(json);
    return 1;
}

stock ReportGUI_DeliverAnswer(targetid, adminid, const answer[])
{
    if(!IsPlayerConnected(targetid)) return 0;

    // SA-MP/mobile chat has a strict per-message length limit.  Keep the
    // service prefix separate and split the custom answer into safe chunks.
    new header[144];
    format(header, sizeof header, "{704214}[REPORT] {FFFFFF}\xc0\xe4\xec\xe8\xed\xe8\xf1\xf2\xf0\xe0\xf2\xee\xf0 %s[%d] \xee\xf2\xe2\xe5\xf2\xe8\xeb \xed\xe0 \xe2\xe0\xf8\xf3 \xe6\xe0\xeb\xee\xe1\xf3:", GetPlayerNameEx(adminid), adminid);
    if(!SendClientMessage(targetid, 0xFFFFFFFF, header)) return 0;

    new answer_length = strlen(answer);
    new offset = 0;
    while(offset < answer_length)
    {
        new end = offset + 96;
        if(end > answer_length) end = answer_length;

        new chunk[100];
        strmid(chunk, answer, offset, end, sizeof chunk);
        if(!SendClientMessage(targetid, 0xFFAE42FF, chunk)) return 0;

        offset = end;
    }
    return 1;
}

stock ReportGUI_SendAnswer(playerid, const answer[])
{
    if(!ReportGUI_IsAdminAuthorized(playerid) || !GetPVarInt(playerid, "REPORT_GUI_ACTIVE")) return 0;

    new targetid = GetPVarInt(playerid, "ANS_TARGET");
    new target_account = GetPVarInt(playerid, "ANS_TARGET_ACCOUNT");
    if(!IsPlayerConnected(targetid) || GetPlayerAccountID(targetid) != target_account)
    {
        ReportGUI_ClearAdminState(playerid);
        return SendClientMessage(playerid, 0xFF3333FF, "\xc8\xe3\xf0\xee\xea \xf3\xe6\xe5 \xe2\xfb\xf8\xe5\xeb \xf1 \xf1\xe5\xf0\xe2\xe5\xf0\xe0.");
    }

    new answer_len = strlen(answer);
    if(answer_len < 1 || answer_len > 143)
        return SendClientMessage(playerid, 0xCECECEFF, "\xce\xf2\xe2\xe5\xf2 \xe4\xee\xeb\xe6\xe5\xed \xf1\xee\xe4\xe5\xf0\xe6\xe0\xf2\xfc \xee\xf2 1 \xe4\xee 143 \xf1\xe8\xec\xe2\xee\xeb\xee\xe2.");

    // Do not mark the report as answered until the player actually receives
    // all chat chunks.  This fixes custom replies being counted but invisible.
    if(!ReportGUI_DeliverAnswer(targetid, playerid, answer))
    {
        SendClientMessage(playerid, 0xFF3333FF, "\xcd\xe5 \xf3\xe4\xe0\xeb\xee\xf1\xfc \xe4\xee\xf1\xf2\xe0\xe2\xe8\xf2\xfc \xee\xf2\xe2\xe5\xf2 \xe8\xe3\xf0\xee\xea\xf3. \xd0\xe5\xef\xee\xf0\xf2 \xed\xe5 \xe7\xe0\xea\xf0\xfb\xf2, \xef\xee\xef\xf0\xee\xe1\xf3\xe9\xf2\xe5 \xee\xf2\xef\xf0\xe0\xe2\xe8\xf2\xfc \xee\xf2\xe2\xe5\xf2 \xe5\xf9\xb8 \xf0\xe0\xe7.");
        ReportGUI_UpdateCounter();
        return 0;
    }

    new message[320];
    format(message, sizeof message, "{704214}[A] %s[%d] \xee\xf2\xe2\xe5\xf2\xe8\xeb %s[%d]: {FFAE42}%s", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid, answer);
    SendMessageToAdmins(message, 0xFFFFFFFF, 1);
    AdminStats_AddReportAnswer(playerid);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, message);

    new Node:close_json = JSON_Object();
    JSON_SetInt(close_json, "c", 1);
    OnPacketIncoming(playerid, REPORT_GUI_ID, close_json);
    JSON_Cleanup(close_json);

    ReportGUI_ClearAdminState(playerid);
    SendClientMessage(playerid, 0x66CC33FF, "\xce\xf2\xe2\xe5\xf2 \xf3\xf1\xef\xe5\xf8\xed\xee \xee\xf2\xef\xf0\xe0\xe2\xeb\xe5\xed \xe8\xe3\xf0\xee\xea\xf3.");
    return 1;
}

stock ReportGUI_SendTemplateAnswer(playerid, template_id)
{
    new answer[144];
    switch(template_id)
    {
        case 1: format(answer, sizeof answer, "Здравствуйте, работаю по вашей жалобе. // Приятной игры");
        case 2: format(answer, sizeof answer, "Здравствуйте, Ваша жалоба не по теме. // Приятной игры");
        case 3: format(answer, sizeof answer, "Здравствуйте, решите ситуацию RolePlay путем. // Приятной игры");
        default: return 0;
    }
    return ReportGUI_SendAnswer(playerid, answer);
}

stock ReportGUI_OnPlayerDisconnect(playerid)
{
    // Если администратор вышел во время обработки — возвращаем живую жалобу в очередь.
    if(GetPVarInt(playerid, "REPORT_GUI_ACTIVE")) ReportGUI_RequeueActive(playerid);
    else ReportGUI_ClearAdminState(playerid);
    DeletePVar(playerid, "REPORT_GUI_NEXT_TIME");
    ReportGUI_UpdateCounter();
    return 1;
}

stock ReportGUI_ReadCustomAnswer(Node:json, output[], len)
{
    output[0] = EOS;
    if(JSON_GetType(json, "rt") == JSON_NODE_STRING)
        JSON_GetString(json, "rt", output, len);
    if(!strlen(output) && JSON_GetType(json, "text") == JSON_NODE_STRING)
        JSON_GetString(json, "text", output, len);
    if(!strlen(output) && JSON_GetType(json, "r") == JSON_NODE_STRING)
        JSON_GetString(json, "r", output, len);
    if(!strlen(output) && JSON_GetType(json, "a") == JSON_NODE_STRING)
        JSON_GetString(json, "a", output, len);
    if(!strlen(output) && JSON_GetType(json, "v") == JSON_NODE_STRING)
        JSON_GetString(json, "v", output, len);
    if(!strlen(output) && JSON_GetType(json, "m") == JSON_NODE_STRING)
        JSON_GetString(json, "m", output, len);
    if(!strlen(output) && JSON_GetType(json, "msg") == JSON_NODE_STRING)
        JSON_GetString(json, "msg", output, len);
    if(!strlen(output) && JSON_GetType(json, "answer") == JSON_NODE_STRING)
        JSON_GetString(json, "answer", output, len);
    if(!strlen(output) && JSON_GetType(json, "input") == JSON_NODE_STRING)
        JSON_GetString(json, "input", output, len);
    return strlen(output);
}

stock AdminHUD_UpdateDateTime()
{
    new hour, minute, second, year, month, day;
    gettime(hour, minute, second);
    getdate(year, month, day);

    new text[40];
    format(text, sizeof text, "%02d.%02d.%04d_|_%02d:%02d:%02d",
        day, month, year, hour, minute, second);
    TextDrawSetString(admin_datetime_TD, text);
    return 1;
}

stock SpectateGUI_GetPunishAdminLevel(category)
{
    switch(category)
    {
        case 3, 4, 5, 7: return 1; // kick, mute, jail, slap
        case 6: return 2;          // warn
        case 8: return 3;          // donor ban level
    }
    return 99;
}

stock bool:AdminToolsGUI_IsAuthorized(playerid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return false;
    if(GetPlayerYouTubeEx(playerid) > 0) return true;
    return SRAdmin_ViewerAuthorized(playerid);
}

stock AdminToolsGUI_Close(playerid)
{
    DeletePVar(playerid, "ADMIN_TOOLS_GUI");
    new Node:json = JSON_Object();
    JSON_SetString(json, "action", "close");
    JSON_SetBool(json, "isNeedClose", true);
    OnPacketIncoming(playerid, REPORT_GUI_ID, json);
    JSON_Cleanup(json);
    return 1;
}

stock AdminToolsGUI_AppendInfo(Node:array, position, title[], value)
{
    new Node:item = JSON_Object("p", JSON_Int(position));
    JSON_SetString(item, "n", title, strlen(title));
    JSON_SetInt(item, "v", value);
    JSON_Append(array, item);
    JSON_Cleanup(item);
    return 1;
}

stock AdminToolsGUI_Show(playerid)
{
    if(!AdminToolsGUI_IsAuthorized(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, "Команда доступна только авторизованной администрации и медиа-админам.");

    if(GetPVarInt(playerid, "REPORT_GUI_ACTIVE")) ReportGUI_RequeueActive(playerid);
    if(GetPlayerSpectateData(playerid, S_PLAYER) != -1)
    {
        StopSpectateGUIRefresh(playerid);
        StopSpectate(playerid);
        Spectate_RestoreSkin(playerid);
    }

    new Node:json = JSON_Object();
    new Node:players = JSON_Array();
    foreach(new targetid : Player)
    {
        if(!IsPlayerLogged(targetid)) continue;
        new name[MAX_PLAYER_NAME], Float:hp, Float:armor, Float:speed;
        new level = GetPlayerLevel(targetid), ping = GetPlayerPing(targetid), money = GetPlayerMoney(targetid);
        new vehicleid = GetPlayerVehicleID(targetid), Float:vehicle_health = 0.0;
        GetPlayerName(targetid, name, sizeof name);
        GetPlayerHealth(targetid, hp);
        GetPlayerArmour(targetid, armor);
        speed = GetPlayerSpeed(targetid);
        if(vehicleid != INVALID_VEHICLE_ID && IsValidVehicle(vehicleid)) GetVehicleHealth(vehicleid, vehicle_health);
        else vehicleid = 0;

        new Node:info = JSON_Array();
        AdminToolsGUI_AppendInfo(info, 1, "Уровень", level);
        AdminToolsGUI_AppendInfo(info, 2, "Здоровье", floatround(hp));
        AdminToolsGUI_AppendInfo(info, 3, "Броня", floatround(armor));
        AdminToolsGUI_AppendInfo(info, 4, "Скорость", floatround(speed));
        AdminToolsGUI_AppendInfo(info, 5, "Пинг", ping);
        AdminToolsGUI_AppendInfo(info, 6, "Деньги", money);
        AdminToolsGUI_AppendInfo(info, 7, "Транспорт", vehicleid);
        AdminToolsGUI_AppendInfo(info, 8, "Состояние ТС", floatround(vehicle_health));

        new Node:player = JSON_Object();
        JSON_SetInt(player, "id", targetid);
        JSON_SetString(player, "name", name);
        JSON_SetArray(player, "info", info);
        JSON_Append(players, player);
        JSON_Cleanup(info);
    }

    JSON_SetArray(json, "playerInfoList", players);
    JSON_SetString(json, "tableTitle", "Информация об игроках");
    JSON_SetInt(json, "admin_id", playerid);
    JSON_SetBool(json, "isShowTable", true);
    JSON_SetInt(json, "screenType", 3);
    JSON_SetString(json, "categoryTitle", "Административные действия");
    SetPVarInt(playerid, "ADMIN_TOOLS_GUI", 1);
    OnPacketIncoming(playerid, REPORT_GUI_ID, json);
    JSON_Cleanup(players);
    JSON_Cleanup(json);
    return 1;
}

stock AdminToolsGUI_Handle(playerid, Node:json)
{
    if(!GetPVarInt(playerid, "ADMIN_TOOLS_GUI")) return 0;
    if(!AdminToolsGUI_IsAuthorized(playerid)) return AdminToolsGUI_Close(playerid);

    new action[32];
    JSON_GetString(json, "action", action, sizeof action);
    if(!strlen(action)) return 1;
    if(!strcmp(action, "close", true)) return AdminToolsGUI_Close(playerid);

    new targetid = INVALID_PLAYER_ID;
    JSON_GetInt(json, "player_id", targetid);
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
        return SendClientMessage(playerid, 0xFF3333FF, "Игрок уже вышел с сервера.");

    if(!strcmp(action, "select_player", true))
    {
        new name[MAX_PLAYER_NAME];
        GetPlayerName(targetid, name, sizeof name);
        new Node:response = JSON_Object();
        JSON_SetInt(response, "player_id", targetid);
        JSON_SetString(response, "playerName", name);
        JSON_SetString(response, "action", "open_template");
        JSON_SetInt(response, "screenType", 1);
        OnPacketIncoming(playerid, REPORT_GUI_ID, response);
        JSON_Cleanup(response);
        return 1;
    }

    new reason[100], params[160], minutes, days;
    JSON_GetString(json, "reason", reason, sizeof reason);
    utf8_to_cp1251(reason);
    if(!strlen(reason)) format(reason, sizeof reason, "Без причины");

    if(!strcmp(action, "kick", true))
    {
        format(params, sizeof params, "%d %s", targetid, reason);
        callcmd::kick(playerid, params);
    }
    else if(!strcmp(action, "ban", true))
    {
        JSON_GetInt(json, "days", days);
        if(days < 1) days = 1;
        format(params, sizeof params, "%d %d %s", targetid, days, reason);
        callcmd::ban(playerid, params);
    }
    else if(!strcmp(action, "mute", true))
    {
        JSON_GetInt(json, "minutes", minutes);
        if(minutes < 1) minutes = 1;
        format(params, sizeof params, "%d %d %s", targetid, minutes, reason);
        callcmd::mute(playerid, params);
    }
    else if(!strcmp(action, "jail", true))
    {
        JSON_GetInt(json, "minutes", minutes);
        if(minutes < 1) minutes = 1;
        format(params, sizeof params, "%d %d %s", targetid, minutes, reason);
        callcmd::jail(playerid, params);
    }
    else if(!strcmp(action, "warn", true))
    {
        format(params, sizeof params, "%d %s", targetid, reason);
        callcmd::warn(playerid, params);
    }
    else if(!strcmp(action, "slap", true))
    {
        format(params, sizeof params, "%d 0 %s", targetid, reason);
        callcmd::slap(playerid, params);
    }
    else if(!strcmp(action, "teleport", true))
    {
        format(params, sizeof params, "%d", targetid);
        callcmd::goto(playerid, params);
    }
    else return 1;

    if(IsPlayerConnected(playerid)) AdminToolsGUI_Show(playerid);
    return 1;
}

CMD:af(playerid, params[])
{
    DeletePVar(playerid, "ADMIN_TOOLS_GUI");
    return callcmd::sp(playerid, params);
}

CMD:admtools(playerid, params[])
{
    DeletePVar(playerid, "ADMIN_TOOLS_GUI");
    return callcmd::sp(playerid, params);
}

stock SpectateGUI_SendPunishTemplates(playerid, category)
{
    new required_level = SpectateGUI_GetPunishAdminLevel(category);
    if(!SRAdmin_Require(playerid, required_level))
        return ShowNotificationNew(playerid, 2, 3, 0, 0, "Недостаточно прав для этого наказания", "");

    new JSON:response = JSON_Object();
    JSON_SetInt(response, "t", 2);

    switch(category)
    {
        case 3:
        {
            JSON_SetString(response, "bn", "Кик");
            JSON_SetInt(response, "tf", 0);
            new JSON:item1 = JSON_Object("bi", JSON_Int(1), "bn", JSON_String("AFK без ESC"), "be", JSON_String("AFK без ESC"));
            new JSON:item2 = JSON_Object("bi", JSON_Int(2), "bn", JSON_String("Помеха"), "be", JSON_String("Помеха игровому процессу"));
            new JSON:item3 = JSON_Object("bi", JSON_Int(3), "bn", JSON_String("Баг"), "be", JSON_String("Использование бага"));
            JSON_SetArray(response, "bt", JSON_Array(item1, item2, item3));
        }
        case 4:
        {
            JSON_SetString(response, "bn", "Мут");
            JSON_SetInt(response, "tf", 1);
            new JSON:item1 = JSON_Object("bi", JSON_Int(4), "bn", JSON_String("Оскорбление"), "be", JSON_String("Оскорбление игроков"), "br", JSON_Int(30));
            new JSON:item2 = JSON_Object("bi", JSON_Int(5), "bn", JSON_String("Упоминание родни"), "be", JSON_String("Упоминание родни"), "br", JSON_Int(90));
            new JSON:item3 = JSON_Object("bi", JSON_Int(6), "bn", JSON_String("Неуважение к администрации"), "be", JSON_String("Неуважение к администрации"), "br", JSON_Int(90));
            new JSON:item4 = JSON_Object("bi", JSON_Int(7), "bn", JSON_String("CAPS"), "be", JSON_String("Капс в чате"), "br", JSON_Int(30));
            JSON_SetArray(response, "bt", JSON_Array(item1, item2, item3, item4));
        }
        case 5:
        {
            JSON_SetString(response, "bn", "Тюрьма");
            JSON_SetInt(response, "tf", 1);
            new JSON:item1 = JSON_Object("bi", JSON_Int(8), "bn", JSON_String("DM"), "be", JSON_String("Убийство без причины"), "br", JSON_Int(60));
            new JSON:item2 = JSON_Object("bi", JSON_Int(9), "bn", JSON_String("DB"), "be", JSON_String("Убийство транспортом"), "br", JSON_Int(30));
            new JSON:item3 = JSON_Object("bi", JSON_Int(10), "bn", JSON_String("TK"), "be", JSON_String("Убийство союзника"), "br", JSON_Int(60));
            new JSON:item4 = JSON_Object("bi", JSON_Int(11), "bn", JSON_String("Провокация ГОС"), "be", JSON_String("Провокация гос. организаций"), "br", JSON_Int(30));
            JSON_SetArray(response, "bt", JSON_Array(item1, item2, item3, item4));
        }
        case 6:
        {
            JSON_SetString(response, "bn", "Предупреждение");
            JSON_SetInt(response, "tf", 0);
            new JSON:item1 = JSON_Object("bi", JSON_Int(12), "bn", JSON_String("NonRP COP"), "be", JSON_String("Нарушение RP за сотрудника"));
            new JSON:item2 = JSON_Object("bi", JSON_Int(13), "bn", JSON_String("NonRP В/Ч"), "be", JSON_String("Нарушение RP в армии"));
            new JSON:item3 = JSON_Object("bi", JSON_Int(14), "bn", JSON_String("Уход от RP"), "be", JSON_String("Уход от RP процесса"));
            new JSON:item4 = JSON_Object("bi", JSON_Int(15), "bn", JSON_String("Снятие лидера"), "be", JSON_String("Снятие с лидерского поста"));
            JSON_SetArray(response, "bt", JSON_Array(item1, item2, item3, item4));
        }
        case 7:
        {
            JSON_SetString(response, "bn", "Slap");
            JSON_SetInt(response, "tf", 0);
            new JSON:item1 = JSON_Object("bi", JSON_Int(16), "bn", JSON_String("Подбросить вверх"), "be", JSON_String("Поднять игрока на 5 метров"));
            new JSON:item2 = JSON_Object("bi", JSON_Int(17), "bn", JSON_String("Опустить вниз"), "be", JSON_String("Опустить игрока на 5 метров"));
            JSON_SetArray(response, "bt", JSON_Array(item1, item2));
        }
        case 8:
        {
            JSON_SetString(response, "bn", "Бан");
            JSON_SetInt(response, "tf", 1);
            new maximum_days = SRAdmin_Level(playerid) > 4 ? 90 : 30;
            new JSON:item1 = JSON_Object("bi", JSON_Int(18), "bn", JSON_String("Mass DM"), "be", JSON_String("Массовое убийство"), "br", JSON_Int(7));
            new JSON:item2 = JSON_Object("bi", JSON_Int(19), "bn", JSON_String("ППВ"), "be", JSON_String("Передача или продажа аккаунта"), "br", JSON_Int(30));
            new JSON:item3 = JSON_Object("bi", JSON_Int(20), "bn", JSON_String("Оскорбление родни"), "be", JSON_String("Оскорбление родных"), "br", JSON_Int(15));
            new JSON:item4 = JSON_Object("bi", JSON_Int(21), "bn", JSON_String("Читы"), "be", JSON_String("Использование читов"), "br", JSON_Int(maximum_days));
            JSON_SetArray(response, "bt", JSON_Array(item1, item2, item3, item4));
        }
        default:
        {
            JSON_Cleanup(response);
            return 0;
        }
    }

    OnPacketIncoming(playerid, 66, response);
    JSON_Cleanup(response);
    return 1;
}

