                                "Настройки семьи",
                                "Вы действительно хотите установить точку спавна вашей семьи\n\
                                На то место где вы находитесь?",
                                "Далее", "Отмена"
                            );
                        }
                        case 1:ShowChangeRangDialog(playerid);
                        case 2: ShowChangeNameDialog(playerid);
