stock FixBugMoneyMinus(playerid)
{
	new money = GetPlayerData(playerid, P_MONEY);
	
	if(GetPlayerMoneyEx(playerid) < 0)
	{
		printf("[MONEY][REPAIR] player=%d account=%d invalid_cash=%d reset=0", playerid, GetPlayerAccountID(playerid), money);
		SetPlayerData(playerid, P_MONEY, 0);
		UpdatePlayerDatabaseInt(playerid, "money", 0);
		ResetPlayerMoney(playerid);
		SendClientMessage(playerid,-1, "Некорректный отрицательный баланс исправлен на 0 рублей");

	}
	
	if(GetPlayerData(playerid, P_BANK) < 0)
	{
		printf("[MONEY][REPAIR] player=%d account=%d invalid_bank=%d reset=0", playerid, GetPlayerAccountID(playerid), GetPlayerData(playerid, P_BANK));
		SetPlayerData(playerid, P_BANK, 0);
	    UpdatePlayerDatabaseInt(playerid, "bank", 0);
	    SendClientMessage(playerid,-1, "Некорректный отрицательный баланс банка исправлен на 0 рублей");
	
	}
}
