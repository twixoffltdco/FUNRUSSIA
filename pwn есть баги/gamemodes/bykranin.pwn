#define DIALOG_WEDDING_MENU       (31430)
#define DIALOG_WEDDING_RING       (31431)
#define DIALOG_WEDDING_PROPOSAL   (31432)
#define DIALOG_WEDDING_DIVORCE    (31433)
#define DIALOG_WEDDING_RENT       (31434)

new wedding_area_enter;
new wedding_area_exit;
new wedding_area_menu;
new wedding_area_car;
new bool:wedding_ring[MAX_PLAYERS];
new wedding_rent_vehicle[MAX_PLAYERS] = {INVALID_VEHICLE_ID, ...};

stock Wedding_EnsureStorage()
{
    static bool:ready = false;
    if(ready) return 1;
    new Cache:result = mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS `wedding_players` (`account_id` INT NOT NULL, `has_ring` TINYINT NOT NULL DEFAULT 0, `updated_at` INT NOT NULL DEFAULT 0, PRIMARY KEY (`account_id`)) ENGINE=InnoDB DEFAULT CHARSET=cp1251",
        true);
    new error = mysql_errno();
    cache_delete(result);
    if(error)
    {
        printf("[WEDDING][ERROR] storage init errno=%d", error);
        return 0;
    }
    ready = true;
    return 1;
}

stock Wedding_LoadRing(playerid)
{
    new account_id = GetPlayerAccountID(playerid);
    wedding_ring[playerid] = false;
    if(account_id <= 0 || !Wedding_EnsureStorage()) return 0;
    new query[160];
    mysql_format(mysql, query, sizeof(query), "SELECT `has_ring` FROM `wedding_players` WHERE `account_id`=%d LIMIT 1", account_id);
    new Cache:result = mysql_query(mysql, query, true);
    if(!mysql_errno() && cache_num_rows(result)) wedding_ring[playerid] = cache_get_field_content_int(0, "has_ring") != 0;
    cache_delete(result);
    return 1;
}

stock Wedding_SaveRing(playerid, bool:value)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0 || !Wedding_EnsureStorage()) return 0;
    new query[384];
    mysql_format(mysql, query, sizeof(query),
        "INSERT INTO `wedding_players` (`account_id`,`has_ring`,`updated_at`) VALUES (%d,%d,%d) ON DUPLICATE KEY UPDATE `has_ring`=%d,`updated_at`=%d",
        account_id, value, gettime(), value, gettime());
    new Cache:result = mysql_query(mysql, query, true);
    new error = mysql_errno();
    cache_delete(result);
    if(error) return 0;
    wedding_ring[playerid] = value;
    return 1;
}

stock Wedding_FindOnlineByAccount(account_id)
{
    foreach(new i : Player) if(GetPlayerAccountID(i) == account_id) return i;
    return INVALID_PLAYER_ID;
}

stock Wedding_Init()
{
    Wedding_EnsureStorage();
    CreateDynamicPickupEx(1318, 23, -2341.432128, 1581.900878, 9.899374);
    CreateDynamicPickupEx(1318, 23, 2500.420898, 2500.220703, 1500.997192, 143);
    CreateDynamicPickupEx(1314, 23, 2534.543945, 2526.558593, 1501.286254, 143);
    CreateDynamicPickupEx(1318, 23, -2362.439453, 1591.376220, 9.891562);
    wedding_area_enter = CreateDynamicSphere(-2341.432128, 1581.900878, 9.899374, 1.0);
    wedding_area_exit = CreateDynamicSphere(2500.420898, 2500.220703, 1500.997192, 1.0, 143);
    wedding_area_menu = CreateDynamicSphere(2534.543945, 2526.558593, 1501.286254, 3.0, 143);
    wedding_area_car = CreateDynamicSphere(-2362.439453, 1591.376220, 9.891562, 3.0);
    CreateDynamic3DTextLabel("{B9234B}ЗАГС\n{FFFFFF}Информация и обручальные кольца", -1, 2534.543945, 2526.558593, 1502.286254, 10.0, _, _, _, 143);
    CreateDynamic3DTextLabel("{B9234B}Аренда свадебного транспорта\n{FFFFFF}Встаньте на метку", -1, -2362.439453, 1591.376220, 10.891562, 10.0);
    return 1;
}

stock Wedding_ShowMenu(playerid)
{
    Wedding_LoadRing(playerid);
    return Dialog(playerid, DIALOG_WEDDING_MENU, DIALOG_STYLE_LIST, "{B9234B}ЗАГС",
        "Информация о свадьбах\nКупить обручальные кольца", "Выбрать", "Закрыть");
}

stock Wedding_OnEnterArea(playerid, areaid)
{
    if(areaid == wedding_area_enter)
    {
        SetPlayerPosEx(playerid, 2501.875244, 2500.405273, 1500.997192, 278.195495, 1, 143);
        return 1;
    }
    if(areaid == wedding_area_exit)
    {
        SetPlayerPosEx(playerid, -2344.0, 1581.9, 9.9, 0.0, 0, 0);
        return 1;
    }
    if(areaid == wedding_area_menu) return Wedding_ShowMenu(playerid);
    if(areaid == wedding_area_car)
    {
        Dialog(playerid, DIALOG_WEDDING_RENT, DIALOG_STYLE_TABLIST,
            "{B9234B}Свадебный транспорт", "Лимузин\t100000 рублей\nInfernus\t50000 рублей\nПолицейский автомобиль\t60000 рублей", "Арендовать", "Закрыть");
        return 1;
    }
    return 0;
}

stock Wedding_CreateMarriage(playerid, partnerid)
{
    if(!IsPlayerConnected(partnerid) || !IsPlayerLogged(partnerid)) return 0;
    if(GetPlayerData(playerid, P_WIFE) || GetPlayerData(partnerid, P_WIFE)) return 0;
    new account_id = GetPlayerAccountID(playerid), partner_account = GetPlayerAccountID(partnerid);
    if(account_id <= 0 || partner_account <= 0) return 0;

    new query[192];
    mysql_format(mysql, query, sizeof(query), "UPDATE `accounts` SET `wife`=%d WHERE `id`=%d AND `wife`=0 LIMIT 1", partner_account, account_id);
    new Cache:r1 = mysql_query(mysql, query, true);
    new ok1 = !mysql_errno() && cache_affected_rows() == 1;
    cache_delete(r1);
    if(!ok1) return 0;

    mysql_format(mysql, query, sizeof(query), "UPDATE `accounts` SET `wife`=%d WHERE `id`=%d AND `wife`=0 LIMIT 1", account_id, partner_account);
    new Cache:r2 = mysql_query(mysql, query, true);
    new ok2 = !mysql_errno() && cache_affected_rows() == 1;
    cache_delete(r2);
    if(!ok2)
    {
        mysql_format(mysql, query, sizeof(query), "UPDATE `accounts` SET `wife`=0 WHERE `id`=%d AND `wife`=%d LIMIT 1", account_id, partner_account);
        mysql_query(mysql, query, false);
        return 0;
    }

    SetPlayerData(playerid, P_WIFE, partner_account);
    SetPlayerData(partnerid, P_WIFE, account_id);
    Wedding_SaveRing(playerid, false);
    Wedding_SaveRing(partnerid, false);
    new message[160];
    format(message, sizeof(message), "[ЗАГС] %s и %s вступили в брак! Пожелаем им счастья!", GetPlayerNameEx(playerid), GetPlayerNameEx(partnerid));
    SendClientMessageToAll(0xDC143CFF, message);
    return 1;
}

stock Wedding_OnDialog(playerid, dialogid, response, listitem)
{
    if(dialogid == DIALOG_WEDDING_MENU)
    {
        if(!response) return 1;
        if(listitem == 0)
            Dialog(playerid, -1, DIALOG_STYLE_MSGBOX, "{B9234B}Свадьбы", "Купите кольца, пригласите партнёра в ЗАГС и используйте /wedding [ID].\nДля развода используйте /divorce.", "Закрыть", "");
        else if(listitem == 1)
            Dialog(playerid, DIALOG_WEDDING_RING, DIALOG_STYLE_MSGBOX, "{B9234B}Обручальные кольца", "Стоимость комплекта: 100000 рублей.", "Купить", "Отмена");
        return 1;
    }
    if(dialogid == DIALOG_WEDDING_RING)
    {
        if(!response) return 1;
        Wedding_LoadRing(playerid);
        if(GetPlayerData(playerid, P_WIFE)) return SendClientMessage(playerid, -1, "Вы уже состоите в браке.");
        if(wedding_ring[playerid]) return SendClientMessage(playerid, -1, "У вас уже есть обручальные кольца.");
        if(GetPlayerMoneyEx(playerid) < 100000) return SendClientMessage(playerid, -1, "Недостаточно денег: требуется 100000 рублей.");
        if(!Wedding_SaveRing(playerid, true)) return SendClientMessage(playerid, -1, "Ошибка сохранения колец. Деньги не списаны.");
        GivePlayerMoneyEx(playerid, -100000, "Wedding rings", true, true);
        SendClientMessage(playerid, 0x66CC66FF, "Вы купили обручальные кольца.");
        return 1;
    }
    if(dialogid == DIALOG_WEDDING_PROPOSAL)
    {
        new proposer = GetPVarInt(playerid, "wedding_proposer");
        DeletePVar(playerid, "wedding_proposer");
        if(!response) return SendClientMessage(playerid, -1, "Вы отказались от предложения.");
        if(!IsPlayerConnected(proposer) || !IsPlayerLogged(proposer)) return SendClientMessage(playerid, -1, "Игрок вышел с сервера.");
        if(GetPlayerVirtualWorld(playerid) != 143 || GetPlayerVirtualWorld(proposer) != 143 || !IsPlayerInRangeOfPlayer(playerid, proposer, 10.0)) return SendClientMessage(playerid, -1, "Для заключения брака оба игрока должны находиться рядом в ЗАГСе.");
        if(!Wedding_CreateMarriage(proposer, playerid)) return SendClientMessage(playerid, -1, "Не удалось зарегистрировать брак.");
        SendClientMessage(playerid, 0x66CC66FF, "Брак успешно зарегистрирован.");
        SendClientMessage(proposer, 0x66CC66FF, "Брак успешно зарегистрирован.");
        return 1;
    }
    if(dialogid == DIALOG_WEDDING_DIVORCE)
    {
        if(!response) return 1;
        new spouse_account = GetPlayerData(playerid, P_WIFE);
        if(spouse_account <= 0) return SendClientMessage(playerid, -1, "Вы не состоите в браке.");
        new query[256], account_id = GetPlayerAccountID(playerid);
        mysql_format(mysql, query, sizeof(query), "UPDATE `accounts` SET `wife`=0 WHERE `id` IN (%d,%d)", account_id, spouse_account);
        new Cache:result = mysql_query(mysql, query, true);
        new error = mysql_errno();
        cache_delete(result);
        if(error) return SendClientMessage(playerid, -1, "Ошибка базы данных. Развод не оформлен.");
        new spouse = Wedding_FindOnlineByAccount(spouse_account);
        if(spouse != INVALID_PLAYER_ID)
        {
            SetPlayerData(spouse, P_WIFE, 0);
            SendClientMessage(spouse, 0xFF6347FF, "Ваш брак был расторгнут.");
        }
        SetPlayerData(playerid, P_WIFE, 0);
        SendClientMessage(playerid, 0x66CC66FF, "Ваш брак успешно расторгнут.");
        return 1;
    }
    if(dialogid == DIALOG_WEDDING_RENT)
    {
        if(!response) return 1;
        if(listitem < 0 || listitem > 2) return 1;
        new const models[] = {409, 411, 596};
        new const prices[] = {100000, 50000, 60000};
        if(GetPlayerMoneyEx(playerid) < prices[listitem]) return SendClientMessage(playerid, -1, "Недостаточно денег для аренды.");
        if(wedding_rent_vehicle[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(wedding_rent_vehicle[playerid]);
        new Float:x, Float:y, Float:z, Float:a;
        GetPlayerPos(playerid, x, y, z); GetPlayerFacingAngle(playerid, a);
        new vehicleid = CreateVehicle(models[listitem], x + 3.0, y, z, a, 0, 0, 600);
        if(vehicleid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, -1, "Не удалось создать транспорт.");
        wedding_rent_vehicle[playerid] = vehicleid;
        GivePlayerMoneyEx(playerid, -prices[listitem], "Wedding vehicle rent", true, true);
        PutPlayerInVehicle(playerid, vehicleid, 0);
        return 1;
    }
    return 0;
}

stock Wedding_OnDisconnect(playerid)
{
    wedding_ring[playerid] = false;
    DeletePVar(playerid, "wedding_proposer");
    if(wedding_rent_vehicle[playerid] != INVALID_VEHICLE_ID)
    {
        DestroyVehicle(wedding_rent_vehicle[playerid]);
        wedding_rent_vehicle[playerid] = INVALID_VEHICLE_ID;
    }
    return 1;
}

CMD:wedding(playerid, params[])
{
    new targetid;
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, -1, "Используйте: /wedding [ID игрока]");
    if(targetid == playerid || !IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return SendClientMessage(playerid, -1, "Игрок не найден.");
    if(GetPlayerVirtualWorld(playerid) != 143 || GetPlayerVirtualWorld(targetid) != 143 || !IsPlayerInRangeOfPlayer(playerid, targetid, 10.0)) return SendClientMessage(playerid, -1, "Оба игрока должны находиться рядом в ЗАГСе.");
    if(GetPlayerData(playerid, P_WIFE) || GetPlayerData(targetid, P_WIFE)) return SendClientMessage(playerid, -1, "Один из игроков уже состоит в браке.");
    Wedding_LoadRing(playerid);
    if(!wedding_ring[playerid]) return SendClientMessage(playerid, -1, "Сначала купите обручальные кольца.");
    SetPVarInt(targetid, "wedding_proposer", playerid);
    new message[128];
    format(message, sizeof(message), "%s предлагает вам вступить в брак.", GetPlayerNameEx(playerid));
    Dialog(targetid, DIALOG_WEDDING_PROPOSAL, DIALOG_STYLE_MSGBOX, "{B9234B}Предложение руки и сердца", message, "Согласиться", "Отказаться");
    SendClientMessage(playerid, 0x66CC66FF, "Предложение отправлено.");
    return 1;
}

CMD:yes_wedding(playerid, params[])
{
    #pragma unused params
    new proposer = GetPVarInt(playerid, "wedding_proposer");
    if(!IsPlayerConnected(proposer)) return SendClientMessage(playerid, -1, "Активного предложения нет.");
    if(!Wedding_CreateMarriage(proposer, playerid)) return SendClientMessage(playerid, -1, "Не удалось зарегистрировать брак.");
    DeletePVar(playerid, "wedding_proposer");
    return 1;
}

CMD:divorce(playerid, params[])
{
    #pragma unused params
    if(!GetPlayerData(playerid, P_WIFE)) return SendClientMessage(playerid, -1, "Вы не состоите в браке.");
    Dialog(playerid, DIALOG_WEDDING_DIVORCE, DIALOG_STYLE_MSGBOX, "{B9234B}Развод", "Вы действительно хотите расторгнуть брак?", "Да", "Нет");
    return 1;
}
