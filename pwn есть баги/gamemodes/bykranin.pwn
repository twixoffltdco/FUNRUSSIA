			// -----------------------------------------------------------------
			case DIALOG_BIZ_BUY:
			{
				if(response)
				{
					new businessid = GetPVarInt(playerid, "buy_biz_id");
					if(businessid < 0 || businessid >= g_business_loaded || IsBusinessOnAuction(businessid))
					{
						DeletePVar(playerid, "buy_biz_id");
