stock FW_HandleCommand(playerid, cmdtext[])
{
    new cmd[32], params[256];
    cmd[0] = EOS;
    params[0] = EOS;

    sscanf(cmdtext, "s[32]S()[256]", cmd, params);

    if(!strcmp(cmd, "fwcreate", true)) return FW_CMD_fwcreate(playerid, params);
    if(!strcmp(cmd, "fwarreg", true)) return FW_CMD_fwarreg(playerid, params);
    if(!strcmp(cmd, "fwarunreg", true)) return FW_CMD_fwarunreg(playerid, params);
    if(!strcmp(cmd, "fwars", true)) return FW_CMD_fwars(playerid, params);
    if(!strcmp(cmd, "fwrating", true)) return FW_CMD_fwrating(playerid, params);
    if(!strcmp(cmd, "fwarhistory", true)) return FW_CMD_fwarhistory(playerid, params);
    if(!strcmp(cmd, "fcontainers", true)) return FW_CMD_fcontainers(playerid, params);
    if(!strcmp(cmd, "fcontaineropen", true)) return FW_CMD_fcontaineropen(playerid, params);

    return 0;
}


