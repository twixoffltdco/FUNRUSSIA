cmd:startfevent(playerid, params[])
{
    extract params -> new t;

    if(!t) return SendClientMessage(playerid, -1, "1 - Вышки / 2 - Ферма Гарель / 3 - Завод Бусаево / 4 - Семейные контейнеры");

    if(1 <= t <= 3)
    {
       if(CAPTURE_STATUS[t-1]) return SendClientMessage(playerid, -1, "Данное сражение уже началось.");
       StartFCapture(t-1);
    }
    else if(t == 4)
    {
        if(FAM_CONT_STATUS[0] || FAM_CONT_STATUS[1]) return SendClientMessage(playerid, -1, "Семейные контейнеры уже начались.");
        StartFCont(0);
    }
    return 1;
}

stock UpdateExpFamily(f, t)
{
    new player_all_exp;

    foreach(new i : Player)
    {
        if(GetPlayerIdFamily(i) != f) continue;
        else if(!IsPlayerInDynamicArea(i, CAPTURE_AREA[t])) continue;

        player_all_exp += CAPTURE_PLAYER_EXP[i];
    }

    if(CAPTURE_FAMILY_EXP[f][t] != player_all_exp) CAPTURE_FAMILY_EXP[f][t] = player_all_exp;

    if(f == CAPTURE_LEADER[t][0]) CAPTURE_LEADER[t][1] = CAPTURE_FAMILY_EXP[f][t];

    return 1;
}
cmd:tpw(playerid, params[])
{
    if(!params[0]) SetPlayerPos(playerid, 452.989440,-2388.076660,34.813564);
    else SetPlayerPos(playerid, 2016.786865,1397.302490,26.15625);

    return 1;
}

stock StartFCont(type_capt)
{
    if(FAM_CONT_STATUS[type_capt]) return printf("CONT: %d already started", type_capt);

    new string[265], welsi = 2;

    for(new i;i < welsi;i++)
    {
        FAM_CONT_STATUS[i] = true;
        FAM_CONT_BOX[i] = 350;
        FAM_CONT_SECOND[i] = 1500;
        FAM_CONT_GANG_ZONE[i] = GangZoneCreate(coord_fam_cont[i][0], coord_fam_cont[i][1], coord_fam_cont[i][2], coord_fam_cont[i][3]);
        FAM_CONT_AREA[i] = CreateDynamicRectangle(coord_fam_cont[i][0], coord_fam_cont[i][1], coord_fam_cont[i][2], coord_fam_cont[i][3],
        0, 0);
        FAM_CONT_OBJECT[i] = CreateObject(934, coord_obj_cont[i][0], coord_obj_cont[i][1], coord_obj_cont[i][2]+1.0, 0.0, 0.0, 0.0);

        FAM_CONT_PICKUP[i] = CreateDynamicPickup(19135, 23, coord_puckup_cont[i][0], coord_puckup_cont[i][1], coord_puckup_cont[i][2], 0, 0);
        FAM_CONT_AREA_P[i] = CreateDynamicSphere(coord_puckup_cont[i][0], coord_puckup_cont[i][1], coord_puckup_cont[i][2], 1.5, 0, 0);
        FAM_CONT_3DTEXT[i] = Create3DTextLabel("Содержимое контейнера\nКонец захвата через: 25 минут\nДля взаимодействия подойдите к пикапу.", -1,
        coord_puckup_cont[i][0], coord_puckup_cont[i][1], coord_puckup_cont[i][2], 20.0, 0);

        foreach(new w : Player)
        {
            if(GetPlayerIdFamily(w) == -1) continue;
            GangZoneShowForPlayer(w, FAM_CONT_GANG_ZONE[i], 0xFF0000FF0);
            GangZoneFlashForPlayer(w, FAM_CONT_GANG_ZONE[i], 0xFFFF00FF);
        }

        format(string, sizeof string, "{FFFF00}|{FFFFFF} Началось сражение за {FFFF00}Семейные контейнеры{FFFFFF}, найдите место проведение с помощью — карты");

        FAM_CONT_TIMER[i] = SetTimerEx("ContUpd", 1000, true, "i", i);
    }

    foreach(new w : Player)
    {
        if(GetPlayerIdFamily(w) == -1) continue;
        SendClientMessage(w, -1, string);
    }

    return 1;
}

new string_count[98];
public:ContUpd(i)
{
    if(!FAM_CONT_SECOND[i]) return EndFCont();
    FAM_CONT_SECOND[i]--;

    format(string_count, sizeof string_count, "Содержимое контейнера\nКонец захвата через: %d минут\nДля взаимодействия подойдите к пикапу.", ConvertUnixTime(FAM_CONT_SECOND[i], CONVERT_TIME_TO_MINUTES));
    Update3DTextLabelText(FAM_CONT_3DTEXT[i], -1, string_count);
    return 1;
}

stock EndFCont()
{
    for(new i;i < 2;i++)
    {
        KillTimer(FAM_CONT_TIMER[i]);
        FAM_CONT_TIMER[i] = -1;

        FAM_CONT_STATUS[i] = false;

        DestroyObject(FAM_CONT_OBJECT[i]);
        FAM_CONT_OBJECT[i] = -1;

        DestroyDynamicArea(FAM_CONT_AREA[i]);
        FAM_CONT_AREA[i] = -1;

        DestroyDynamicArea(FAM_CONT_AREA_P[i]);
        FAM_CONT_AREA_P[i] = -1;

        GangZoneDestroy(FAM_CONT_GANG_ZONE[i]);
        FAM_CONT_GANG_ZONE[i] = -1;

        FAM_CONT_BOX[i] = 0;

        FAM_CONT_SECOND[i] = 0;

        Delete3DTextLabel(FAM_CONT_3DTEXT[i]);
        FAM_CONT_3DTEXT[i] = Text3D:-1;

        DestroyDynamicPickup(FAM_CONT_PICKUP[i]);
        FAM_CONT_PICKUP[i] = -1;
    }
    return 1;
}

cmd:loadfamily(playerid)
{
    if(GetPlayerIdFamily(playerid) == -1) return 0;

    if(!IsPlayerInDynamicArea(playerid, FAM_CONT_AREA[0]) && !IsPlayerInDynamicArea(playerid, FAM_CONT_AREA[1]))
        return SendClientMessage(playerid, -1, ""c_f_g"Вы не на семейных контейнерах.");

    new vehicleid = GetPlayerVehicleID(playerid), action = GetVehicleData(vehicleid, V_ACTION_ID);

    if(vehicleid == INVALID_VEHICLE_ID || GetCarFamily(action, CAR_F_database) == -1 || GetCarFamily(action, OW_F_server) != GetPlayerIdFamily(playerid))
        return SendClientMessage(playerid, -1, ""c_f_r"Вы должны быть в семейном транспорте.");

    FAM_CONT_VEHICLE[playerid] = action;

    new Float:x, Float:y, Float:z, string[74];
    GetCoordBootFamilyVehicle(vehicleid, x, y, z);

    format(string, sizeof string, "Загружено ящиков: {FF0000}%d", GetCarFamily(action, V_F_COUNT_BOX));

    SetCarFamily(action, V_F_AREA_CONT, CreateDynamicSphere(x,y,z,1.5, 0, 0));
    SetCarFamily(action, V_F_TEXT_CONT, CreateDynamic3DTextLabel(string, -1, x, y, z, 7.0));
    SetCarFamily(action, V_F_STATUS_CONT, true);

    RemovePlayerFromVehicle(playerid);
    SendClientMessage(playerid, -1, ""c_f_g"Началась загрузка.");

    return 1;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
    {
        new id = GetVehicleData(vehicleid, V_ACTION_ID);

        if(GetCarFamily(id, V_F_STATUS_CONT))
        {
            SendClientMessage(playerid, -1, ""c_f_r"Метка отмечена у Вас на карте (знак оружия)");
            CreateDynamicMapIcon(2323.082275,-248.499404,1.991280, 6, 0, 0, 0, playerid, -1);
            SetCarFamily(id, V_F_STATUS_CONT, false);

            RemovePlayerAttachedObject(playerid, 2);

            FAM_CONT_VEHICLE[playerid] = -1;

            if(IsValidDynamicArea(GetCarFamily(id, V_F_AREA_CONT))) DestroyDynamicArea(GetCarFamily(id, V_F_AREA_CONT));
            DestroyDynamic3DTextLabel(GetCarFamily(id, V_F_TEXT_CONT));
            SetCarFamily(id, V_F_STATUS_CONT, false);
        }
    }
    #if defined cont_OnPlayerEnterVehicle
        return cont_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger);
    #else
        return 1;
    #endif
}
   #if defined _ALS_OnPlayerEnterVehicle
    #undef OnPlayerEnterVehicle
#else
    #define _ALS_OnPlayerEnterVehicle
#endif
#define OnPlayerEnterVehicle cont_OnPlayerEnterVehicle
#if defined cont_OnPlayerEnterVehicle
    forward cont_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger);
#endif

stock GetCoordBootFamilyVehicle(vehicleid, &Float:x, &Float:y, &Float:z)
{
    new Float:angle,Float:distance;
    GetVehicleModelInfo(GetVehicleModel(vehicleid), 1, x, distance, z);
    distance = distance/2 + 0.1;
        GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle+180, degrees));
    y += (distance * floatcos(-angle+180, degrees));
    return 1;
}

public:SetPlayerBoxInHard(playerid, number)
{
    SetPlayerAttachedObject(playerid, 2, 2969, 1, 0.121241, 0.433916, -0.038068, 359.338867, 91.670600, 179.788787, 1.000000, 1.000000, 1.000000);
    FAM_CONT_BOX[number]--;
    SendClientMessage(playerid, -1, ""c_f"Вы взяли ящик, теперь отнесите его в машину.");
    SetPVarInt(playerid, "box_in_hard", 1);
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 1, 1, 1, 1, 0);

    return 1;
}

stock HandleFamilyCrouch(playerid)
{
    if(GetPlayerIdFamily(playerid) == -1 || !IsPlayerInDynamicArea(playerid, FAM_CONT_DELIVERY)) return 0;

    new vehicleid = GetPlayerVehicleID(playerid);

    if(vehicleid == INVALID_VEHICLE_ID || GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_FAMILY_CAR) return 0;

    new action = GetVehicleData(vehicleid, V_ACTION_ID), f = GetCarFamily(action, OW_F_server);

    if(f != GetPlayerIdFamily(playerid)) return 0;

    if(GetCarFamily(action, V_F_COUNT_BOX) == 0) return SendClientMessage(playerid, -1, ""c_f_r" В вашем семейном транспорте нет ящиков");

    new money = GetCarFamily(action, V_F_COUNT_BOX) * 100;

    AddFamily(f, family_reputation, +, GetCarFamily(action, V_F_COUNT_BOX));
    AddFamily(f, family_money, +, money);
    UpdateColumnFamilyInt(GetFamily(f, family_database), "money", GetFamily(f, family_money));
    UpdateColumnFamilyInt(GetFamily(f, family_database), "reputation", GetFamily(f, family_reputation));

    format(f_string144, sizeof f_string144, "%s[%d] пригнал машину на черный рынок, семья получила %d реп., — %d рублей",
        GetPlayerNameEx(playerid), playerid, GetCarFamily(action, V_F_COUNT_BOX), money);
    SendFamilyMessage(f, f_string144);
    SetCarFamily(action, V_F_COUNT_BOX, 0);

    return 1;
}

#if defined _INC_FAMILY_SYSTEM
    #endinput
#endif
#define _INC_FAMILY_SYSTEM

#define FAMILY_SYSTEM_MAX_CARS (1000)

enum E_FAMILY_SYSTEM_CAR
{
    FS_SQL_ID,
    FS_FAMILY_ID,
    FS_OWNABLE_CAR_ID,
    FS_MODEL_ID,
    FS_OWNER_ID,
    FS_ACCESS_RANK,
    FS_STATUS
}

new g_family_system_car[FAMILY_SYSTEM_MAX_CARS][E_FAMILY_SYSTEM_CAR];
new g_family_system_loaded;

stock FamilySystemGetPlayerFamily(playerid)
{
    new family_id = GetPlayerData(playerid, P_FAMILY);

    if(family_id > 0)
    {
        return family_id;
    }

    if(family_id == 0 && GetPlayerData(playerid, P_FAMILY_RANK) >= 10)
    {
        new fam_name[64];
        format(fam_name, sizeof fam_name, "%s", GetFamilyData(0, F_NAME));
        if(strlen(fam_name) > 0)
        {
            return 0;
        }
    }

    if(GetPlayerIdFamily(playerid) != -1)
    {
        return GetPlayerIdFamily(playerid);
    }

    return -1;
}

stock FamilySystemResetSlot(slot)
{
    g_family_system_car[slot][FS_SQL_ID] = 0;
    g_family_system_car[slot][FS_FAMILY_ID] = 0;
    g_family_system_car[slot][FS_OWNABLE_CAR_ID] = 0;
    g_family_system_car[slot][FS_MODEL_ID] = 0;
    g_family_system_car[slot][FS_OWNER_ID] = 0;
    g_family_system_car[slot][FS_ACCESS_RANK] = 1;
    g_family_system_car[slot][FS_STATUS] = 0;
    return 1;
}

stock FamilySystemGetFreeSlot()
{
    for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
    {
        if(g_family_system_car[i][FS_SQL_ID] == 0)
        {
            return i;
        }
    }
    return -1;
}

stock FamilySystemFindBySql(sql_id)
{
    for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
    {
        if(g_family_system_car[i][FS_SQL_ID] == sql_id)
        {
            return i;
        }
    }
    return -1;
}

stock FamilySystemFindByFamilyOwnable(family_id, ownable_car_id)
{
    for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
    {
        if(g_family_system_car[i][FS_SQL_ID] == 0) continue;
        if(g_family_system_car[i][FS_FAMILY_ID] != family_id) continue;
        if(g_family_system_car[i][FS_OWNABLE_CAR_ID] != ownable_car_id) continue;
        return i;
    }
    return -1;
}

stock FamilySystemCreateTable()
{
    mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS `familysystem` (\
        `id` INT NOT NULL AUTO_INCREMENT,\
        `family_id` INT NOT NULL,\
        `owner_id` INT NOT NULL,\
        `ownable_car_id` INT NOT NULL,\
        `model_id` INT NOT NULL,\
        `access_rank` INT NOT NULL DEFAULT 1,\
        `status` TINYINT NOT NULL DEFAULT 0,\
        `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\
        PRIMARY KEY (`id`),\
        UNIQUE KEY `idx_family_ownable` (`family_id`, `ownable_car_id`),\
        KEY `idx_family` (`family_id`),\
        KEY `idx_owner` (`owner_id`),\
        KEY `idx_ownable` (`ownable_car_id`)\
    ) ENGINE=InnoDB DEFAULT CHARSET=cp1251;",
    false);
    return 1;
}

stock FamilySystemLoad()
{
    for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
    {
        FamilySystemResetSlot(i);
    }

    new Cache:result = mysql_query(mysql,
        "SELECT id, family_id, owner_id, ownable_car_id, model_id, access_rank, status FROM familysystem",
    true);

    new rows = cache_num_rows();
    if(rows > FAMILY_SYSTEM_MAX_CARS)
    {
        printf("[FamilySystem] rows (%d) > FAMILY_SYSTEM_MAX_CARS (%d)", rows, FAMILY_SYSTEM_MAX_CARS);
        rows = FAMILY_SYSTEM_MAX_CARS;
    }

    for(new i; i < rows; i++)
    {
        g_family_system_car[i][FS_SQL_ID] = cache_get_field_content_int(i, "id");
        g_family_system_car[i][FS_FAMILY_ID] = cache_get_field_content_int(i, "family_id");
        g_family_system_car[i][FS_OWNER_ID] = cache_get_field_content_int(i, "owner_id");
        g_family_system_car[i][FS_OWNABLE_CAR_ID] = cache_get_field_content_int(i, "ownable_car_id");
        g_family_system_car[i][FS_MODEL_ID] = cache_get_field_content_int(i, "model_id");
        g_family_system_car[i][FS_ACCESS_RANK] = cache_get_field_content_int(i, "access_rank");
        g_family_system_car[i][FS_STATUS] = cache_get_field_content_int(i, "status");
    }

    g_family_system_loaded = rows;
    cache_delete(result);

    printf("[FamilySystem] Loaded cars: %d", g_family_system_loaded);
    return rows;
}

stock FamilySystemInit()
{
    FamilySystemCreateTable();
    FamilySystemLoad();
    return 1;
}

stock FamilySystemAddOwnableCarToFamily(playerid, ownable_car_id, model_id)
{
    new family_id = FamilySystemGetPlayerFamily(playerid);
    if(family_id == -1)
    {
        SendClientMessage(playerid, 0xCECECEFF, "You are not in a family");
        return 0;
    }

    if(GetPlayerData(playerid, P_FAMILY_RANK) < 10 && GetPlayerRangFamily(playerid) != 5)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Only family leader can add cars");
        return 0;
    }

    if(ownable_car_id <= 0 || model_id <= 0)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Invalid vehicle data");
        return 0;
    }

    if(FamilySystemFindByFamilyOwnable(family_id, ownable_car_id) != -1)
    {
        SendClientMessage(playerid, 0xCECECEFF, "This car is already in family car park");
        return 0;
    }

    new slot = FamilySystemGetFreeSlot();
    if(slot == -1)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Family car park limit reached");
        return 0;
    }

    new query[256];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO familysystem (family_id, owner_id, ownable_car_id, model_id, access_rank, status) VALUES (%d, %d, %d, %d, 1, 0)",
        family_id,
        GetPlayerAccountID(playerid),
        ownable_car_id,
        model_id);

    new Cache:result = mysql_query(mysql, query, true);
    if(mysql_errno() != 0)
    {
        cache_delete(result);
        SendClientMessage(playerid, 0xCECECEFF, "SQL error while adding car to family");
        return 0;
    }

    new insert_id = cache_insert_id();
    cache_delete(result);

    if(insert_id <= 0)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Failed to get new family car ID");
        return 0;
    }

    g_family_system_car[slot][FS_SQL_ID] = insert_id;
    g_family_system_car[slot][FS_FAMILY_ID] = family_id;
    g_family_system_car[slot][FS_OWNER_ID] = GetPlayerAccountID(playerid);
    g_family_system_car[slot][FS_OWNABLE_CAR_ID] = ownable_car_id;
    g_family_system_car[slot][FS_MODEL_ID] = model_id;
    g_family_system_car[slot][FS_ACCESS_RANK] = 1;
    g_family_system_car[slot][FS_STATUS] = 0;
    g_family_system_loaded++;

    SendClientMessage(playerid, 0x66CC00FF, "Car added to family car park");
    return 1;
}

stock FamilySystemAddOwnableCarBySql(playerid, ownable_car_id)
{
    if(ownable_car_id <= 0)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Usage: /testfamilybuy [ownable_cars id]");
        return 0;
    }

    new query[144];
    mysql_format(mysql, query, sizeof query,
        "SELECT owner_id, model_id FROM ownable_cars WHERE id = %d LIMIT 1",
        ownable_car_id);

    new Cache:result = mysql_query(mysql, query, true);
    if(cache_num_rows() == 0)
    {
        cache_delete(result);
        SendClientMessage(playerid, 0xCECECEFF, "Car with this ID was not found");
        return 0;
    }

    new owner_id = cache_get_field_content_int(0, "owner_id");
    new model_id = cache_get_field_content_int(0, "model_id");
    cache_delete(result);

    if(owner_id != GetPlayerAccountID(playerid))
    {
        SendClientMessage(playerid, 0xCECECEFF, "You can add only your own personal car");
        return 0;
    }

    return FamilySystemAddOwnableCarToFamily(playerid, ownable_car_id, model_id);
}

stock FamilySystemSendCarList(playerid, Node:json)
{
    new family_id = FamilySystemGetPlayerFamily(playerid);

    JSON_SetInt(json, "t", 2);
    JSON_SetInt(json, "g", 1);

    new Node:nArray = JSON_Array();
    new Node:idArray = JSON_Array();

    if(family_id != -1)
    {
        new model_name[32];
        for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
        {
            if(g_family_system_car[i][FS_SQL_ID] == 0) continue;
            if(g_family_system_car[i][FS_FAMILY_ID] != family_id) continue;

            model_name[0] = EOS;
            if(g_family_system_car[i][FS_MODEL_ID] >= 400 && g_family_system_car[i][FS_MODEL_ID] <= 611)
                GetVehicleModelName(g_family_system_car[i][FS_MODEL_ID], model_name);
            else
                format(model_name, sizeof model_name, "Model %d", g_family_system_car[i][FS_MODEL_ID]);

            nArray = JSON_Append(nArray, JSON_Array(JSON_String(model_name)));
            idArray = JSON_Append(idArray, JSON_Array(JSON_Int(g_family_system_car[i][FS_SQL_ID])));
        }
    }

    JSON_SetArray(json, "n", nArray);
    JSON_SetArray(json, "id", idArray);

    OnPacketIncoming(playerid, 45, json);
    return 1;
}

stock FamilySystemSendCarInfo(playerid, Node:json)
{
    new family_id = FamilySystemGetPlayerFamily(playerid);

    new sql_id;
    if(!JSON_GetInt(json, "id", sql_id))
    {
        JSON_SetInt(json, "t", 2);
        JSON_SetInt(json, "s", 1);
        JSON_SetInt(json, "r", 1);
        JSON_SetInt(json, "d", 0);
        OnPacketIncoming(playerid, 45, json);
        return 0;
    }

    new idx = FamilySystemFindBySql(sql_id);
    if(idx == -1 || family_id == -1 || g_family_system_car[idx][FS_FAMILY_ID] != family_id)
    {
        JSON_SetInt(json, "t", 2);
        JSON_SetInt(json, "s", 1);
        JSON_SetInt(json, "r", 1);
        JSON_SetInt(json, "d", 0);
        OnPacketIncoming(playerid, 45, json);
        return 0;
    }

    JSON_SetInt(json, "t", 2);
    JSON_SetInt(json, "s", 1);
    JSON_SetInt(json, "r", g_family_system_car[idx][FS_ACCESS_RANK]);
    JSON_SetInt(json, "d", g_family_system_car[idx][FS_STATUS]);
    OnPacketIncoming(playerid, 45, json);
    return 1;
}

stock FamilySystemSendActionResult(playerid, Node:json, success)
{
    JSON_SetInt(json, "t", 2);
    JSON_SetInt(json, "s", 2);
    JSON_SetInt(json, "d", success ? 1 : 0);
    OnPacketIncoming(playerid, 45, json);
    return 1;
}

stock FamilySystemHandleCarAction(playerid, Node:json)
{
    new family_id = FamilySystemGetPlayerFamily(playerid);

    new sql_id, action_id;
    if(!JSON_GetInt(json, "m", sql_id) || !JSON_GetInt(json, "id", action_id))
    {
        return FamilySystemSendActionResult(playerid, json, 0);
    }

    new idx = FamilySystemFindBySql(sql_id);
    if(idx == -1 || family_id == -1 || g_family_system_car[idx][FS_FAMILY_ID] != family_id)
    {
        return FamilySystemSendActionResult(playerid, json, 0);
    }

    new query[160];

    switch(action_id)
    {
        case 1, 5, 6:
        {
            g_family_system_car[idx][FS_STATUS] = 1;
            mysql_format(mysql, query, sizeof query,
                "UPDATE familysystem SET status = 1 WHERE id = %d LIMIT 1",
                g_family_system_car[idx][FS_SQL_ID]);
            mysql_query(mysql, query, false);
        }
        case 4:
        {
            g_family_system_car[idx][FS_STATUS] = 0;
            mysql_format(mysql, query, sizeof query,
                "UPDATE familysystem SET status = 0 WHERE id = %d LIMIT 1",
                g_family_system_car[idx][FS_SQL_ID]);
            mysql_query(mysql, query, false);
        }
        case 2:
        {
            mysql_format(mysql, query, sizeof query,
                "DELETE FROM familysystem WHERE id = %d LIMIT 1",
                g_family_system_car[idx][FS_SQL_ID]);
            mysql_query(mysql, query, false);
            FamilySystemResetSlot(idx);
            if(g_family_system_loaded > 0) g_family_system_loaded--;
        }
        case 3:
        {
            new access;
            if(JSON_GetInt(json, "r", access))
            {
                if(access == 0 && g_family_system_car[idx][FS_ACCESS_RANK] > 1)
                    g_family_system_car[idx][FS_ACCESS_RANK]--;
                else if(access == 1 && g_family_system_car[idx][FS_ACCESS_RANK] < 10)
                    g_family_system_car[idx][FS_ACCESS_RANK]++;
            }

            mysql_format(mysql, query, sizeof query,
                "UPDATE familysystem SET access_rank = %d WHERE id = %d LIMIT 1",
                g_family_system_car[idx][FS_ACCESS_RANK],
                g_family_system_car[idx][FS_SQL_ID]);
            mysql_query(mysql, query, false);
        }
        case 0, 7:
        {
        }
        default:
        {
            return FamilySystemSendActionResult(playerid, json, 0);
        }
    }

    return FamilySystemSendActionResult(playerid, json, 1);
}

CMD:testfamilybuy(playerid, params[])
{
    if(FamilySystemGetPlayerFamily(playerid) == -1)
        return SendClientMessage(playerid, 0xCECECEFF, "You are not in a family");

    if(GetPlayerData(playerid, P_FAMILY_RANK) < 10 && GetPlayerRangFamily(playerid) != 5)
        return SendClientMessage(playerid, 0xCECECEFF, "Only family leader can use /testfamilybuy");

    new ownable_car_id;
    if(sscanf(params, "d", ownable_car_id))
        ownable_car_id = 0;

    if(ownable_car_id > 0)
        return FamilySystemAddOwnableCarBySql(playerid, ownable_car_id);

    new vehicleid = GetPlayerOwnableCar(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0xCECECEFF, "Sit in your own car or use: /testfamilybuy [id]");

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    return FamilySystemAddOwnableCarToFamily(
        playerid,
        GetOwnableCarData(index, OC_SQL_ID),
        GetOwnableCarData(index, OC_MODEL_ID)
    );
}

enum Weekly_Prizes
{
    WP_Name[24],
    WP_Type,
    WP_Index

}

#define WP_RUB  1
#define WP_MONEY   2
#define WP_VIP 3
#define WP_SLOT 4

new weekly_prizes[7][Weekly_Prizes] =
{
    {"100 доната-руб.", WP_RUB, 100},
    {"500000 руб.", WP_MONEY, 500000},
    {"150 доната-руб.", WP_RUB, 150},
    {"VIP подписка (3 дня.)", WP_VIP, 3},
    {"30000000 руб.", WP_MONEY, 30000000},
    {"500 доната-руб.", WP_RUB, 500},
    {"3 слот на машину", WP_SLOT, 3}
};

#define STATUS_WP_WAITING   0
#define STATUS_WP_MAYBE     1
#define STATUS_WP_TOOK_IT   2

new player_wp[MAX_PLAYERS][8];

public:CREATE_ACCOUNTS_TABLE_WP()
{
    mysql_query(mysql, "SELECT * FROM accounts WHERE weekly_prizes AND weekly_day", false);

    if(mysql_errno())
    {
        mysql_query(mysql, "ALTER TABLE `accounts` ADD `weekly_prizes` TEXT NOT NULL DEFAULT '0,0,0,0,0,0,0' AFTER `level`, ADD `weekly_day` INT NOT NULL DEFAULT '0' AFTER `weekly_prizes`", false);

        if(!mysql_errno()) print("[KASHON_SYSTEM] Столбцы созданы для еженедельных наград");
    }

    return 1;
}

public:LoadWeeklyPrizes(playerid)
{
    new string[84];

    mysql_format(mysql, string, sizeof string, "SELECT weekly_prizes, weekly_day FROM accounts WHERE id = %d", GetPlayerAccountID(playerid));
    new Cache:cache = mysql_query(mysql, string);

    if(!mysql_errno())
    {
        new weekly[48];

        cache_get_row(0,0,weekly);

        sscanf(weekly, "P<,>a<i>[48]", player_wp[playerid]);

        player_wp[playerid][7] = cache_get_row_int(0, 1);

    }

    cache_delete(cache);

    return 1;
}

public:UnLoadWeeklyPrizes(playerid)
{
    new string[48];

    format(string, sizeof string, "%d,%d,%d,%d,%d,%d,%d",
    player_wp[playerid][0],
    player_wp[playerid][1],
    player_wp[playerid][2],
    player_wp[playerid][3],
    player_wp[playerid][4],
    player_wp[playerid][5],
    player_wp[playerid][6]);

    new query[184];

    mysql_format(mysql, query, sizeof query, "UPDATE accounts SET weekly_prizes = '%s', weekly_day = %d WHERE id=%d", string, player_wp[playerid][7], GetPlayerAccountID(playerid));
    mysql_query(mysql, query, false);

    return 1;
}

public OnPlayerConnect(playerid)
{
    SetTimerEx("LoadWeeklyPrizes", 2000, false, "i", playerid);
    #if defined weekly_OnPlayerConnect
        return weekly_OnPlayerConnect(playerid);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnPlayerConnect
    #undef OnPlayerConnect
#else
    #define _ALS_OnPlayerConnect
#endif
#define OnPlayerConnect weekly_OnPlayerConnect
#if defined weekly_OnPlayerConnect
    forward weekly_OnPlayerConnect(playerid);
#endif

public OnPlayerDisconnect(playerid, reason)
{
    UnLoadWeeklyPrizes(playerid);
    #if defined weekly_OnPlayerDisconnect
        return weekly_OnPlayerDisconnect(playerid, reason);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnPlayerDisconnect
    #undef OnPlayerDisconnect
#else
    #define _ALS_OnPlayerDisconnect
#endif
#define OnPlayerDisconnect weekly_OnPlayerDisconnect
#if defined weekly_OnPlayerDisconnect
    forward weekly_OnPlayerDisconnect(playerid, reason);
#endif

public OnGameModeInit()
{
    SetTimer("CREATE_ACCOUNTS_TABLE_WP", 3000, false);

    print("[KASHON_SYSTEM] Система еженедельных наград загружена.");

    #if defined weekly_OnGameModeInit
        return weekly_OnGameModeInit();
    #else
        return 1;
    #endif
}
   #if defined _ALS_OnGameModeInit
    #undef OnGameModeInit
#else
    #define _ALS_OnGameModeInit
#endif
#define OnGameModeInit weekly_OnGameModeInit
#if defined weekly_OnGameModeInit
    forward weekly_OnGameModeInit();
#endif

public:CheckWeeklyPrizes()
{
    new year, month, day, hour, minute;

    getdate(year, month, day);
    gettime(hour, minute);

    new day_weekly = GetDayOfWeek(year, month, day)-1;

    if(!day_weekly && !hour && !minute) mysql_query(mysql, "UPDATE accounts SET weekly_prizes = '0,0,0,0,0,0,0'");

    if(!hour && !minute) mysql_query(mysql, "UPDATE accounts SET weekly_day = 0");

    new pday;

    foreach(new i : Player)
    {
        if(player_wp[i][7]) continue;

        pday = -1;
        for(new q;q < 7; q++) if(!player_wp[i][q]) pday = q;

        if(pday == -1) continue;

        if(!player_wp[i][7] && GetPlayerData(i, P_GAME_FOR_DAY) >= 7200)
        {
            SendClientMessage(i, -1, "Поздравляем, вы отыграли 2 часа и можете забрать свою награду! ({FFFF00}/everyprize{FFFFFF})");
            player_wp[i][pday]++;
            player_wp[i][7]++;
            UnLoadWeeklyPrizes(i);
        }
    }

    return 1;
}

cmd:everyprize(playerid)
{
    new dialog[348];

    for(new i, prize[28], list[84]; i < 7;i ++)
    {
        switch(player_wp[playerid][i])
        {
            case STATUS_WP_WAITING: format(prize, sizeof prize, "{787878}[Отыграйте 2 часа]");
            case STATUS_WP_MAYBE: format(prize, sizeof prize, "{E6E32C}[Можно получить]");
            case STATUS_WP_TOOK_IT: format(prize, sizeof prize, "{39D055}[Получен]");

        }

        format(list, sizeof list, "%d. %s — %s\n", i+1, weekly_prizes[i][WP_Name], prize);
        strcat(dialog, list);
    }

    ShowPlayerDialog(playerid, 3882, DIALOG_STYLE_LIST, "Еженедельные награды", dialog, "Получить", "Выйти");

    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == 3882)
    {
        if(response)
        {
            new day = listitem;

            if(day && player_wp[playerid][day] == STATUS_WP_MAYBE && player_wp[playerid][day-1] == STATUS_WP_MAYBE)
                return SendClientMessage(playerid, -1, "{E6E32C}[Еженедельные награды] {FFFFFF}Чтобы получить награду, получите предыдущие");

            if(day && !player_wp[playerid][day] && !player_wp[playerid][day-1])
                return SendClientMessage(playerid, -1, "{E6E32C}[Еженедельные награды] {FFFFFF}Вы сможете получить эту награду только после того, как получите предыдущие");

            if(player_wp[playerid][day] == STATUS_WP_TOOK_IT) return SendClientMessage(playerid, -1, "{E6E32C}[Еженедельные награды] {FFFFFF}Вы уже получали данную награду");

            switch(player_wp[playerid][day])
            {
                case STATUS_WP_WAITING: SendClientMessage(playerid, -1, "{E6E32C}[Еженедельные награды] {FFFFFF}Чтобы получить награду отыграйте 2 часа");
                case STATUS_WP_MAYBE:
                {
                    switch(weekly_prizes[day][WP_Type])
                    {
                        case WP_RUB: GivePlayerDonateRub(playerid, weekly_prizes[day][WP_Index]);
                        case WP_MONEY: GivePlayerMoneyEx(playerid, weekly_prizes[day][WP_Index]);
                        case WP_VIP: {

                            if(!GetPlayerPremium(playerid))
                            {
                                SetPlayerData(playerid, P_PREMIUM, 3);
                                SetPlayerData(playerid, P_PREMIUM_DATE, gettime() +  weekly_prizes[day][WP_Index] * 86400);
                            }
                            else
                            {
                                AddPlayerData(playerid, P_PREMIUM_DATE, +,  weekly_prizes[day][WP_Index] * 86400);
                            }
                            new prem_day,
                            prem_month,
                            prem_year;

                            timestamp_to_date(GetPlayerData(playerid, P_PREMIUM_DATE), prem_year, prem_month, prem_day);

                            UpdatePlayerDatabaseInt(playerid, "premium", 3);
                            UpdatePlayerDatabaseInt(playerid, "premium_date", GetPlayerData(playerid, P_PREMIUM_DATE));
                        }
                        case WP_SLOT: {
                            AddPlayerData(playerid, P_CAR_SLOTS, +, weekly_prizes[day][WP_Index]);
                            UpdatePlayerDatabaseInt(playerid, "car_slots", GetPlayerData(playerid, P_CAR_SLOTS));
                        }
                    }

                    new string[144];
                    format(string, sizeof string, "{E6E32C}[Еженедельные награды] {FFFFFF} Поздравляем! Вы получили {E6E32C}%s{FFFFFF}", weekly_prizes[day][WP_Name]);
                    SendClientMessage(playerid, -1, string);

                    player_wp[playerid][day] = STATUS_WP_TOOK_IT;
                    player_wp[playerid][7] = 1;
                    UnLoadWeeklyPrizes(playerid);

                }
                case STATUS_WP_TOOK_IT: SendClientMessage(playerid, -1, "{E6E32C}[Еженедельные награды] {FFFFFF}Вы уже получили данный приз");
            }
        }
    }
    #if defined weekly_OnDialogResponse
    return weekly_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnDialogResponse
#undef OnDialogResponse
#else
#define _ALS_OnDialogResponse
#endif
#define OnDialogResponse weekly_OnDialogResponse
#if defined weekly_OnDialogResponse
forward weekly_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]);
#endif

enum Game_HAT
{
    HAT_Owner,
    HAT_Player,
    HAT_Role,
    bool:HAT_Throw,
    HAT_Bid,
    bool:HAT_Game,
}

#define HAT_Role_Heads 1
#define HAT_Role_Tails 2

#define HAT_MSG "{FF9500}[Орёл и Решка]{FFFFFF} "
#define MAX_BID_HAT 10_000_000
#define MAX_BID_HAT_str "10.000.000"

new player_HAT[MAX_PLAYERS][Game_HAT];

new player_timer_acceptHAT[MAX_PLAYERS];
public OnGameModeInit()
{
    printf("[KASHON_SYSTEM] Игра \"Орёл и решка\" загружена");
    #if defined HAT_OnGameModeInit
        return HAT_OnGameModeInit();
    #else
        return 1;
    #endif
}
   #if defined _ALS_OnGameModeInit
    #undef OnGameModeInit
#else
    #define _ALS_OnGameModeInit
#endif
#define OnGameModeInit HAT_OnGameModeInit
#if defined HAT_OnGameModeInit
    forward HAT_OnGameModeInit();
#endif

cmd:spin(playerid, params[])
{
    new to_player = -1;

    if(sscanf(params, "d", to_player)) return SendClientMessage(playerid, -1, ""HAT_MSG"/spin [ID - игрока]");

    if(!IsPlayerInRangeOfPlayer(playerid, to_player, 3.5)) return SendClientMessage(playerid, -1, ""HAT_MSG"Игрок слишком далеко от Вас");

    if(player_HAT[to_player][HAT_Owner] != -1) return SendClientMessage(playerid, -1, ""HAT_MSG"У игрока уже есть активное предложение");

    ShowPlayerDialog(playerid, 4374, DIALOG_STYLE_INPUT, "Орёл и Решка", "Введите ставку\nВведите 0 чтобы играть без ставки\n\
    Максимальная ставка: "MAX_BID_HAT_str" руб.", "Далее", "Выйти");

    player_HAT[playerid][HAT_Player] = to_player;

    return 1;
}

cmd:spins(playerid, params[])
{
    if(player_HAT[playerid][HAT_Game]) return SendClientMessage(playerid, -1, ""HAT_MSG"Ждите окончания игры");

    if(player_HAT[playerid][HAT_Owner] == -1) return SendClientMessage(playerid, -1, ""HAT_MSG"У вас нет актуального предложения");

    if(!strcmp(params, "Yes", true)) {
        if(player_HAT[playerid][HAT_Owner] == playerid) return 0;

        new to_player = player_HAT[playerid][HAT_Owner];

        KillTimer(player_timer_acceptHAT[to_player]);

        if(player_HAT[playerid][HAT_Role] == HAT_Role_Heads) StartHAT(playerid, to_player);
        else StartHAT(to_player, playerid);
    }
    else if(!strcmp(params, "No", true))
    {
        new to_player = -1;
        if(player_HAT[playerid][HAT_Owner] == playerid) to_player = player_HAT[playerid][HAT_Player];
        else to_player = player_HAT[playerid][HAT_Owner];

        SendClientMessage(to_player, -1, ""HAT_MSG"Игрок отказался от предложения");
        SendClientMessage(playerid, -1, ""HAT_MSG"Вы отказались от предложения");

        DefaultHAT(playerid);
        DefaultHAT(to_player);
    }
    else SendClientMessage(playerid, -1, ""HAT_MSG"/spins [Yes / No]");

    return 1;
}

stock StartHAT(heads, tails)
{
    if(!IsPlayerConnected(heads) || !IsPlayerConnected(tails))
    {
        SendClientMessage(heads, -1, ""HAT_MSG"Один из игроков вышел");
        SendClientMessage(tails, -1, ""HAT_MSG"Один из игроков вышел");

        DefaultHAT(heads);
        DefaultHAT(tails);

        return 1;
    }

    new bid = player_HAT[heads][HAT_Bid];
    if(GetPlayerMoneyEx(heads) < bid || GetPlayerMoneyEx(tails) < bid) {
        SendClientMessage(heads, -1, "У одного из игроков не хватает деньги на ставку");
        SendClientMessage(tails, -1, "У одного из игроков не хватает деньги на ставку");

        DefaultHAT(heads);
        DefaultHAT(tails);
        return 1;
    }
    new string[144];

	if(player_HAT[heads][HAT_Throw]) format(string, sizeof string, "%s бросил монету...", GetPlayerNameEx(heads));
    else format(string, sizeof string, "%s бросил монету...", GetPlayerNameEx(tails));
	SendClientMessage(heads, 0xDD90FFFF, string);
	SendClientMessage(tails, 0xDD90FFFF, string);
    format(string, sizeof string, ""HAT_MSG"%s - Орёл", GetPlayerNameEx(heads));
    format(string, sizeof string, ""HAT_MSG"%s - Решка", GetPlayerNameEx(tails));

    player_HAT[heads][HAT_Game] = true;
    player_HAT[tails][HAT_Game] = true;
    SetTimerEx("EndHAT", 3000, false, "ii", heads, tails);
    return 1;
}

public:EndHAT(heads, tails)
{
    if(!IsPlayerConnected(heads) || !IsPlayerConnected(tails))
    {
        SendClientMessage(heads, -1, ""HAT_MSG"Один из игроков вышел");
        SendClientMessage(tails, -1, ""HAT_MSG"Один из игроков вышел");

        DefaultHAT(heads);
        DefaultHAT(tails);

        return 1;
    }

    new winner, loser, r = random(2);

    if(!r) { winner = heads; loser = tails; }
    else { winner = tails; loser = heads; }

    new string[144];

    new owner, player;

    if(player_HAT[heads][HAT_Owner] == heads) { owner = heads; player = tails; }
    else { owner = tails; player = heads; }

    format(string, sizeof string, ""HAT_MSG"Выпал(а) %s", r > 0 ? "Решка" : "Орёл");
    SendClientMessage(heads, -1, string);
    SendClientMessage(tails, -1, string);

    new bid = player_HAT[owner][HAT_Bid];

    if(bid)
    {
        if(GetPlayerMoneyEx(loser) >= bid) {
            GivePlayerMoneyEx(loser, -bid, "Орёл и Решка");
            GivePlayerMoneyEx(winner, bid, "Орёл и Решка");
        }
        else {
            SendClientMessage(loser, -1, "У Вас не хватает денег для выплаты выигрыша");
            SendClientMessage(winner, -1, "У Игрока не хватает денег для выплаты выигрыша");
        }
    }

    ShowPlayerDialog(owner, 4377, DIALOG_STYLE_LIST, "Орёл и решка",
    "Изменить роли или бросающего монету\n"\
    "Предложить снова",
    "Далее", "Выйти"
    );

    player_HAT[player][HAT_Owner] = -1;
    player_HAT[player][HAT_Bid] = 0;

    player_HAT[owner][HAT_Game] = false;
    player_HAT[player][HAT_Game] = false;

    return 1;
}

stock DefaultHAT(playerid)
{
    player_HAT[playerid][HAT_Bid] = 0;
    player_HAT[playerid][HAT_Owner] = -1;
    player_HAT[playerid][HAT_Player] = -1;
    player_HAT[playerid][HAT_Game] = false;
    player_HAT[playerid][HAT_Role] = 0;
}

stock DialogThrowHAT(playerid)
{
    new string[144];

    format(string, sizeof string, "Бросает %s\nБросает %s", GetPlayerNameEx(playerid), GetPlayerNameEx(player_HAT[playerid][HAT_Player]));

    ShowPlayerDialog(
        playerid, 4375, DIALOG_STYLE_LIST,
        "Орёл и Решка", string, "Выбрать", "Выйти"
    );
    return 1;
}

stock DialogRoleHAT(playerid)
{
    new string[144], to_player = player_HAT[playerid][HAT_Player];

    format(string, sizeof string, "Я – Орёл, %s – Решка\n%s – Орёл, Я – Решка", GetPlayerNameEx(to_player), GetPlayerNameEx(to_player));

    ShowPlayerDialog(
        playerid, 4376, DIALOG_STYLE_LIST,
        "Орёл и Решка", string, "Выбрать", "Выйти"
    );
    return 1;
}

stock AcceptHAT(playerid, to_player)
{
    if(player_HAT[to_player][HAT_Owner] != -1) { SendClientMessage(playerid, -1, ""HAT_MSG"У игрока уже есть актуальное предложение"); DefaultHAT(playerid); return 1;}

    if(player_HAT[playerid][HAT_Throw]) player_HAT[to_player][HAT_Throw] = false;
    else player_HAT[to_player][HAT_Throw] = true;

    if(player_HAT[playerid][HAT_Role] == HAT_Role_Heads) player_HAT[to_player][HAT_Role] = HAT_Role_Tails;
    else player_HAT[to_player][HAT_Role] = HAT_Role_Heads;

    new bid = player_HAT[playerid][HAT_Bid];

    player_HAT[to_player][HAT_Owner] = playerid;
    player_HAT[playerid][HAT_Owner] = playerid;
    player_HAT[to_player][HAT_Bid] = bid;

    new string[144], bid_text[42] = "без ставки";

    if(bid > 0) format(bid_text, sizeof bid_text, "со ставкой: %d руб.", bid);

    format(string, sizeof string, "%s предлагает Вам сыграть в \"Орёл и решка\" %s", GetPlayerNameEx(playerid), bid_text);
    SendClientMessage(to_player, 0xFF9500FF, string);
    format(string, sizeof string, "Вы %s", player_HAT[to_player][HAT_Role] > 1 ? "Решка" : "Орёл");
    SendClientMessage(to_player, 0xFF9500FF, string);

    format(string, sizeof string, "Вы предложили %s сыграть в \"Орёл и решка\" %s", GetPlayerNameEx(to_player), bid_text);
    SendClientMessage(playerid, 0xFF9500FF, string);

    format(string, sizeof string, "Вы %s", player_HAT[playerid][HAT_Role] > 1 ? "Решка" : "Орёл");
    SendClientMessage(playerid, 0xFF9500FF, string);

    SendClientMessage(to_player, -1, ""HAT_MSG"{D22323}Чтобы отказаться /spins No");
    SendClientMessage(playerid, -1, ""HAT_MSG"{D22323}Чтобы отозвать /spins No");
    SendClientMessage(to_player, -1, ""HAT_MSG"{45CF29}Чтобы принять /spins Yes");

    player_timer_acceptHAT[playerid] = SetTimerEx("CancelAcceptHAT", 10000, false, "ii", playerid, to_player);
    return 1;
}

public:CancelAcceptHAT(playerid, to_player)
{
    SendClientMessage(to_player, -1, ""HAT_MSG"Игрок отказался от предложения");
    SendClientMessage(playerid, -1, ""HAT_MSG"Вы отказались от предложения");

    DefaultHAT(playerid);
    DefaultHAT(to_player);
    player_timer_acceptHAT[playerid]= -1;
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == 4374)
    {
        if(response)
        {
            new bid;
            if(sscanf(inputtext, "d", bid)) SendClientMessage(playerid, -1, ""HAT_MSG"Вы не правильно ввели данные");
            else {
                if(bid > MAX_BID_HAT) return SendClientMessage(playerid, -1, ""HAT_MSG"Ваша ставка превышает максимальную ("MAX_BID_HAT_str" руб.)");

                new to_player = player_HAT[playerid][HAT_Player];

                if(!IsPlayerInRangeOfPlayer(playerid, to_player, 4.5)) return SendClientMessage(playerid, -1, ""HAT_MSG"Игрок слишком далеко от Вас");

                if(GetPlayerMoneyEx(to_player) < bid) return SendClientMessage(playerid, -1, ""HAT_MSG"У игрока не хватает денег");
                player_HAT[playerid][HAT_Bid] = bid;

                DialogRoleHAT(playerid);
            }
        }
        else
        {
            DefaultHAT(player_HAT[playerid][HAT_Player]); DefaultHAT(playerid);
        }
    }
    if(dialogid == 4375)
    {
        if(response)
        {
            new to_player = player_HAT[playerid][HAT_Player];
            if(!listitem) player_HAT[playerid][HAT_Throw] = true;

            AcceptHAT(playerid, to_player);
        }
        else {
            DefaultHAT(player_HAT[playerid][HAT_Player]); DefaultHAT(playerid);
        }
    }
    if(dialogid == 4376)
    {
        if(response)
        {
            if(!listitem) { player_HAT[playerid][HAT_Role] = HAT_Role_Heads;}
            else { player_HAT[playerid][HAT_Role] = HAT_Role_Tails;}

            DialogThrowHAT(playerid);
        }
        else {
            DefaultHAT(player_HAT[playerid][HAT_Player]); DefaultHAT(playerid);
        }
    }
    if(dialogid == 4377) {
    if(response) {
        if(!listitem) DialogRoleHAT(playerid);
        else AcceptHAT(playerid, player_HAT[playerid][HAT_Player]);
    }
    else { DefaultHAT(player_HAT[playerid][HAT_Player]); DefaultHAT(playerid); }

    }
    #if defined HAT_OnDialogResponse
    return HAT_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnDialogResponse
#undef OnDialogResponse
#else
#define _ALS_OnDialogResponse
#endif
#define OnDialogResponse HAT_OnDialogResponse
#if defined HAT_OnDialogResponse
forward HAT_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]);
#endif

public OnPlayerSpawn(playerid)
{
    DefaultHAT(playerid);
    #if defined HAT_OnPlayerSpawn
        return HAT_OnPlayerSpawn(playerid);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnPlayerSpawn
    #undef OnPlayerSpawn
#else
    #define _ALS_OnPlayerSpawn
#endif
#define OnPlayerSpawn HAT_OnPlayerSpawn
#if defined HAT_OnPlayerSpawn
    forward HAT_OnPlayerSpawn(playerid);
#endif

