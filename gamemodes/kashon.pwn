stock Marketplace_ShowDialogMain(playerid)
{
    ShowPlayerDialog(playerid, MP_DIALOG_MAIN, DIALOG_STYLE_LIST, "\xcc\xe0\xf0\xea\xe5\xf2\xef\xeb\xe5\xe9\xf1", "\xce\xf2\xea\xf0\xfb\xf2\xfc\x20\x47\x55\x49\n\xca\xf3\xef\xe8\xf2\xfc\x20\xef\xf0\xe5\xe4\xec\xe5\xf2\xfb\n\xcf\xf0\xee\xe4\xe0\xf2\xfc\x20\xef\xf0\xe5\xe4\xec\xe5\xf2\x20\xe8\xe7\x20\xe8\xed\xe2\xe5\xed\xf2\xe0\xf0\xff\n\xcc\xee\xe8\x20\xeb\xee\xf2\xfb\n\xcf\xee\xe8\xf1\xea", "\xc2\xfb\xe1\xf0\xe0\xf2\xfc", "\xc7\xe0\xea\xf0\xfb\xf2\xfc");
    return 1;
}

CMD:marketd(playerid, params[])
{
    #pragma unused params
    if(!IsPlayerLogged(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "\xc2\xfb\x20\xe4\xee\xeb\xe6\xed\xfb\x20\xe0\xe2\xf2\xee\xf0\xe8\xe7\xee\xe2\xe0\xf2\xfc\xf1\xff\x2e");
    Marketplace_ShowDialogMain(playerid);
    return 1;
}

stock Marketplace_ShowDialogLots(playerid, my_lots = 0)
{
    new query[384];
    if(my_lots)
    {
        mysql_format(mysql, query, sizeof(query), "SELECT * FROM `marketplace_lots` WHERE `seller_id`=%d AND `status`=0 ORDER BY `id` DESC LIMIT 30", GetPlayerAccountID(playerid));
        mysql_tquery(mysql, query, "Marketplace_OnDialogLots", "ii", playerid, 1);
    }
    else
    {
        mysql_format(mysql, query, sizeof(query), "SELECT * FROM `marketplace_lots` WHERE `status`=0 AND `expires_at`>%d ORDER BY `is_hot` DESC, `id` DESC LIMIT 30", gettime());
        mysql_tquery(mysql, query, "Marketplace_OnDialogLots", "ii", playerid, 0);
    }
    return 1;
}

public Marketplace_OnDialogLots(playerid, my_lots)
{
    if(!IsPlayerConnected(playerid)) return 0;
    new rows, fields;
    cache_get_data(rows, fields, mysql);
    new list[2048];
    list[0] = EOS;
    if(!rows) strcat(list, "\xcb\xee\xf2\xee\xe2\x20\xed\xe5\xf2\n", sizeof(list));
    for(new i = 0; i < rows && i < 30; i++)
    {
        new lot_id = cache_get_field_content_int(i, "id", mysql);
        new amount = cache_get_field_content_int(i, "amount", mysql);
        new price = cache_get_field_content_int(i, "price", mysql);
        new item_name[64], lot_line[128];
        cache_get_field_content(i, "item_name", item_name, mysql, sizeof item_name);
        format(lot_line, sizeof lot_line, "#%d %s x%d - %d rub\n", lot_id, item_name, amount, price);
        strcat(list, lot_line, sizeof list);
    }
    ShowPlayerDialog(playerid, my_lots ? MP_DIALOG_MYLOTS : MP_DIALOG_LOTS, DIALOG_STYLE_LIST, my_lots ? "\xcc\xee\xe8\x20\xeb\xee\xf2\xfb" : "\xcb\xee\xf2\xfb\x20\xec\xe0\xf0\xea\xe5\xf2\xef\xeb\xe5\xe9\xf1\xe0", list, "\xc2\xfb\xe1\xf0\xe0\xf2\xfc", "\xcd\xe0\xe7\xe0\xe4");
    return 1;
}

stock Marketplace_ShowInventoryDialog(playerid)
{
    Market_RefreshAccessoryCache(playerid);

    new list[2048];
    list[0] = EOS;

    for(new i = 0; i < MAX_INVENTORY_SLOTS; i++)
    {
        if(!Market_CanSellSource(playerid, i)) continue;
        new mp_inv_line[128], mp_inv_name[64];
        Marketplace_GetInventoryName(playerid, i, mp_inv_name, sizeof(mp_inv_name));
        format(mp_inv_line, sizeof(mp_inv_line), "slot %d: %s\n", i, mp_inv_name);
        strcat(list, mp_inv_line, sizeof(list));
    }

    for(new active_slot = 0; active_slot < MAX_ACTIVE_SLOTS; active_slot++)
    {
        new source_id = Market_MakeActiveSource(active_slot);
        if(!Market_CanSellSource(playerid, source_id)) continue;
        new mp_inv_line[128], mp_inv_name[64];
        Marketplace_GetInventoryName(playerid, source_id, mp_inv_name, sizeof(mp_inv_name));
        format(mp_inv_line, sizeof(mp_inv_line), "slot %d: %s [active]\n", source_id, mp_inv_name);
        strcat(list, mp_inv_line, sizeof(list));
    }

    for(new accessory_slot = 0; accessory_slot < MARKET_SOURCE_ACCESSORY_SLOTS; accessory_slot++)
    {
        new source_id = Market_MakeAccessorySource(accessory_slot);
        if(!Market_CanSellSource(playerid, source_id)) continue;
        new mp_inv_line[128], mp_inv_name[64];
        Marketplace_GetInventoryName(playerid, source_id, mp_inv_name, sizeof(mp_inv_name));
        format(mp_inv_line, sizeof(mp_inv_line), "slot %d: %s [equipped accessory]\n", source_id, mp_inv_name);
        strcat(list, mp_inv_line, sizeof(list));
    }

    if(!strlen(list)) strcat(list, "Only skins and accessories can be sold\n", sizeof(list));
    ShowPlayerDialog(playerid, MP_DIALOG_INV, DIALOG_STYLE_LIST, "Marketplace inventory", list, "Sell", "Back");
    return 1;
}

stock Marketplace_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == MP_DIALOG_MAIN)
    {
        if(!response) return 1;
        switch(listitem)
        {
            case 0: Marketplace_OpenGUI(playerid);
            case 1: Marketplace_ShowDialogLots(playerid, 0);
            case 2: Marketplace_ShowInventoryDialog(playerid);
            case 3: Marketplace_ShowDialogLots(playerid, 1);
            case 4: ShowPlayerDialog(playerid, MP_DIALOG_SEARCH, DIALOG_STYLE_INPUT, "\xcf\xee\xe8\xf1\xea\x20\xe2\x20\xec\xe0\xf0\xea\xe5\xf2\xef\xeb\xe5\xe9\xf1\xe5", "\xc2\xe2\xe5\xe4\xe8\xf2\xe5\x20\xed\xe0\xe7\xe2\xe0\xed\xe8\xe5\x20\xef\xf0\xe5\xe4\xec\xe5\xf2\xe0\x3a", "\xcf\xee\xe8\xf1\xea", "\xcd\xe0\xe7\xe0\xe4");
        }
        return 1;
    }
    if(dialogid == MP_DIALOG_LOTS)
    {
        if(!response) return Marketplace_ShowDialogMain(playerid);
        new lot_id;
        if(sscanf(inputtext, "p<#>i", lot_id)) return 1;
        g_MP_SelectedLot[playerid] = lot_id;
        ShowPlayerDialog(playerid, MP_DIALOG_LOT_ACTION, DIALOG_STYLE_INPUT, "\xcf\xee\xea\xf3\xef\xea\xe0\x20\xeb\xee\xf2\xe0", "\xc2\xe2\xe5\xe4\xe8\xf2\xe5\x20\xea\xee\xeb\xe8\xf7\xe5\xf1\xf2\xe2\xee\x20\xe4\xeb\xff\x20\xef\xee\xea\xf3\xef\xea\xe8\x3a", "\xca\xf3\xef\xe8\xf2\xfc", "\xcd\xe0\xe7\xe0\xe4");
        return 1;
    }
    if(dialogid == MP_DIALOG_LOT_ACTION)
    {
        if(!response) return Marketplace_ShowDialogLots(playerid, 0);
        new amount = strval(inputtext);
        if(amount < 1) amount = 1;
        Marketplace_ConfirmBuy(playerid, g_MP_SelectedLot[playerid], amount);
        return 1;
    }
    if(dialogid == MP_DIALOG_INV)
    {
        if(!response) return Marketplace_ShowDialogMain(playerid);
        new slot = -1;
        if(strfind(inputtext, "slot ", true) == 0)
        {
            new colon = strfind(inputtext, ":", true), tmp[12];
            if(colon != -1)
            {
                strmid(tmp, inputtext, 5, colon, sizeof(tmp));
                slot = strval(tmp);
            }
        }
        if(!Market_CanSellSource(playerid, slot)) return 1;
        g_MP_SelectedSlot[playerid] = slot;
        ShowPlayerDialog(playerid, MP_DIALOG_SELL_COUNT, DIALOG_STYLE_INPUT, "\xca\xee\xeb\xe8\xf7\xe5\xf1\xf2\xe2\xee\x20\xe4\xeb\xff\x20\xef\xf0\xee\xe4\xe0\xe6\xe8", "\xc2\xe2\xe5\xe4\xe8\xf2\xe5\x20\xea\xee\xeb\xe8\xf7\xe5\xf1\xf2\xe2\xee\x3a", "\xc4\xe0\xeb\xe5\xe5", "\xcd\xe0\xe7\xe0\xe4");
        return 1;
    }
    if(dialogid == MP_DIALOG_SELL_COUNT)
    {
        if(!response) return Marketplace_ShowInventoryDialog(playerid);
        new amount = strval(inputtext), max_amount = Marketplace_GetSlotSellAmount(playerid, g_MP_SelectedSlot[playerid]);
        if(amount < 1) amount = 1;
        if(amount > max_amount) amount = max_amount;
        g_MP_SelectedSellCount[playerid] = amount;
        ShowPlayerDialog(playerid, MP_DIALOG_SELL_PRICE, DIALOG_STYLE_INPUT, "\xd6\xe5\xed\xe0\x20\xef\xf0\xee\xe4\xe0\xe6\xe8", "\xc2\xe2\xe5\xe4\xe8\xf2\xe5\x20\xf6\xe5\xed\xf3\x20\xe7\xe0\x20\x31\x20\xef\xf0\xe5\xe4\xec\xe5\xf2\x3a", "\xc2\xfb\xf1\xf2\xe0\xe2\xe8\xf2\xfc", "\xcd\xe0\xe7\xe0\xe4");
        return 1;
    }
    if(dialogid == MP_DIALOG_SELL_PRICE)
    {
        if(!response) return Marketplace_ShowInventoryDialog(playerid);
        new price = strval(inputtext);
        Marketplace_PublishSelected(playerid, g_MP_SelectedSellCount[playerid], price, 0);
        return 1;
    }
    if(dialogid == MP_DIALOG_MYLOTS)
    {
        if(!response) return Marketplace_ShowDialogMain(playerid);
        new lot_id;
        if(sscanf(inputtext, "p<#>i", lot_id)) return 1;
        g_MP_SelectedLot[playerid] = lot_id;
        ShowPlayerDialog(playerid, MP_DIALOG_MYLOT_ACTION, DIALOG_STYLE_LIST, "\xcc\xee\xe9\x20\xeb\xee\xf2", "\xd1\xed\xff\xf2\xfc\x20\xe2\x20\xe8\xed\xe2\xe5\xed\xf2\xe0\xf0\xfc\n\xc8\xe7\xec\xe5\xed\xe8\xf2\xfc\x20\xf6\xe5\xed\xf3", "\xc2\xfb\xe1\xf0\xe0\xf2\xfc", "\xcd\xe0\xe7\xe0\xe4");
        return 1;
    }
    if(dialogid == MP_DIALOG_MYLOT_ACTION)
    {
        if(!response) return Marketplace_ShowDialogLots(playerid, 1);
        if(listitem == 0) Marketplace_DeleteOrWithdrawLot(playerid, g_MP_SelectedLot[playerid]);
        else ShowPlayerDialog(playerid, MP_DIALOG_EDIT_PRICE, DIALOG_STYLE_INPUT, "\xcd\xee\xe2\xe0\xff\x20\xf6\xe5\xed\xe0", "\xc2\xe2\xe5\xe4\xe8\xf2\xe5\x20\xed\xee\xe2\xf3\xfe\x20\xf6\xe5\xed\xf3\x3a", "\xd1\xee\xf5\xf0\xe0\xed\xe8\xf2\xfc", "\xcd\xe0\xe7\xe0\xe4");
        return 1;
    }
    if(dialogid == MP_DIALOG_EDIT_PRICE)
    {
        if(!response) return Marketplace_ShowDialogLots(playerid, 1);
        new price = strval(inputtext);
        Marketplace_EditLot(playerid, g_MP_SelectedLot[playerid], price);
        return 1;
    }
    if(dialogid == MP_DIALOG_SEARCH)
    {
        if(!response) return Marketplace_ShowDialogMain(playerid);
        format(g_MP_Search[playerid], 64, "%s", inputtext);
        Marketplace_SendLotsRequest(playerid, MP_ACT_SEARCH, MP_TAB_MAIN);
        Marketplace_ShowDialogLots(playerid, 0);
        return 1;
    }
    return 0;
}

#if defined _PVZ_POINTS_INCLUDED
    #endinput
#endif
#define _PVZ_POINTS_INCLUDED

// =====================================================================
// ПВЗ (пункты выдачи заказов) — точки, где игрок забирает товары,
// купленные на маркетплейсе. Все покупки уходят в reward-очередь
// (см. Marketplace_ConfirmBuy в marketplace.pwn) и забираются здесь
// через MPReward_OpenGUI.
// =====================================================================

enum E_PICKUP_POINT
{
    pp_name[64],
    Float:pp_enter_x, Float:pp_enter_y, Float:pp_enter_z, pp_enter_vw,
    Float:pp_exit_x, Float:pp_exit_y, Float:pp_exit_z, pp_exit_vw, pp_exit_int,
    Float:pp_inside_x, Float:pp_inside_y, Float:pp_inside_z,  // координаты выхода внутри
    pp_enter_pickup,
    pp_exit_pickup
}

new PickupPoints[][E_PICKUP_POINT] =
{
    {"Батырево", 1803.149047, 2037.017944, 16.008436, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1},
    {"Арзамас", 292.996765, 1541.501220, 12.156729, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1},
    {"Арзамас", 614.631835, 579.856567, 12.188437, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1},
    {"Южный", 2566.409179, -2516.000488, 22.119831, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1},
    {"Южный", 2386.718017, -1708.890747, 22.084220, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1},
    {"Бусаево", -528.563598, -1788.569946, 41.065799, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1},
    {"Лыткарино", -2265.864746, -322.510284, 28.101448, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1},
    {"Нижегородск", -2457.938476, 1134.409301, 10.855109, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1},
    {"Нижегородск", -1824.447631, 2717.559814, 57.766563, 0, 2283.669921, 1836.158691, 1519.743286, 1, 1, 2282.679199, 1836.778442, 1519.743286, -1, -1}
};

// Отдельный пикап получения товара (reward). Общий на всех, т.к. все ПВЗ
// физически ведут в один и тот же интерьер/виртуальный мир (см. pp_exit_vw/pp_exit_int).
#define PVZ_REWARD_X (2287.283691)
#define PVZ_REWARD_Y (1834.868408)
#define PVZ_REWARD_Z (1519.743286)
#define PVZ_REWARD_VW (1)

new bool:g_PvzPointsCreated = false;
new g_PvzRewardPickup = -1;

// Точка прибытия (pp_exit_x/y/z) и пикап выхода (pp_inside_x/y/z) стоят
// друг от друга примерно в 1 юните — это внутри радиуса срабатывания
// обычного пикапа. Без задержки игрок при входе сразу же попадал в
// радиус пикапа выхода и его тут же телепортировало обратно, что и
// вызывало "переподключение" из-за частых SetPlayerPos/смен интерьера.
#define PVZ_TP_COOLDOWN_MS (1500)

// Создание пикапов (вызывается из основного OnGameModeInit в KASHON.pwn)
stock CreatePickupPoints()
{
    if(g_PvzPointsCreated) return 1;

    for(new i = 0; i < sizeof(PickupPoints); i++)
    {
        // Пикап входа (стоит на улице у каждого города)
        PickupPoints[i][pp_enter_pickup] = CreatePickup(19132, 23,
            PickupPoints[i][pp_enter_x],
            PickupPoints[i][pp_enter_y],
            PickupPoints[i][pp_enter_z],
            PickupPoints[i][pp_enter_vw]);

        // Пикап выхода внутри здания ПВЗ (возвращает игрока обратно на улицу)
        PickupPoints[i][pp_exit_pickup] = CreatePickup(19132, 23,
            PickupPoints[i][pp_inside_x],
            PickupPoints[i][pp_inside_y],
            PickupPoints[i][pp_inside_z],
            PickupPoints[i][pp_exit_vw]);

        // Красивый 3D-текст над каждым входом ПВЗ.
        new pvz_label[512];
        format(pvz_label, sizeof(pvz_label),
            "{33CCFF}Пункт выдачи заказов\n{FFFFFF}Крыша: {FF8C00}Батыревская ОПГ\n{66FF66}Доступно к покупке {FFFFFF}/buybiz\n{FFD700}Цена: {FFFFFF}35,000,000",
            PickupPoints[i][pp_name]);
        Create3DTextLabel(pvz_label, -1,
            PickupPoints[i][pp_enter_x],
            PickupPoints[i][pp_enter_y],
            PickupPoints[i][pp_enter_z] + 1.0,
            20.0, 0, PickupPoints[i][pp_enter_vw]);

        // Такой же аккуратный текст у внутреннего пикапа выхода.
        new pvz_exit_label[256];
        format(pvz_exit_label, sizeof(pvz_exit_label),
            "{33CCFF}Пункт выдачи заказов\n{FFFFFF}%s\n{FF6666}Выход из ПВЗ",
            PickupPoints[i][pp_name]);
        Create3DTextLabel(pvz_exit_label, -1,
            PickupPoints[i][pp_inside_x],
            PickupPoints[i][pp_inside_y],
            PickupPoints[i][pp_inside_z] + 1.0,
            12.0, 0, PickupPoints[i][pp_exit_vw]);
    }

    // Отдельный пикап получения товара (reward) — только открывает reward gui,
    // никуда не телепортирует.
    g_PvzRewardPickup = CreatePickup(1239, 23, PVZ_REWARD_X, PVZ_REWARD_Y, PVZ_REWARD_Z, PVZ_REWARD_VW);

    // Табличка над пикапом получения товара (виден в любом случае, даже если
    // модель пикапа не отрисовалась).
    Create3DTextLabel("{33CCFF}Пункт выдачи заказов\n{FFFFFF}Забрать готовый заказ\n{66FF66}Нажмите, чтобы открыть выдачу", -1,
        PVZ_REWARD_X, PVZ_REWARD_Y, PVZ_REWARD_Z + 0.9,
        20.0, 0, 1);

    g_PvzPointsCreated = true;
    return 1;
}

// Обработка входа/выхода в ПВЗ и получения товара.
// Вызывается из OnPlayerPickUpPickupEx в KASHON.pwn.
// Возвращает 1, если пикап был обработан как ПВЗ (чтобы прервать дальнейшую обработку).
stock HandlePickupPoint(playerid, pickupid)
{
    new tick = GetTickCount();

    // Пикап получения товара (reward)
    if(pickupid == g_PvzRewardPickup)
    {
        if(!IsPlayerLogged(playerid)) return 1;
        if(tick - GetPVarInt(playerid, "pvz_last_tp") < PVZ_TP_COOLDOWN_MS) return 1;

        MPReward_OpenGUI(playerid);
        return 1;
    }

    // Проверка на вход
    for(new i = 0; i < sizeof(PickupPoints); i++)
    {
        if(pickupid == PickupPoints[i][pp_enter_pickup])
        {
            if(!IsPlayerLogged(playerid)) return 1;
            if(tick - GetPVarInt(playerid, "pvz_last_tp") < PVZ_TP_COOLDOWN_MS) return 1;

            // Телепортируем внутрь ПВЗ
            SetPlayerPos(playerid,
                PickupPoints[i][pp_exit_x],
                PickupPoints[i][pp_exit_y],
                PickupPoints[i][pp_exit_z]);
            SetPlayerInterior(playerid, PickupPoints[i][pp_exit_int]);
            SetPlayerVirtualWorld(playerid, PickupPoints[i][pp_exit_vw]);

            SetPVarInt(playerid, "in_pickup_point", i);
            SetPVarInt(playerid, "pvz_last_tp", tick);

            new msg[128];
            format(msg, sizeof(msg), "{33aa33}| {ffffff}Вы вошли в ПВЗ \"%s\".", PickupPoints[i][pp_name]);
            SendClientMessage(playerid, -1, msg);
            return 1;
        }
    }

    // Проверка на выход
    for(new i = 0; i < sizeof(PickupPoints); i++)
    {
        if(pickupid == PickupPoints[i][pp_exit_pickup])
        {
            if(tick - GetPVarInt(playerid, "pvz_last_tp") < PVZ_TP_COOLDOWN_MS) return 1;

            // Телепортируем наружу
            SetPlayerPos(playerid,
                PickupPoints[i][pp_enter_x],
                PickupPoints[i][pp_enter_y],
                PickupPoints[i][pp_enter_z]);
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, PickupPoints[i][pp_enter_vw]);
            DeletePVar(playerid, "in_pickup_point");
            SetPVarInt(playerid, "pvz_last_tp", tick);

            new msg[128];
            format(msg, sizeof(msg), "{33aa33}| {ffffff}Вы вышли из ПВЗ \"%s\".", PickupPoints[i][pp_name]);
            SendClientMessage(playerid, -1, msg);
            return 1;
        }
    }

    return 0;
}

// ============================================================================
// pvz_cargo_job.inc — работа "доставка груза" для ПВЗ (без гуишек)
//
//   Подходите к начальнику -> в чат пишется подсказка -> пишете /y -> точка
//   забора груза отмечается на карте (GPS + кольцо).
//   Приезжаете на точку забора -> в чат пишется подсказка -> пишете /y ->
//   идёт полоса погрузки (ShowPlayerProgress) -> груз на спине.
//   Несёте груз в ПВЗ (через любой из 9 пикапов) -> подходите к чекпоинту
//   у начальника -> груз сдаётся и засчитывается автоматически -> деньги.
// ============================================================================

#define PVZ_CARGO_NPC_MODEL         (6792)
#define PVZ_CARGO_NPC_X             (2284.598144)
#define PVZ_CARGO_NPC_Y             (1832.220703)
#define PVZ_CARGO_NPC_Z             (1519.743286)
#define PVZ_CARGO_NPC_A             (342.522583)
#define PVZ_CARGO_NPC_INT           (1)
#define PVZ_CARGO_NPC_VW            (1)

#define PVZ_CARGO_BTN_X             (2285.099121)
#define PVZ_CARGO_BTN_Y             (1834.363037)
#define PVZ_CARGO_BTN_Z             (1519.743286)
#define PVZ_CARGO_BTN_RADIUS        (2.5)

#define PVZ_CARGO_TAKE_X            (2025.244262)
#define PVZ_CARGO_TAKE_Y            (1398.201416)
#define PVZ_CARGO_TAKE_Z            (26.196250)
#define PVZ_CARGO_TAKE_RADIUS       (2.5)

#define PVZ_CARGO_LOAD_TIME_MS      (5000)
#define PVZ_CARGO_PAY               (3000)
#define PVZ_CARGO_COOLDOWN_MS       (120000)
#define PVZ_CARGO_OBJECT_MODEL      (2912)

new g_PvzCargoNpc = INVALID_ACTOR_ID;
new STREAMER_TAG_3D_TEXT_LABEL:g_PvzCargoNpcLabel = STREAMER_TAG_3D_TEXT_LABEL:-1;
new g_PvzCargoBossArea = -1;
new g_PvzCargoTakeArea = -1;

// ----------------------------------------------------------------------
// Полоса прогресса — дано как есть.
// ----------------------------------------------------------------------
stock ShowPlayerProgress(playerid, close, current_status, max_value, max_bar_progress, tick, timer, title[])
{
	new Node:json = JSON_Object();
	JSON_SetInt(json, "o", 1);
	JSON_SetInt(json, "g", 1);
	JSON_SetInt(json, "x", close);

	JSON_SetInt(json, "p_start", current_status);
	JSON_SetInt(json, "p_max", max_value);
	JSON_SetInt(json, "p_max_bar", max_bar_progress);
	JSON_SetInt(json, "p_tick", tick);
	JSON_SetInt(json, "p_timer", timer);
	JSON_SetString(json, "p_title", title, strlen(title));

	SendPacketToClient(playerid, 31, json);
	JSON_Cleanup(json);
	return 1;
}

// ----------------------------------------------------------------------
// Вызывается из OnGameModeInit
// ----------------------------------------------------------------------
stock CreatePvzCargoJobNpc()
{
	if(g_PvzCargoNpc != INVALID_ACTOR_ID) return 1;

	g_PvzCargoNpc = CreateActor(PVZ_CARGO_NPC_MODEL, PVZ_CARGO_NPC_X, PVZ_CARGO_NPC_Y, PVZ_CARGO_NPC_Z, PVZ_CARGO_NPC_A);
	SetActorVirtualWorld(g_PvzCargoNpc, PVZ_CARGO_NPC_VW);
	SetActorInvulnerable(g_PvzCargoNpc, true);

	g_PvzCargoNpcLabel = CreateDynamic3DTextLabel(
		"{FFD429}Начальник\n{FFFFFF}Напишите {FFD429}/y{FFFFFF}, чтобы поговорить",
		0xFFFFFFFF, PVZ_CARGO_NPC_X, PVZ_CARGO_NPC_Y, PVZ_CARGO_NPC_Z + 0.85, 18.0,
		INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, PVZ_CARGO_NPC_VW, PVZ_CARGO_NPC_INT);

	g_PvzCargoBossArea = CreateDynamicSphere(PVZ_CARGO_BTN_X, PVZ_CARGO_BTN_Y, PVZ_CARGO_BTN_Z, PVZ_CARGO_BTN_RADIUS, PVZ_CARGO_NPC_VW, PVZ_CARGO_NPC_INT);
	g_PvzCargoTakeArea = CreateDynamicSphere(PVZ_CARGO_TAKE_X, PVZ_CARGO_TAKE_Y, PVZ_CARGO_TAKE_Z, PVZ_CARGO_TAKE_RADIUS, 0, 0);
	return 1;
}

// ----------------------------------------------------------------------
// Вход в зоны — вызвать из существующего OnPlayerEnterDynamicArea:
//     if(PvzCargo_OnEnterArea(playerid, areaid)) return 1;
// Просто подсказка в чат, никакого гуи.
// ----------------------------------------------------------------------
stock PvzCargo_OnEnterArea(playerid, areaid)
{
	if(areaid == g_PvzCargoBossArea)
	{
		SendClientMessage(playerid, -1, "{2299ee}| {FFFFFF}Напишите {FFD700}/y{FFFFFF}, чтобы начать работу.");
		return 1;
	}

	if(areaid == g_PvzCargoTakeArea)
	{
		if(GetPVarInt(playerid, "pvz_cargo_accepted") && !GetPVarInt(playerid, "pvz_cargo_has"))
		{
			SendClientMessage(playerid, -1, "{2299ee}| {FFFFFF}Напишите {FFD700}/y{FFFFFF}, чтобы забрать груз.");
		}
		return 1;
	}
	return 0;
}

// ----------------------------------------------------------------------
// /y — универсальная команда подтверждения: смотрим, в какой мы зоне.
// ----------------------------------------------------------------------


// ----------------------------------------------------------------------
// Принять заказ у начальника
// ----------------------------------------------------------------------
stock PvzCargo_AcceptJob(playerid)
{
	if(GetPVarInt(playerid, "pvz_cargo_has"))
	{
		SendClientMessage(playerid, -1, "{FF5252}| {FFFFFF}Груз уже у вас на руках, довезите его.");
		return 1;
	}

	new cd = GetPVarInt(playerid, "pvz_cargo_cd");
	if(cd != 0 && GetTickCount() - cd < PVZ_CARGO_COOLDOWN_MS)
	{
		new left = (PVZ_CARGO_COOLDOWN_MS - (GetTickCount() - cd)) / 1000;
		new msg[96];
		format(msg, sizeof(msg), "{FF5252}| {FFFFFF}Следующий заказ можно взять через %d сек.", left);
		SendClientMessage(playerid, -1, msg);
		return 1;
	}

	SetPVarInt(playerid, "pvz_cargo_accepted", 1);
	DisablePlayerCheckpoint(playerid);
	DisablePlayerGPS(playerid);
	EnablePlayerGPS(playerid, 55, PVZ_CARGO_TAKE_X, PVZ_CARGO_TAKE_Y, PVZ_CARGO_TAKE_Z, "Забор груза отмечен на карте.");
	SetPlayerCheckpoint(playerid, PVZ_CARGO_TAKE_X, PVZ_CARGO_TAKE_Y, PVZ_CARGO_TAKE_Z, 3.0);

	SendClientMessage(playerid, -1, "{2299ee}| {FFFFFF}Есть работёнка. Нужно забрать груз, привезти сюда - и деньги твои.");
	new msg2[96];
	format(msg2, sizeof(msg2), "{2299ee}| {FFFFFF}За доставку заплачу {33aa33}%d рублей{FFFFFF}. Точка забора отмечена на карте.", PVZ_CARGO_PAY);
	SendClientMessage(playerid, -1, msg2);
	return 1;
}

// ----------------------------------------------------------------------
// Забрать груз на точке (запускает полосу погрузки)
// ----------------------------------------------------------------------
stock PvzCargo_StartLoading(playerid)
{
	if(!GetPVarInt(playerid, "pvz_cargo_accepted"))
	{
		SendClientMessage(playerid, -1, "{FF5252}| {FFFFFF}У вас нет активного заказа.");
		return 1;
	}
	if(GetPVarInt(playerid, "pvz_cargo_has")) return 1;
	if(GetPVarInt(playerid, "pvz_cargo_loading")) return 1;

	SetPVarInt(playerid, "pvz_cargo_loading", 1);
	TogglePlayerControllable(playerid, false);

	ShowPlayerProgress(playerid, 0, 0, 100, 100, 2, 100, "Погрузка груза...");
	SetTimerEx("PvzCargo_FinishLoad", PVZ_CARGO_LOAD_TIME_MS, false, "i", playerid);
	return 1;
}

// ----------------------------------------------------------------------
// Завершение погрузки
// ----------------------------------------------------------------------
forward PvzCargo_FinishLoad(playerid);
public PvzCargo_FinishLoad(playerid)
{
	if(!IsPlayerConnected(playerid)) return 1;
	if(!GetPVarInt(playerid, "pvz_cargo_loading")) return 1;
	DeletePVar(playerid, "pvz_cargo_loading");
	DeletePVar(playerid, "pvz_cargo_accepted");

	TogglePlayerControllable(playerid, true);
	HidePlayerGUI(playerid, 31);

	SetPVarInt(playerid, "pvz_cargo_has", 1);
	SetPlayerAttachedObject(playerid, A_OBJECT_SLOT_SPINE, PVZ_CARGO_OBJECT_MODEL, A_OBJECT_BONE_SPINE,
		0.0, 0.25, 0.15, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0);

	DisablePlayerGPS(playerid);
	EnablePlayerGPS(playerid, 55, PVZ_CARGO_NPC_X, PVZ_CARGO_NPC_Y, PVZ_CARGO_NPC_Z, "Точка сдачи груза отмечена на карте.");
	n_SetPlayerCheckpoint(playerid, PVZ_CARGO_NPC_X, PVZ_CARGO_NPC_Y, PVZ_CARGO_NPC_Z, 3.0, CP_ACTION_TYPE_PVZ_CARGO_PUT);
	SendClientMessage(playerid, -1, "{2299ee}| {FFFFFF}Груз загружен. Отнесите его начальнику в пункте выдачи.");
	return 1;
}

// ----------------------------------------------------------------------
// Сдача груза — вызвать из switch(action_type) внутри OnPlayerEnterCheckpoint:
//     case CP_ACTION_TYPE_PVZ_CARGO_PUT: PvzCargo_OnEnterPutCP(playerid);
// ----------------------------------------------------------------------
stock PvzCargo_OnEnterPutCP(playerid)
{
	if(!GetPVarInt(playerid, "pvz_cargo_has")) return 1;

	DisablePlayerCheckpoint(playerid);
	DisablePlayerGPS(playerid);
	DeletePVar(playerid, "pvz_cargo_has");
	RemovePlayerAttachedObject(playerid, A_OBJECT_SLOT_SPINE);

	SetPVarInt(playerid, "pvz_cargo_cd", GetTickCount());
	GivePlayerMoneyEx(playerid, PVZ_CARGO_PAY, "Доставка груза (ПВЗ)", true, true);

	new msg[96];
	format(msg, sizeof(msg), "{33aa33}| {FFFFFF}Груз доставлен! Вы получили {33aa33}%d руб.", PVZ_CARGO_PAY);
	SendClientMessage(playerid, -1, msg);
	return 1;
}

