    JSON_SetInt(json, "r", 122);

    new JSON:buttonList = JSON_Array();

    new JSON:btn1 = JSON_Object();
    JSON_SetInt(btn1, "k", INTERACTION_WITH_NPC_BUTTON_GREEN);
    JSON_SetString(btn1, "n", "Accept");
