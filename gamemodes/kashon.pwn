		{
			SetPlayerData(playerid, P_CAR_SLOTS, 20);
			UpdatePlayerDatabaseInt(playerid, "car_slots", 20);
		}
		SetPlayerData(playerid, P_HOUSE_SLOTS,			cache_get_field_content_int(0, "house_slots"));

