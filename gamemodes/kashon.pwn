	if(mysql_errno() != 0)
		return print("Не удалось подключится к базе данных!");

	mysql_set_charset("cp1251");
mysql_tquery(mysql, "SET NAMES cp1251");

    // Authentication checks listban before loading the player. Some clean
    // databases were shipped without this table, which made valid logins
    // fail with "cannot verify account". Create only the missing table.
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS `listban` (`acc_id` int(11) NOT NULL, `player_name` varchar(24) NOT NULL DEFAULT '', `admin_name` varchar(24) NOT NULL DEFAULT '', `reason` varchar(128) NOT NULL DEFAULT '', `ban_time` int(11) NOT NULL DEFAULT 0, `unban_time` int(11) NOT NULL DEFAULT 0, KEY `idx_listban_acc_id` (`acc_id`)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
