stock SPromo_EnsureTables()
{
    mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS `silver_custom_promocodes` ("\
        "`id` INT NOT NULL AUTO_INCREMENT,"\
        "`code` VARCHAR(31) NOT NULL,"\
        "`reward_mask` INT NOT NULL DEFAULT 0,"\
        "`car_model` INT NOT NULL DEFAULT 0,"\
        "`money` BIGINT NOT NULL DEFAULT 0,"\
        "`donate` BIGINT NOT NULL DEFAULT 0,"\
        "`exp` BIGINT NOT NULL DEFAULT 0,"\
        "`created_by` INT NOT NULL DEFAULT 0,"\
        "`created_at` INT NOT NULL DEFAULT 0,"\
        "PRIMARY KEY (`id`), UNIQUE KEY `code` (`code`)"\
        ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);

    mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS `silver_custom_promocode_used` ("\
        "`id` INT NOT NULL AUTO_INCREMENT,"\
        "`promo_id` INT NOT NULL,"\
        "`account_id` INT NOT NULL,"\
        "`used_at` INT NOT NULL DEFAULT 0,"\
        "PRIMARY KEY (`id`), UNIQUE KEY `promo_account` (`promo_id`,`account_id`)"\
        ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    return 1;
}

stock SPromo_ResetCreate(playerid)
{
    g_sPromoMask[playerid] = 0;
    g_sPromoCar[playerid] = 0;
    g_sPromoMoney[playerid] = 0;
    g_sPromoDonate[playerid] = 0;
    g_sPromoExp[playerid] = 0;
    g_sPromoCode[playerid][0] = EOS;
    return 1;
}

stock SPromo_ShowRewardSelect(playerid)
{
    return Dialog(playerid, DIALOG_SPROMO_REWARD, DIALOG_STYLE_LIST,
        "Создание промокода",
        "Машина\nДеньги\nДонат\nEXP\nВыбрать все",
        "Выбрать", "Отмена");
}

stock SPromo_ShowConfirm(playerid)
{
    new text[768], rewards[512], reward_line[128];
    rewards[0] = EOS;

    if(g_sPromoMask[playerid] & SPROMO_REWARD_CAR)
    {
        format(reward_line, sizeof reward_line, "Машина: модель %d\n", g_sPromoCar[playerid]);
        strcat(rewards, reward_line);
    }
    if(g_sPromoMask[playerid] & SPROMO_REWARD_MONEY)
    {
        format(reward_line, sizeof reward_line, "Деньги: %d руб.\n", g_sPromoMoney[playerid]);
        strcat(rewards, reward_line);
    }
    if(g_sPromoMask[playerid] & SPROMO_REWARD_DONATE)
    {
        format(reward_line, sizeof reward_line, "Донат: %d\n", g_sPromoDonate[playerid]);
        strcat(rewards, reward_line);
    }
    if(g_sPromoMask[playerid] & SPROMO_REWARD_EXP)
    {
        format(reward_line, sizeof reward_line, "EXP: %d\n", g_sPromoExp[playerid]);
        strcat(rewards, reward_line);
    }

    format(text, sizeof text,
        "Вы точно хотите создать промокод?\n\nПромокод: %s\n\nНаграды:\n%s",
        g_sPromoCode[playerid], rewards);
    return Dialog(playerid, DIALOG_SPROMO_CONFIRM, DIALOG_STYLE_MSGBOX,
        "Подтверждение", text, "Подтвердить", "Нет");
}

stock SPromo_Save(playerid)
{
    SPromo_EnsureTables();

    new query[768], Cache:result;
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO `silver_custom_promocodes` (`code`,`reward_mask`,`car_model`,`money`,`donate`,`exp`,`created_by`,`created_at`) VALUES ('%e',%d,%d,%d,%d,%d,%d,%d)",
        g_sPromoCode[playerid], g_sPromoMask[playerid], g_sPromoCar[playerid],
        g_sPromoMoney[playerid], g_sPromoDonate[playerid], g_sPromoExp[playerid],
        GetPlayerAccountID(playerid), gettime());

    result = mysql_query(mysql, query, true);
    if(mysql_errno())
    {
        cache_delete(result);
        return 0;
    }
    cache_delete(result);
    return 1;
}

stock SPromo_GiveCar(playerid, model_id)
{
    if(!(400 <= model_id <= 30000)) return 0;
    if((GetPlayerOwnableCars(playerid) + 1) > GetPlayerCarSlots(playerid)) return 0;

    new idx = GetFreeOwnableCarID();
    if(idx == -1) return 0;

    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);

    SetOwnableCarData(idx, OC_OWNER_ID, GetPlayerAccountID(playerid));
    SetOwnableCarData(idx, OC_MODEL_ID, model_id);
    SetOwnableCarData(idx, OC_COLOR_1, 1);
    SetOwnableCarData(idx, OC_COLOR_2, 1);
    SetOwnableCarData(idx, OC_POS_X, x);
    SetOwnableCarData(idx, OC_POS_Y, y);
    SetOwnableCarData(idx, OC_POS_Z, z);
    SetOwnableCarData(idx, OC_ANGLE, a);
    strmid(g_ownable_car[idx][OC_NUMBER], "------", 0, 8, 8);
    SetOwnableCarData(idx, OC_ALARM, false);
    SetOwnableCarData(idx, OC_KEY_IN, false);
    SetOwnableCarData(idx, OC_CREATE, gettime());
    format(g_ownable_car[idx][OC_OWNER_NAME], 21, GetPlayerNameEx(playerid));

    new query[512], Cache:result;
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ownable_cars (owner_id,model_id,color_1,color_2,pos_x,pos_y,pos_z,angle,create_time) VALUES (%d,%d,1,1,'%f','%f','%f','%f',%d)",
        GetPlayerAccountID(playerid), model_id, x, y, z, a, gettime());
    result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        SetOwnableCarData(idx, OC_OWNER_ID, 0);
        SetOwnableCarData(idx, OC_MODEL_ID, 0);
        SetOwnableCarData(idx, OC_COLOR_1, 0);
        SetOwnableCarData(idx, OC_COLOR_2, 0);
        cache_delete(result);
        return 0;
    }

    SetOwnableCarData(idx, OC_SQL_ID, cache_insert_id());
    cache_delete(result);
    return 1;
}

stock SPromo_Use(playerid)
{
    SPromo_EnsureTables();

    new query[768], Cache:result;
    mysql_format(mysql, query, sizeof query,
        "SELECT id,reward_mask,car_model,money,donate,exp FROM silver_custom_promocodes WHERE code='%e' LIMIT 1",
        g_sPromoInputCode[playerid]);
    result = mysql_query(mysql, query, true);

    if(cache_num_rows(result) == 0)
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0xFF5533FF, "Промокод не найден или введён неверно.");
    }

    new promo_id = cache_get_field_content_int(0, "id");
    new mask = cache_get_field_content_int(0, "reward_mask");
    new car = cache_get_field_content_int(0, "car_model");
    new money = cache_get_field_content_int(0, "money");
    new donate = cache_get_field_content_int(0, "donate");
    new exp = cache_get_field_content_int(0, "exp");
    cache_delete(result);

    mysql_format(mysql, query, sizeof query,
        "SELECT id FROM silver_custom_promocode_used WHERE promo_id=%d AND account_id=%d LIMIT 1",
        promo_id, GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);
    if(cache_num_rows(result) > 0)
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0xFF5533FF, "Вы уже использовали этот промокод.");
    }
    cache_delete(result);

    new rewards[768], reward_line[128];
    rewards[0] = EOS;

    // Проверяем автомобиль до выдачи остальных наград, чтобы не было частичной выдачи.
    if(mask & SPROMO_REWARD_CAR)
    {
        if(!SPromo_GiveCar(playerid, car))
            return SendClientMessage(playerid, 0xFF5533FF, "Не удалось выдать автомобиль: проверьте свободный слот транспорта.");

        format(reward_line, sizeof reward_line, "Машина: модель %d\n", car);
        strcat(rewards, reward_line);
    }
    if(mask & SPROMO_REWARD_MONEY)
    {
        if(money > 0) GivePlayerMoneyEx(playerid, money, "Промокод", true, false);
        format(reward_line, sizeof reward_line, "Деньги: %d руб.\n", money);
        strcat(rewards, reward_line);
    }
    if(mask & SPROMO_REWARD_DONATE)
    {
        if(donate > 0) GivePlayerDonateRub(playerid, donate, "Промокод", true, false);
        format(reward_line, sizeof reward_line, "Донат: %d\n", donate);
        strcat(rewards, reward_line);
    }
    if(mask & SPROMO_REWARD_EXP)
    {
        if(exp > 0)
        {
            AddPlayerData(playerid, P_EXP, +, exp);
            UpdatePlayerDatabaseInt(playerid, "exp", GetPlayerData(playerid, P_EXP));
        }
        format(reward_line, sizeof reward_line, "EXP: %d\n", exp);
        strcat(rewards, reward_line);
    }

    mysql_format(mysql, query, sizeof query,
        "INSERT INTO silver_custom_promocode_used (promo_id,account_id,used_at) VALUES (%d,%d,%d)",
        promo_id, GetPlayerAccountID(playerid), gettime());
    mysql_query(mysql, query, false);

    new result_text[900];
    format(result_text, sizeof result_text,
        "Вы успешно ввели промокод, вот ваши награды!\n\nПромокод: %s\n\n%s",
        g_sPromoInputCode[playerid], rewards);
    Dialog(playerid, DIALOG_SPROMO_REWARD_RESULT, DIALOG_STYLE_MSGBOX,
        "Промокод активирован", result_text, "Закрыть", "");
    return 1;
}

CMD:addpromo(playerid, params[])
{
    #pragma unused params
    if(GetPlayerAdminEx(playerid) < 5)
        return SendClientMessage(playerid, 0xFF5533FF, "У вас нет доступа к этой команде.");

    SPromo_ResetCreate(playerid);
    return Dialog(playerid, DIALOG_SPROMO_CODE, DIALOG_STYLE_INPUT,
        "Создание промокода", "Введите название промокода:", "Далее", "Отмена");
}

CMD:promocods(playerid, params[])
{
    #pragma unused params
    if(!IsPlayerLogged(playerid)) return 1;
    g_sPromoInputCode[playerid][0] = EOS;
    return Dialog(playerid, DIALOG_SPROMO_USE, DIALOG_STYLE_INPUT,
        "Промокод", "Введите промокод:", "Активировать", "Отмена");
}

CMD:createpromo(playerid, params[])
{

	Dialog
	(
		playerid, DIALOG_PROMO_CREATE, DIALOG_STYLE_INPUT,
		"{ff0000}Создание промокода",
		"{FFFF00}Промокод {FFFFFF}- уникальный набор символов,позволяющий Вам и человеку,использующему Ваш промокод получить вознаграждение.\n"\
		"Промокод разделен на {FFFF00}10 уровней{FFFFFF},с повыщением которого Вы будете получать ценные призы.\n"\
		"Вы можете самостоятельно создать {FFFF00}свой промокод{FFFFFF},при условии что он свободен.\n\n"\
		"Однако стоит помнить,что количество символов в промокоде определяют его стоимость\n"\
		"{FFFF00}1 символ {FFFFFF}- 10.000.000 рублей или 2000 донат-рублей\n"\
		"{FFFF00}От 2 символов до 3 символов {FFFFFF}- 7.000.000 рублей или 1.000 донат-рублей\n"\
		"{FFFF00}{FFFF00}От 3 символов до 5 символов {FFFFFF}- 6.000.000 рублей.\n"\
		"{FFFF00}От 5 символов до 7 символов {FFFFFF}- 3.000.000 рублей.\n"\
		"{FFFF00}От 7 символов {FFFFFF}- 1.000.000 рублей.\n"\
		"Вы можете использовать {FFFF00}латиницу и кириллицу,@ и цифры\n\n"\
		"{FFFFFF}Для создания промокода введите в поле ниже желаемый набор символов.",
		"Далее", "Выйти"
	);

	return 1;
}

