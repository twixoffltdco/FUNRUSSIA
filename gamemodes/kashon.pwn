stock TaxiPark_OpenStaffOnline(playerid, park_id)
{
	new caption[72], list[1500], name[24], rank_str[16];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", "Список сотрудников в сети");
	format(list, sizeof list, "%s\t%s\t%s\t%s", "Ник", "Ранг", "Доход за 1 день", "Рейтинг");
	new count = 0;
	SetPVarInt(playerid, "TaxiStaffMode", 1);
	for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(TaxiPark_GetPlayerJob(i) != park_id) continue;
		GetPlayerName(i, name, sizeof name);
		TaxiPark_RankName(g_TaxiDriverRank[i], rank_str);
		format(list, sizeof list, "%s\n%s\t%s\t%d %s\t%.2f", list, name, rank_str, g_TaxiDayIncome[i], "рублей", g_TaxiDriverRating[i]);
		SetPVarInt(playerid, "TaxiStaffSlot", i); // last only - better use array
		count++;
		if(count >= 25) break;
	}
	if(count == 0) format(list, sizeof list, "%s", "Нет сотрудников в сети");
	Dialog_Open(playerid, "TaxiPark_TMenuStaffList", DIALOG_STYLE_TABLIST_HEADERS, caption, list, "Выбрать", "Назад");
	return 1;
}

stock TaxiPark_OpenStaffOffline(playerid, park_id)
{
	#pragma unused park_id
	new caption[72], list[200];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", "Список сотрудников не в сети");
	format(list, sizeof list, "%s", "Оффлайн-список загружается из базы при наличии записи taxi_park у аккаунта. Сейчас показаны только онлайн-сотрудники через первый пункт.");
	Dialog_Open(playerid, "TaxiPark_TMenuStaffList", DIALOG_STYLE_MSGBOX, caption, list, "Назад", "");
	return 1;
}

Dialog_Response:TaxiPark_TMenuStaffList(playerid, response, listitem, inputtext[])
{
	#pragma unused listitem, inputtext
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenStaffMenu(playerid, park_id);
	if(GetPVarInt(playerid, "TaxiStaffMode") == 1 && listitem >= 0)
	{
		// find Nth online employee
		new n = -1;
		for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
		{
			if(!IsPlayerConnected(i)) continue;
			if(TaxiPark_GetPlayerJob(i) != park_id) continue;
			n++;
			if(n == listitem)
			{
				TaxiPark_OpenEmployeeCard(playerid, i);
				return 1;
			}
		}
	}
	return TaxiPark_OpenStaffMenu(playerid, park_id);
}

