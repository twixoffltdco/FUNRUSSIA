Dialog_Response:TaxiPark_TMenuPctEdit(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenPctManage(playerid, park_id);
	new pct = strval(inputtext);
	if(pct < 20 || pct > 75)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Процент должен быть от 20 до 75", "");
		return TaxiPark_OpenPctManage(playerid, park_id);
	}
	new ed = GetPVarInt(playerid, "TaxiPctEdit");
	g_TaxiDriverPct[park_id][ed] = pct;
	TaxiPark_SaveCompany(park_id);
	ShowNotificationNew(playerid, 3, 4, 0, 0, "Процент водителю изменён", "");
	return TaxiPark_OpenPctManage(playerid, park_id);
}

