                    printf("Case 1: random spawn Pos: %f, %f, %f, Angle: %f", case_1_spawns[spawn_index][0], case_1_spawns[spawn_index][1], case_1_spawns[spawn_index][2], case_1_spawns[spawn_index][3]);
