Dialog_Response:TaxiPark_TMenuPriceEdit(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenPriceManage(playerid, park_id);
	new price = strval(inputtext);
	if(price < 50 || price > 50000)
	{
		ShowNotificationNew(playerid, 2, 4, 0, 0, "Цена от 50 до 50000", "");
		return TaxiPark_OpenPriceManage(playerid, park_id);
	}
	new ed = GetPVarInt(playerid, "TaxiPriceEdit");
	if(ed == 0) g_TaxiCompany[park_id][TC_PRICE_ECO] = price;
	else if(ed == 1) g_TaxiCompany[park_id][TC_PRICE_COM] = price;
	else g_TaxiCompany[park_id][TC_PRICE_BIZ] = price;
	TaxiPark_SaveCompany(park_id);
	ShowNotificationNew(playerid, 3, 4, 0, 0, "Цена изменена", "");
	return TaxiPark_OpenPriceManage(playerid, park_id);
}

