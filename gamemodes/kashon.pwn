                ResetContInfo(cont);
                pInfo[playerid][BuyUseCont] = 0;
                pInfo[playerid][BetUseCont] = 0;

                if(ContsRespawnTimer[cont] != 0) KillTimer(ContsRespawnTimer[cont]);
                ContsRespawnTimer[cont] = SetTimerEx("SpawnNewCont", 5000, false, "i", cont);
            }
