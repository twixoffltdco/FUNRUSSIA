#define SILVER_OPG_MAT_RAID_BOX 500
#define SILVER_OPG_MAT_RAID_MAX 5000
#define SILVER_OPG_MAT_RAID_COOLDOWN 3600
#define SILVER_OPG_MAT_RAID_DURATION 1200
#define SILVER_OPG_MAT_RAID_MIN_PLAYERS 5
#define SILVER_OPG_MAT_RAID_MIN_RANK 6
#define SILVER_OPG_MAT_RAID_MAX_STOCK 6000
#define SILVER_OPG_MAT_ARMY_X 1562.881469
#define SILVER_OPG_MAT_ARMY_Y 1642.907470
#define SILVER_OPG_MAT_ARMY_Z 15.971530
#define SILVER_OPG_MAT_ARMY_WORLD 0
#define SILVER_OPG_MAT_ARMY_INTERIOR 0
#define SILVER_OPG_MAT_TRUCK_NOTIFY_ID 9301

new g_opg_mat_raid_until;
new g_opg_mat_raid_started;
new g_opg_mat_raid_team = 0;
new g_opg_mat_raid_total;
new g_opg_mat_raid_last;

#define SILVER_OPG_KPP_HACK_TIME 25
#define SILVER_OPG_KPP_OPEN_TIME 180
#define SILVER_OPG_KPP_RADIUS 12.0
new g_opg_kpp_hacker = INVALID_PLAYER_ID;
new g_silver_materials_pickup = -1;
new g_opg_kpp_open_until;
new g_opg_kpp_close_timer = -1;
forward SilverOpgKppStart(playerid);
forward SilverOpgMaterialLoadTruck(playerid);
forward SilverOpgKppFinish(playerid);
forward SilverOpgKppClose();

stock bool:IsSilverOpgMaterialRaidTeam(team)
{
    return (8 <= team <= 10);
}

stock bool:IsSilverOpgMaterialTruck(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID) return false;
    switch(GetVehicleModel(vehicleid))
    {
        case 403, 418, 514, 515, 578: return true;
    }
    return false;
}

stock SilverOpgMaterialRaidCountPlayers(team, &players, &senior)
{
    players = 0;
    senior = 0;
    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i) || !IsPlayerLogged(i)) continue;
        if(GetPlayerTeamEx(i) != team) continue;
        if(GetPlayerVirtualWorld(i) != SILVER_OPG_MAT_ARMY_WORLD) continue;
        if(GetPlayerInterior(i) != SILVER_OPG_MAT_ARMY_INTERIOR) continue;
        if(!IsPlayerInRangeOfPoint(i, 120.0, SILVER_OPG_MAT_ARMY_X, SILVER_OPG_MAT_ARMY_Y, SILVER_OPG_MAT_ARMY_Z)) continue;
        players++;
        if(GetPlayerJob(i) >= SILVER_OPG_MAT_RAID_MIN_RANK) senior++;
    }
}

stock SilverOpgMaterialRaidReset()
{
    g_opg_mat_raid_started = 0;
    g_opg_mat_raid_team = 0;
    g_opg_mat_raid_total = 0;
    g_opg_mat_raid_last = 0;
}

stock bool:SilverOpgMaterialRaidCheckTime(playerid)
{
    new hour;
    gettime(hour);
    if(hour >= 23 || hour < 6)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Ограбление ВЧ запрещено с 23:00 до 06:00"), false;
    return true;
}

stock SilverOpgMaterialRaidNotify(team, const text[])
{
    SendMessageToTeam(team, text, 0xFFCD00FF);
    SendMessageToTeam(2, text, 0xFF5533FF);
    SendMessageToTeam(5, text, 0xFF5533FF);
    SendMessageToTeam(6, text, 0xFF5533FF);
}

stock bool:SilverOpgMaterialRaidCanLoad(playerid, team)
{
    if(!IsSilverOpgMaterialRaidTeam(team) || !SilverOpgMaterialRaidCheckTime(playerid)) return false;
    new now = gettime();
    if(g_opg_mat_raid_started && now > g_opg_mat_raid_until)
    {
        SilverOpgMaterialRaidReset();
        SilverOpgKppCloseGate(0);
        SilverOpgKppCloseGate(1);
        g_opg_kpp_open_until = 0;
    }
    if(!g_opg_mat_raid_started && g_opg_mat_raid_last > now)
    {
        new left = g_opg_mat_raid_last - now;
        new msg[100];
        format(msg, sizeof msg, "{FF5533}Следующее ограбление ВЧ будет доступно через %d мин.", (left + 59) / 60);
        SendClientMessage(playerid, 0x999999FF, msg);
        return false;
    }
    if(g_opg_mat_raid_started && g_opg_mat_raid_team != team)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Сейчас ограбление ВЧ проводит другая ОПГ."), false;

    if(!g_opg_mat_raid_started)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Сначала нужно взломать КПП ВЧ. Используйте \xea\xed\xee\xef\xea\xf3 \xe2\xe7\xe0\xe8\xec\xee\xe4\xe5\xe9\xf1\xf2\xe2\xe8\xff."), false;

    if(g_opg_kpp_open_until <= now)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}КПП ВЧ уже закрыто. Нужно заново провести взлом."), false;

    if(g_opg_mat_raid_total + SILVER_OPG_MAT_RAID_BOX > SILVER_OPG_MAT_RAID_MAX)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Лимит материалов этого рейда уже исчерпан."), false;
    return true;
}

