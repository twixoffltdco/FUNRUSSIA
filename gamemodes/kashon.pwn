        {
            if(GetPlayerData(playerid, P_RENT_BIKE))
                return ShowNotificationNew(playerid, 2, 4, 0, 0, "Вы уже арендовали скутер!", "");

            if(GetPlayerMoneyEx(playerid) < 50)
