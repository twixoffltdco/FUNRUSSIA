	return 1;

}
CMD:buyslot(playerid)
{
						new fmt_text[80];

						if(GetPlayerDonateRub(playerid) < 100)
						{
						    ShowNotificationNew(playerid, 2, 4, 0, 0, "Для покупки слота для транспорта необходимо иметь на счету 100 руб!", "");
						}
