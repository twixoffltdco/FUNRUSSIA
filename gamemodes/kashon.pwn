	SetPlayerRaceCPInfo(playerid, RCP_ACTION_TYPE, action_type);
	SetPlayerRaceCPInfo(playerid, RCP_ENABLED, true);

	return SetPlayerRaceCheckpoint(playerid, type, x, y, z, nextx, nexty, nextz, size);
}
