				if(!response) return callcmd::lmenu(playerid);
				if(listitem == 0) Dialog(playerid, DIALOG_LMENU_RANG, DIALOG_STYLE_INPUT, "Изменение ранга", "Введите: ID + или ID -", "Изменить", "Назад");
				else callcmd::showall(playerid, "");
			}

			case DIALOG_LMENU_EVENTS:
			{
				if(!response) return callcmd::lmenu(playerid);
				if(listitem == 0) callcmd::addvacancy(playerid);
				else if(listitem == 1) callcmd::delvacancy(playerid);
				else callcmd::vacancy(playerid);
			}

			case DIALOG_LMENU_OTHER:
			{
				if(!response) return callcmd::lmenu(playerid);
				if(listitem == 0) callcmd::showall(playerid, "");
				else Dialog(playerid, DIALOG_LEADER_MENU_JOBS, DIALOG_STYLE_LIST, "Вакансии", "Создать вакансию\nУдалить вакансию", "Выбрать", "Назад");
			}

			case DIALOG_LMENU_INVITE:
			{
				if(!response) return Dialog(playerid, DIALOG_LMENU_COMPOSITION, DIALOG_STYLE_LIST, "Управление составом", "Пригласить сотрудника\nУволить сотрудника\nСписок сотрудников\nИзменить ранг\nУправление вакансиями", "Выбрать", "Назад");
				new id; if(sscanf(inputtext, "d", id)) return Dialog(playerid, DIALOG_LMENU_INVITE, DIALOG_STYLE_INPUT, "Приглашение", "Введите корректный ID игрока:", "Пригласить", "Назад");
				return callcmd::invite(playerid, inputtext);
			}

			case DIALOG_LMENU_UNINVITE:
			{
				if(!response) return Dialog(playerid, DIALOG_LMENU_COMPOSITION, DIALOG_STYLE_LIST, "Управление составом", "Пригласить сотрудника\nУволить сотрудника\nСписок сотрудников\nИзменить ранг\nУправление вакансиями", "Выбрать", "Назад");
				new id, reason[64], params[96]; if(sscanf(inputtext, "ds[63]", id, reason)) return Dialog(playerid, DIALOG_LMENU_UNINVITE, DIALOG_STYLE_INPUT, "Увольнение", "Введите: ID причина", "Уволить", "Назад");
				format(params, sizeof(params), "%d %s", id, reason); return callcmd::uninvite(playerid, params);
			}

			case DIALOG_LMENU_RANG:
			{
				if(!response) return Dialog(playerid, DIALOG_LMENU_RANKS, DIALOG_STYLE_LIST, "Настройки рангов", "Изменить ранг сотрудника\nСписок сотрудников", "Выбрать", "Назад");
				return callcmd::rang(playerid, inputtext);
			}

			case DIALOG_LMENU_ANNOUNCE:
			{
				if(!response) return Dialog(playerid, DIALOG_LMENU_FRACTION, DIALOG_STYLE_LIST, "Настройки фракции", "Объявление для состава\nИнформация о фракции", "Выбрать", "Назад");
				if(strlen(inputtext) < 2) return Dialog(playerid, DIALOG_LMENU_ANNOUNCE, DIALOG_STYLE_INPUT, "Объявление фракции", "Введите текст объявления для всего состава:", "Отправить", "Назад");
				utf8_to_cp1251(inputtext);
				new text[300]; format(text, sizeof(text), "[Фракция] %s: %s", GetPlayerNameEx(playerid), inputtext); SendMessageToTeam(GetPlayerTeamEx(playerid), text, 0x66CCFFFF); return 1;
			}

		    case DIALOG_LEADER_MENU_JOBS:
		    {
		        if(!response) return 1;
		        switch(list_id)
		        {
		            case 1: callcmd::addvacancy(playerid);
		            case 2: callcmd::delvacancy(playerid);
		        }
		    }
		    case DIALOG_LEADER_MENU_UNINVITE:
		    {
		        if(!response) return 1;
		        callcmd::uninviteoff(playerid,inputtext);
		        return 1;
		    }

