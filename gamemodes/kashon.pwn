stock bool:IsDonateCarGameModel(modelid)
{
    if(modelid < 400) return false;

    // Premium/donate custom vehicles are stored as model_id = 400 + vehicle-info index.
    if(modelid >= 2043 && modelid < (400 + sizeof(g_vehicle_info))) return true;

    for(new i = 0; i < sizeof(car_game_ids); i++)
    {
        if(car_game_ids[i][1] == modelid) return true;
    }
    return false;
}

stock GetDonateCarParkingClass(modelid)
{
    if(!IsDonateCarGameModel(modelid)) return 0;
    if(GetCarMarketModelIndex(1, modelid) != -1) return 1;
    return 2;
}

stock bool:GetDonateCarSpecialParkingByModel(modelid, &Float:x, &Float:y, &Float:z, &Float:a)
{
    new parking_class = GetDonateCarParkingClass(modelid);
    if(parking_class == 1)
    {
        x = 2494.723144;
        y = -759.527648;
        z = 11.833450;
        a = 289.204193;
        return true;
    }
    if(parking_class == 2)
    {
        x = 668.062316;
        y = 2639.194824;
        z = 12.060885;
        a = 235.927810;
        return true;
    }
    return false;
}

stock bool:GetDonateCarSpecialParkingBySqlID(sql_id, &Float:x, &Float:y, &Float:z, &Float:a)
{
    if(sql_id <= 0) return false;
    new query[96], Cache:result;
    mysql_format(mysql, query, sizeof query, "SELECT model_id FROM ownable_cars WHERE id=%d LIMIT 1", sql_id);
    result = mysql_query(mysql, query, true);
    if(!cache_num_rows(result))
    {
        cache_delete(result);
        return false;
    }
    new modelid = cache_get_field_content_int(0, "model_id");
    cache_delete(result);
    return GetDonateCarSpecialParkingByModel(modelid, x, y, z, a);
}


