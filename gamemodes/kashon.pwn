    JSON_SetString(response, "pn", player_name);
    JSON_SetInt(response, "pi", playerid);
    JSON_SetInt(response, "is", GetFamily(family_id, family_syndicate));

    ShowPlayerGUI(playerid, 45, response);
    JSON_Cleanup(response);
    return 1;
}

