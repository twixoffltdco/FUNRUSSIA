public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{

    if(IsPlayerLogged(playerid) && GetPlayerAdminEx(playerid) > 0 && !GetPlayerData(playerid, P_ADMIN_LOGGED))
    {
        SRAdmin_ShowLogin(playerid);
        return 0;
    }

	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);

	if(!IsPlayerLogged(playerid)) return 0;
	if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
	{
		ShowNotificationNew(playerid,  2, 6, 0, 0, "Не флудите", "qq");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			ShowNotificationNew(playerid,  2, 6, 0, 0, "Пожалуйста, подождите несколько секунд...", "qq");

		return 0;
	}

    return 1;
}

public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{

    // Fallback for integrated Media commands.
    if(!strcmp(cmd, "media", true) || !strcmp(cmd, "/media", true))
    {
        if(!IsMediaAdmin(playerid)) return SendClientMessage(playerid, 0xFF5533FF, "\xD3\x20\xE2\xE0\xF1\x20\xED\xE5\xF2\x20\xEF\xF0\xE0\xE2\x20\xEC\xE5\xE4\xE8\xE0\x-\xF1\xEE\xF2\xF0\xF3\xE4\xED\xE8\xEA\xE0");
        new media_list[1600], media_row[160], media_rank_name[32], media_duty_name[16], media_count;
        format(media_list, sizeof media_list, "ID\t\xC8\xE3\xF0\xEE\xEA\t\xC4\xEE\xEB\xE6\xED\xEE\xF1\xF2\xFC\t\xD0\xE5\xE6\xE8\xEC\n");
        foreach(new mediaid : Player)
        {
            new media_level = GetPlayerData(mediaid, P_YOUTUBE);
            if(!IsPlayerLogged(mediaid) || media_level < 1) continue;
            if(media_level >= 2) format(media_rank_name, sizeof media_rank_name, "PR-manager");
            else format(media_rank_name, sizeof media_rank_name, "Media");
            format(media_duty_name, sizeof media_duty_name, "-");
            format(media_row, sizeof media_row, "%d\t%s\t%s\t%s\n", mediaid, GetPlayerNameEx(mediaid), media_rank_name, media_duty_name);
            if(strlen(media_list) + strlen(media_row) < sizeof media_list) strcat(media_list, media_row);
            media_count++;
        }
        if(!media_count) return SendClientMessage(playerid, 0xCECECEFF, "\xCC\xE5\xE4\xE8\xE0-\xF1\xEE\xF2\xF0\xF3\xE4\xED\xE8\xEA\xEE\xE2\x20\xEE\xED\xEB\xE0\xE9\xED\x20\xED\xE5\xF2");
        ShowPlayerDialog(playerid, 18992, DIALOG_STYLE_TABLIST_HEADERS, "\xD1\xEF\xE8\xF1\xEE\xEA \xEC\xE5\xE4\xE8\xE0 \xEE\xED\xEB\xE0\xE9\xED", media_list, "\xC7\xE0\xEA\xF0\xFB\xF2\xFC", "");
        return 1;
    }

    if(!strcmp(cmd, "mhelp", true) || !strcmp(cmd, "/mhelp", true) || !strcmp(cmd, "yhelp", true) || !strcmp(cmd, "/yhelp", true))
    {
        if(!IsMediaAdmin(playerid)) return SendClientMessage(playerid, 0xFF5533FF, "\xD3\x20\xE2\xE0\xF1\x20\xED\xE5\xF2\x20\xEF\xF0\xE0\xE2\x20\xEC\xE5\xE4\xE8\xE0\x-\xF1\xEE\xF2\xF0\xF3\xE4\xED\xE8\xEA\xE0");
        new media_help[1800];
        format(media_help, sizeof media_help, "\xCA\xEE\xEC\xE0\xED\xE4\xE0\t\xCD\xE0\xE7\xED\xE0\xF7\xE5\xED\xE8\xE5\n/media\t\xD1\xEF\xE8\xF1\xEE\xEA \xEC\xE5\xE4\xE8\xE0\n/mchat [text]\t\xCC\xE5\xE4\xE8\xE0-\xF7\xE0\xF2\n/mduty\t\xC2\xEA\xEB\xE2\xFB\xEA\xEB \xEC\xE5\xE4\xE8\xE0-\xF0\xE5\xE6\xE8\xEC\n/mhp\t\xC2\xEE\xF1\xF1\xF2\xE0\xED\xEE\xE2\xE8\xF2\xFC HP\n/mworld [id]\t\xC8\xE7\xEC\xE5\xED\xE8\xF2\xFC virtual world\n/mflip\t\xCF\xE5\xF5\xE2\xE5\xF0\xED\xF3\xF2\xFC \xF2\xF0\xE0\xED\xF1\xEF\xEE\xF0\xF2\n/mypromo\t\xCC\xE5\xE4\xE8\xE0-\xEF\xF0\xEE\xEC\xEE\xEA\xEE\xE4\xF3\n/mskin [id]\t\xD1\xEA\xE8\xED\n/mveh [model] [c1] [c2]\t\xCC\xE5\xE4\xE8\xE0-\xF2\xF0\xE0\xED\xF1\xEF\xEE\xF0\xF2\n/mvehdel\t\xD3\xE4\xE0\xEB\xE8\xF2\xFC \xEC\xE5\xE4\xE8\xE0-\xF2\xF0\xE0\xED\xF1\xEF\xEE\xF0\xF2\n/mfix\t\xCF\xEE\xF7\xE8\xED\xE8\xF2\xFC \xF2\xF0\xE0\xED\xF1\xEF\xEE\xF0\xF2\n/msp [id]\t\xD1\xEB\xE5\xE6\xEA\xE0\n/mspoff\t\xD1\xEE\xF1\xF2\xEE\xEF\xF0\xEE\xE2\xE0\xF2\xFC \xF1\xEB\xE5\xE6\xEA\xEA\xF3\n/mgoto [id]\t\xD2\xE5\xEB\xE5\xEF\xEE\xF0\xF2\n/minfo [id]\t\xC8\xED\xF4\xEE\xF0\xEC\xE0\xF6\xE8\xFF\n/mzone\t\xCC\xE5\xE4\xE8\xE0-\xE7\xEE\xED\xE0\n/mgetv\t\xD2\xE5\xEB\xE5\xEF\xEE\xF0\xF2 \xEC\xE5\xE4\xE8\xE0-\xF2\xF0\xE0\xED\xF1\xEF\xEE\xF0\xF2\xE0");
        ShowPlayerDialog(playerid, 18993, DIALOG_STYLE_TABLIST_HEADERS, "\xCA\xEE\xEC\xE0\xED\xE4\xFB \xEC\xE5\xE4\xE8\xE0", media_help, "\xC7\xE0\xEA\xF0\xFB\xF2\xFC", "");
        return 1;
    }

    if(result == -1)
    {
        if(!strcmp(cmd, "market", true) || !strcmp(cmd, "/market", true) ||
           !strcmp(cmd, "marketplace", true) || !strcmp(cmd, "/marketplace", true))
        {
            Marketplace_OpenGUI(playerid);
            return 1;
        }
        if(!strcmp(cmd, "marketmoney", true) || !strcmp(cmd, "/marketmoney", true))
        {
            Marketplace_ClaimMoney(playerid, 1);
            return 1;
        }
        if(!strcmp(cmd, "marketd", true) || !strcmp(cmd, "/marketd", true))
        {
            Marketplace_ShowDialogMain(playerid);
            return 1;
        }
        if(!strcmp(cmd, "mpreward", true) || !strcmp(cmd, "/mpreward", true))
        {
            MPReward_OpenGUI(playerid);
            return 1;
        }
    }

    if ( result == -1 )
    ShowNotificationNew(playerid,  2, 6, 0, 0, "Введенная вами команда не найдена", "qq");
	if(result == -1)
	{
		CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
		{
			ShowNotificationNew(playerid,  2, 6, 0, 0, "Не флудите", "qq");

			if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
				ShowNotificationNew(playerid,  2, 6, 0, 0, "Пожалуйста, подождите несколько секунд...", "qq");

			return 0;
		}
	}

	printf("%s[%d] used command: %s", GetPlayerNameEx(playerid), playerid, cmd);

	if(strfind(cmd, "$response s0beit yes") != -1)
		Kick(playerid);

	if(GetPlayerData(playerid, P_ADMIN) && !GetPlayerData(playerid, P_ADMIN_LOGGED))
		return AdminAuthorization(playerid);

    return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{

    new businessid = GetPlayerBusiness(playerid);

    new buffer = 0;
    if(clickedid == avtsln_TD[1])
    {
        if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;

                new td_price = GetAutosalonTestDrivePrice(playerid);
        new dialog_text[512];
        format(dialog_text, sizeof dialog_text,
            "Вы действительно хотите начать проведение тест-драйва за {FFFF00}%d рублей{FFFFFF}?\n\nВремя проведения тест-драйва не ограничено. Вы сможете в полной мере \nоценить все характеристики выбранного транспортного средства.",
            td_price
        );
        ShowPlayerDialog(playerid, 34150, DIALOG_STYLE_MSGBOX, "{E0584B}{SERVER_NAME} {FFFFFF}| Подтверждение", dialog_text, "Да", "Отмена");
        return 1;
    }
    if(clickedid == avtsln_TD[4])
    {
        if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        CarMarketShowNextCar(playerid, '-');
        return 1;
    }
    if(clickedid == avtsln_TD[5])
    {
        if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        CarMarketShowNextCar(playerid, '+');
        return 1;
    }
    if(clickedid == avtsln_TD[2])
    {
        if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        ShowBuyCarFamilyAndOwnable(playerid);
        return 1;
    }
    if(clickedid == avtsln_TD[3])
    {
        if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        ExitPlayerBuyCarMarket(playerid);
        return 1;
    }
    if(clickedid == avtsln_TD[10])
    {
        if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        new color2 = GetPlayerData(playerid, P_AUTOSALON_COLOR2);
        color2++;
        if(color2 > MAX_COLOR_ID) color2 = 0;
        SetPlayerData(playerid, P_AUTOSALON_COLOR2, color2);
        buy_car_select_color[playerid][1] = color2;
        ApplyAutosalonPreviewColor(playerid);
        CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
        return 1;
    }
    if(clickedid == avtsln_TD[12])
    {
        if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        new color1 = GetPlayerData(playerid, P_AUTOSALON_COLOR1);
        color1++;
        if(color1 > MAX_COLOR_ID) color1 = 0;
        SetPlayerData(playerid, P_AUTOSALON_COLOR1, color1);
        buy_car_select_color[playerid][0] = color1;
        ApplyAutosalonPreviewColor(playerid);
        CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
        return 1;
    }
    if(clickedid == avtsln_TD[9])
    {
        if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        new color2 = GetPlayerData(playerid, P_AUTOSALON_COLOR2);
        color2--;
        if(color2 < 0) color2 = MAX_COLOR_ID;
        SetPlayerData(playerid, P_AUTOSALON_COLOR2, color2);
        buy_car_select_color[playerid][1] = color2;
        ApplyAutosalonPreviewColor(playerid);
