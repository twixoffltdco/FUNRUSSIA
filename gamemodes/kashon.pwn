Dialog_Response:TaxiPark_TMenuFire(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenManage(playerid, park_id);
	new target = -1;
	if(IsNumeric(inputtext))
	{
		target = strval(inputtext);
		if(!IsPlayerConnected(target)) target = -1;
	}
	else
	{
		for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
		{
			if(!IsPlayerConnected(i)) continue;
			new name[24];
			GetPlayerName(i, name, sizeof name);
			if(!strcmp(name, inputtext, true))
			{
				target = i;
				break;
			}
		}
	}
	if(target == -1 || TaxiPark_GetPlayerJob(target) != park_id)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Данного игрока нет в списке работников таксопарка", "");
		return TaxiPark_OpenManage(playerid, park_id);
	}
	if(target == playerid)
	{
		ShowNotificationNew(playerid, 2, 4, 0, 0, "Нельзя уволить самого себя", "");
		return TaxiPark_OpenManage(playerid, park_id);
	}
	new tname[24], msg[96];
	GetPlayerName(target, tname, sizeof tname);
	TaxiPark_DestroyPlayerVehicle(target);
	TaxiPark_CancelPlayerOrder(target);
	TaxiPark_RemovePlayerJob(target);
	format(msg, sizeof msg, "%s %s", "Вы успешно уволили игрока", tname);
	ShowNotificationNew(playerid, 3, 5, 0, 0, msg, "");
	ShowNotificationNew(target, 2, 5, 0, 0, "Вас уволили из таксопарка", "");
	return TaxiPark_OpenManage(playerid, park_id);
}

stock TaxiPark_OpenFinanceStats(playerid, park_id)
{
	new biz = g_TaxiParkBizID[park_id];
	if(biz < 0)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Бизнес не привязан", "");
		return TaxiPark_OpenManage(playerid, park_id);
	}
	new sql_id = GetBusinessData(biz, B_SQL_ID);
	new query[256];
	new time = gettime();
	new cur_day = time - (time % 86400);
	new start_day = cur_day - (86400 * 20);
	mysql_format(mysql, query, sizeof query,
		"SELECT FROM_UNIXTIME(time, '%%Y-%%m-%%d') AS date, SUM(money) as total FROM business_profit WHERE bid=%d AND view=1 AND time>=%d AND time<=%d GROUP BY date ORDER BY date DESC LIMIT 20",
		sql_id, start_day, time);
	mysql_tquery(mysql, query, "TaxiPark_OnFinanceStats", "ii", playerid, park_id);
	return 1;
}

forward TaxiPark_OnFinanceStats(playerid, park_id);
public TaxiPark_OnFinanceStats(playerid, park_id)
{
	new caption[72], string[900], fmt_str[48];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", "Финансовая статистика");
	new rows = cache_num_rows();
	if(rows)
		format(string, sizeof string, "%s\t%s\n", "Дата", "Прибыль");
	else
		format(string, sizeof string, "%s", "Финансовая статистика Вашего таксопарка еще не сформирована");
	for(new idx = 0; idx < rows; idx++)
	{
		cache_get_row(idx, 0, fmt_str, mysql, sizeof fmt_str);
		format(string, sizeof string, "%s%s\t%d %s\n", string, fmt_str, cache_get_row_int(idx, 1), "рублей");
	}
	Dialog_Open(playerid, "TaxiPark_TMenuFinBack", DIALOG_STYLE_TABLIST_HEADERS, caption, string, "Назад", "");
	return 1;
}

