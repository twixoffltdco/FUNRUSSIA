Dialog_Response:TaxiPark_TMenuUpgBuy(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenUpgrades(playerid, park_id);
	if(!TaxiPark_IsOwner(playerid, park_id)) return TaxiPark_OpenMainMenu(playerid);
	new upg = GetPVarInt(playerid, "TaxiUpgSel");
	new cost, need_orders;
	switch(upg)
	{
		case 0: { cost = 2000000; need_orders = 300; if(g_TaxiCompany[park_id][TC_UPG_FLEET]) return ShowNotificationNew(playerid, 2, 4, 0, 0, "Уже приобретено", ""); }
		case 1: { cost = 2500000; need_orders = 500; if(g_TaxiCompany[park_id][TC_UPG_STAFF]) return ShowNotificationNew(playerid, 2, 4, 0, 0, "Уже приобретено", ""); }
		case 2: { cost = 1000000; need_orders = 1000; if(g_TaxiCompany[park_id][TC_UPG_SAFE]) return ShowNotificationNew(playerid, 2, 4, 0, 0, "Уже приобретено", ""); }
		case 3: { cost = 5000000; need_orders = 5000; if(g_TaxiCompany[park_id][TC_UPG_GAS]) return ShowNotificationNew(playerid, 2, 4, 0, 0, "Уже приобретено", ""); }
		case 4: { cost = 3000000; need_orders = 100; if(g_TaxiCompany[park_id][TC_UPG_DISP]) return ShowNotificationNew(playerid, 2, 4, 0, 0, "Уже приобретено", ""); }
		default: { cost = 7000000; need_orders = 350; if(g_TaxiCompany[park_id][TC_UPG_BOOST_CD]) return ShowNotificationNew(playerid, 2, 4, 0, 0, "Уже приобретено", ""); }
	}
	if(g_TaxiCompany[park_id][TC_BALANCE] < cost)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Недостаточно средств в сейфе компании", "");
		return TaxiPark_OpenUpgrades(playerid, park_id);
	}
	if(g_TaxiCompany[park_id][TC_ORDERS] < need_orders)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Недостаточно выполненных заказов компании", "");
		return TaxiPark_OpenUpgrades(playerid, park_id);
	}
	g_TaxiCompany[park_id][TC_BALANCE] -= cost;
	g_TaxiCompany[park_id][TC_ORDERS] -= need_orders;
	if(upg == 0) { g_TaxiCompany[park_id][TC_UPG_FLEET] = 1; g_TaxiCompany[park_id][TC_CARS] = TAXI_COMPANY_CARS_UPG; }
	else if(upg == 1) g_TaxiCompany[park_id][TC_UPG_STAFF] = 1;
	else if(upg == 2) g_TaxiCompany[park_id][TC_UPG_SAFE] = 1;
	else if(upg == 3) g_TaxiCompany[park_id][TC_UPG_GAS] = 1;
	else if(upg == 4) g_TaxiCompany[park_id][TC_UPG_DISP] = 1;
	else g_TaxiCompany[park_id][TC_UPG_BOOST_CD] = 1;
	TaxiPark_SaveCompany(park_id);
	ShowNotificationNew(playerid, 3, 5, 0, 0, "Улучшение успешно приобретено", "");
	return TaxiPark_OpenUpgrades(playerid, park_id);
}

