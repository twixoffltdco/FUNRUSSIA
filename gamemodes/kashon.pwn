                case 0: return 2;
                case 1: return 3;
                case 2: return 1;
                case 3: return 4;
                case 4: return 2;
                case 5: return 1;
            }
        }
        case 20:
        {
            switch (indexid)
            {
                case 0: return 1;
                case 1: return 3;
            }
        }
        case 21:
        {
            switch (indexid)
            {
                case 0: return 3;
                case 1: return 1;
                case 2: return 4;
                case 3: return 3;
                case 4: return 1;
                case 5: return 2;
                case 6: return 4;
                case 7: return 3;
                case 8: return 1;
                case 9: return 2;
                case 10: return 4;
            }
        }
        case 22:
        {
            switch (indexid)
            {
                case 0: return 3;
                case 1: return 1;
                case 2: return 2;
                case 3: return 4;
                case 4: return 3;
                case 5: return 3;
                case 6: return 1;
                case 7: return 2;
                case 8: return 4;
                case 9: return 1;
            }
        }
        case 23:
        {
            switch (indexid)
            {
                case 0: return 2;
                case 1: return 3;
                case 2: return 1;
                case 3: return 4;
                case 4: return 2;
                case 5: return 1;
            }
        }
        case 24:
        {
            switch (indexid)
            {
                case 0: return 1;
                case 1: return 3;
            }
        }
        case 25:
        {
            switch (indexid)
            {
                case 0: return 4;
                case 1: return 2;
                case 2: return 3;
                case 3: return 1;
                case 4: return 2;
                case 5: return 3;
                case 6: return 4;
                case 7: return 2;
                case 8: return 1;
                case 9: return 3;
                case 10: return 1;
                case 11: return 4;
                case 12: return 2;
            }
        }
    }

    return 0;
}


stock FracTestAnswerkmonarch(playerid, answerid)
{
    new total = fractesttotal[playerid];

    if (total <= 0)
    {
        total = FracTestCountkmonarch(fractestdoc[playerid]);
        fractesttotal[playerid] = total;
    }

    if (total <= 0)
    {
        return Fractestresultkmonarch(playerid, 0, 0, 1);
    }

    new indexid = fractestpos[playerid];
    new correct = FracTestCorrectkmonarch(fractestdoc[playerid], indexid);

    if (answerid == correct)
    {
        fractestok[playerid]++;
    }

    fractestpos[playerid]++;

    if (fractestpos[playerid] >= total)
    {
        new passed = fractestok[playerid] == total ? 1 : 0;
        new right = fractestok[playerid];

        fractestdoc[playerid] = 0;
        fractestpos[playerid] = 0;
        fractestok[playerid] = 0;
        fractesttotal[playerid] = 0;

        return Fractestresultkmonarch(playerid, passed, right, total);
    }

    return 1;
}
stock Fractestresultkmonarch(playerid, positive = 1, total = 1, questions = 1)
{
    format
    (
        fracpayload,
        sizeof(fracpayload),
        "{\"page\":6,\"testing_result\":%d,\"testing_total\":%d,\"question_total\":%d}",
        positive,
        total,
        questions
    );
    Fracsendkmonarch(playerid, fracpayload);
    return 1;
}

stock Fracbuydialogkmonarch(playerid, bcvalue = 0)
{
    format(fracpayload, sizeof(fracpayload), "{\"page\":7,\"type\":2,\"bc_value\":%d,\"token_price\":0}", bcvalue);
    Fracsendkmonarch(playerid, fracpayload);
    return 1;
}

stock Fracrewardkmonarch(playerid)
{
    if (GetPlayerJob(playerid) < 10)
    {
        return Fracnotifykmonarch(playerid, 4601, "Доступно только лидеру");
    }

    return Fracnotifykmonarch(playerid, 4602, "Лидер назначается через /setleader");
}

stock Fracdocsetkmonarch(playerid, docid, docnum)
{
    new query[256];
    new teamid = GetPlayerTeamEx(playerid);

    fractestdoc[playerid] = docid;
    fractestpos[playerid] = 0;
    fractestok[playerid] = 0;
    fractesttotal[playerid] = FracTestCountkmonarch(docid);
    Fracensurekmonarch();

    mysql_format
    (
        mysql,
        query,
        sizeof(query),
        "INSERT INTO `fraction_documents` (`uid`,`fraction_id`,`document_id`,`document_number`,`acquainted`) VALUES (%d,%d,%d,%d,1) \
        ON DUPLICATE KEY UPDATE `document_id`=%d,`acquainted`=1",
        GetPlayerAccountID(playerid),
        teamid,
        docid,
        docnum,
        docid
    );
    mysql_query(mysql, query, false);
    format(fracpayload, sizeof(fracpayload), "{\"page\":5}");
    Fracsendkmonarch(playerid, fracpayload);
    return 1;
}

stock Fracactkmonarch(playerid, actionid, changeid)
{
    new uid = fracchosen[playerid];

    if (uid <= 0)
    {
        return 1;
    }

    new query[224];
    new teamid = GetPlayerTeamEx(playerid);

    mysql_format
    (
        mysql,
        query,
        sizeof(query),
        "SELECT `id`,`name`,`job`,`owarn`,`phone`,`level`,`org_skin`,`sex`,`team` FROM `accounts` WHERE `id`=%d AND `team`=%d LIMIT 1",
        uid,
        teamid
    );
    mysql_tquery(mysql, query, "Fracplayeract", "ddddd", playerid, uid, actionid, changeid, teamid);
    return 1;
}

stock Fracopenkmonarch(playerid)
{
    new teamid = GetPlayerTeamEx(playerid);

    if (teamid < 1 || teamid >= MAX_ORG)
    {
        return Fracnotifykmonarch(playerid, 4600, "Вы не состоите во фракции");
    }

    if (!Fracfractionidkmonarch(teamid))
    {
        return Fracnotifykmonarch(playerid, 4610, "Меню доступно только для гос. фракций");
    }

    fracchosen[playerid] = 0;
    Fracmainkmonarch(playerid, 1);
    return 1;
}

stock FracHandlekmonarch(playerid, const data[])
{
    new pageid;
    new buttonid;
    new changeid;
    new uid;
    new docid;
    new docnum;
    new typeid;
    new amount;

    if (!Fracintkmonarch(data, "page", pageid))
    {
        return 1;
    }

    Fracintkmonarch(data, "button", buttonid);
    Fracintkmonarch(data, "type", typeid);

    switch (buttonid)
    {
        case 1: return 1;
        case 3: return Fracshopkmonarch(playerid);
        case 4: return Fraccontrolkmonarch(playerid);
        case 5: return Fracdocskmonarch(playerid);
        case 6: return Fracquestkmonarch(playerid);
        case 7: return Fracrewardkmonarch(playerid);
        case 8: return Fracmainkmonarch(playerid);
        case 9:
        {
            if (pageid == 4)
            {
                if (Fracintkmonarch(data, "document_id", docid) && Fracintkmonarch(data, "document_number", docnum))
                {
                    return Fracdocsetkmonarch(playerid, docid, docnum);
                }
            }
            return 1;
        }
        case 10:
        {
            return Fracnotifykmonarch(playerid, 4603, "Квесты в разработке");
        }
        case 11: return Fracmainkmonarch(playerid);
        case 12: return Fracdocskmonarch(playerid);
        case 13:
        {
            new answerid;
            Fracintkmonarch(data, "answer_id", answerid);
            return FracTestAnswerkmonarch(playerid, answerid);
        }
        case 14:
        {
            if (pageid == 7)
            {
                Fracnotifykmonarch(playerid, 4604, "Покупка токенов в разработке");
            }
            return 1;
        }
        case 15:
        {
            if (Fracintkmonarch(data, "account_id", uid))
            {
                return Fracplayerkmonarch(playerid, uid);
            }
            return 1;
        }
        case 16:
        {
            Fracintkmonarch(data, "change", changeid);
            return Fracactkmonarch(playerid, 16, changeid);
        }
        case 17:
        {
            Fracintkmonarch(data, "change", changeid);
            return Fracactkmonarch(playerid, 17, changeid);
        }
        case 18: return Fracactkmonarch(playerid, 18, 0);
        case 20:
        {
            return Fracnotifykmonarch(playerid, 4605, "Магазин фракции в разработке");
        }
        case 21: return 1;
    }

    if (pageid == 7 && typeid == 1 && Fracintkmonarch(data, "token_amount", amount))
    {
        if (amount < 0)
        {
            amount = 0;
        }
        return Fracbuydialogkmonarch(playerid, amount);
    }

    return 1;
}

public Fracdocsload(playerid, teamid)
{
    #pragma unused teamid

    for (new i = 0; i < FRACDOCMAX; i++)
    {
        fracdocs[i] = 0;
    }

    for (new row = 0; row < cache_num_rows(); row++)
    {
        new num = cache_get_field_content_int(row, "document_number");
        if (num >= 0 && num < FRACDOCMAX)
        {
            fracdocs[num] = cache_get_field_content_int(row, "acquainted") ? 1 : 0;
        }
    }

    format(fracpayload, sizeof(fracpayload), "{\"page\":4,\"document_status\":[");

    for (new i = 0; i < FRACDOCMAX; i++)
    {
        format(fracpiece, sizeof(fracpiece), "%s%d", i ? "," : "", fracdocs[i]);
        strcat(fracpayload, fracpiece, sizeof(fracpayload));
    }

    strcat(fracpayload, "]}", sizeof(fracpayload));
    Fracsendkmonarch(playerid, fracpayload);
    return 1;
}

public Fracctrlload(playerid, teamid)
{
    fracnp[0] = '\0';
    fracrs[0] = '\0';

    strcat(fracnp, "[", sizeof(fracnp));
    strcat(fracrs, "[", sizeof(fracrs));

    for (new row = 0; row < cache_num_rows(); row++)
    {
        new uid = cache_get_field_content_int(row, "id");
        new rankid = cache_get_field_content_int(row, "job");
        new online = Fraconlinekmonarch(uid) ? 1 : 0;

        cache_get_field_content(row, "name", fracname, mysql, sizeof(fracname));
        Fracesckmonarch(fracname, fracescaped, sizeof(fracescaped));

        format(fracpiece, sizeof(fracpiece), "%s\"%s\"", row ? "," : "", fracescaped);
        strcat(fracnp, fracpiece, sizeof(fracnp));

        format(fracpiece, sizeof(fracpiece), "%s%d,%d,%d", row ? "," : "", uid, rankid, online);
        strcat(fracrs, fracpiece, sizeof(fracrs));
    }

    strcat(fracnp, "]", sizeof(fracnp));
    strcat(fracrs, "]", sizeof(fracrs));

    format
    (
        fracpayload,
        sizeof(fracpayload),
        "{\"t\":4,\"page\":9,\"type\":1,\"np\":%s,\"rs\":%s}",
        fracnp,
        fracrs
    );
    Fracsendkmonarch(playerid, fracpayload);

    if (cache_num_rows() > 0)
    {
        fracchosen[playerid] = cache_get_field_content_int(0, "id");
        Fracplayerkmonarch(playerid, fracchosen[playerid]);
    }

    #pragma unused teamid
    return 1;
}

public Fracplayerdb(playerid, uid, teamid)
{
    if (!cache_num_rows())
    {
        return 1;
    }

    new rankid = cache_get_field_content_int(0, "job");
    new skinid = cache_get_field_content_int(0, "org_skin");
    new levelid = cache_get_field_content_int(0, "level");
    new owarn = cache_get_field_content_int(0, "owarn");
    new phone = cache_get_field_content_int(0, "phone");

    cache_get_field_content(0, "name", fracname, mysql, sizeof(fracname));
    Fracesckmonarch(fracname, fracescaped, sizeof(fracescaped));
    Fracranknamekmonarch(teamid, rankid, fracname, sizeof(fracname));
    Fracesckmonarch(fracname, fracpiece, sizeof(fracpiece));

    format
    (
        fracpayload,
        sizeof(fracpayload),
        "{\"page\":9,\"type\":2,\"nickname\":\"%s\",\"skin_id\":%d,\"level\":%d,\"rank_name\":\"%s\",\"rank\":%d,\"reprimand\":%d,\"phone\":\"%d\"}",
        fracescaped,
        skinid,
        levelid,
        fracpiece,
        rankid,
        owarn,
        phone
    );
    Fracsendkmonarch(playerid, fracpayload);

    #pragma unused uid
    return 1;
}

public Fracplayeract(playerid, uid, actionid, changeid, teamid)
{
    if (!cache_num_rows())
    {
        return 1;
    }

    if (GetPlayerJob(playerid) < 10)
    {
        return Fracnotifykmonarch(playerid, 4606, "Действие доступно только лидеру");
    }

    new rankid = cache_get_field_content_int(0, "job");
    new owarn = cache_get_field_content_int(0, "owarn");
    new target = Fracuidkmonarch(uid);

    if (rankid >= 10)
    {
        return Fracnotifykmonarch(playerid, 4607, "Нельзя изменять лидера");
    }

    switch (actionid)
    {
        case 16:
        {
            new newrank = rankid;
            new sexid = cache_get_field_content_int(0, "sex");
            new skinid;

            if (changeid == 1)
            {
                if (newrank >= 9)
                {
                    return Fracnotifykmonarch(playerid, 4608, "Максимальный ранг 9");
                }
                newrank++;
            }
            else
            {
                if (newrank <= 1)
                {
                    return Fracnotifykmonarch(playerid, 4609, "Минимальный ранг 1");
                }
                newrank--;
            }

            if (!sexid)
            {
                skinid = GetTeamData(teamid, O_SKINS)[newrank - 1];
            }
            else
            {
                skinid = GetTeamData(teamid, O_WOMEN_SKIN);
            }

            format(fracpayload, sizeof(fracpayload), "UPDATE accounts SET job=%d,org_skin=%d WHERE id=%d", newrank, skinid, uid);
            mysql_query(mysql, fracpayload, false);

            if (target != INVALID_PLAYER_ID)
            {
                SetPlayerData(target, P_JOB, newrank);

                if (!GetPlayerSex(target))
                {
                    SetPlayerData(target, P_OSKIN, GetTeamData(teamid, O_SKINS)[newrank - 1]);
                }
                else
                {
                    SetPlayerData(target, P_OSKIN, GetTeamData(teamid, O_WOMEN_SKIN));
                }

                ResetSkin(target);
            }

            Fracranknamekmonarch(teamid, newrank, fracname, sizeof(fracname));
            Fracesckmonarch(fracname, fracescaped, sizeof(fracescaped));

            format
            (
                fracpayload,
                sizeof(fracpayload),
                "{\"page\":9,\"type\":3,\"new_rank\":%d,\"new_rank_name\":\"%s\"}",
                newrank,
                fracescaped
            );
            Fracsendkmonarch(playerid, fracpayload);
            return 1;
        }
        case 17:
        {
            new newwarn = owarn;

            if (changeid == 1)
            {
                newwarn++;
            }
            else if (newwarn > 0)
            {
                newwarn--;
            }

            if (newwarn >= 3)
            {
                if (target != INVALID_PLAYER_ID)
                {
                    SetPlayerData(target, P_OWARN, 0);
                    InvitePlayer(target, 0, 0, true);
                }
                else
                {
                    format(fracpayload, sizeof(fracpayload), "UPDATE accounts SET owarn=0,team=0,job=0,org_skin=0 WHERE id=%d", uid);
                    mysql_query(mysql, fracpayload, false);
                }

                fracchosen[playerid] = 0;
                format(fracpayload, sizeof(fracpayload), "{\"page\":9,\"type\":5,\"dismissed_account_id\":%d}", uid);
                Fracsendkmonarch(playerid, fracpayload);
                return 1;
            }

            format(fracpayload, sizeof(fracpayload), "UPDATE accounts SET owarn=%d WHERE id=%d", newwarn, uid);
            mysql_query(mysql, fracpayload, false);

            if (target != INVALID_PLAYER_ID)
            {
                SetPlayerData(target, P_OWARN, newwarn);
            }

            format
            (
                fracpayload,
                sizeof(fracpayload),
                "{\"page\":9,\"type\":4,\"reprimand\":%d}",
                newwarn
            );
            Fracsendkmonarch(playerid, fracpayload);
            return 1;
        }
        case 18:
        {
            if (target != INVALID_PLAYER_ID)
            {
                UnInvite(playerid, target, "GUI");
            }
            else
            {
                format(fracpayload, sizeof(fracpayload), "UPDATE accounts SET owarn=0,team=0,job=0,org_skin=0 WHERE id=%d", uid);
                mysql_query(mysql, fracpayload, false);
            }

            fracchosen[playerid] = 0;
            format(fracpayload, sizeof(fracpayload), "{\"page\":9,\"type\":5,\"dismissed_account_id\":%d}", uid);
            Fracsendkmonarch(playerid, fracpayload);
            return 1;
        }
    }

    return 1;
}

IPacket:252(playerid, BitStream:bitstream)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid)) return 0;

    new
        header,
        rpcid,
        data[512],
        outcoming_data[512],
        JSON:json,
        JSON:json_packet_data = JSON_Object(),
        JSON:JSONObject = JSON_Object();

    BS_ReadValue(bitstream, PR_UINT8, header);
    BS_ReadValue(bitstream, PR_UINT16, rpcid);

    if(rpcid == 115)
    {
        new bool:take_damage;
        new targetid;
        new Float:damage;
        new weaponid;
        new bodypart;

        if(!BS_ReadBool(bitstream, take_damage)) return 1;
        if(!BS_ReadUint16(bitstream, targetid)) return 1;
        if(!BS_ReadFloat(bitstream, damage)) return 1;
        if(!BS_ReadUint32(bitstream, weaponid)) return 1;
        if(!BS_ReadUint32(bitstream, bodypart)) return 1;

        DamageRpc_Handle115(playerid, take_damage, targetid, damage, weaponid, bodypart);
        return 1;
    }
if (rpcid == 111){
	return 1;
}
    #if defined STABILITY_DEBUG_GUI
    printf("[GUI] player=%d header=%d rpc=%d", playerid, header, rpcid);
    #endif

    new length;
    new packet_unread_bits;
    BS_GetNumberOfUnreadBits(bitstream, packet_unread_bits);
    if(packet_unread_bits < 32)
    {
        JSON_Cleanup(json_packet_data);
        JSON_Cleanup(JSONObject);
        return 0;
    }
    BS_ReadValue(bitstream, PR_UINT32, length);
    new auth_unread_bits;
    if(rpcid == 38) BS_GetNumberOfUnreadBits(bitstream, auth_unread_bits);
    if(rpcid == 38 && (length < 2 || length >= sizeof data || auth_unread_bits < length * 8))
    {
        JSON_Cleanup(json_packet_data);
        JSON_Cleanup(JSONObject);
        printf("[AUTH][ERROR] player=%d invalid_packet_length=%d", playerid, length);
        return 0;
    }

    BS_GetNumberOfUnreadBits(bitstream, packet_unread_bits);
    if(length < 2 || length >= sizeof data || packet_unread_bits / 8 < length)
    {
        JSON_Cleanup(json_packet_data);
        JSON_Cleanup(JSONObject);
        return 0;
    }
    BS_ReadValue(bitstream, PR_STRING, data, length);
    data[length] = EOS;

    #if defined STABILITY_DEBUG_GUI
    if(rpcid != 38) printf("[GUI] rpc=%d bytes=%d", rpcid, length);
    #endif

    JSON_Parse(data, json);

    switch(rpcid)
    {
       case FRACGUIID:
       {
            return FracHandlekmonarch(playerid, data);
       }
       case 71:
       {
            return Calendar_HandlePacket(playerid, json);
       }
       case 112:
       {
            return Radio_HandlePacket(playerid, json);
       }
       case 39, 65:
       {
            return BlackPass_HandleExtraGui(playerid, rpcid, json);
       }
       case BrDialogDiner:
       {
            return Larek_HandleJsonPacket(playerid, json);
       }
       case GUIWoundSystem:
       {
            return WoundHandle(playerid, json);
       }
       case 125:
       {
            return ContNewSystem_HandlePacket(playerid, json);
       }
        case 113:
{
    new type;

    if (JSON_GetInt(json, "a", type)) {
        printf("[RPC 113] Получен параметр type = %d из поля 'a'", type);
    }

    else if (JSON_GetInt(json, "c", type)) {
        printf("[RPC 113] Получен параметр type = %d из поля 'c'", type);

        if (type == 1) {
            printf("[RPC 113] Игрок %d закрыл интерфейс", playerid);
            return 1;
        }
    }
					else {
        printf("[RPC 113] Не найден параметр type в полях 'a' или 'c'");
        return 1;
    }

    switch (type) {
        case 2:
        {
            new JSON:root = JSON_Object();
            ShowPlayerGUI(playerid, 47, root);
            JSON_Cleanup(root);
        }
        case 3:  ShowNotificationNew(playerid, 2, 6, 0, 0, "Уведомление не найдены", "qq");
        case 4:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 5:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 100: Marketplace_OpenGUI(playerid);
        case 8:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 12: animsss(playerid);
        case 13: donatess(playerid);
        case 18: Calendar_Open(playerid);
        case 19: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 22: rewardsss(playerid);
        case 11: inssssv(playerid);
        case 21: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 15: promosss(playerid);
        case 14: carssssc(playerid);
        case 7:  gpswww(playerid);
        case 17: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 25: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 20: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 9:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 24: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 16: sssreport(playerid);
        default: printf("[RPC 113] Неизвестный тип: %d", type);
    }

    return 1;
}

case 45:
{
    return FamilyGuiHandlePacket(playerid, json);
}

	case GUIFuelFill:
	{
		if(Fuel_HandleGuiPacket(playerid, json))
		{
			return 1;
		}
		return 0;
	}

	case 9:
{
    return Music_OnAudioGuiPacket(playerid, json);
}

	case TaxiFragment:
{
    new t, b;
    JSON_GetInt(json, "t", t);
    JSON_GetInt(json, "b", b);
    switch(t)
    {
        case 0:
        {
            switch(b)
            {
                case 0: TaxiPark_OnTaxiGUI(playerid, 2, 0, 0);
                case 1: TaxiPark_OnTaxiGUI(playerid, 3, 0, 0);
                case 2: TaxiPark_OnTaxiGUI(playerid, 4, 0, 0);
            }
        }
    }
    return 1;
}

case TaxiOrderFragment:
{
    new t;
    JSON_GetInt(json, "t", t);
    switch(t)
    {
        case 0:
        {
            new order_company, order_rate, order_payment, order_price;
            new Float: order_x, Float: order_y;
            new order_comment[128];
            JSON_GetInt(json, "c", order_company);
            JSON_GetInt(json, "r", order_rate);
            if(JSON_GetInt(json, "p", order_payment) == 0)
                JSON_GetInt(json, "pay", order_payment);
            JSON_GetInt(json, "ma", order_price);
            JSON_GetFloat(json, "x", order_x);
            JSON_GetFloat(json, "y", order_y);
            JSON_GetString(json, "co", order_comment, sizeof(order_comment));
            TaxiPark_OnClientOrder(playerid, order_company, order_rate, order_payment,
                order_x, order_y, order_price, order_comment);
        }
        case 1: TaxiPark_CancelPlayerOrder(playerid);
        case 2: TaxiPark_OpenDestDialog(playerid);
    }
    return 1;
}

case 25:
{
    new type;
    JSON_GetInt(json, "t", type);

    printf("[CASE 25] Получен пакет типа %d от игрока %d", type, playerid);

    switch(type)
    {
        case 1:
        {
            printf("[CASE 25][TYPE 1] Запрос обновления списка игроков от %d", playerid);

            new JSON:response = JSON_Object();

            new JSON:playersArray = JSON_Array();
            new playerIndex = 0;

            foreach(new i : Player)
            {
                if(!IsPlayerConnected(i)) continue;

                new JSON:playerObj = JSON_Object();
                JSON_SetInt(playerObj, "id", i);

                new name[MAX_PLAYER_NAME];
                GetPlayerName(i, name, sizeof(name));
                JSON_SetString(playerObj, "nick", name);

                JSON_SetInt(playerObj, "level", GetPlayerData(i, P_LEVEL));
                JSON_SetInt(playerObj, "ping", GetPlayerPing(i));

                JSON_ArrayAppend(playersArray, "", playerObj);

                JSON_Cleanup(playerObj);
                playerIndex++;

                printf("[CASE 25][TYPE 1] Добавлен игрок %d: %s", i, name);
            }

            printf("[CASE 25][TYPE 1] Всего добавлено игроков: %d", playerIndex);

            JSON_SetInt(response, "t", 1);
            JSON_SetArray(response, "data", playersArray);

            new jsonString[4096];
            JSON_Stringify(response, jsonString, sizeof(jsonString));
            printf("[CASE 25][TYPE 1] JSON ответ (первые 200 символов): %.200s", jsonString);

            OnPacketIncoming(playerid, 25, response);

            JSON_Cleanup(playersArray);
            JSON_Cleanup(response);

            return 1;
        }

        case 2:
        {
            printf("[CASE 25][TYPE 2] Игрок %d закрыл окно", playerid);
            return 1;
        }

        default:
        {
            printf("[CASE 25][ERROR] Неизвестный тип пакета: %d от игрока %d", type, playerid);
            return 0;
        }
    }
}

        case 34:
        {
            new type = -1;
            JSON_GetInt(json, "t", type);            if(type == 8)
            {
// Do not drop vehicle context here: client can send t=8 during internal GUI refresh.
                printf("[TRUNKTEST] close gui: player=%d vehicle=%d (context kept)", playerid, GetPVarInt(playerid, PVAR_TRUNKTEST_VEHICLE));
                return 1;
            }

            if(type == 3 || type == 4 || type == 5 || type == 6 || type == 7)
            {
                printf("[TRUNKTEST] menu action: player=%d type=%d", playerid, type);
                return 1;
            }

                        new vehicleid = GetPVarInt(playerid, PVAR_TRUNKTEST_VEHICLE);
            if(vehicleid == 0 || vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
            {
                new restore_vehicle = INVALID_VEHICLE_ID;
                if(TrunkTest_GetNearbyPersonalVehicle(playerid, restore_vehicle, 7.0) && TrunkTest_IsPlayerNearVehicleRear(playerid, restore_vehicle, 3.0))
                {
                    vehicleid = restore_vehicle;
                    SetPVarInt(playerid, PVAR_TRUNKTEST_VEHICLE, vehicleid);
                    printf("[TRUNKTEST] restored vehicle context: player=%d type=%d vehicle=%d", playerid, type, vehicleid);
                }
            }

            if(vehicleid == 0 || vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
            {
                printf("[TRUNKTEST][ERROR] packet without active vehicle: player=%d type=%d vehicle=%d", playerid, type, vehicleid);

                new JSON:resp_no_vehicle = JSON_Object();
                JSON_SetInt(resp_no_vehicle, "t", type);
                JSON_SetInt(resp_no_vehicle, "s", 0);
                OnPacketIncoming(playerid, 34, resp_no_vehicle);
                JSON_Cleanup(resp_no_vehicle);
                return 1;
            }

            new ga = 0, os = -1, ns = -1, value = 0;
            JSON_GetInt(json, "ga", ga);
            JSON_GetInt(json, "os", os);
            JSON_GetInt(json, "ns", ns);
            JSON_GetInt(json, "v", value);

            if(ns == -1)
            {
                JSON_GetInt(json, "s", ns);
            }

            if(type == 0 && os == 0) os = 1;
            if(type == 1 && ns == 0) ns = 1;
            if((type == 2 || type == 9) && ns == 0) ns = 1;

            new bool:ok = false;
            new JSON:resp = JSON_Object();
            JSON_SetInt(resp, "t", type);

            switch(type)
            {
                case 0:
                {
                    printf("[TRUNKTEST] type=0 request: player=%d vehicle=%d ga=%d os=%d ns=%d v=%d", playerid, vehicleid, ga, os, ns, value);
                    ok = TrunkTest_MoveInventoryToTrunk(playerid, vehicleid, ga, os, ns, value);
                    JSON_SetInt(resp, "w", Inventory11_GetCurrentWeightKg(playerid));
                    JSON_SetInt(resp, "bw", TrunkTest_GetTrunkWeightKg(vehicleid));
                }
                case 1:
                {
                    printf("[TRUNKTEST] type=1 request: player=%d vehicle=%d ga=%d os=%d ns=%d v=%d", playerid, vehicleid, ga, os, ns, value);
                    ok = TrunkTest_MoveTrunkToInventory(playerid, vehicleid, ga, os, ns, value);
                    JSON_SetInt(resp, "w", Inventory11_GetCurrentWeightKg(playerid));
                    JSON_SetInt(resp, "bw", TrunkTest_GetTrunkWeightKg(vehicleid));
                }
                case 2, 9:
                {
                    new slot_item = ga;
                    new active_slot = os;
                    new target_slot = ns;

                    ok = false;

                    if(slot_item == 134 || slot_item == 122)
                    {
                        ShowNotificationNew(playerid, 2, 6, 0, 0, "Нельзя снять одежду", " ");
                    }
					else if(!Inventory11_IsAccessoryItem(slot_item))
                    {
                        ShowNotificationNew(playerid, 2, 6, 0, 0, "Неверный аксессуар", " ");
                    }
					else
                    {
                        if(active_slot == 0)
                        {
                            active_slot = 1;
                        }

                        if(active_slot < 1 || active_slot > INVENTORY11_MAX_ACTIVE_ACCESSORIES)
                        {
                            active_slot = 1;
                        }
                            if(target_slot < 1 || target_slot > Inventory11_GetMaxSlots(playerid))
                            {
                                target_slot = TrunkTest_GetFreeInventorySlot(playerid);
                            }

                            if(target_slot == -1)
                            {
                                ShowNotificationNew(playerid, 2, 6, 0, 0, "Нету мест в инвентаре", " ");
                            }
        					else
                            {
                                new item_weight_x10 = InventoryCfg_GetItemWeightX10(slot_item);
                                if(item_weight_x10 <= 0) item_weight_x10 = 10;

                                if(Inventory11_GetCurrentWeightX10(playerid) + item_weight_x10 > (Inventory11_GetMaxWeightKg(playerid) * 10))
                                {
                                    ShowNotificationNew(playerid, 2, 6, 0, 0, "Нету мест в инвентаре", " ");
                                }
            					else
                                {
                                    new moved_model = 0;
                                    new used_slot = active_slot;
                                    if(Inventory11_MoveActiveAccessoryToInventorySlot(playerid, slot_item, used_slot, target_slot, moved_model))
                                    {
                                        ok = true;
                                    }
                                    else
                                    {
                                        for(new candidate_slot = 1; candidate_slot <= INVENTORY11_MAX_ACTIVE_ACCESSORIES; candidate_slot++)
                                        {
                                            if(candidate_slot == used_slot) continue;
                                            if(!Inventory11_MoveActiveAccessoryToInventorySlot(playerid, slot_item, candidate_slot, target_slot, moved_model)) continue;
                                            used_slot = candidate_slot;
                                            ok = true;
                                            break;
                                        }
                                    }

                                    if(!ok)
                                    {
                                        ShowNotificationNew(playerid, 2, 6, 0, 0, "Аксессуар не надет", " ");
                                    }
                                    else
                                    {
                                        JSON_SetInt(resp, "w", Inventory11_GetCurrentWeightKg(playerid));
                                        JSON_SetInt(resp, "bw", TrunkTest_GetTrunkWeightKg(vehicleid));
                                    }
                                }
                            }
                        }
                    }
                default:
                {
                    printf("[TRUNKTEST][WARN] unknown action: player=%d type=%d ga=%d os=%d ns=%d v=%d", playerid, type, ga, os, ns, value);
                    ok = false;
                }
            }

            JSON_SetInt(resp, "s", ok ? 1 : 0);
            OnPacketIncoming(playerid, 34, resp);
            JSON_Cleanup(resp);

            if(ok)
            {
                TrunkTest_OpenGui(playerid, vehicleid);
            }
            return 1;
        }
