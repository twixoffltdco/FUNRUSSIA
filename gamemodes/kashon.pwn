stock FamilyBattle_DisableAgm(playerid)
{
    // Admin immortality makes a fighter undamageable and unkillable, which breaks the battle.
    if(!GetPVarInt(playerid, "agm")) return 0;
    SetPVarInt(playerid, "agm", 0);
    SetPlayerData(playerid, P_HEALTH, 100.0);
    SetPlayerHealth(playerid, 100.0);
    SendClientMessage(playerid, 0xFFCC00FF, "Административное бессмертие отключено на время Битвы семей.");
    return 1;
}

// The server marks the killer in PVars when server-side HP hits 0 (ApplyServerPlayerDamage), because
// the client then reports OnPlayerDeath with killerid=INVALID/reason=255. Resolve it here, otherwise
// the battle branch (which returns early) never sees the killer and no kill points are given.
stock FamilyBattle_ResolveKiller(playerid, &killerid, &reason)
{
    new death_tick = GetTickCount();
    new pending_killer_raw = GetPVarInt(playerid, "server_death_killer");
    new pending_kill_tick = GetPVarInt(playerid, "server_death_tick");
    if(pending_killer_raw > 0 &&
       (killerid == INVALID_PLAYER_ID || killerid == playerid) &&
       death_tick - pending_kill_tick >= 0 && death_tick - pending_kill_tick <= 3000)
    {
        new pending_killer = pending_killer_raw - 1;
        if(pending_killer >= 0 && pending_killer < MAX_PLAYERS &&
           pending_killer != playerid && IsPlayerConnected(pending_killer))
        {
            killerid = pending_killer;
            reason = GetPVarInt(playerid, "server_death_weapon");
        }
    }
    DeletePVar(playerid, "server_death_killer");
    DeletePVar(playerid, "server_death_weapon");
    DeletePVar(playerid, "server_death_tick");
    return 1;
}

// Returns 1 if a respawn was started now, 0 if this is a duplicate death event of the same death.
stock FamilyBattle_QueueRespawn(playerid)
{
    new now_tick = GetTickCount();
    new since_last = now_tick - GetPVarInt(playerid, "fb_respawn_tick");
    if(since_last >= 0 && since_last < 1500)
    {
        printf("[FAMILY_BATTLE][DEATH] player=%d duplicate death ignored dt=%d", playerid, since_last);
        return 0;
    }

    SetPVarInt(playerid, "fb_respawn_pending", 1);
    SetPVarInt(playerid, "fb_respawn_tick", now_tick);
    if(g_wound_active[playerid]) SetPVarInt(playerid, "fb_cam_reset", 1);

    // Death must never enter the wound/hospital flow inside the arena.
    WoundReset(playerid);
    WoundClose(playerid);
    WoundFadeHide(playerid);

    printf("[FAMILY_BATTLE][DEATH] player=%d respawn now (state=%d)", playerid, GetPlayerState(playerid));

    // Respawn synchronously, exactly like WoundStart does. A timer-based SpawnPlayer conflicts with
    // the client's own death countdown (see WoundRespawn comments) and leaves the player lying dead.
    FamilyBattleRespawn(playerid);

    // Watchdog: if no OnPlayerSpawn arrives (pending flag still set), retry and finally force the state.
    SetTimerEx("FamilyBattleWatchdog", 500, false, "iii", playerid, now_tick, 1);
    return 1;
}

public FamilyBattleWatchdog(playerid, token, attempt)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(!g_family_battle_active || !GetPVarInt(playerid, "family_battle_member")) return 0;
    if(GetPVarInt(playerid, "fb_respawn_tick") != token) return 0; // a newer death took over
    if(!GetPVarInt(playerid, "fb_respawn_pending")) return 1;      // spawned fine

    printf("[FAMILY_BATTLE][WATCHDOG] player=%d no spawn callback, attempt=%d state=%d hp=%.1f",
        playerid, attempt, GetPlayerState(playerid), GetPlayerData(playerid, P_HEALTH));

    if(attempt < 3)
    {
        FamilyBattleRespawn(playerid);
        SetTimerEx("FamilyBattleWatchdog", 700, false, "iii", playerid, token, attempt + 1);
        return 1;
    }

    // Last resort: apply the arena state without waiting for a spawn callback.
    FamilyBattleApplySpawn(playerid);
    return 1;
}

public FamilyBattleGiveWeapons(playerid, token)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(!g_family_battle_active || !GetPVarInt(playerid, "family_battle_member")) return 0;
    if(GetPVarInt(playerid, "fb_spawn_token") != token) return 0;
    if(GetPlayerState(playerid) == PLAYER_STATE_WASTED || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 0;

    // Some chained handlers / the client's late spawn drop weapons after OnPlayerSpawn.
    // Give again only if the deagle is really missing, so ammo is not reset mid-fight.
    new fb_weapon, fb_ammo;
    GetPlayerWeaponData(playerid, 2, fb_weapon, fb_ammo);
    if(fb_weapon != 24 || fb_ammo < 1)
    {
        printf("[FAMILY_BATTLE][WEAPON] player=%d deagle missing (w=%d ammo=%d), giving again", playerid, fb_weapon, fb_ammo);
        GivePlayerWeapon(playerid, 24, 2000);
        SetPlayerArmedWeapon(playerid, 24);
    }
    return 1;
}

stock FamilyBattleApplySpawn(playerid)
{
    if(!g_family_battle_active || !GetPVarInt(playerid, "family_battle_member"))
        return 0;

    new battle_family = GetPlayerIdFamily(playerid);
    if(battle_family == -1 || !g_family_battle_registered[battle_family])
    {
        // Never leave the pending flag stuck, otherwise the next death is ignored.
        DeletePVar(playerid, "fb_respawn_pending");
        return 0;
    }

    // Use the exact random point selected BEFORE SpawnPlayer, so the default
    // gamemode spawn is never shown and the player does not travel through it.
    new Float:fb_x = GetPVarFloat(playerid, "fb_respawn_x");
    new Float:fb_y = GetPVarFloat(playerid, "fb_respawn_y");
    new Float:fb_z = GetPVarFloat(playerid, "fb_respawn_z");
    if(fb_x == 0.0 && fb_y == 0.0)
    {
        fb_x = -111.156661;
        fb_y = 1419.539184;
        fb_z = 10.408114;
    }

    // A second spawn callback shortly after a handled respawn (the client's own death countdown
    // requests a spawn again ~8 s later) must not heal / re-teleport the fighter mid-fight.
    new since_respawn = GetTickCount() - GetPVarInt(playerid, "fb_respawn_tick");
    new duplicate_spawn = (!GetPVarInt(playerid, "fb_respawn_pending") && since_respawn >= 0 && since_respawn < 12000) ? 1 : 0;
    printf("[FAMILY_BATTLE][SPAWN] player=%d pending=%d since=%d duplicate=%d hp=%.1f",
        playerid, GetPVarInt(playerid, "fb_respawn_pending"), since_respawn, duplicate_spawn, GetPlayerData(playerid, P_HEALTH));

    if(duplicate_spawn)
    {
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, FAMILY_BATTLE_WORLD);
        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, true);
        if(GetPlayerData(playerid, P_HEALTH) <= 0.0)
        {
            SetPlayerData(playerid, P_HEALTH, 100.0);
            SetPlayerHealth(playerid, 100.0);
        }
        GivePlayerWeapon(playerid, 24, 500);
        SetPlayerArmedWeapon(playerid, 24);
        return 1;
    }

    // Full state reset: no wound overlay, no lying animation, no frozen controls.
    WoundReset(playerid);
    WoundClose(playerid);
    WoundFadeHide(playerid);
    FamilyBattle_DisableAgm(playerid);

    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, FAMILY_BATTLE_WORLD);
    SetPlayerPos(playerid, fb_x, fb_y, fb_z);
    SetPlayerFacingAngle(playerid, float(random(360)));
    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, true);

    // Do not touch the player's camera in Family Battle.
    // The normal death camera transition is bypassed by the immediate arena respawn.
    DeletePVar(playerid, "fb_cam_reset");

    // Keep server-side HP (P_HEALTH) in sync with the client HP. Before this, only the client HP
    // was set to 100 while P_HEALTH stayed 0/stale, so damage sync could kill or ignore the player.
    SetPlayerData(playerid, P_HOSPITAL, false);
    SetPlayerData(playerid, P_HEALTH, 100.0);
    SetPlayerHealth(playerid, 100.0);

    ResetPlayerWeapons(playerid);
    GivePlayerWeapon(playerid, 24, 2000);
    SetPlayerArmedWeapon(playerid, 24);

    DeletePVar(playerid, "fb_respawn_pending");
    DeletePVar(playerid, "fb_respawn_x");
    DeletePVar(playerid, "fb_respawn_y");
    DeletePVar(playerid, "fb_respawn_z");
    if(g_family_battle_zone != -1)
        GangZoneShowForPlayer(playerid, g_family_battle_zone, 0xFF0000AA);
    SetPlayerCheckpoint(playerid, -111.010421, 1416.870605, 15.399374, 35.0);

    new spawn_token = GetPVarInt(playerid, "fb_spawn_token") + 1;
    SetPVarInt(playerid, "fb_spawn_token", spawn_token);
    SetTimerEx("FamilyBattleGiveWeapons", 500, false, "ii", playerid, spawn_token);
    SetTimerEx("FamilyBattleGiveWeapons", 1500, false, "ii", playerid, spawn_token);
    SetTimerEx("FamilyBattleGiveWeapons", 3500, false, "ii", playerid, spawn_token);
    SetTimerEx("FamilyBattleGiveWeapons", 9000, false, "ii", playerid, spawn_token);
    return 1;
}

