stock TaxiPark_FindNearestPoint(playerid, Float:points[][3], count, &Float:ox, &Float:oy, &Float:oz)
{
	new Float:px, Float:py, Float:pz;
	GetPlayerPos(playerid, px, py, pz);
	new best = 0;
	new Float:best_dist = 999999.0;
	for(new i = 0; i < count; i++)
	{
		new Float:d = GetDistanceBetweenPoints(px, py, pz, points[i][0], points[i][1], points[i][2]);
		if(d < best_dist)
		{
			best_dist = d;
			best = i;
		}
	}
	ox = points[best][0];
	oy = points[best][1];
	oz = points[best][2];
	return best;
}

Dialog_Response:TP_DestNear(playerid, response, listitem, inputtext[])
{
	if(!response) return TaxiPark_OpenDestDialog(playerid);
	if(listitem < 0 || listitem > 3) return 1;

	new Float:tx, Float:ty, Float:tz;

	switch(listitem)
	{
		case 0:
		{
			TaxiPark_FindNearestPoint(playerid, g_TaxiGPS_banks, 3, tx, ty, tz);
		}
		case 1:
		{
			TaxiPark_FindNearestPoint(playerid, g_TaxiGPS_public_places, 4, tx, ty, tz);
		}
		case 2:
		{
			TaxiPark_FindNearestPoint(playerid, g_TaxiGPS_autosalons, 6, tx, ty, tz);
		}
		case 3:
		{
			TaxiPark_FindNearestPoint(playerid, g_TaxiGPS_vokzals, 3, tx, ty, tz);
		}
	}

	TaxiPark_ApplyDestCoords(playerid, tx, ty, tz);
	return 1;
}

public TaxiPark_OnClientOrder(playerid, company, rate, payment, Float: x, Float: y, price, comment[])
{
	#pragma unused price, comment

	if(!IsPlayerConnected(playerid)) return 0;

	if(company < 0 || company >= TAXI_PARK_COUNT)
		company = 0;

	if(g_TaxiPlayerOrder[playerid][TPO_STATE] != TAXI_PLAYER_ORDER_NONE)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "У вас уже есть активный заказ такси", "");
		return 1;
	}

	// No drivers with a taken car in this park
	if(TaxiPark_CountDriversWithCar(company) <= 0)
	{
		ShowNotificationNew(playerid, 2, 6, 0, 0, "В данном таксопарке нету водителей", "");
		return 1;
	}

	new Float: tx = g_TaxiPendingToX[playerid];
	new Float: ty = g_TaxiPendingToY[playerid];
	new Float: tz = g_TaxiPendingToZ[playerid];

	if(!g_TaxiDestSelected[playerid])
	{
		new Float: tmpz;
		GetPlayerPos(playerid, tx, ty, tmpz);
		tx = x;
		ty = y;
		tz = tmpz;
	}

	new Float: px, Float: py, Float: pz;
	GetPlayerPos(playerid, px, py, pz);

	new Float: dist = GetDistanceBetweenPoints(px, py, pz, tx, ty, tz);
	new final_price = TaxiPark_CalcPriceForPark(company, dist, rate);
	if(final_price <= 0)
		final_price = TaxiPark_CalcPrice(dist, rate); // fallback defaults
	g_TaxiPendingPrice[playerid] = final_price;

	if(GetPlayerMoney(playerid) < final_price)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Недостаточно денег для заказа такси", "");
		return 1;
	}

	g_TaxiPlayerOrder[playerid][TPO_STATE] = TAXI_PLAYER_ORDER_WAITING;
	g_TaxiPlayerOrder[playerid][TPO_PASSENGER] = playerid;
	g_TaxiPlayerOrder[playerid][TPO_DRIVER] = INVALID_PLAYER_ID;
	g_TaxiPlayerOrder[playerid][TPO_COMPANY] = company;
	g_TaxiPlayerOrder[playerid][TPO_FROM_X] = px;
	g_TaxiPlayerOrder[playerid][TPO_FROM_Y] = py;
	g_TaxiPlayerOrder[playerid][TPO_FROM_Z] = pz;
	g_TaxiPlayerOrder[playerid][TPO_TO_X] = tx;
	g_TaxiPlayerOrder[playerid][TPO_TO_Y] = ty;
	g_TaxiPlayerOrder[playerid][TPO_TO_Z] = tz;
	g_TaxiPlayerOrder[playerid][TPO_PRICE] = final_price;
	g_TaxiPlayerOrder[playerid][TPO_PAYMENT] = payment;
	g_TaxiPlayerOrder[playerid][TPO_RATE] = rate;

	ShowNotificationNew(playerid, 3, 6, 0, 0, "Вы вызвали такси, ожидайте пока кто нибудь примет ваш вызов.", "");

	
	
	for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(TaxiPark_GetPlayerJob(i) != company) continue;
		if(GetPVarInt(i, TAXI_PARK_PVAR_VEHICLE) == 0) continue;
		ShowNotificationNew(i, 4, 6, TAXI_PARK_NOTIFICATION_ID, 0, "У вас новый заказ", "принять");
	}

	return 1;
}

stock TaxiPark_ResetPlayerOrder(playerid)
{
	g_TaxiPlayerOrder[playerid][TPO_STATE] = TAXI_PLAYER_ORDER_NONE;
	g_TaxiPlayerOrder[playerid][TPO_PASSENGER] = INVALID_PLAYER_ID;
	g_TaxiPlayerOrder[playerid][TPO_DRIVER] = INVALID_PLAYER_ID;
	g_TaxiPlayerOrder[playerid][TPO_COMPANY] = -1;
	g_TaxiPlayerOrder[playerid][TPO_PRICE] = 0;
	g_TaxiPlayerOrder[playerid][TPO_PAYMENT] = 0;
	g_TaxiPlayerOrder[playerid][TPO_RATE] = 0;
	if(g_TaxiDistTimer[playerid] != 0)
	{
		KillTimer(g_TaxiDistTimer[playerid]);
		g_TaxiDistTimer[playerid] = 0;
	}
	g_TaxiDestSelected[playerid] = false;
	g_TaxiCompanySelected[playerid] = false;
	g_TaxiPendingDest[playerid] = -1;
	return 1;
}

stock TaxiPark_CancelPlayerOrder(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;

	new order_state = g_TaxiPlayerOrder[playerid][TPO_STATE];
	if(order_state == TAXI_PLAYER_ORDER_NONE)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "У вас нет активного заказа такси", "");
		return 1;
	}

	new driver = g_TaxiPlayerOrder[playerid][TPO_DRIVER];

	if(driver != INVALID_PLAYER_ID && IsPlayerConnected(driver))
	{
		ShowNotificationNew(driver, 2, 5, 0, 0, "Игрок отменил вызов", "");
		SendClientMessage(driver, -1, "{ff2400}| {ffffff}Игрок отменил вызов");

		if(GetPVarInt(driver, "TaxiOrderIsPlayer") && GetPVarInt(driver, "TaxiOrderPassenger") == playerid)
		{
			DisablePlayerGPS(driver);
			if(g_TaxiPark_ArriveTimer[driver] != 0)
			{
				KillTimer(g_TaxiPark_ArriveTimer[driver]);
				g_TaxiPark_ArriveTimer[driver] = 0;
			}
			SetPVarInt(driver, TAXI_PARK_PVAR_ORDER_STAGE, 0);
			SetPVarInt(driver, "TaxiOrderIsPlayer", 0);
			SetPVarInt(driver, "TaxiOrderPassenger", INVALID_PLAYER_ID);
			g_TaxiPark_SelectedOrder[driver] = -1;
		}
	}

	TaxiPark_ResetPlayerOrder(playerid);
	DisablePlayerGPS(playerid);
	ShowNotificationNew(playerid, 3, 5, 0, 0, "Вы отменили вызов такси", "");
	SendClientMessage(playerid, -1, "{33FF33}| {ffffff}Заказ такси отменён.");
	return 1;
}

forward TaxiPark_DistMessage(passenger);
public TaxiPark_DistMessage(passenger)
{
	if(!IsPlayerConnected(passenger)) return 0;
	if(g_TaxiPlayerOrder[passenger][TPO_STATE] != TAXI_PLAYER_ORDER_ACCEPTED &&
		g_TaxiPlayerOrder[passenger][TPO_STATE] != TAXI_PLAYER_ORDER_PICKUP)
		return 0;
	new driver = g_TaxiPlayerOrder[passenger][TPO_DRIVER];
	if(!IsPlayerConnected(driver)) return 0;
	new Float: px, Float: py, Float: pz, Float: dx, Float: dy, Float: dz;
	GetPlayerPos(passenger, px, py, pz);
	GetPlayerPos(driver, dx, dy, dz);
	new Float: dist = GetDistanceBetweenPoints(px, py, pz, dx, dy, dz);
	new msg[128];
	format(msg, sizeof msg, "[Taxi] Ваш таксист находится в %.0fм от вас", dist);
	SendClientMessage(passenger, -1, msg);
	format(msg, sizeof msg, "[Taxi] Клиент находится в %.0fм от вас", dist);
	SendClientMessage(driver, -1, msg);
	g_TaxiDistTimer[passenger] = SetTimerEx("TaxiPark_DistMessage", 15000, false, "i", passenger);
	return 1;
}

public TaxiPark_OnTaxiGUI(playerid, action, company, dest_id)
{
	if(!IsPlayerConnected(playerid)) return 0;

	
	if(action == 1)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "В разработке", "");
		return 1;
	}

	if(action == 2)
	{
		if(g_TaxiDriverOrderCount[playerid] <= 0)
		{
			ShowNotificationNew(playerid, 2, 5, 0, 0, "Больше заказов на данный момент нету.", "");
			ShowTaxiGUI(playerid, 0.11, 0, GetPlayerMoney(playerid), false);
			return 1;
		}
		g_TaxiDriverOrderIdx[playerid]++;
		if(g_TaxiDriverOrderIdx[playerid] >= g_TaxiDriverOrderCount[playerid])
		{
			ShowNotificationNew(playerid, 2, 5, 0, 0, "Больше заказов на данный момент нету.", "");
			g_TaxiDriverOrderIdx[playerid] = g_TaxiDriverOrderCount[playerid] - 1;
		}
		ShowTaxiGUI(playerid, 0.11, g_TaxiDriverOrderCount[playerid], GetPlayerMoney(playerid), false);
		return 1;
	}

	if(action == 3)
	{
		if(g_TaxiDriverOrderCount[playerid] <= 0)
		{
			ShowNotificationNew(playerid, 2, 5, 0, 0, "Больше заказов на данный момент нету.", "");
			ShowTaxiGUI(playerid, 0.11, 0, GetPlayerMoney(playerid), false);
			return 1;
		}
		g_TaxiDriverOrderIdx[playerid]--;
		if(g_TaxiDriverOrderIdx[playerid] < 0)
		{
			ShowNotificationNew(playerid, 2, 5, 0, 0, "Больше заказов на данный момент нету.", "");
			g_TaxiDriverOrderIdx[playerid] = 0;
		}
		ShowTaxiGUI(playerid, 0.11, g_TaxiDriverOrderCount[playerid], GetPlayerMoney(playerid), false);
		return 1;
	}

	
	if(action == 4)
	{
		TaxiPark_BuildDriverOrders(playerid);
		new idx = g_TaxiDriverOrderIdx[playerid];
		if(g_TaxiDriverOrderCount[playerid] <= 0 || idx < 0 || idx >= g_TaxiDriverOrderCount[playerid])
		{
			ShowNotificationNew(playerid, 2, 5, 0, 0, "Больше заказов на данный момент нету.", "");
			return 1;
		}
		if(GetPVarInt(playerid, TAXI_PARK_PVAR_ORDER_STAGE) != 0)
		{
			SendClientMessage(playerid, -1, "{ff2400}| {ffffff}У вас уже есть активный заказ такси");
			return 1;
		}
		if(g_TaxiDriverOrderType[playerid][idx] == 0)
		{
			// Delivery: OrderId = shared slot
			new park_id = TaxiPark_GetPlayerJob(playerid);
			new slot = g_TaxiDriverOrderId[playerid][idx];
			if(park_id == -1 || slot < 0 || slot >= TAXI_SHARED_MAX || g_TaxiShared[park_id][slot][TS_ACTIVE] != 1)
			{
				ShowNotificationNew(playerid, 2, 5, 0, 0, "данный вызов уже принят", "");
				TaxiPark_BuildDriverOrders(playerid);
				ShowTaxiGUI(playerid, 0.11, g_TaxiDriverOrderCount[playerid], g_TaxiDayIncome[playerid], false);
				return 1;
			}
			// Take shared order for whole park
			g_TaxiShared[park_id][slot][TS_ACTIVE] = 2;
			g_TaxiShared[park_id][slot][TS_TAKEN_BY] = playerid;
			if(g_TaxiSharedCount[park_id] > 0) g_TaxiSharedCount[park_id]--;

			new Float: dx = g_TaxiShared[park_id][slot][TS_TO_X];
			new Float: dy = g_TaxiShared[park_id][slot][TS_TO_Y];
			new Float: dz = g_TaxiShared[park_id][slot][TS_TO_Z];
			new price = g_TaxiShared[park_id][slot][TS_PRICE];
			g_TaxiPark_SelectedOrder[playerid] = slot;
			SetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_X, dx);
			SetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_Y, dy);
			SetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_Z, dz);
			SetPVarInt(playerid, "TaxiOrderPrice", price);
			SetPVarInt(playerid, TAXI_PARK_PVAR_ORDER_STAGE, 2);
			SetPVarInt(playerid, "TaxiOrderIsPlayer", 0);
			SetPVarInt(playerid, "TaxiOrderIsDelivery", 1);
			SetPVarInt(playerid, "TaxiSharedSlot", slot);

			EnablePlayerGPS(playerid, 0, dx, dy, dz, "Доставьте ремонтный набор");
			if(g_TaxiPark_ArriveTimer[playerid] != 0) KillTimer(g_TaxiPark_ArriveTimer[playerid]);
			g_TaxiPark_ArriveTimer[playerid] = SetTimerEx("TaxiPark_CheckArrive", 1000, true, "i", playerid);
			SendClientMessage(playerid, -1, "{33FF33}| {ffffff}Вы приняли вызов типа: \"Доставка\"");
			SendClientMessage(playerid, -1, "{33FF33}| {ffffff}Мы выдали вам ремонтный набор. И вам необходимо довести ремонтный набор на точку отмеченную вам на карте");
			ShowNotificationNew(playerid, 3, 5, 0, 0, "Вызов принят: Доставка", "");
		}
		else
		{
			new passenger = g_TaxiDriverOrderId[playerid][idx];
			if(!IsPlayerConnected(passenger) || g_TaxiPlayerOrder[passenger][TPO_STATE] != TAXI_PLAYER_ORDER_WAITING)
			{
				ShowNotificationNew(playerid, 2, 5, 0, 0, "данный вызов уже принят", "");
				return 1;
			}
			g_TaxiPlayerOrder[passenger][TPO_STATE] = TAXI_PLAYER_ORDER_ACCEPTED;
			g_TaxiPlayerOrder[passenger][TPO_DRIVER] = playerid;
			SetPVarInt(playerid, TAXI_PARK_PVAR_ORDER_STAGE, 1);
			SetPVarInt(playerid, "TaxiOrderIsPlayer", 1);
			SetPVarInt(playerid, "TaxiOrderPassenger", passenger);
			printf("[TAXI GUI ACCEPT] driver=%d passenger=%d -> UpdateTaxiOrderDriverFound", playerid, passenger);
			TaxiPark_UpdateTaxiOrderDriverFound(passenger, playerid);
			EnablePlayerGPS(playerid, 0, g_TaxiPlayerOrder[passenger][TPO_FROM_X], g_TaxiPlayerOrder[passenger][TPO_FROM_Y], g_TaxiPlayerOrder[passenger][TPO_FROM_Z], "Едьте к клиенту по GPS");
			if(g_TaxiPark_ArriveTimer[playerid] != 0) KillTimer(g_TaxiPark_ArriveTimer[playerid]);
			g_TaxiPark_ArriveTimer[playerid] = SetTimerEx("TaxiPark_CheckArrive", 1000, true, "i", playerid);
			// Board watch from accept moment (not only after arrive) — anticheat eats StateChange
			TaxiPark_StartBoardWatch(playerid);
			SendClientMessage(playerid, -1, "{33FF33}| {ffffff}Вызов от игрока принят. Езжайте к клиенту.");
			ShowNotificationNew(passenger, 3, 5, 0, 0, "Ваш вызов принят, ожидайте", "");
			new dname[24], msg[144];
			GetPlayerName(playerid, dname, sizeof dname);
			format(msg, sizeof msg, "Ваш таксист выехал, Имя таксиста: %s", dname);
			SendClientMessage(passenger, -1, msg);
			SendClientMessage(passenger, -1, "Не уходите никуда от места где вы вызвали такси, иначе ваш заказ будет отменен");
			if(g_TaxiDistTimer[passenger] != 0) KillTimer(g_TaxiDistTimer[passenger]);
			g_TaxiDistTimer[passenger] = SetTimerEx("TaxiPark_DistMessage", 15000, false, "i", passenger);
		}
		TaxiPark_BuildDriverOrders(playerid);
		return 1;
	}
	return 1;
}


stock TaxiPark_GetAccID(playerid)
{
	#pragma unused playerid
	return -1;
}

stock TaxiPark_IsOwner(playerid, park_id)
{
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	if(g_TaxiCompany[park_id][TC_OWNER_ID] == -1 && !g_TaxiCompanyOwnerName[park_id][0]) return 0;
	if(!strcmp(g_TaxiCompanyOwnerName[park_id], "Государство", true)) return 0;
	new name[24];
	GetPlayerName(playerid, name, sizeof name);
	if(!strcmp(name, g_TaxiCompanyOwnerName[park_id], true)) return 1;
	return 0;
}

stock TaxiPark_CountDrivers(park_id)
{
	new count = 0;
	for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(TaxiPark_GetPlayerJob(i) == park_id) count++;
	}
	return count;
}

stock TaxiPark_GetSafeMax(park_id)
{
	if(g_TaxiCompany[park_id][TC_UPG_SAFE]) return TAXI_COMPANY_SAFE_UPG;
	return TAXI_COMPANY_SAFE_BASE;
}

stock TaxiPark_GetStaffMax(park_id)
{
	if(g_TaxiCompany[park_id][TC_UPG_STAFF]) return TAXI_COMPANY_STAFF_UPG;
	return TAXI_COMPANY_STAFF_BASE;
}

stock TaxiPark_GetCarsMax(park_id)
{
	if(g_TaxiCompany[park_id][TC_UPG_FLEET]) return TAXI_COMPANY_CARS_UPG;
	return TAXI_COMPANY_CARS_BASE;
}

stock TaxiPark_BoostActive(park_id, field)
{
	new until = g_TaxiCompany[park_id][field];
	if(until <= 0) return 0;
	return (gettime() < until);
}

stock TaxiPark_RankName(rank, dest[], size = sizeof dest)
{
	switch(rank)
	{
		case 1: format(dest, size, "%s", "Комфорт");
		case 2: format(dest, size, "%s", "Бизнес");
		default: format(dest, size, "%s", "Эконом");
	}
	return 1;
}

stock TaxiPark_UpgStatus(owned, dest[], size = sizeof dest)
{
	if(owned) format(dest, size, "{33AA33}[%s]", "Приобретено");
	else format(dest, size, "{FF3333}[%s]", "Не приобретено");
	return 1;
}

stock TaxiPark_BoostStatus(active, dest[], size = sizeof dest)
{
	if(active) format(dest, size, "{33AA33}[%s]", "Действует");
	else format(dest, size, "{FFCC00}[%s]", "Не действует");
	return 1;
}


stock TaxiPark_LoadCompanies()
{
	mysql_tquery(mysql,
		"CREATE TABLE IF NOT EXISTS `taxi_by_workk` (\
		`park_id` INT NOT NULL PRIMARY KEY,\
		`owner_id` INT NOT NULL DEFAULT -1,\
		`owner_name` VARCHAR(24) NOT NULL DEFAULT '',\
		`balance` INT NOT NULL DEFAULT 0,\
		`rating` FLOAT NOT NULL DEFAULT 5.0,\
		`orders` INT NOT NULL DEFAULT 0,\
		`cars` INT NOT NULL DEFAULT 0,\
		`rent_days` INT NOT NULL DEFAULT 27,\
		`price_eco` INT NOT NULL DEFAULT 300,\
		`price_com` INT NOT NULL DEFAULT 450,\
		`price_biz` INT NOT NULL DEFAULT 600,\
		`pct_eco` INT NOT NULL DEFAULT 40,\
		`pct_com` INT NOT NULL DEFAULT 40,\
		`pct_biz` INT NOT NULL DEFAULT 50,\
		`upg_fleet` TINYINT NOT NULL DEFAULT 0,\
		`upg_staff` TINYINT NOT NULL DEFAULT 0,\
		`upg_safe` TINYINT NOT NULL DEFAULT 0,\
		`upg_gas` TINYINT NOT NULL DEFAULT 0,\
		`upg_disp` TINYINT NOT NULL DEFAULT 0,\
		`upg_boost_cd` INT NOT NULL DEFAULT 0,\
		`boost_profit` INT NOT NULL DEFAULT 0,\
		`boost_exp` INT NOT NULL DEFAULT 0,\
		`boost_rating` INT NOT NULL DEFAULT 0,\
		`boost_delivery` INT NOT NULL DEFAULT 0,\
		`boost_client` INT NOT NULL DEFAULT 0,\
		`boost_fast` INT NOT NULL DEFAULT 0,\
		`f0_en` TINYINT NOT NULL DEFAULT 0, `f0_model` INT NOT NULL DEFAULT 0, `f0_name` VARCHAR(32) NOT NULL DEFAULT '', `f0_price` INT NOT NULL DEFAULT 1000, `f0_rank` TINYINT NOT NULL DEFAULT 0, `f0_class` TINYINT NOT NULL DEFAULT 0,\
		`f1_en` TINYINT NOT NULL DEFAULT 0, `f1_model` INT NOT NULL DEFAULT 0, `f1_name` VARCHAR(32) NOT NULL DEFAULT '', `f1_price` INT NOT NULL DEFAULT 1000, `f1_rank` TINYINT NOT NULL DEFAULT 0, `f1_class` TINYINT NOT NULL DEFAULT 0,\
		`f2_en` TINYINT NOT NULL DEFAULT 0, `f2_model` INT NOT NULL DEFAULT 0, `f2_name` VARCHAR(32) NOT NULL DEFAULT '', `f2_price` INT NOT NULL DEFAULT 1000, `f2_rank` TINYINT NOT NULL DEFAULT 0, `f2_class` TINYINT NOT NULL DEFAULT 0\
		) ENGINE=InnoDB DEFAULT CHARSET=cp1251");
	mysql_tquery(mysql, "SELECT * FROM `taxi_by_workk`", "TaxiPark_OnCompaniesLoad", "");
	return 1;
}

public TaxiPark_OnCompaniesLoad()
{
	new rows = cache_num_rows();
	for(new r = 0; r < rows; r++)
	{
		new park_id = cache_get_field_content_int(r, "park_id");
		if(park_id < 0 || park_id >= TAXI_PARK_COUNT) continue;

		g_TaxiCompany[park_id][TC_OWNER_ID] = cache_get_field_content_int(r, "owner_id");
		cache_get_field_content(r, "owner_name", g_TaxiCompanyOwnerName[park_id], .max_len = 24);
		if(g_TaxiCompany[park_id][TC_OWNER_ID] <= 0 || !g_TaxiCompanyOwnerName[park_id][0])
			format(g_TaxiCompanyOwnerName[park_id], 24, "%s", "Государство");

		g_TaxiCompany[park_id][TC_BALANCE] = cache_get_field_content_int(r, "balance");
		g_TaxiCompany[park_id][TC_RATING] = cache_get_field_content_float(r, "rating");
		g_TaxiCompany[park_id][TC_ORDERS] = cache_get_field_content_int(r, "orders");
		g_TaxiCompany[park_id][TC_CARS] = cache_get_field_content_int(r, "cars");
		g_TaxiCompany[park_id][TC_RENT_DAYS] = cache_get_field_content_int(r, "rent_days");
		g_TaxiCompany[park_id][TC_PRICE_ECO] = cache_get_field_content_int(r, "price_eco");
		g_TaxiCompany[park_id][TC_PRICE_COM] = cache_get_field_content_int(r, "price_com");
		g_TaxiCompany[park_id][TC_PRICE_BIZ] = cache_get_field_content_int(r, "price_biz");

		new pe = cache_get_field_content_int(r, "pct_eco");
		new pc = cache_get_field_content_int(r, "pct_com");
		new pb = cache_get_field_content_int(r, "pct_biz");
		if(pe >= 20 && pe <= 75) g_TaxiDriverPct[park_id][0] = pe;
		if(pc >= 20 && pc <= 75) g_TaxiDriverPct[park_id][1] = pc;
		if(pb >= 20 && pb <= 75) g_TaxiDriverPct[park_id][2] = pb;

		g_TaxiCompany[park_id][TC_UPG_FLEET] = cache_get_field_content_int(r, "upg_fleet");
		g_TaxiCompany[park_id][TC_UPG_STAFF] = cache_get_field_content_int(r, "upg_staff");
		g_TaxiCompany[park_id][TC_UPG_SAFE] = cache_get_field_content_int(r, "upg_safe");
		g_TaxiCompany[park_id][TC_UPG_GAS] = cache_get_field_content_int(r, "upg_gas");
		g_TaxiCompany[park_id][TC_UPG_DISP] = cache_get_field_content_int(r, "upg_disp");
		g_TaxiCompany[park_id][TC_UPG_BOOST_CD] = cache_get_field_content_int(r, "upg_boost_cd");
		g_TaxiCompany[park_id][TC_BOOST_PROFIT] = cache_get_field_content_int(r, "boost_profit");
		g_TaxiCompany[park_id][TC_BOOST_EXP] = cache_get_field_content_int(r, "boost_exp");
		g_TaxiCompany[park_id][TC_BOOST_RATING] = cache_get_field_content_int(r, "boost_rating");
		g_TaxiCompany[park_id][TC_BOOST_DELIVERY] = cache_get_field_content_int(r, "boost_delivery");
		g_TaxiCompany[park_id][TC_BOOST_CLIENT] = cache_get_field_content_int(r, "boost_client");
		g_TaxiCompany[park_id][TC_BOOST_FAST] = cache_get_field_content_int(r, "boost_fast");

		g_TaxiFleetEnabled[park_id][0] = cache_get_field_content_int(r, "f0_en");
		g_TaxiFleetModel[park_id][0] = cache_get_field_content_int(r, "f0_model");
		cache_get_field_content(r, "f0_name", g_TaxiFleetName[park_id][0], .max_len = 32);
		g_TaxiFleetPrice[park_id][0] = cache_get_field_content_int(r, "f0_price");
		g_TaxiFleetRank[park_id][0] = cache_get_field_content_int(r, "f0_rank");
		g_TaxiFleetClass[park_id][0] = cache_get_field_content_int(r, "f0_class");

		g_TaxiFleetEnabled[park_id][1] = cache_get_field_content_int(r, "f1_en");
		g_TaxiFleetModel[park_id][1] = cache_get_field_content_int(r, "f1_model");
		cache_get_field_content(r, "f1_name", g_TaxiFleetName[park_id][1], .max_len = 32);
		g_TaxiFleetPrice[park_id][1] = cache_get_field_content_int(r, "f1_price");
		g_TaxiFleetRank[park_id][1] = cache_get_field_content_int(r, "f1_rank");
		g_TaxiFleetClass[park_id][1] = cache_get_field_content_int(r, "f1_class");

		g_TaxiFleetEnabled[park_id][2] = cache_get_field_content_int(r, "f2_en");
		g_TaxiFleetModel[park_id][2] = cache_get_field_content_int(r, "f2_model");
		cache_get_field_content(r, "f2_name", g_TaxiFleetName[park_id][2], .max_len = 32);
		g_TaxiFleetPrice[park_id][2] = cache_get_field_content_int(r, "f2_price");
		g_TaxiFleetRank[park_id][2] = cache_get_field_content_int(r, "f2_rank");
		g_TaxiFleetClass[park_id][2] = cache_get_field_content_int(r, "f2_class");

		new cnt = 0;
		for(new v = 0; v < TAXI_PARK_CAR_COUNT; v++)
			if(g_TaxiFleetEnabled[park_id][v]) cnt++;
		g_TaxiCompany[park_id][TC_CARS] = cnt;
	}
	printf("[TAXI] Loaded %d companies from taxi_by_workk", rows);
	return 1;
}

stock TaxiPark_SaveCompany(park_id)
{
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;

	new cnt = 0;
	for(new v = 0; v < TAXI_PARK_CAR_COUNT; v++)
		if(g_TaxiFleetEnabled[park_id][v]) cnt++;
	g_TaxiCompany[park_id][TC_CARS] = cnt;

	new query[1600];
	mysql_format(mysql, query, sizeof query,
		"INSERT INTO `taxi_by_workk` (		park_id,owner_id,owner_name,balance,rating,orders,cars,rent_days,		price_eco,price_com,price_biz,pct_eco,pct_com,pct_biz,		upg_fleet,upg_staff,upg_safe,upg_gas,upg_disp,upg_boost_cd,		boost_profit,boost_exp,boost_rating,boost_delivery,boost_client,boost_fast,		f0_en,f0_model,f0_name,f0_price,f0_rank,f0_class,		f1_en,f1_model,f1_name,f1_price,f1_rank,f1_class,		f2_en,f2_model,f2_name,f2_price,f2_rank,f2_class		) VALUES (		%d,%d,'%e',%d,%f,%d,%d,%d,		%d,%d,%d,%d,%d,%d,		%d,%d,%d,%d,%d,%d,		%d,%d,%d,%d,%d,%d,		%d,%d,'%e',%d,%d,%d,		%d,%d,'%e',%d,%d,%d,		%d,%d,'%e',%d,%d,%d		) ON DUPLICATE KEY UPDATE 		owner_id=%d,owner_name='%e',balance=%d,rating=%f,orders=%d,cars=%d,rent_days=%d,		price_eco=%d,price_com=%d,price_biz=%d,pct_eco=%d,pct_com=%d,pct_biz=%d,		upg_fleet=%d,upg_staff=%d,upg_safe=%d,upg_gas=%d,upg_disp=%d,upg_boost_cd=%d,		boost_profit=%d,boost_exp=%d,boost_rating=%d,boost_delivery=%d,boost_client=%d,boost_fast=%d,		f0_en=%d,f0_model=%d,f0_name='%e',f0_price=%d,f0_rank=%d,f0_class=%d,		f1_en=%d,f1_model=%d,f1_name='%e',f1_price=%d,f1_rank=%d,f1_class=%d,		f2_en=%d,f2_model=%d,f2_name='%e',f2_price=%d,f2_rank=%d,f2_class=%d",
		park_id,
		g_TaxiCompany[park_id][TC_OWNER_ID], g_TaxiCompanyOwnerName[park_id],
		g_TaxiCompany[park_id][TC_BALANCE], g_TaxiCompany[park_id][TC_RATING],
		g_TaxiCompany[park_id][TC_ORDERS], g_TaxiCompany[park_id][TC_CARS], g_TaxiCompany[park_id][TC_RENT_DAYS],
		g_TaxiCompany[park_id][TC_PRICE_ECO], g_TaxiCompany[park_id][TC_PRICE_COM], g_TaxiCompany[park_id][TC_PRICE_BIZ],
		g_TaxiDriverPct[park_id][0], g_TaxiDriverPct[park_id][1], g_TaxiDriverPct[park_id][2],
		g_TaxiCompany[park_id][TC_UPG_FLEET], g_TaxiCompany[park_id][TC_UPG_STAFF], g_TaxiCompany[park_id][TC_UPG_SAFE],
		g_TaxiCompany[park_id][TC_UPG_GAS], g_TaxiCompany[park_id][TC_UPG_DISP], g_TaxiCompany[park_id][TC_UPG_BOOST_CD],
		g_TaxiCompany[park_id][TC_BOOST_PROFIT], g_TaxiCompany[park_id][TC_BOOST_EXP], g_TaxiCompany[park_id][TC_BOOST_RATING],
		g_TaxiCompany[park_id][TC_BOOST_DELIVERY], g_TaxiCompany[park_id][TC_BOOST_CLIENT], g_TaxiCompany[park_id][TC_BOOST_FAST],
		g_TaxiFleetEnabled[park_id][0], g_TaxiFleetModel[park_id][0], g_TaxiFleetName[park_id][0], g_TaxiFleetPrice[park_id][0], g_TaxiFleetRank[park_id][0], g_TaxiFleetClass[park_id][0],
		g_TaxiFleetEnabled[park_id][1], g_TaxiFleetModel[park_id][1], g_TaxiFleetName[park_id][1], g_TaxiFleetPrice[park_id][1], g_TaxiFleetRank[park_id][1], g_TaxiFleetClass[park_id][1],
		g_TaxiFleetEnabled[park_id][2], g_TaxiFleetModel[park_id][2], g_TaxiFleetName[park_id][2], g_TaxiFleetPrice[park_id][2], g_TaxiFleetRank[park_id][2], g_TaxiFleetClass[park_id][2],
		g_TaxiCompany[park_id][TC_OWNER_ID], g_TaxiCompanyOwnerName[park_id],
		g_TaxiCompany[park_id][TC_BALANCE], g_TaxiCompany[park_id][TC_RATING],
		g_TaxiCompany[park_id][TC_ORDERS], g_TaxiCompany[park_id][TC_CARS], g_TaxiCompany[park_id][TC_RENT_DAYS],
		g_TaxiCompany[park_id][TC_PRICE_ECO], g_TaxiCompany[park_id][TC_PRICE_COM], g_TaxiCompany[park_id][TC_PRICE_BIZ],
		g_TaxiDriverPct[park_id][0], g_TaxiDriverPct[park_id][1], g_TaxiDriverPct[park_id][2],
		g_TaxiCompany[park_id][TC_UPG_FLEET], g_TaxiCompany[park_id][TC_UPG_STAFF], g_TaxiCompany[park_id][TC_UPG_SAFE],
		g_TaxiCompany[park_id][TC_UPG_GAS], g_TaxiCompany[park_id][TC_UPG_DISP], g_TaxiCompany[park_id][TC_UPG_BOOST_CD],
		g_TaxiCompany[park_id][TC_BOOST_PROFIT], g_TaxiCompany[park_id][TC_BOOST_EXP], g_TaxiCompany[park_id][TC_BOOST_RATING],
		g_TaxiCompany[park_id][TC_BOOST_DELIVERY], g_TaxiCompany[park_id][TC_BOOST_CLIENT], g_TaxiCompany[park_id][TC_BOOST_FAST],
		g_TaxiFleetEnabled[park_id][0], g_TaxiFleetModel[park_id][0], g_TaxiFleetName[park_id][0], g_TaxiFleetPrice[park_id][0], g_TaxiFleetRank[park_id][0], g_TaxiFleetClass[park_id][0],
		g_TaxiFleetEnabled[park_id][1], g_TaxiFleetModel[park_id][1], g_TaxiFleetName[park_id][1], g_TaxiFleetPrice[park_id][1], g_TaxiFleetRank[park_id][1], g_TaxiFleetClass[park_id][1],
		g_TaxiFleetEnabled[park_id][2], g_TaxiFleetModel[park_id][2], g_TaxiFleetName[park_id][2], g_TaxiFleetPrice[park_id][2], g_TaxiFleetRank[park_id][2], g_TaxiFleetClass[park_id][2]
	);
	mysql_tquery(mysql, query);
	return 1;
}

stock TaxiPark_OpenMainMenu(playerid)
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Вы не устроены ни в одном таксопарке", "");
		return 0;
	}
	new caption[72], list[700];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", "Управление таксокомпанией");
	format(list, sizeof list,
		"#\t%s\t%s\n#1.\t%s\t%s\n#2.\t%s\t%s\n#3.\t%s\t%s\n#4.\t%s\t%s\n#5.\t%s\t%s\n#6.\t%s\t%s\n#7.\t%s\t%s\n#8.\t%s\t%s\n#9.\t%s\t%s",
		"Название", "Доступное действие",
		"Информация о компании", "Нажмите для взаимодействия",
		"Управление компанией", "Нажмите для взаимодействия",
		"Улучшения компании", "Нажмите для взаимодействия",
		"Бусты компании", "Нажмите для взаимодействия",
		"Список сотрудников компании", "Нажмите для взаимодействия",
		"Личная карточка таксиста", "Нажмите для взаимодействия",
		"Сейф", "Нажмите для взаимодействия",
		"Помощь по компании", "Нажмите для взаимодействия",
		"Покинуть компанию", "Нажмите для взаимодействия");
	Dialog_Open(playerid, "TaxiPark_TMenuMain", DIALOG_STYLE_TABLIST_HEADERS, caption, list, "Далее", "Закрыть");
	return 1;
}

cmd:tmenu(playerid, params[])
{
	#pragma unused params
	TaxiPark_OpenMainMenu(playerid);
	return 1;
}

Dialog_Response:TaxiPark_TMenuMain(playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	switch(listitem)
	{
		case 0: TaxiPark_OpenInfo(playerid, park_id);
		case 1: TaxiPark_OpenManage(playerid, park_id);
		case 2: TaxiPark_OpenUpgrades(playerid, park_id);
		case 3: TaxiPark_OpenBoosts(playerid, park_id);
		case 4: TaxiPark_OpenStaffMenu(playerid, park_id);
		case 5: TaxiPark_OpenPersonalCard(playerid, park_id);
		case 6: TaxiPark_OpenSafeMenu(playerid, park_id);
		case 7: TaxiPark_OpenHelp(playerid);
		case 8: TaxiPark_OpenLeave(playerid);
	}
	return 1;
}

Dialog_Response:TaxiPark_TMenuBack(playerid, response, listitem, inputtext[])
{
	#pragma unused response, listitem, inputtext
	TaxiPark_OpenMainMenu(playerid);
	return 1;
}

stock TaxiPark_OpenInfo(playerid, park_id)
{
	new caption[72], info[1200];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", "Информация о компании");
	new drivers = TaxiPark_CountDrivers(park_id);
	new car_count = g_TaxiCompany[park_id][TC_CARS];
	if(car_count < 1) car_count = TaxiPark_GetCarsMax(park_id);
	format(info, sizeof info,
		"%s %s\n\n1. %s: %s\n2. %s: %.2f\n3. %s: %d\n4. %s: %d %s\n5. %s: %d %s\n6. %s: %d %s (%s %d %s)\n\n7. %s:\n* %s: %d %s\n* %s: %d %s\n* %s: %d %s\n\n8. %s:\n%s\n- %s 120 180 40\n- %s 225 275 45\n- %s 375 375 50",
		"Информация о компании", g_TaxiPark[park_id][TP_NAME],
		"Владелец компании", g_TaxiCompanyOwnerName[park_id],
		"Рейтинг компании", g_TaxiCompany[park_id][TC_RATING],
		"Количество выполненных заказов", g_TaxiCompany[park_id][TC_ORDERS],
		"Количество машин в автопарке", car_count, "шт.",
		"Количество водителей в компании", drivers, "шт.",
		"Аренда помещения", TAXI_COMPANY_RENT_DAY, "рублей в день",
		"Оплачено на", g_TaxiCompany[park_id][TC_RENT_DAYS], "дней",
		"Стоимость 1 километра для разных типов",
		"Эконом", g_TaxiCompany[park_id][TC_PRICE_ECO], "рублей",
		"Комфорт", g_TaxiCompany[park_id][TC_PRICE_COM], "рублей",
		"Бизнес", g_TaxiCompany[park_id][TC_PRICE_BIZ], "рублей",
		"Доход водителя и компании за 1 км",
		"Класс  Водитель  Компания  Процент",
		"Эконом", "Комфорт", "Бизнес");
	Dialog_Open(playerid, "TaxiPark_TMenuBack", DIALOG_STYLE_MSGBOX, caption, info, "Назад", "");
	return 1;
}


stock TaxiPark_AddProfit(park_id, amount)
{
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT || amount <= 0) return 0;
	new biz = g_TaxiParkBizID[park_id];
	if(biz < 0) return 0;
	new sql_id = GetBusinessData(biz, B_SQL_ID);
	new query[256];
	mysql_format(mysql, query, sizeof query,
		"INSERT INTO business_profit (bid,uid,uip,time,money,view) VALUES (%d,0,'taxi',%d,%d,1)",
		sql_id, gettime(), amount);
	mysql_tquery(mysql, query);
	return 1;
}

stock TaxiPark_OpenManage(playerid, park_id)
{
	new caption[72], list[700];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", "Управление компанией");
	if(!TaxiPark_IsOwner(playerid, park_id))
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Доступно только директору таксокомпании", "");
		return TaxiPark_OpenMainMenu(playerid);
	}
	format(list, sizeof list,
		"#\t%s\t%s\n#1.\t%s\t%s\n#2.\t%s\t%s\n#3.\t%s\t%s\n#4.\t%s\t%s\n#5.\t%s\t%s",
		"Наименование", "Доступное действие",
		"Управление автопарком", "Нажмите для взаимодействия",
		"Изменение цены за поездку", "Нажмите для взаимодействия",
		"Изменение процента водителю", "Нажмите для взаимодействия",
		"Увольнение игрока", "Нажмите для взаимодействия",
		"Финансовая статистика", "Нажмите для взаимодействия");
	Dialog_Open(playerid, "TaxiPark_TMenuManage", DIALOG_STYLE_TABLIST_HEADERS, caption, list, "Выбрать", "Назад");
	return 1;
}

Dialog_Response:TaxiPark_TMenuManage(playerid, response, listitem, inputtext[])
{
	if(!response) return TaxiPark_OpenMainMenu(playerid);
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!TaxiPark_IsOwner(playerid, park_id)) return TaxiPark_OpenMainMenu(playerid);
	switch(listitem)
	{
		case 0: TaxiPark_OpenFleetManage(playerid, park_id);
		case 1: TaxiPark_OpenPriceManage(playerid, park_id);
		case 2: TaxiPark_OpenPctManage(playerid, park_id);
		case 3: TaxiPark_OpenFirePlayer(playerid, park_id);
		case 4: TaxiPark_OpenFinanceStats(playerid, park_id);
	}
	return 1;
}


stock TaxiPark_OpenAddVehicle(playerid, park_id)
{
	#pragma unused park_id
	new query[128];
	mysql_format(mysql, query, sizeof query,
		"SELECT id, model_id FROM ownable_cars WHERE owner_id=%d LIMIT 30",
		GetPlayerAccountID(playerid));
	mysql_tquery(mysql, query, "TaxiPark_OnPlayerCarsLoad", "i", playerid);
	return 1;
}

forward TaxiPark_OnPlayerCarsLoad(playerid);
public TaxiPark_OnPlayerCarsLoad(playerid)
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	new rows = cache_num_rows();
	if(rows <= 0)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "У вас нет личного транспорта", "");
		return TaxiPark_OpenFleetManage(playerid, park_id);
	}
	new caption[72], list[1200], name[32];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", "Добавление тс в таксопарк");
	list[0] = 0;
	new count = 0;
	for(new i = 0; i < rows; i++)
	{
		new sql_id = cache_get_field_content_int(i, "id");
		new model = cache_get_field_content_int(i, "model_id");
		GetVehicleModelName(model, name, sizeof name);
		if(!name[0]) format(name, sizeof name, "Model %d", model);
		format(list, sizeof list, "%s%d. %s\n", list, i + 1, name);
		new pvn[24];
		format(pvn, sizeof pvn, "TaxiAddCar%d", count);
		SetPVarInt(playerid, pvn, sql_id);
		format(pvn, sizeof pvn, "TaxiAddModel%d", count);
		SetPVarInt(playerid, pvn, model);
		count++;
	}
	SetPVarInt(playerid, "TaxiAddCount", count);
	Dialog_Open(playerid, "TaxiPark_TMenuAddCar", DIALOG_STYLE_LIST, caption, list, "Добавить", "Назад");
	return 1;
}

Dialog_Response:TaxiPark_TMenuAddCar(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenFleetManage(playerid, park_id);
	new count = GetPVarInt(playerid, "TaxiAddCount");
	if(listitem < 0 || listitem >= count) return TaxiPark_OpenFleetManage(playerid, park_id);

	new free_slot = -1;
	for(new v = 0; v < TAXI_PARK_CAR_COUNT; v++)
	{
		if(!g_TaxiFleetEnabled[park_id][v])
		{
			free_slot = v;
			break;
		}
	}
	if(free_slot == -1)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Все слоты автопарка заняты", "");
		return TaxiPark_OpenFleetManage(playerid, park_id);
	}

	new pvn[24], model, name[32];
	format(pvn, sizeof pvn, "TaxiAddModel%d", listitem);
	model = GetPVarInt(playerid, pvn);
	GetVehicleModelName(model, name, sizeof name);
	if(!name[0]) format(name, sizeof name, "Model %d", model);

	new pvn_sql[24];
	format(pvn_sql, sizeof pvn_sql, "TaxiAddCar%d", listitem);
	new sql_id = GetPVarInt(playerid, pvn_sql);
	TaxiPark_TakePlayerOwnableCar(playerid, sql_id);

	g_TaxiFleetEnabled[park_id][free_slot] = 1;
	g_TaxiFleetModel[park_id][free_slot] = model;
	format(g_TaxiFleetName[park_id][free_slot], 32, "%s", name);
	if(g_TaxiFleetPrice[park_id][free_slot] <= 0)
		g_TaxiFleetPrice[park_id][free_slot] = 1000;
	g_TaxiCompany[park_id][TC_CARS] = 0;
	for(new v = 0; v < TAXI_PARK_CAR_COUNT; v++)
		if(g_TaxiFleetEnabled[park_id][v]) g_TaxiCompany[park_id][TC_CARS]++;
	TaxiPark_SaveCompany(park_id);

	new msg[96];
	format(msg, sizeof msg, "%s %s", "Транспорт добавлен:", name);
	ShowNotificationNew(playerid, 3, 5, 0, 0, msg, "");
	return TaxiPark_OpenFleetManage(playerid, park_id);
}

stock TaxiPark_TakePlayerOwnableCar(playerid, sql_id)
{
	if(sql_id <= 0) return 0;
	new query[160];
	mysql_format(mysql, query, sizeof query,
		"DELETE FROM ownable_cars WHERE id=%d AND owner_id=%d",
		sql_id, GetPlayerAccountID(playerid));
	mysql_tquery(mysql, query);
	mysql_format(mysql, query, sizeof query, "DELETE FROM trunks WHERE oc_id=%d", sql_id);
	mysql_tquery(mysql, query);

	for(new idx = 0; idx < g_ownable_car_loaded; idx++)
	{
		if(GetOwnableCarData(idx, OC_SQL_ID) != sql_id) continue;
		if(GetOwnableCarData(idx, OC_OWNER_ID) != GetPlayerAccountID(playerid)) continue;
		SetOwnableCarData(idx, OC_SQL_ID, 0);
		SetOwnableCarData(idx, OC_OWNER_ID, 0);
		SetOwnableCarData(idx, OC_CREATE, 0);
		for(new vid = 1; vid < MAX_VEHICLES; vid++)
		{
			if(!IsValidVehicle(vid)) continue;
			if(!IsAOwnableCar(vid)) continue;
			if(GetVehicleData(vid, V_ACTION_ID) != idx) continue;
			DestroyVehicleLabel(vid);
			UnloadOwnableCarTrunk(vid);
			DestroyVehicle(vid);
			break;
		}
		break;
	}
	return 1;
}

stock TaxiPark_OpenFleetManage(playerid, park_id)
{
	new caption[72], list[1100], rank_n[24], class_n[24];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", "Управление автопарком");
	format(list, sizeof list, "%s\t%s\t%s\t%s",
		"Название", "Доступно с ранга", "Класс", "Стоимость аренды");
	format(list, sizeof list, "%s\n%s\t-\t-\t-", list, "Добавить транспорт");
	new shown = 0;
	for(new v = 0; v < TAXI_PARK_CAR_COUNT; v++)
	{
		if(!g_TaxiFleetEnabled[park_id][v]) continue;
		new r = g_TaxiFleetRank[park_id][v];
		if(r < 0) r = 0; if(r > 2) r = 2;
		new c = g_TaxiFleetClass[park_id][v];
		if(c < 0) c = 0; if(c > 2) c = 2;
		format(rank_n, sizeof rank_n, "%s", g_TaxiRankNames[park_id][r]);
		format(class_n, sizeof class_n, "%s", g_TaxiRankNames[park_id][c]);
		format(list, sizeof list, "%s\n%s\t%s\t%s\t%d %s",
			list, g_TaxiFleetName[park_id][v], rank_n, class_n, g_TaxiFleetPrice[park_id][v], "рублей");
		new pvn[24];
		format(pvn, sizeof pvn, "TaxiFleetMap%d", shown);
		SetPVarInt(playerid, pvn, v);
		shown++;
	}
	SetPVarInt(playerid, "TaxiFleetShown", shown);
	Dialog_Open(playerid, "TaxiPark_TMenuFleet", DIALOG_STYLE_TABLIST_HEADERS, caption, list, "Выбрать", "Назад");
	return 1;
}

Dialog_Response:TaxiPark_TMenuFleet(playerid, response, listitem, inputtext[])
{
	if(!response) return TaxiPark_OpenManage(playerid, TaxiPark_GetPlayerJob(playerid));
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1 || listitem < 0) return 1;
	if(listitem == 0)
		return TaxiPark_OpenAddVehicle(playerid, park_id);
	listitem -= 1;
	new shown = GetPVarInt(playerid, "TaxiFleetShown");
	if(listitem < 0 || listitem >= shown) return 1;
	new pvn[24];
	format(pvn, sizeof pvn, "TaxiFleetMap%d", listitem);
	new car = GetPVarInt(playerid, pvn);
	if(car < 0 || car >= TAXI_PARK_CAR_COUNT) return 1;
	SetPVarInt(playerid, "TaxiFleetCar", car);
	new caption[72], list[200];
	format(caption, sizeof caption, "BLACK RUSSIA | %s", g_TaxiFleetName[park_id][listitem]);
	new en_str[40];
	if(g_TaxiFleetEnabled[park_id][listitem])
		format(en_str, sizeof en_str, "%s", "Отключить автомобиль");
	else
		format(en_str, sizeof en_str, "%s", "Включить автомобиль");
	format(list, sizeof list, "1. %s\n2. %s\n3. %s\n4. %s\n5. %s",
		"Изменить ранг доступа",
		"Изменить класс",
		"Изменить стоимость аренды",
		en_str,
		"Назад");
	Dialog_Open(playerid, "TaxiPark_TMenuFleetEdit", DIALOG_STYLE_LIST, caption, list, "Выбрать", "Назад");
	return 1;
}

Dialog_Response:TaxiPark_TMenuFleetEdit(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenFleetManage(playerid, park_id);
	new car = GetPVarInt(playerid, "TaxiFleetCar");
	if(listitem == 4) return TaxiPark_OpenFleetManage(playerid, park_id);
	if(listitem == 3)
	{
		g_TaxiFleetEnabled[park_id][car] = !g_TaxiFleetEnabled[park_id][car];
		TaxiPark_SaveCompany(park_id);
		if(g_TaxiFleetEnabled[park_id][car])
			ShowNotificationNew(playerid, 3, 4, 0, 0, "Автомобиль добавлен в автопарк", "");
		else
			ShowNotificationNew(playerid, 3, 4, 0, 0, "Автомобиль убран из автопарка", "");
		return TaxiPark_OpenFleetManage(playerid, park_id);
	}
	SetPVarInt(playerid, "TaxiFleetEdit", listitem);
	if(listitem == 0 || listitem == 1)
	{
		new caption[72], list[200];
		new _cap[32];
	if(listitem == 0) format(_cap, sizeof _cap, "%s", "Ранг доступа");
	else format(_cap, sizeof _cap, "%s", "Класс");
	format(caption, sizeof caption, "BLACK RUSSIA | %s", _cap);
		format(list, sizeof list, "1. %s\n2. %s\n3. %s",
			g_TaxiRankNames[park_id][0], g_TaxiRankNames[park_id][1], g_TaxiRankNames[park_id][2]);
		Dialog_Open(playerid, "TaxiPark_TMenuFleetSet", DIALOG_STYLE_LIST, caption, list, "Выбрать", "Назад");
	}
	else
	{
		new caption[72], info[160];
		format(caption, sizeof caption, "BLACK RUSSIA | %s", "Стоимость аренды");
		format(info, sizeof info, "%s\n%s: %d", "Введите новую стоимость аренды:", "Сейчас", g_TaxiFleetPrice[park_id][car]);
		Dialog_Open(playerid, "TaxiPark_TMenuFleetPrice", DIALOG_STYLE_INPUT, caption, info, "Изменить", "Назад");
	}
	return 1;
}

Dialog_Response:TaxiPark_TMenuFleetSet(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenFleetManage(playerid, park_id);
	new car = GetPVarInt(playerid, "TaxiFleetCar");
	new edit = GetPVarInt(playerid, "TaxiFleetEdit");
	if(listitem < 0 || listitem > 2) return TaxiPark_OpenFleetManage(playerid, park_id);
	if(edit == 0) g_TaxiFleetRank[park_id][car] = listitem;
	else g_TaxiFleetClass[park_id][car] = listitem;
	TaxiPark_SaveCompany(park_id);
	ShowNotificationNew(playerid, 3, 4, 0, 0, "Настройки автопарка сохранены", "");
	return TaxiPark_OpenFleetManage(playerid, park_id);
}

Dialog_Response:TaxiPark_TMenuFleetPrice(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenFleetManage(playerid, park_id);
	new car = GetPVarInt(playerid, "TaxiFleetCar");
	new price = strval(inputtext);
	if(price < 0 || price > 1000000)
	{
		ShowNotificationNew(playerid, 2, 4, 0, 0, "Некорректная стоимость", "");
		return TaxiPark_OpenFleetManage(playerid, park_id);
	}
	g_TaxiFleetPrice[park_id][car] = price;
	TaxiPark_SaveCompany(park_id);
	ShowNotificationNew(playerid, 3, 4, 0, 0, "Стоимость аренды изменена", "");
	return TaxiPark_OpenFleetManage(playerid, park_id);
}

