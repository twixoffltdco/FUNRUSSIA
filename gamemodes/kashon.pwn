	mysql_format(mysql, query, sizeof query, "SELECT * FROM tickets WHERE uid=%d", GetPlayerAccountID(to_player));
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows(result);

	SendClientMessage(playerid, 0x66CC33FF, "Список штрафов:");

	if(!rows)
		SendClientMessage(playerid, 0xFFCD00FF, "Штрафы отсутствуют");

	else
	{
		new paid_tickets;

		for(new idx; idx < rows; idx ++)
		{
			new id = cache_get_field_content_int(idx, "id"),
				amount = cache_get_field_content_int(idx, "amount"),
				status = cache_get_field_content_int(idx, "status"),
				desc[64],
				issuer[32];

			cache_get_field_content(idx, "description", desc);
			cache_get_field_content(idx, "issuer", issuer);

			format(query, sizeof query, "#%d | %d руб | %s | Выдал: %s | %s", id, amount, desc, issuer, status ? "{66CC33}Оплачен" : "{FF5533}Не оплачен");
			SendClientMessage(playerid, 0xFFCD00FF, query);

			if(status) paid_tickets ++;
		}

		format(query, sizeof query, "Общее количество штрафов: %d | Оплачены: %d | Не оплачены: %d", rows, paid_tickets, rows-paid_tickets);
		SendClientMessage(playerid, 0x66CC33FF, query);
	}

	cache_delete(result);

	return 1;
}


#define DIALOG_BWLIST (34163)

CMD:bwlist(playerid, params[])
{
    #pragma unused params
    new list[4096], row[192], count;
    new opg_name[32];
    strcat(list, "{FFCD00}Крыша бизнесов ОПГ\n\n", sizeof list);
    format(opg_name, sizeof opg_name, "Арзамасская ОПГ");
    for(new businessid; businessid < g_business_loaded; businessid++)
    {
        if(GetBusinessData(businessid, B_TYPE) != BUSINESS_TYPE_LAREK) continue;
        format(row, sizeof row, "{FFFFFF}%d. %s {AAAAAA}- {66CC00}%s\n", businessid, GetBusinessData(businessid, B_NAME), opg_name);
        strcat(list, row, sizeof list); count++;
    }
    format(opg_name, sizeof opg_name, "Лыткаринская ОПГ");
    for(new businessid; businessid < g_business_loaded; businessid++)
    {
        if(GetBusinessData(businessid, B_TYPE) != BUSINESS_TYPE_CASINO) continue;
        format(row, sizeof row, "{FFFFFF}%d. %s {AAAAAA}- {66CC00}%s\n", businessid, GetBusinessData(businessid, B_NAME), opg_name);
        strcat(list, row, sizeof list); count++;
    }
    format(opg_name, sizeof opg_name, "Арзамасская ОПГ");
    for(new stationid; stationid < g_fuel_station_loaded; stationid++)
    {
        format(row, sizeof row, "{FFFFFF}АЗС %d. %s {AAAAAA}- {66CC00}%s\n", GetFuelStationData(stationid, FS_SQL_ID), GetFuelStationData(stationid, FS_NAME), opg_name);
        strcat(list, row, sizeof list); count++;
    }
    if(!count) return SendClientMessage(playerid, 0x999999FF, "{FF5533}Список крышуемых бизнесов пуст.");
    Dialog(playerid, DIALOG_BWLIST, DIALOG_STYLE_MSGBOX, "{FFCD00}/bwlist - Крыша ОПГ", list, "Закрыть", "");
    return 1;
}

stock SilverOpgMaterialUpdateMultivanLabel(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0;
    if(!g_opg_multivan_label_created[vehicleid]) return 0;
    new text[160];
    format(text, sizeof text, "{FFCD00}\xca\xf0\xe0\xe6\xe0 \xec\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xee\xe2\n{FFFFFF}\xcd\xe0\xe7\xed\xe0\xf7\xe5\xed\xe8\xe5: {FFFF00}\xc2\xee\xe5\xed\xed\xe0\xff \xf7\xe0\xf1\xf2\xfc\n{FFFFFF}\xc7\xe0\xe3\xf0\xf3\xe6\xe5\xed\xee \xff\xf9\xe8\xea\xee\xe2 \xf1 \xec\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xe0\xec\xe8: {FFFF00}%d \xe8\xe7 10", g_opg_multivan_boxes[vehicleid]);
    Update3DTextLabelText(g_opg_multivan_label[vehicleid], -1, text);
    return 1;
}

stock SilverOpgMaterialFindMultivan(playerid, team)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid != INVALID_VEHICLE_ID && IsValidVehicle(vehicleid) && GetVehicleModel(vehicleid) == 418 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_ORG_CAR && GetVehicleData(vehicleid, V_ACTION_ID) == team)
        return vehicleid;

    new nearest = INVALID_VEHICLE_ID;
    new Float:best = 99999.0;
    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(!IsValidVehicle(i) || GetVehicleModel(i) != 418) continue;
        if(GetVehicleData(i, V_ACTION_TYPE) != VEHICLE_ACTION_ORG_CAR) continue;
        if(GetVehicleData(i, V_ACTION_ID) != team) continue;
        new Float:x, Float:y, Float:z;
        GetVehiclePos(i, x, y, z);
        new Float:dist = GetPlayerDistanceFromPoint(playerid, x, y, z);
        if(dist < best)
        {
            best = dist;
            nearest = i;
        }
    }
    if(best > 60.0) return INVALID_VEHICLE_ID;
    return nearest;
}

stock SilverOpgMaterialSetTruckCheckpoint(playerid, vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0;
    new Float:x, Float:y, Float:z, Float:a;
    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, a);
    x -= floatsin(-a, degrees) * 4.0;
    y -= floatcos(-a, degrees) * 4.0;
    SetPlayerCheckpoint(playerid, x, y, z + 0.5, 2.5);
    return 1;
}

stock SilverOpgMaterialTakeRaidBox(playerid)
{
    new team = GetPlayerTeamEx(playerid);
    if(!IsSilverOpgMaterialRaidTeam(team)) return 0;
    if(GetPVarInt(playerid, "opg_mat_route") != 1) return 0;
    if(GetPVarInt(playerid, "opg_mat_box") > 0) return 1;
    if(g_opg_mat_raid_team != team || g_opg_kpp_open_until <= gettime())
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xd1\xed\xe0\xf7\xe0\xeb\xe0 \xe2\xe7\xeb\xee\xec\xe0\xe9\xf2\xe5 \xca\xcf\xcf \xc2\xd7.");
    if(g_opg_mat_raid_total + SILVER_OPG_MAT_RAID_BOX > SILVER_OPG_MAT_RAID_MAX)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xcb\xe8\xec\xe8\xf2 \xf0\xe5\xe9\xe4\xe0 \xef\xee \xec\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xe0\xec \xe8\xf1\xf7\xe5\xf0\xef\xe0\xed.");

    new army_metal = GetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT);
    if(army_metal < SILVER_OPG_MAT_RAID_BOX)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xcd\xe0 \xf1\xea\xeb\xe0\xe4\xe5 \xc2\xd7 \xed\xe5\xf2 \xed\xf3\xe6\xed\xee\xe3\xee \xea\xee\xeb\xe8\xf7\xe5\xf1\xf2\xe2\xe0 \xec\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xee\xe2.");

    SetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT, army_metal - SILVER_OPG_MAT_RAID_BOX);
    UpdateRepository(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL);
    g_opg_mat_raid_total += SILVER_OPG_MAT_RAID_BOX;
    SetPVarInt(playerid, "opg_mat_box", SILVER_OPG_MAT_RAID_BOX);
    SetPVarInt(playerid, "opg_mat_box_team", team);
    SetPVarInt(playerid, "opg_mat_route", 2);
    SetPlayerAttachedObject(playerid, 0, 1271, 5, 0.15, 0.25, 0.0, 0.0, 90.0, 0.0, 0.65, 0.65, 0.65);
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 1, 1, 1, 1, 1);
    new vehicleid = GetPVarInt(playerid, "opg_mat_vehicle");
    SilverOpgMaterialSetTruckCheckpoint(playerid, vehicleid);
    new msg[144];
    format(msg, sizeof msg, "{66CC33}\xd1\xed\x8f\xf2 \xff\xf9\xe8\xea 1/10. {FFFFFF}\xcf\xee\xe4\xee\xe9\xe4\xe8\xf2\xe2\xf2\xe5 \xea \xe1\xe0\xe3\xe0\xe6\xed\xe8\xea\xf3 \xec\xe0\xf8\xe8\xed\xfb.");
    SendClientMessage(playerid, 0x66CC33FF, msg);
    return 1;
}

stock SilverOpgMaterialPutRaidBox(playerid)
{
    if(GetPVarInt(playerid, "opg_mat_route") != 2) return 0;
    new box = GetPVarInt(playerid, "opg_mat_box");
    new vehicleid = GetPVarInt(playerid, "opg_mat_vehicle");
    new team = GetPVarInt(playerid, "opg_mat_box_team");
    if(box <= 0 || !IsValidVehicle(vehicleid)) return 0;
    if(GetVehicleModel(vehicleid) != 418 || GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_ORG_CAR || GetVehicleData(vehicleid, V_ACTION_ID) != team)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xdd\xf2\xee \xed\xe5 \xe2\xe0\xf8 \xe2\xee\xe5\xed\xed\fb\xe9 \xe0\xe2\xf2\xee\xec\xee\xe1\xe8\xeb\xfc.");
    new Float:x, Float:y, Float:z;
    GetVehiclePos(vehicleid, x, y, z);
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) return 1;

    g_opg_multivan_boxes[vehicleid]++;
    if(g_opg_multivan_boxes[vehicleid] > 10) g_opg_multivan_boxes[vehicleid] = 10;
    DeletePVar(playerid, "opg_mat_box");
    DeletePVar(playerid, "opg_mat_box_team");
    RemovePlayerAttachedObject(playerid, 0);
    ClearAnimations(playerid);
    SilverOpgMaterialUpdateMultivanLabel(vehicleid);

    new loaded = g_opg_multivan_boxes[vehicleid];
    if(loaded >= 10)
    {
        SetPVarInt(playerid, "opg_mat_route", 3);
        new gang_index = team - TEAM_OPG_ARZAMASKAYA;
        if(0 <= gang_index <= 2)
        {
            EnablePlayerGPS(playerid, gps_gangs[gang_index][G_MARKET_TYPE], gps_gangs[gang_index][G_POS_X], gps_gangs[gang_index][G_POS_Y], gps_gangs[gang_index][G_POS_Z], "Место отмечено на GPS");
            SetPlayerCheckpoint(playerid, gps_gangs[gang_index][G_POS_X], gps_gangs[gang_index][G_POS_Y], gps_gangs[gang_index][G_POS_Z], 4.0);
        }
        SendClientMessage(playerid, 0x66CC33FF, "{66CC33}Машина загружена 10/10! {FFFFFF}Следуйте к метке своей ОПГ. {FFFF00}После прибытия выгрузите ящики по одному.");
    }
    else
    {
        SetPVarInt(playerid, "opg_mat_route", 1);
        SetPlayerCheckpoint(playerid, 1574.054931, 1643.135620, 16.011531, 2.5);
        new msg[96];
        format(msg, sizeof msg, "{66CC33}\xd1\xed\xee\xe2\xe0 \xe2\xee\xe7\xec\xe8\xf2\xe5 \xff\xf9\xe8\xea: {FFFFFF}%d/10.", loaded);
        SendClientMessage(playerid, 0x66CC33FF, msg);
    }
    return 1;
}

stock SilverOpgMaterialShowTruckInteraction(playerid)
{
    if(GetPVarInt(playerid, "opg_mat_route") != 5) return 0;
    new vehicleid = GetPVarInt(playerid, "opg_mat_vehicle");
    new team = GetPlayerTeamEx(playerid);
    if(!IsValidVehicle(vehicleid) || GetVehicleModel(vehicleid) != 418 || GetVehicleData(vehicleid, V_ACTION_ID) != team)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Это не ваш Multivan ОПГ.");
    if(g_opg_multivan_boxes[vehicleid] <= 0)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}В машине больше нет ящиков.");

    new Float:x, Float:y, Float:z, Float:a;
    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, a);
    x -= floatsin(-a, degrees) * 3.5;
    y -= floatcos(-a, degrees) * 3.5;
    if(!IsPlayerInRangeOfPoint(playerid, 4.0, x, y, z))
        return SendClientMessage(playerid, 0xFFCD00FF, "{FFCD00}Подойдите к багажнику машины.");

    ShowNotificationNew(playerid, 5, 7, SILVER_OPG_MAT_TRUCK_NOTIFY_ID, vehicleid, "Взять ящик из багажника", "ВЗЯТЬ");
    return 1;
}

stock SilverOpgMaterialHandleNotification(playerid, notify_type, notify_id, notify_sub_id)
{
    if(notify_id != SILVER_OPG_MAT_TRUCK_NOTIFY_ID) return 0;
    if(notify_type == 0)
        return SilverOpgMaterialTakeFromTruck(playerid);
    return 1;
}

stock SilverOpgMaterialTakeFromTruck(playerid)
{
    if(GetPVarInt(playerid, "opg_mat_route") != 5) return 0;
    new vehicleid = GetPVarInt(playerid, "opg_mat_vehicle");
    new team = GetPlayerTeamEx(playerid);
    if(!IsValidVehicle(vehicleid) || GetVehicleModel(vehicleid) != 418 || GetVehicleData(vehicleid, V_ACTION_ID) != team)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Это не ваш Multivan ОПГ.");
    if(g_opg_multivan_boxes[vehicleid] <= 0)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}В машине больше нет ящиков.");
    if(GetPVarInt(playerid, "opg_mat_box") > 0)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Вы уже несете ящик.");

    new repository = team - TEAM_OPG_ARZAMASKAYA;
    new current = GetGangRepositoryData(repository, GR_METALL);
    if(current + SILVER_OPG_MAT_RAID_BOX > SILVER_OPG_MAT_RAID_MAX_STOCK)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}На складе ОПГ недостаточно места для этого ящика.");

    new Float:x, Float:y, Float:z;
    GetVehiclePos(vehicleid, x, y, z);
    new Float:a;
    GetVehicleZAngle(vehicleid, a);
    x -= floatsin(-a, degrees) * 3.5;
    y -= floatcos(-a, degrees) * 3.5;
    if(!IsPlayerInRangeOfPoint(playerid, 4.0, x, y, z))
        return SendClientMessage(playerid, 0xFFCD00FF, "{FFCD00}Подойдите к багажнику машины и возьмите ящик.");

    SetPVarInt(playerid, "opg_mat_box", SILVER_OPG_MAT_RAID_BOX);
    SetPVarInt(playerid, "opg_mat_box_team", team);
    SetPVarInt(playerid, "opg_mat_route", 4);
    SetPlayerAttachedObject(playerid, 0, 1271, 5, 0.15, 0.25, 0.0, 0.0, 90.0, 0.0, 0.65, 0.65, 0.65);
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 1, 1, 1, 1, 1);

    new Float:rx = GetTeamData(team, O_REPOSITORY_POS)[0];
    new Float:ry = GetTeamData(team, O_REPOSITORY_POS)[1];
    new Float:rz = GetTeamData(team, O_REPOSITORY_POS)[2];
    SetPlayerCheckpoint(playerid, rx, ry, rz, 2.5);
    SendClientMessage(playerid, 0x66CC33FF, "{66CC33}Ящик взят. {FFFFFF}Отнесите его внутрь склада ОПГ и сдайте в отмеченной точке.");
    return 1;
}

stock SilverOpgMaterialPutIntoWarehouse(playerid)
{
    if(GetPVarInt(playerid, "opg_mat_route") != 4) return 0;
    new box = GetPVarInt(playerid, "opg_mat_box");
    new vehicleid = GetPVarInt(playerid, "opg_mat_vehicle");
    new team = GetPlayerTeamEx(playerid);
    if(box <= 0 || !IsValidVehicle(vehicleid)) return 0;
    if(GetPVarInt(playerid, "opg_mat_box_team") != team)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Этот ящик принадлежит другой ОПГ.");

    new Float:rx = GetTeamData(team, O_REPOSITORY_POS)[0];
    new Float:ry = GetTeamData(team, O_REPOSITORY_POS)[1];
    new Float:rz = GetTeamData(team, O_REPOSITORY_POS)[2];
    if(!IsPlayerInRangeOfPoint(playerid, 3.5, rx, ry, rz)) return 1;

    new repository = team - TEAM_OPG_ARZAMASKAYA;
    new current = GetGangRepositoryData(repository, GR_METALL);
    new add = box;
    new free = SILVER_OPG_MAT_RAID_MAX_STOCK - current;
    if(add > free) add = free;
    if(add <= 0)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Склад ОПГ заполнен. Больше материалов принять нельзя.");

    SetGangRepositoryData(repository, GR_METALL, current + add);
    UpdateGangRepository(repository);

    if(g_opg_multivan_boxes[vehicleid] > 0)
        g_opg_multivan_boxes[vehicleid]--;
    SilverOpgMaterialUpdateMultivanLabel(vehicleid);

    DeletePVar(playerid, "opg_mat_box");
    DeletePVar(playerid, "opg_mat_box_team");
    RemovePlayerAttachedObject(playerid, 0);
    ClearAnimations(playerid);

    new left = g_opg_multivan_boxes[vehicleid];
    if(left > 0)
    {
        SetPVarInt(playerid, "opg_mat_route", 5);
        new Float:x, Float:y, Float:z, Float:a;
        GetVehiclePos(vehicleid, x, y, z);
        GetVehicleZAngle(vehicleid, a);
        x -= floatsin(-a, degrees) * 3.5;
        y -= floatcos(-a, degrees) * 3.5;
        SetPlayerCheckpoint(playerid, x, y, z, 2.5);
        new msg[128];
        format(msg, sizeof msg, "{66CC33}Ящик сдан на склад. {FFFFFF}Осталось перенести: %d/10. Подойдите к багажнику.", left);
        SendClientMessage(playerid, 0x66CC33FF, msg);
    }
    else
    {
        DeletePVar(playerid, "opg_mat_route");
        DeletePVar(playerid, "opg_mat_vehicle");
        DisablePlayerCheckpoint(playerid);
        g_opg_mat_raid_total = 0;
        g_opg_mat_raid_started = 0;
        g_opg_mat_raid_team = 0;
        SendClientMessage(playerid, 0x66CC33FF, "{66CC33}Все 10 ящиков успешно перенесены в склад ОПГ. Рейд завершен.");
    }
    return 1;
}

stock SilverOpgMaterialDeliverRaid(playerid)
{
    return SilverOpgMaterialTakeFromTruck(playerid);
}

stock SilverOpgMaterialsPickup(playerid)
{
    new team = GetPlayerTeamEx(playerid);

    if(team == TEAM_ARMY)
    {
        new rank = GetPlayerJob(playerid);
        if(rank < 8 || rank > 10)
            return SendClientMessage(playerid, 0x999999FF, "{FF5533}Взять материалы здесь можно с 8-10 ранга.");

        new current = GetPlayerData(playerid, P_METALL);
        if(current >= 40)
            return SendClientMessage(playerid, 0x999999FF, "{FF5533}У вас уже максимум 40 кг материалов.");

        new amount = 7 + random(2);
        if(current + amount > 40) amount = 40 - current;

        new army_metal = GetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT);
        if(army_metal < amount)
            return SendClientMessage(playerid, 0x999999FF, "{FF5533}На складе ВЧ нет столько материалов.");

        AddPlayerData(playerid, P_METALL, +, amount);
        UpdatePlayerDatabaseInt(playerid, "metall", GetPlayerData(playerid, P_METALL));
        SetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT, army_metal - amount);
        UpdateRepository(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL);

        new msg[144];
        format(msg, sizeof msg, "%s[%d] взял(а) со склада ВЧ %d кг материалов.", GetPlayerNameEx(playerid), playerid, amount);
        SendMessageToTeam(TEAM_ARMY, msg, 0x3399FFFF);
        format(msg, sizeof msg, "{66CC33}+%d кг материалов. {FFFFFF}Всего: %d/40 кг.", amount, GetPlayerData(playerid, P_METALL));
        SendClientMessage(playerid, 0x66CC33FF, msg);
        return 1;
    }

    if(IsSilverOpgMaterialRaidTeam(team))
        return SilverOpgMaterialTakeRaidBox(playerid);

    return SendClientMessage(playerid, 0x999999FF, "{FF5533}Этот склад доступен только ВЧ и ОПГ.");
}

stock SilverOpgMaterialLoadTruck(playerid)
{
    new team = GetPlayerTeamEx(playerid);
    if(!IsSilverOpgMaterialRaidTeam(team))
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xdd\xf2\xe0 \xea\xee\xec\xe0\xed\xe4\xe0 \xe4\xee\xf1\xf2\xf3\xef\xed\xe0 \xf2\xee\xeb\xfc\xea\xee \xce\xcf\xc3."), 1;
    if(!SilverOpgMaterialRaidCheckTime(playerid)) return 1;
    if(g_opg_mat_raid_team != team || g_opg_kpp_open_until <= gettime())
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xd1\xed\xe0\xf7\xe0\xeb\xe0 \xe2\xe7\xeb\xee\xec\xe0\xe9\xf2\xe5 \xca\xcf\xcf \xc2\xd7."), 1;
    if(!IsPlayerInRangeOfPoint(playerid, 20.0, SILVER_OPG_MAT_ARMY_X, SILVER_OPG_MAT_ARMY_Y, SILVER_OPG_MAT_ARMY_Z))
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xcf\xee\xe4\xee\xe9\xe4\xe8\xf2\xe5 \xea \xf1\xea\xeb\xe0\xe4\xf3 \xec\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xee\xe2 \xc2\xd7."), 1;
    if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xd1\xea\xeb\xe0\xe4 \xec\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xee\xe2 \xed\xe0\xf5\xee\xe4\xe8\xf2\xf1\xff \xe2 \xec\xe8\xf0\xe5 0."), 1;
    if(GetPVarInt(playerid, "opg_mat_route") > 0)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xd0\xe5\xe9\xe4 \xf3\xe6\xe5 \xe7\xe0\xef\xf3\xf9\xe5\xed. \xd1\xeb\xe5\xe4\xf3\xe9\xf2\xe5 \xea\xf0\xe0\xf1\xed\xfb\xec \xec\xe5\xf2\xea\xe0\xec."), 1;

    new vehicleid = SilverOpgMaterialFindMultivan(playerid, team);
    if(vehicleid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xcd\xe5\xf4\xe0\xf5\xe4\xe8\xf2\xf1\xff \xe2\xe0\xf8 Multivan \xed\xe5\xe4\xe0\xeb\xe5\xea\xee \xee\xf2 \xf1\xea\xeb\xe0\xe4\xe0. \xcf\xee\xe4\xe3\xee\xed\xe8\xf2\xe5 \xe5\xe3\xee \xea \xc2\xd7."), 1;

    if(g_opg_multivan_boxes[vehicleid] > 0)
        g_opg_multivan_boxes[vehicleid] = 0;
    SilverOpgMaterialUpdateMultivanLabel(vehicleid);
    SetPVarInt(playerid, "opg_mat_vehicle", vehicleid);
    SetPVarInt(playerid, "opg_mat_route", 1);
    SetPlayerCheckpoint(playerid, 1574.054931, 1643.135620, 16.011531, 2.5);
    SendClientMessage(playerid, 0xFFCD00FF, "{FFCD00}\xcd\xe0\xe9\xe4\xe8\xf2\xe5 \xea \xea\xf0\xe0\xf1\xed\xee\xe9 \xec\xe5\xf2\xea\xe5 \xf3 \xf1\xea\xeb\xe0\xe4\xe0 \xe8 \xe7\xe0\xe1\xe5\xf0\xe8\xf2\xe5 \xff\xf9\xe8\xea. \xc7\xe0\xf2\xe5\xec \xed\xe5\xf1\xe8\xf2\xe5 \xe5\xe3\xee \xea \xe1\xe0\xe3\xe0\xe6\xed\xe8\xea\xf3 \xec\xe0\xf8\xe8\xed\xfb.");
    return 1;
}

CMD:loadgun(playerid, params[])
{
    return SilverOpgMaterialLoadTruck(playerid);
}

CMD:discard(playerid, params[])
{
    new box = GetPVarInt(playerid, "opg_mat_box");
    if(box <= 0)
    {
        if(GetPVarInt(playerid, "opg_mat_route") > 0)
        {
            DeletePVar(playerid, "opg_mat_route");
            DeletePVar(playerid, "opg_mat_vehicle");
            DisablePlayerCheckpoint(playerid);
            SendClientMessage(playerid, 0xFFCD00FF, "{FFCD00}\xd0\xe5\xe9\xe4 \xef\xee \xec\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xe0\xec \xee\xf2\xec\xe5\xed\xb8\xed.");
            return 1;
        }
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}\xd3 \xf2\xe5\xe1\xff \xed\xe5\xf2 \xff\xf9\xe8\xea\xe0 \xf1 \xec\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xe0\xec\xe8.");
    }
    DeletePVar(playerid, "opg_mat_box");
    DeletePVar(playerid, "opg_mat_box_team");
    RemovePlayerAttachedObject(playerid, 0);
    ClearAnimations(playerid);
    new army_metal = GetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT);
    if(army_metal + box > 200000) box = 200000 - army_metal;
    if(box > 0)
    {
        SetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT, army_metal + box);
        UpdateRepository(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL);
    }
    if(g_opg_mat_raid_total >= box) g_opg_mat_raid_total -= box;
    SetPVarInt(playerid, "opg_mat_route", 1);
    SetPlayerCheckpoint(playerid, 1574.054931, 1643.135620, 16.011531, 2.5);
    SendClientMessage(playerid, 0xFFCD00FF, "{FFCD00}\xdf\xf9\xe8\xea \xf1\xe1\xf0\xee\xf8\xe5\xed. \xcc\xe0\xf2\xe5\xf0\xe8\xe0\xeb\xfb \xe2\xee\xe7\xe2\xf0\xe0\xf9\xe5\xed\xfb \xed\xe0 \xf1\xea\xeb\xe0\xe4 \xc2\xd7.");
    return 1;
}

CMD:makegun(playerid, params[])
{
	if(GetPlayerTeamEx(playerid) != TEAM_ARMY && !(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(playerid) <= TEAM_OPG_LYTKARINSKAYA))
		return SendClientMessage(playerid, 0x999999FF, "Вы не можете использовать это");

	extract params -> new weapon_id, weapon_ammo;

	if(!(1 <= weapon_id <= 7))
	{
		Dialog
		(
			playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
			"Доступное оружие",
			"{66CCCC}\
			ID\tНазвание\t\tМатериалы\n\n\
			{FFFFFF}1.\tSilenced 9mm\t\t3\n\
			2.\tDesert Eagle\t\t6\n\
			3.\tShotgun\t\t8\n\
			4.\tMP5\t\t\t9\n\
			5.\tAK47\t\t\t10\n\
			6.\tM4\t\t\t10\n\
			7.\tCountry Rifle\t\t11\n\n\
			Для добавления патронов к созданному оружию\n\
			необходимо держать его в руках\
			",
			"Закрыть", ""
		);

		SendClientMessage(playerid, 0xCECECEFF, "Используйте: /makegun [id оружия] [кол-во патронов]");

		return 1;
	}

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /makegun [id оружия] [кол-во патронов]");
	if(weapon_ammo <= 0) return SendClientMessage(playerid, 0xCECECEFF, "Неверное количество патронов");

	enum TEMP_GUN_INFO
	{
		GUN_ID,
		GUN_METAL,
		GUN_NAME[16]
	};

	new temp_gun[7][TEMP_GUN_INFO] =
	{
		{23, 3, 	"Silenced 9mm"},
		{24, 6, 	"Desert Eagle"},
		{25, 8, 	"Shotgun"},
		{29, 9, 	"MP5"},
		{30, 10, 	"AK47"},
		{31, 10, 	"M4"},
		{33, 11, 	"Country Rifle"}
	};

	if(weapon_id != GetPlayerWeapon(playerid) && GetPlayerData(playerid, P_METALL) < temp_gun[weapon_id-1][GUN_METAL])
		return SendClientMessage(playerid, 0xCECECEFF, "У Вас нет нужного количества Материалыа");
	if(GetPlayerData(playerid, P_AMMO) < weapon_ammo)
		return SendClientMessage(playerid, 0xCECECEFF, "У Вас нет нужного количества патронов");

	new fmt_text[128];

	if(GetPlayerWeapon(playerid) == temp_gun[weapon_id-1][GUN_ID])
	{
		format(fmt_text, sizeof fmt_text, "добавил к %s %d патронов", temp_gun[weapon_id-1][GUN_NAME], weapon_ammo);

		Action(playerid, fmt_text, _, false);
	}
					else
	{
		new w_id, w_ammo;

		for(new i; i < 13; i++)
		{
			GetPlayerWeaponData(playerid, i, w_id, w_ammo);

			if(w_id == temp_gun[weapon_id-1][GUN_ID])
			{
				GivePlayerWeapon(playerid, w_id, -w_ammo);
				break;
			}
		}

		AddPlayerData(playerid, P_METALL, -, temp_gun[weapon_id-1][GUN_METAL]);
		UpdatePlayerDatabaseInt(playerid, "metall", GetPlayerData(playerid, P_METALL));

		format(fmt_text, sizeof fmt_text, "сделал %s из Материалыа и %d патронов", temp_gun[weapon_id-1][GUN_NAME], weapon_ammo);

		Action(playerid, fmt_text, _, false);
	}

	GivePlayerWeapon(playerid, temp_gun[weapon_id-1][GUN_ID], weapon_ammo);

	AddPlayerData(playerid, P_AMMO, -, weapon_ammo);
	UpdatePlayerDatabaseInt(playerid, "ammo", GetPlayerData(playerid, P_AMMO));

	return 1;
}

CMD:close(playerid, params[])
{
	if(!(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(playerid) <= TEAM_OPG_LYTKARINSKAYA))
		return SendClientMessage(playerid, 0x999999FF, "Вы не можете использовать это");

	if(GetPlayerJob(playerid) < 8)
		return SendClientMessage(playerid, 0x999999FF, "Открывать или закрывать склад можно с 8-ого ранга");

	new repository = GetPlayerTeamEx(playerid) - TEAM_OPG_ARZAMASKAYA,
		fmt_text[70];

	SetGangRepositoryData(repository, GR_LOCK, GetGangRepositoryData(repository, GR_LOCK) ^ true);

	UpdateGangRepository(repository);

	format(fmt_text, sizeof fmt_text, "[Внимание] Склад был %s игроком %s[%d]",
	GetGangRepositoryData(repository, GR_LOCK) ? "открыт" : "закрыт", GetPlayerNameEx(playerid), playerid);

	SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_text, GetGangRepositoryData(repository, GR_LOCK) ? 0x66CC00FF : 0xFF6600FF);

	return 1;
}

CMD:tie(playerid, params[])
{
	if(!(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(playerid) <= TEAM_OPG_LYTKARINSKAYA))
		return SendClientMessage(playerid, 0x999999FF, "Вы не можете использовать это");

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /tie [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "Такого игрока нет");
	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0)) return SendClientMessage(playerid, 0xCECECEFF, "Игрок находится слишком далеко");

	if(GetPlayerData(to_player, P_CUFFED)) return SendClientMessage(playerid, 0xCECECEFF, "Игрок уже связан/закован в наручники");

	SetPlayerSpecialAction(to_player, SPECIAL_ACTION_CUFFED);

	SetPlayerData(to_player, P_CUFFED, true);

	TogglePlayerControllable(to_player, false);

	new fmt_str[90];

	format(fmt_str, sizeof fmt_str, "%s связал %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));
	SendMessageInLocal(playerid, fmt_str, 0xDD90FFFF, 25.0);

	return 1;
}

CMD:untie(playerid, params[])
{
	if(!(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(playerid) <= TEAM_OPG_LYTKARINSKAYA))
		return SendClientMessage(playerid, 0x999999FF, "Вы не можете использовать это");

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /untie [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SendClientMessage(playerid, 0xCECECEFF, "Такого игрока нет");
	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0)) return SendClientMessage(playerid, 0xCECECEFF, "Игрок находится слишком далеко");

	if(!GetPlayerData(to_player, P_CUFFED)) return SendClientMessage(playerid, 0xCECECEFF, "Игрок не завязан");

	SetPlayerSpecialAction(to_player, SPECIAL_ACTION_NONE);

	SetPlayerData(to_player, P_CUFFED, false);

	TogglePlayerControllable(to_player, true);

	new fmt_str[90];

	format(fmt_str, sizeof fmt_str, "%s развязал %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));
	SendMessageInLocal(playerid, fmt_str, 0xDD90FFFF, 25.0);

	return 1;
}

CMD:capture(playerid, params[])
{
	if(!(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(playerid) <= TEAM_OPG_LYTKARINSKAYA))
		return SendClientMessage(playerid, 0x999999FF, "Вы не можете использовать это");

	if(GetPlayerJob(playerid) < 6)
		return SendClientMessage(playerid, 0x999999FF, "Организовывать захват территории можно только с 6-ого ранга");

	if(g_capture[C_STATUS])
		return SendClientMessage(playerid, 0x999999FF, "Дождитесь окончания текущего захвата");

	new gang_id = (GetPlayerTeamEx(playerid) - TEAM_OPG_ARZAMASKAYA) + 1;

	if(g_capture[C_WAIT_TIME][gang_id - 1] > gettime())
		return SendClientMessage(playerid, 0x999999FF, "С момента последнего Вашего захвата еще не прошел 1 час");

	new gang_zone_id = -1;

	for(new idx; idx < g_gang_zones_loaded; idx ++)
	{
		if(!IsPlayerInDynamicArea(playerid, GetGangZoneData(idx, GZ_AREA))) continue;

		gang_zone_id = idx;
		break;
	}

	if(gang_zone_id == -1)
		return SendClientMessage(playerid, 0x999999FF, "Вы должны находиться на захваченной кем-то территории");

	new gang_zone_team = GetGangZoneData(gang_zone_id, GZ_GANG);

	if(!gang_zone_team)
		return SendClientMessage(playerid, 0x999999FF, "Вы должны находиться на захваченной кем-то территории");

	if(gang_zone_team == gang_id)
		return SendClientMessage(playerid, 0x999999FF, "Вы не можете захватить свою территорию");

	if(g_capture[C_WAIT_TIME][gang_zone_team - 1] > gettime())
		return SendClientMessage(playerid, 0x999999FF, "Банда, чью территорию Вы хотите захватить, еще не окрепла с последнего захвата (не прошел 1 час)");

	new gang_players[2];

	foreach(new idx : Player)
	{
		if(GetPlayerTeamEx(idx) == GetPlayerTeamEx(playerid)) gang_players[0] ++;
		else if(GetPlayerTeamEx(idx) == (gang_zone_team - 1) + TEAM_OPG_ARZAMASKAYA) gang_players[1] ++;
		else continue;
	}

	if(gang_players[0] < MIN_PLAYERS_FOR_CAPTURE)
		return SendClientMessage(playerid, 0x999999FF, "В Вашей банде должно быть не менее 5-ти людей для захвата");

	if(gang_players[1] < MIN_PLAYERS_FOR_CAPTURE)
		return SendClientMessage(playerid, 0x999999FF, "В банде, территорию которой Вы хотите захватить, должно быть не менее 5-ти людей для захвата");

	StartCapture(playerid, gang_zone_id, gang_id, gang_zone_team);

	return 1;
}

stock StartCapture(playerid, gang_zone_id, attack_team, protect_team)
{

	if(g_capture[C_STATUS]) return 0;

	new fmt_text[128],
		gps_icons[3] = {62, 61, 60};

	format(fmt_text, sizeof fmt_text, "%s начали захват территории у %s",
	GetTeamName( (attack_team + TEAM_OPG_ARZAMASKAYA) - 1), GetTeamName( (protect_team + TEAM_OPG_ARZAMASKAYA) - 1));

	SendMessageToGang(fmt_text, 0xFF5533FF);

	format(fmt_text, sizeof fmt_text, "%s %s[%d] инициировал захват",
	GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid);

	SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_text, 0xFF5533FF);

	foreach(new idx : Player)
	{
		if(!(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(idx) <= TEAM_OPG_LYTKARINSKAYA)) continue;

		TextDrawShowForPlayer(playerid, capture_TD[0]);
		TextDrawShowForPlayer(playerid, capture_TD[1]);

		format(fmt_text, sizeof fmt_text, "Место отмечено на GPS. Окажите сопротивление вражеской банде, чтобы %s территорию",
		GetPlayerTeamEx(idx) == ((attack_team + TEAM_OPG_ARZAMASKAYA) - 1) ? "захватить" : "сохранить свою");

		SendClientMessage(idx, 0xFFFF00FF, fmt_text);

		SetPlayerMapIcon
		(
			idx, 97,
			GetGangZoneData(gang_zone_id, GZ_MIN_X) + 50.0,
			GetGangZoneData(gang_zone_id, GZ_MIN_Y) + 50.0,
			0.0,
			gps_icons[ GetPlayerTeamEx(idx) - TEAM_OPG_ARZAMASKAYA ],
			0xFFFFFFFF,
			MAPICON_GLOBAL
		);
	}

	g_capture[C_STATUS] = true;

	g_capture[C_GANG_ZONE] = gang_zone_id;

	g_capture[C_ATTACK_TEAM] = attack_team;
	g_capture[C_PROTECT_TEAM] = protect_team;

	g_capture[C_ATTACKER_KILLS] = 0;
	g_capture[C_PROTECTOR_KILLS] = 0;

	g_capture[C_TIME] = 7 * 60;

	UpdateCaptureTextDraw();

	return 1;
}

stock EndCapture()
{
	if(!g_capture[C_STATUS]) return 0;

	new fmt_text[90],
		attack_team = (g_capture[C_ATTACK_TEAM] + TEAM_OPG_ARZAMASKAYA) - 1,
		protect_team = (g_capture[C_PROTECT_TEAM] + TEAM_OPG_ARZAMASKAYA) - 1;

	if(g_capture[C_ATTACKER_KILLS] > g_capture[C_PROTECTOR_KILLS])
		format(fmt_text, sizeof fmt_text, "%s захватили территорию у %s", GetTeamName(attack_team), GetTeamName(protect_team));

	else
		format(fmt_text, sizeof fmt_text, "Попытка %s захватить территорию у %s провалилась", GetTeamName(attack_team), GetTeamName(protect_team));

	SendMessageToGang(fmt_text, 0xFF5533FF);

	if(g_capture[C_ATTACKER_KILLS] > g_capture[C_PROTECTOR_KILLS])
	{

		UpdateGangRepository(g_capture[C_ATTACK_TEAM] - 1);
		UpdateGangRepository(g_capture[C_PROTECT_TEAM] - 1);
	}

	TextDrawHideForAll(capture_TD[0]);
	TextDrawHideForAll(capture_TD[1]);

	g_capture[C_STATUS] = false;

	g_capture[C_GANG_ZONE] = -1;

	g_capture[C_ATTACK_TEAM] =
	g_capture[C_PROTECT_TEAM] = -1;

	g_capture[C_ATTACKER_KILLS] =
	g_capture[C_PROTECTOR_KILLS] = 0;

	g_capture[C_TIME] = 0;

	g_capture[C_WAIT_TIME][attack_team - 1] =
	g_capture[C_WAIT_TIME][protect_team - 1] = gettime() + 3600;

	foreach(new idx : Player)
		RemovePlayerMapIcon(idx, 97);

	return 1;
}

stock UpdateCaptureTextDraw()
{
	new fmt_text[128];

	format
	(
		fmt_text, sizeof fmt_text,
		"Время: %d:%02d~n~"\
		"~w~%s__~r~~h~%d~n~"\
		"~w~%s__~r~~h~%d",
		g_capture[C_TIME] / 60,
		g_capture[C_TIME] % 60,
		GetTeamName( (g_capture[C_ATTACK_TEAM] + TEAM_OPG_ARZAMASKAYA) - 1 ),
		g_capture[C_ATTACKER_KILLS],
		GetTeamName( (g_capture[C_PROTECT_TEAM] + TEAM_OPG_ARZAMASKAYA) - 1 ),
		g_capture[C_PROTECTOR_KILLS]
	);

	TextDrawSetString(capture_TD[1], fmt_text);

	foreach(new idx : Player)
	{
		if(!IsPlayerConnected(idx)) continue;
		if(!IsPlayerLogged(idx)) continue;
		if(!(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(idx) <= TEAM_OPG_LYTKARINSKAYA)) continue;

		TextDrawShowForPlayer(idx, capture_TD[0]);
		TextDrawShowForPlayer(idx, capture_TD[1]);
	}
}

stock IsPlayerInPoliceTeam(playerid)
{
	if(TEAM_DPS <= GetPlayerTeamEx(playerid) <= TEAM_FBI) return true;
	return false;
}

stock IsPlayerInPoliceCar(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	if(VEHICLE_ACTION_TYPE_DPS_CAR <= GetVehicleData(vehicleid, V_ACTION_TYPE) <= VEHICLE_ACTION_TYPE_FBI_CAR) return true;
	if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_ORG_CAR &&
		GetVehicleData(vehicleid, V_ACTION_ID) == GetPlayerTeamEx(playerid) && IsPlayerInPoliceTeam(playerid)) return true;
	return false;
}

stock GenerateCarNumber()
{
	static const chars[11] = {'A', 'B', 'C', 'E', 'H', 'K', 'M', 'O', 'P', 'T', 'X'};
	new number[6];

	number[0] = chars[random(sizeof chars)];
	number[1] = random('9' - '0') + '0';
	number[2] = random('9' - '0') + '0';
	number[3] = random('9' - '0') + '0';

	if(number[1] == number[2] && number[2] == number[3] && number[3] == '0')
		number[3] = random('9' - '0') + '1';

	number[4] = chars[random(sizeof chars)];
	number[5] = chars[random(sizeof chars)];

	return number;
}

stock IsACarNumber(const text[])
{
	new length = strlen(text);

	if(length != 6)
	{
		return 0;
	}

	for(new i; i < length; i ++)
	{
		switch(i)
		{
			case 0, 4, 5:
			{
				switch(text[i])
				{
					case 'A'..'Z': continue;
					default: return 0;
				}
			}
			case 1..3:
			{
				switch(text[i])
				{
					case '0'..'9': continue;
					default: return 0;
				}
			}
		}
	}

	if(text[1] == text[2] && text[2] == text[3] && text[3] == '0')
	{
		return 0;
	}

	return 1;
}

stock GetCarNumberPrice(number[])
{
	if(strlen(number) != 6) return 0;

	new chars[4],
		price = GetDonatePrice(DONATE_PRICE_CAR_NUMBER);

	format(chars, sizeof chars, "%c%c%c", number[0], number[4], number[5]);

	if(!strcmp(chars, "amp", true)) price += 800;
	else if(!strcmp(chars, "ooo", true)) price += 700;
	else if(!strcmp(chars, "aaa", true)) price += 700;
	else if(!strcmp(chars, "ekx", true)) price += 600;
	else if(!strcmp(chars, "xam", true)) price += 600;
	else if(!strcmp(chars, "bop", true)) price += 300;
	else if(!strcmp(chars, "xep", true)) price += 200;
	else if(!strcmp(chars, "hax", true)) price += 200;
	else if(!strcmp(chars, "bbb", true)) price += 700;
	else if(!strcmp(chars, "ttt", true)) price += 700;
	else
	{
		if(chars[0] == chars[1] && chars[0] != chars[2]) price += 50;
		else if(chars[0] == chars[1] && chars[0] == chars[2]) price += 200;
		else if(chars[0] == chars[2] && chars[0] != chars[1]) price += 100;
	}

	if(number[1] == 0 && number[1] == 0) price += 200;
	else if(number[1] == number[2] && number[1] != number[3]) price += 150;
	else if(number[1] == number[2] && number[1] == number[3]) price += 250;

	return price;
}

CMD:checknumber(playerid, params[])
{
	extract params -> new string: number[7]; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /checknumber [номер]");

	if(strlen(number) != 6) return SendClientMessage(playerid, 0x999999FF, "Длина номера должна быть 6 символов");

	new fmt_text[90];
	format(fmt_text, sizeof fmt_text, "Стоимость введенного Вами номера: %d рублей", GetCarNumberPrice(number));
	SendClientMessage(playerid, 0x66CC33FF, fmt_text);

	return 1;
}

CMD:skill(playerid, params[])
{
	extract params -> new to_player; else return SendClientMessage(playerid, 0x999999FF, "Используйте: /skill [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "Такого игрока нет");

	if(to_player == playerid)
	{
		ShowPlayerSkills(playerid);
		return Action(playerid, "просматривает свои навыки владения оружием", _, false);
	}

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0))
		return SendClientMessage(playerid, 0x999999FF, "Игрок находится слишком далеко");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_SHOW_SKILL);

	return 1;
}

CMD:creategift(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 5) return 1;

	new query[128],
		Cache: result,
		Float: X,
		Float: Y,
		Float: Z,
		idx = g_gift_loaded;

	GetPlayerPos(playerid, X, Y, Z);

	mysql_format(mysql, query, sizeof query, "INSERT INTO gift (x, y, z) VALUES (%f, %f, %f)", X, Y, Z);
	result = mysql_query(mysql, query, true);

	SetGiftData(idx, G_SQL_ID, 		cache_insert_id());

	SetGiftData(idx, G_POS_X,		X);
	SetGiftData(idx, G_POS_Y,		Y);
	SetGiftData(idx, G_POS_Z,		Z);

	CreatePickup
	(
		1279,
		23,
		X, Y, Z,
		-1,
		PICKUP_ACTION_TYPE_GIFT,
		idx
	);

	g_gift_loaded++;

	cache_delete(result);

	SendClientMessage(playerid, 0x32a44bFF, "Вы создали подарок!");

	return 1;
}

CMD:donat(playerid, params[])
{
  new fmt_str[500];

 format
 (
   fmt_str, sizeof(fmt_str),
   "{FFFFFF}В этом разделе Вы можете использовать дополнительные\n"\
   "возможности сервера. Чтобы получить к ним доступ,\n"\
   "необходимо пополнить свой игровой счёт. Описание всех\n"\
   "дополнительных возможностей, а также о способах\n"\
   "пополнения счёта Вы можете узнать на нашем сайте:\n"\
   "{32CD32}"SERVER_SITE" (раздел Донат)\n\n"\
   "{1E90FF}Информация:\n"\
   "{FFFFFF}Номер аккаунта:  %d\n"\
   "{FFFFFF}Текущее состояние счёта:  %d BC\n"\
   "{FFFFFF}Последние пополнение: %d BC\n"\
   "{FFFFFF}Общая сумма пополнение: %d BC\n",
   GetPlayerAccountID(playerid),
   GetPlayerDonateRub(playerid),
