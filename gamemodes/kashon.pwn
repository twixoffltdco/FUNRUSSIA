}

stock AdminDelete_ClearAccountLinkedTables()
{
    new ok = 1;
    ok &= AdminDelete_ClearTable("accessories_players");
    ok &= AdminDelete_ClearTable("accessory_inventory");
    ok &= AdminDelete_ClearTable("inventory");
    ok &= AdminDelete_ClearTable("inventory_accessories");
    ok &= AdminDelete_ClearTable("inventory_plates");
    ok &= AdminDelete_ClearTable("inventory_skins");
    ok &= AdminDelete_ClearTable("player_skins");
    ok &= AdminDelete_ClearTable("bank_accounts");
    ok &= AdminDelete_ClearTable("bank_accounts_log");
    ok &= AdminDelete_ClearTable("phone_books");
    ok &= AdminDelete_ClearTable("change_names");
    ok &= AdminDelete_ClearTable("promocode_activations");
    ok &= AdminDelete_ClearTable("ytpromocode_activations");
    ok &= AdminDelete_ClearTable("blackpass_players");
    ok &= AdminDelete_ClearTable("tickets");
    ok &= AdminDelete_ClearTable("quick_message");
    ok &= AdminDelete_ClearTable("payments");
    return ok;
}

stock AdminDelete_ClearAllAccounts()
{
    new ok = 1;

    // Сначала отвязываем статическое имущество, чтобы после удаления аккаунтов
    // в гаражах, домах, бизнесах и АЗС не оставались старые владельцы.
    ok &= AdminDelete_ResetGarageOwners();
    ok &= AdminDelete_ResetHouseOwners();
    ok &= AdminDelete_ClearVehiclesRewards();
    ok &= AdminDelete_ClearFamilies();
    ok &= AdminDelete_ClearAccountLinkedTables();

    if(AdminDelete_TableExists("business"))
        ok &= AdminDelete_RunQuery("UPDATE `business` SET `owner_id`=0", "reset businesses owners");
    if(AdminDelete_TableExists("fuel_stations"))
        ok &= AdminDelete_RunQuery("UPDATE `fuel_stations` SET `owner_id`=0", "reset fuel stations owners");
    if(AdminDelete_TableExists("hotels"))
        ok &= AdminDelete_RunQuery("UPDATE `hotels` SET `owner_id`=0,`rent_time`=0,`status`=0", "reset hotels owners");

    ok &= AdminDelete_ClearTable("accounts");
    return ok;
}

stock AdminDelete_GetActionName(action, output[], size = sizeof output)
{
    switch(action)
    {
        case ADMIN_DELETE_GARAGES: format(output, size, "сброс владельцев гаражей");
        case ADMIN_DELETE_HOUSES: format(output, size, "сброс владельцев домов");
        case ADMIN_DELETE_VEHICLES_REWARDS: format(output, size, "удаление машин и наград");
        case ADMIN_DELETE_FAMILIES: format(output, size, "удаление семей");
        case ADMIN_DELETE_ACCOUNTS_ALL: format(output, size, "ПОЛНОЕ удаление аккаунтов и имущества");
        case ADMIN_DELETE_LOGS: format(output, size, "очистка логов");
        default: format(output, size, "неизвестное действие");
    }
    return 1;
}

stock AdminDelete_ShowMenu(playerid)
{
    if(GetPlayerAdminEx(playerid) < 13)
        return ShowNotificationNew(playerid, 2, 3, 0, 0, "Команда доступна только администрации 13 уровня", "");

    new list[1024];
    format(list, sizeof list,
        "Сбросить владельцев гаражей (гаражи останутся)\n"\
        "Сбросить владельцев домов (дома останутся)\n"\
        "Удалить все машины и награды игроков\n"\
        "Удалить все семьи\n"\
        "{FF4444}Удалить ВСЕ аккаунты и всё имущество\n"\
        "Очистить административные и денежные логи"
    );

    ShowPlayerDialog(playerid, DIALOG_ADMIN_DELETE_MENU, DIALOG_STYLE_LIST,
        "{FF4444}DELETE — очистка базы данных", list, "Выбрать", "Отмена");
    return 1;
}

stock AdminDelete_ShowConfirmation(playerid, action)
{
    new action_name[96], body[640];
    AdminDelete_GetActionName(action, action_name, sizeof action_name);
    SetPVarInt(playerid, "admin_delete_action", action);

    format(body, sizeof body,
        "{FF4444}ВНИМАНИЕ! Действие необратимо.\n\n"\
        "{FFFFFF}Вы выбрали: {FFCC00}%s\n"\
        "{FFFFFF}После выполнения сервер автоматически перезагрузит мод.\n\n"\
        "{FF4444}Для подтверждения введите точное слово: {FFFFFF}DELETE",
        action_name
    );

    ShowPlayerDialog(playerid, DIALOG_ADMIN_DELETE_CONFIRM, DIALOG_STYLE_INPUT,
        "{FF4444}Подтверждение очистки", body, "Удалить", "Отмена");
    return 1;
}

forward AdminDelete_RestartGameMode();
public AdminDelete_RestartGameMode()
{
    SendRconCommand("gmx");
    return 1;
}

stock AdminDelete_ScheduleRestart()
{
    if(g_admin_delete_restart_pending) return 1;
    g_admin_delete_restart_pending = true;
    SendClientMessageToAll(0xFF4444FF, "[DELETE] База данных очищена. Перезапуск игрового мода через 3 секунды...");
    SetTimer("AdminDelete_RestartGameMode", 3000, false);
    return 1;
}

stock AdminDelete_Execute(playerid, action)
{
    if(GetPlayerAdminEx(playerid) < 13) return 0;

    new action_name[96], log_message[220];
    AdminDelete_GetActionName(action, action_name, sizeof action_name);
    format(log_message, sizeof log_message,
        "[A] %s[%d] выполнил DELETE: %s",
        GetPlayerNameEx(playerid), playerid, action_name);

    // Пишем лог до удаления accounts, чтобы запись администратора не потерялась.
    printf("[ADMIN DELETE] %s", log_message);
    SendMessageToAdmins(log_message, 0xFF4444FF);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, log_message);

    new success = 0;
    switch(action)
    {
        case ADMIN_DELETE_GARAGES: success = AdminDelete_ResetGarageOwners();
        case ADMIN_DELETE_HOUSES: success = AdminDelete_ResetHouseOwners();
        case ADMIN_DELETE_VEHICLES_REWARDS: success = AdminDelete_ClearVehiclesRewards();
        case ADMIN_DELETE_FAMILIES: success = AdminDelete_ClearFamilies();
        case ADMIN_DELETE_ACCOUNTS_ALL: success = AdminDelete_ClearAllAccounts();
        case ADMIN_DELETE_LOGS: success = AdminDelete_ClearLogs();
    }

    DeletePVar(playerid, "admin_delete_action");

    if(!success)
    {
        SendClientMessage(playerid, 0xFF4444FF, "Очистка выполнена не полностью. Проверьте [ADMIN DELETE][SQL ERROR] в server_log.");
        return 1;
    }

    SendClientMessage(playerid, 0x66CC33FF, "Очистка базы данных успешно выполнена.");
    return AdminDelete_ScheduleRestart();
}

stock AdminDelete_HandleDialog(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == DIALOG_ADMIN_DELETE_MENU)
    {
        if(!response) return 1;
        if(GetPlayerAdminEx(playerid) < 13) return 1;

        new action = listitem + 1;
        if(action < ADMIN_DELETE_GARAGES || action > ADMIN_DELETE_LOGS) return 1;
        return AdminDelete_ShowConfirmation(playerid, action);
    }

    if(dialogid == DIALOG_ADMIN_DELETE_CONFIRM)
    {
        if(!response)
        {
            DeletePVar(playerid, "admin_delete_action");
            return 1;
        }
        if(GetPlayerAdminEx(playerid) < 13) return 1;

        new action = GetPVarInt(playerid, "admin_delete_action");
        if(strcmp(inputtext, "DELETE", false) != 0)
        {
            SendClientMessage(playerid, 0xFF4444FF, "Подтверждение неверное. Нужно ввести точное слово DELETE.");
            return AdminDelete_ShowConfirmation(playerid, action);
        }
        return AdminDelete_Execute(playerid, action);
    }
    return 0;
}

CMD:delete(playerid, params[])
{
    #pragma unused params
    return AdminDelete_ShowMenu(playerid);
}


// SAME RUSSIA | Developer whitelist transferred from SAME_RUSSIA_MAIN
#if defined _dev_whitelist_included
    #endinput
#endif
#define _dev_whitelist_included

#define DIALOG_DEV_WHITELIST_MENU          (34780)
#define DIALOG_DEV_WHITELIST_PASSWORD      (34781)
#define DIALOG_DEV_WHITELIST_ACCESS        (34782)


forward DevWhitelist_ResumeConnect(playerid);
forward DevWhitelist_Kick(playerid);

stock DevWhitelist_Save()
{
    new query[256];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO `server_whitelist` (`id`,`enabled`,`password`) VALUES (1,%d,'%e') ON DUPLICATE KEY UPDATE `enabled`=VALUES(`enabled`),`password`=VALUES(`password`)",
        _:g_dev_whitelist_enabled, g_dev_whitelist_password);
    mysql_query(mysql, query, false);
    return 1;
}

stock DevWhitelist_Init()
{
    mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS `server_whitelist` (`id` TINYINT UNSIGNED NOT NULL DEFAULT 1, `enabled` TINYINT(1) NOT NULL DEFAULT 0, `password` VARCHAR(64) NOT NULL DEFAULT 'dev2026', PRIMARY KEY (`id`)) ENGINE=MyISAM DEFAULT CHARSET=cp1251",
        false);

    new Cache:result = mysql_query(mysql, "SELECT `enabled`,`password` FROM `server_whitelist` WHERE `id`=1 LIMIT 1", true);
    if(mysql_errno(mysql) == 0 && cache_num_rows() > 0)
    {
        g_dev_whitelist_enabled = bool:cache_get_field_content_int(0, "enabled");
        cache_get_field_content(0, "password", g_dev_whitelist_password, mysql, sizeof g_dev_whitelist_password);
        if(!strlen(g_dev_whitelist_password)) format(g_dev_whitelist_password, sizeof g_dev_whitelist_password, "dev2026");
    }
    else
    {
        format(g_dev_whitelist_password, sizeof g_dev_whitelist_password, "dev2026");
        g_dev_whitelist_enabled = false;
        DevWhitelist_Save();
    }
    cache_delete(result);
    printf("[WHITELIST] loaded: enabled=%d", _:g_dev_whitelist_enabled);
    return 1;
}

stock DevWhitelist_ShowAccess(playerid, const extra[] = "")
{
    new text[512];
    if(strlen(extra))
        format(text, sizeof text, "{FF4444}%s\n\n{FFFFFF}Доступ к серверу разрешён только разработчикам.\nВведите пароль от whitelist для продолжения.\n\n{AAAAAA}После 3 неудачных попыток соединение будет закрыто.", extra);
    else
        format(text, sizeof text, "{FFFFFF}Доступ к серверу разрешён только разработчикам.\nВведите пароль от whitelist для продолжения.\n\n{AAAAAA}После 3 неудачных попыток соединение будет закрыто.");

    ShowPlayerDialog(playerid, DIALOG_DEV_WHITELIST_ACCESS, DIALOG_STYLE_PASSWORD,
        "{FF3B30}Доступ разработчика", text, "Войти", "Выйти");
    return 1;
}

stock DevWhitelist_ShowMenu(playerid)
{
    new title[96], text[256];
    format(title, sizeof title, "{FFFFFF}Whitelist разработчиков | %s", g_dev_whitelist_enabled ? "{33CC66}ВКЛ" : "{FF5555}ВЫКЛ");
    format(text, sizeof text, "%s whitelist\nИзменить пароль\nПоказать статус", g_dev_whitelist_enabled ? "Отключить" : "Включить");
    ShowPlayerDialog(playerid, DIALOG_DEV_WHITELIST_MENU, DIALOG_STYLE_LIST, title, text, "Выбрать", "Закрыть");
    return 1;
}

public DevWhitelist_ResumeConnect(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    return OnPlayerConnect(playerid);
}

public DevWhitelist_Kick(playerid)
{
    if(IsPlayerConnected(playerid)) Kick(playerid);
    return 1;
}

stock DevWhitelist_HandleDialog(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == DIALOG_DEV_WHITELIST_ACCESS)
    {
        if(!response)
        {
            SetTimerEx("DevWhitelist_Kick", 300, false, "i", playerid);
            return 1;
        }
        if(!strcmp(inputtext, g_dev_whitelist_password, false))
        {
            g_dev_whitelist_passed[playerid] = true;
            g_dev_whitelist_attempts[playerid] = 0;
            SendClientMessage(playerid, 0x55DD77FF, "Пароль whitelist принят.");
            SetTimerEx("DevWhitelist_ResumeConnect", 100, false, "i", playerid);
            return 1;
        }
        g_dev_whitelist_attempts[playerid]++;
        if(g_dev_whitelist_attempts[playerid] >= 3)
        {
            SendClientMessage(playerid, 0xFF4444FF, "Неверный пароль whitelist. Все 3 попытки использованы.");
            SetTimerEx("DevWhitelist_Kick", 500, false, "i", playerid);
            return 1;
        }
        new extra[128];
        format(extra, sizeof extra, "Неверный пароль. Осталось попыток: %d", 3 - g_dev_whitelist_attempts[playerid]);
        DevWhitelist_ShowAccess(playerid, extra);
        return 1;
    }

    if(dialogid == DIALOG_DEV_WHITELIST_MENU)
    {
        if(!response) return 1;
        if(GetPlayerAdminEx(playerid) < 13 || !GetPlayerData(playerid, P_ADMIN_LOGGED)) return 1;
        switch(listitem)
        {
            case 0:
            {
                g_dev_whitelist_enabled = !g_dev_whitelist_enabled;
                DevWhitelist_Save();
                SendClientMessage(playerid, 0x55DD77FF, g_dev_whitelist_enabled ? "Whitelist включён." : "Whitelist отключён.");
                return DevWhitelist_ShowMenu(playerid);
            }
            case 1:
            {
                ShowPlayerDialog(playerid, DIALOG_DEV_WHITELIST_PASSWORD, DIALOG_STYLE_INPUT,
                    "Whitelist разработчиков | Новый пароль", "Введите новый пароль whitelist (от 4 до 32 символов).", "Сохранить", "Назад");
                return 1;
            }
            case 2:
            {
                new msg[192];
                format(msg, sizeof msg, "Whitelist: %s | Длина пароля: %d", g_dev_whitelist_enabled ? "ВКЛ" : "ВЫКЛ", strlen(g_dev_whitelist_password));
                SendClientMessage(playerid, 0xFFFFFFFF, msg);
                return DevWhitelist_ShowMenu(playerid);
            }
        }
        return 1;
    }

    if(dialogid == DIALOG_DEV_WHITELIST_PASSWORD)
    {
        if(!response) return DevWhitelist_ShowMenu(playerid);
        if(GetPlayerAdminEx(playerid) < 13 || !GetPlayerData(playerid, P_ADMIN_LOGGED)) return 1;
        if(strlen(inputtext) < 4 || strlen(inputtext) > 32)
        {
            ShowPlayerDialog(playerid, DIALOG_DEV_WHITELIST_PASSWORD, DIALOG_STYLE_INPUT,
                "Whitelist разработчиков | Ошибка", "Пароль должен содержать от 4 до 32 символов.", "Сохранить", "Назад");
            return 1;
        }
        format(g_dev_whitelist_password, sizeof g_dev_whitelist_password, "%s", inputtext);
        DevWhitelist_Save();
        SendClientMessage(playerid, 0x55DD77FF, "Новый пароль whitelist сохранён в базу данных.");
        return DevWhitelist_ShowMenu(playerid);
    }
    return 0;
}

CMD:devwhitelist(playerid, params[])
{
    #pragma unused params
    if(GetPlayerAdminEx(playerid) < 13 || !GetPlayerData(playerid, P_ADMIN_LOGGED))
        return SendClientMessage(playerid, 0xFF5555FF, "Команда доступна только авторизованным администраторам 14+ уровня.");
    return DevWhitelist_ShowMenu(playerid);
}

// ===== END INTEGRATED SYSTEMS =====


// ============================================================================
// GUNWARN — встроенная система, без отдельного include
// Доступ администраторам с 7 уровня.
// ============================================================================
#define DIALOG_GUNWARN (34162)

forward GunWarn_Init();
forward GunWarn_Tick();

stock GunWarn_IsActive(playerid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 0;

    new expire = GetPlayerData(playerid, P_GUNWARN_TIME);
    if(expire <= 0) return 0;

    if(expire <= gettime())
    {
        SetPlayerData(playerid, P_GUNWARN_TIME, 0);
        new query[128];
        mysql_format(mysql, query, sizeof query,
            "UPDATE accounts SET gunwarn_time=0 WHERE id=%d LIMIT 1",
            GetPlayerAccountID(playerid));
        mysql_query(mysql, query, false);
        return 0;
    }
    return 1;
}

stock GunWarn_Show(playerid)
{
    if(!GunWarn_IsActive(playerid)) return 0;

    new expire = GetPlayerData(playerid, P_GUNWARN_TIME);
    new year, month, day, hour, minute, second;
    timestamp_to_date(expire + 10800, year, month, day, hour, minute, second);

    new text[512];
    format(text, sizeof text,
        "{FFFFFF}\xC2\xE0\xEC \xE7\xE0\xEF\xF0\xE5\xF9\xE5\xED\xEE \xE8\xF1\xEF\xEE\xEB\xFC\xE7\xEE\xE2\xE0\xF2\xFC \xEE\xF0\xF3\xE6\xE8\xE5.\n\n{FF5533}\xCF\xF0\xE8\xF7\xE8\xED\xE0: {FFFFFF}\xE1\xEB\xEE\xEA\xE8\xF0\xEE\xE2\xEA\xE0 \xEE\xF0\xF3\xE6\xE8\xFF (GunWarn)\n{FF5533}\xCE\xEA\xEE\xED\xF7\xE0\xED\xE8\xE5 GunWarn: {FFFFFF}%02d.%02d.%04d %02d:%02d\n\n{AAAAAA}\xC2\xEE \xE2\xF0\xE5\xEC\xFF \xE4\xE5\xE9\xF1\xF2\xE2\xE8\xFF GunWarn \xF0\xE0\xE7\xF0\xE5\xF8\xE5\xED\xEE \xE8\xF1\xEF\xEE\xEB\xFC\xE7\xEE\xE2\xE0\xF2\xFC \xF2\xEE\xEB\xFC\xEA\xEE \xEA\xF3\xEB\xE0\xEA\xE8.",
        day, month, year, hour, minute);

    SetPlayerData(playerid, P_LAST_DIALOG, DIALOG_GUNWARN);
    ShowPlayerDialog(playerid, DIALOG_GUNWARN, DIALOG_STYLE_MSGBOX,
        "{E0584B}{SERVER_NAME} {FFFFFF}| {FFFFFF}GunWarn",
        text, "\xC7\xE0\xEA\xF0\xFB\xF2\xFC", "");
    return 1;
}

stock GunWarn_Block(playerid)
{
    if(!GunWarn_IsActive(playerid)) return 0;
    if(GetPlayerWeapon(playerid) == 0) return 0;

    SetPlayerArmedWeapon(playerid, 0);

    new tick = GetTickCount();
    if(GetPVarInt(playerid, "gunwarn_dialog_tick") + 2000 <= tick)
    {
        SetPVarInt(playerid, "gunwarn_dialog_tick", tick);
        GunWarn_Show(playerid);
    }
    return 1;
}

public GunWarn_Init()
{
    new Cache:result = mysql_query(mysql,
        "SELECT COUNT(*) AS cnt FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='accounts' AND COLUMN_NAME='gunwarn_time'",
        true);

    if(!mysql_errno() && cache_num_rows() > 0 && cache_get_field_content_int(0, "cnt") == 0)
    {
        mysql_query(mysql,
            "ALTER TABLE `accounts` ADD COLUMN `gunwarn_time` INT NOT NULL DEFAULT 0",
            false);
    }

    if(result) cache_delete(result);
    return 1;
}

public GunWarn_Tick()
{
    foreach(new playerid : Player)
    {
        if(!IsPlayerLogged(playerid)) continue;
        GunWarn_Block(playerid);
    }
    return 1;
}

CMD:gwarn(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 7)
        return SendClientMessage(playerid, 0xCECECEFF, "{E0584B}[A] {FFFFFF}\xD3 \xC2\xE0\xF1 \xED\xE5\xF2 \xE4\xEE\xF1\xF2\xF3\xEF\xE0 \xEA \xE0\xE4\xEC\xE8\xED\xE8\xF1\xF2\xF0\xE0\xF2\xE8\xE2\xED\xFB\xEC \xEA\xEE\xEC\xE0\xED\xE4\xE0\xEC.");

    new targetid, hours, reason[64];
    if(sscanf(params, "dds[64]", targetid, hours, reason))
        return SendClientMessage(playerid, 0xCECECEFF, "{FFFFFF}\xC8\xF1\xEF\xEE\xEB\xFC\xE7\xF3\xE9\xF2\xE5: /gwarn [ID] [\xF7\xE0\xF1\xFB] [\xEF\xF0\xE8\xF7\xE8\xED\xE0]");

    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
        return SendClientMessage(playerid, 0xCECECEFF, "{FFFFFF}\xC8\xE3\xF0\xEE\xEA \xED\xE5 \xED\xE0\xE9\xE4\xE5\xED.");

    if(hours < 1 || hours > 720)
        return SendClientMessage(playerid, 0xCECECEFF, "{FFFFFF}\xD1\xF0\xEE\xEA GunWarn: \xEE\xF2 1 \xE4\xEE 720 \xF7\xE0\xF1\xEE\xE2.");

    if(!strlen(reason) || strlen(reason) > 63)
        return SendClientMessage(playerid, 0xCECECEFF, "{FFFFFF}\xD3\xEA\xE0\xE6\xE8\xF2\xE5 \xEF\xF0\xE8\xF7\xE8\xED\xF3 \xEE\xF2 1 \xE4\xEE 63 \xF1\xE8\xEC\xE2\xEE\xEB\xEE\xE2.");

    new expire = gettime() + hours * 3600;
    SetPlayerData(targetid, P_GUNWARN_TIME, expire);

    new query[160];
    mysql_format(mysql, query, sizeof query,
        "UPDATE accounts SET gunwarn_time=%d WHERE id=%d LIMIT 1",
        expire, GetPlayerAccountID(targetid));
    mysql_query(mysql, query, false);
    SetPlayerArmedWeapon(targetid, 0);

    new msg[256];
    format(msg, sizeof msg,
        "{FF5533}\xC0\xE4\xEC\xE8\xED\xE8\xF1\xF2\xF0\xE0\xF2\xEE\xF0 {FFFFFF}%s {FF5533}\xE2\xFB\xE4\xE0\xEB GunWarn \xE8\xE3\xF0\xEE\xEA\xF3 {FFFFFF}%s {FF5533}\xED\xE0 %d \xF7\xE0\xF1\xEE\xE2. \xCF\xF0\xE8\xF7\xE8\xED\xE0: {FFFFFF}%s",
        GetPlayerNameEx(playerid), GetPlayerNameEx(targetid), hours, reason);
    SendClientMessageToAll(0xFF5533FF, msg);

    format(msg, sizeof msg,
        "{FF5533}[GunWarn] {FFFFFF}\xC2\xE0\xEC \xE7\xE0\xEF\xF0\xE5\xF9\xE5\xED\xEE \xEE\xF0\xF3\xE6\xE8\xE5 \xED\xE0 %d \xF7\xE0\xF1\xEE\xE2. \xCF\xF0\xE8\xF7\xE8\xED\xE0: %s",
        hours, reason);
    SendClientMessage(targetid, 0xFF5533FF, msg);

    format(msg, sizeof msg, "GWARN: %s[%d] -> %s[%d] \xED\xE0 %d \xF7. \xCF\xF0\xE8\xF7\xE8\xED\xE0: %s",
        GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid, hours, reason);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, msg);
    return 1;
}

CMD:ungwarn(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 7)
        return SendClientMessage(playerid, 0xCECECEFF, "{E0584B}[A] {FFFFFF}\xD3 \xC2\xE0\xF1 \xED\xE5\xF2 \xE4\xEE\xF1\xF2\xF3\xEF\xE0 \xEA \xE0\xE4\xEC\xE8\xED\xE8\xF1\xF2\xF0\xE0\xF2\xE8\xE2\xED\xFB\xEC \xEA\xEE\xEC\xE0\xED\xE4\xE0\xEC.");

    new targetid, reason[64];
    if(sscanf(params, "ds[64]", targetid, reason))
        return SendClientMessage(playerid, 0xCECECEFF, "{FFFFFF}\xC8\xF1\xEF\xEE\xEB\xFC\xE7\xF3\xE9\xF2\xE5: /ungwarn [ID] [\xEF\xF0\xE8\xF7\xE8\xED\xE0]");

    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
        return SendClientMessage(playerid, 0xCECECEFF, "{FFFFFF}\xC8\xE3\xF0\xEE\xEA \xED\xE5 \xED\xE0\xE9\xE4\xE5\xED.");

    if(!GunWarn_IsActive(targetid))
        return SendClientMessage(playerid, 0xCECECEFF, "{FFFFFF}\xD3 \xE8\xE3\xF0\xEE\xEA\xE0 \xED\xE5\xF2 \xE0\xEA\xF2\xE8\xE2\xED\xEE\xE3\xEE GunWarn.");

    if(!strlen(reason))
        return SendClientMessage(playerid, 0xCECECEFF, "{FFFFFF}\xD3\xEA\xE0\xE6\xE8\xF2\xE5 \xEF\xF0\xE8\xF7\xE8\xED\xF3 \xF1\xED\xFF\xF2\xE8\xFF GunWarn.");

    SetPlayerData(targetid, P_GUNWARN_TIME, 0);

    new query[160];
    mysql_format(mysql, query, sizeof query,
        "UPDATE accounts SET gunwarn_time=0 WHERE id=%d LIMIT 1",
        GetPlayerAccountID(targetid));
    mysql_query(mysql, query, false);
    SetPlayerArmedWeapon(targetid, 0);

    new msg[256];
    format(msg, sizeof msg,
        "{66CC33}\xC0\xE4\xEC\xE8\xED\xE8\xF1\xF2\xF0\xE0\xF2\xEE\xF0 {FFFFFF}%s {66CC33}\xF1\xED\xFF\xEB GunWarn \xF1 \xE8\xE3\xF0\xEE\xEA\xE0 {FFFFFF}%s{66CC33}. \xCF\xF0\xE8\xF7\xE8\xED\xE0: {FFFFFF}%s",
        GetPlayerNameEx(playerid), GetPlayerNameEx(targetid), reason);
    SendClientMessageToAll(0x66CC33FF, msg);

    format(msg, sizeof msg, "UNGWARN: %s[%d] -> %s[%d]. \xCF\xF0\xE8\xF7\xE8\xED\xE0: %s",
        GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid, reason);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, msg);
    return 1;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    if(GunWarn_IsActive(playerid) && weaponid != 0)
    {
        SetPlayerArmedWeapon(playerid, 0);
        GunWarn_Show(playerid);
        return 0;
    }
    return 1;
}

stock FamilyBattle_UpdateInteraction(playerid)
{
    if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0 || GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
    {
        DeletePVar(playerid, "family_battle_notify_shown");
        return 0;
    }

    return 1;
}

stock FamilyBattle_HandleNotification(playerid, notify_type, notify_id, notify_sub_id)
{
    #pragma unused notify_sub_id
    if(notify_id != FAMILY_BATTLE_NOTIFY_ID) return 0;
    if(notify_type == 0)
    {
        DeletePVar(playerid, "family_battle_notify_shown");
        return FamilyBattleShowMenu(playerid);
    }
    return 1;
}

stock FamilyBattleEnsureSchema()
{
    new Cache:result = mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS family_battle_rating (family_id INT NOT NULL PRIMARY KEY, points INT NOT NULL DEFAULT 0, wins INT NOT NULL DEFAULT 0, kills INT NOT NULL DEFAULT 0, updated_at INT NOT NULL DEFAULT 0)",
        true
    );
    if(mysql_errno())
    {
        printf("[FAMILY_BATTLE] SQL schema error=%d", mysql_errno());
        cache_delete(result);
        return 0;
    }
    cache_delete(result);
    return 1;
}

stock FamilyBattleIsNearNpc(playerid)
{
    return IsPlayerInRangeOfPoint(playerid, 4.0, -32.473251, 1350.249755, 12.919919);
}

stock FamilyBattleGetRegisteredCount()
{
    new count;
    for(new f; f < MAX_FAM; f++)
    {
        if(g_family_battle_registered[f])
            count++;
    }
    return count;
}

stock FamilyBattleShowMenu(playerid)
{
    new f = GetPlayerIdFamily(playerid);
    new text[700];
    new title[240];
    new registered = FamilyBattleGetRegisteredCount();

    if(f == -1)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "\xc4\xeb\xff \xf3\xf7\xe0\xf1\xf2\xe8\xff \xe2 \xc1\xe8\xf2\xe2\xe5 \xf1\xe5\xec\xe5\xe9 \xed\xe5\xee\xe1\xf5\xee\xe4\xe8\xec\xee \xf1\xee\xf1\xf2\xee\xff\xf2\xfc \xe2 \xf1\xe5\xec\xfc\xe5.", "OK");

    if(!FamilyBattleIsNearNpc(playerid))
        return ShowNotificationNew(playerid, 2, 5, 0, 0, "\xcf\xee\xe4\xee\xe9\xe4\xe8\xf2\xe5 \xea NPC \xab\xc1\xe8\xf2\xe2\xe0 \xf1\xe5\xec\xe5\xe9\xbb.", "OK");

    format(text, sizeof text,
        "{FFFFFF}1. \xc8\xed\xf4\xee\xf0\xec\xe0\xf6\xe8\xff \xee \xc1\xe8\xf2\xe2\xe5 \xf1\xe5\xec\xe5\xe9\n"\
        "{FFFFFF}2. \xc7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xf2\xfc \xf1\xe5\xec\xfc\xfe\n"\
        "{FFFFFF}3. \xc2\xee\xe9\xf2\xe8 \xe2 \xe0\xea\xf2\xe8\xe2\xed\xf3\xfe \xe1\xe8\xf2\xe2\xf3\n"\
        "{FFFFFF}4. \xcf\xee\xea\xe8\xed\xf3\xf2\xfc \xe1\xe8\xf2\xe2\xf3\n"\
        "{FFFFFF}5. \xd0\xe5\xe9\xf2\xe8\xed\xe3 \xf1\xe5\xec\xe5\xe9");

    format(title, sizeof title,
        "{FFCC00}\xc1\xe8\xf2\xe2\xe0 \xf1\xe5\xec\xe5\xe9\n{FFFFFF}\xd1\xf2\xe0\xf2\xf3\xf1: %s | \xc2\xe0\xf8\xe0 \xf1\xe5\xec\xfc\xff: {FFFF00}%s | \xce\xf7\xea\xe8: {00FF66}%d\n{FFFFFF}\xc7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xed\xee: {FFFF00}%d/2",
        g_family_battle_active ? "\xc0\xca\xd2\xc8\xc2\xcd\xc0" : "\xce\xc6\xc8\xc4\xc0\xcd\xc8\xc5",
        GetFamily(f, family_name),
        g_family_battle_score[f],
        registered
    );

    return Dialog(playerid, DIALOG_FAMILY_BATTLE_MENU, DIALOG_STYLE_LIST,
        title, text, "\xc2\xfb\xe1\xf0\xe0\xf2\xfc", "\xc7\xe0\xea\xf0\xfb\xf2\xfc");
}

stock FamilyBattleRegister(playerid)
{
    new f = GetPlayerIdFamily(playerid);
    if(f < 0 || f >= MAX_FAM)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "\xc2\xfb \xed\xe5 \xf1\xee\xf1\xf2\xee\xe8\xf2\xe5 \xe2 \xf1\xe5\xec\xfc\xe5.", "OK");

    if(GetPlayerRangFamily(playerid) != 5)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "\xc7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xf2\xfc \xf1\xe5\xec\xfc\xfe \xec\xee\xe6\xe5\xf2 \xf2\xee\xeb\xfc\xea\xee \xeb\xe8\xe4\xe5\xf0.", "OK");

    if(g_family_battle_active)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "\xd0\xe5\xe3\xe8\xf1\xf2\xf0\xe0\xf6\xe8\xff \xed\xe0 \xf2\xe5\xea\xf3\xf9\xf3\xfe \xc1\xe8\xf2\xe2\xf3 \xf1\xe5\xec\xe5\xe9 \xf3\xe6\xe5 \xe7\xe0\xea\xf0\xfb\xf2\xe0.", "OK");

    if(g_family_battle_registered[f])
        return ShowNotificationNew(playerid, 2, 5, 0, 0, "\xc2\xe0\xf8\xe0 \xf1\xe5\xec\xfc\xff \xf3\xe6\xe5 \xe7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xed\xe0 \xed\xe0 \xf2\xe5\xea\xf3\xf9\xf3\xfe \xc1\xe8\xf2\xe2\xf3.", "OK");

    new registered = FamilyBattleGetRegisteredCount();
    if(registered >= 2)
        return ShowNotificationNew(playerid, 2, 5, 0, 0, "\xc2\xe6\xe5 \xe4\xe2\xe5 \xf1\xe5\xec\xfc\xe8 \xe7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xed\xfb. \xc6\xe4\xe8\xf2\xe5 \xed\xe0\xf7\xe0\xeb\xe0 \xc1\xe8\xf2\xe2\xfb \xf1\xe5\xec\xe5\xe9.", "OK");

    g_family_battle_registered[f] = 1;
    g_family_battle_score[f] = 0;
    g_family_battle_kills[f] = 0;
    registered++;

    new msg[220];
    format(msg, sizeof msg, "\xd1\xe5\xec\xfc\xff %s \xe7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xed\xe0 \xed\xe0 \xf1\xeb\xe5\xe4\xf3\xfe\xf9\xf3\xfe \xc1\xe8\xf2\xe2\xf3 \xf1\xe5\xec\xe5\xe9. \xc7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xed\xee: %d/2.", GetFamily(f, family_name), registered);
    SendFamilyMessage(f, msg);

    if(registered >= 2)
    {
        foreach(new i : Player)
        {
            new pf = GetPlayerIdFamily(i);
            if(pf >= 0 && pf < MAX_FAM && g_family_battle_registered[pf])
                ShowNotificationNew(i, 3, 5, 0, 0, "\xc4\xe2\xe5 \xf1\xe5\xec\xfc\xe8 \xe7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xed\xfb. \xc1\xe8\xf2\xe2\xe0 \xf1\xe5\xec\xe5\xe9 \xed\xe0\xf7\xe8\xed\xe0\xe5\xf2\xf1\xff \xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe0\xf6\xe8\xe5\xe9.", "OK");
        }
        FamilyBattleStart();
    }
    else
    {
        ShowNotificationNew(playerid, 3, 5, 0, 0, "\xd1\xe5\xec\xfc\xff \xe7\xe0\xf0\xe5\xe3\xe8\xf1\xf2\xf0\xe8\xf0\xee\xe2\xe0\xed\xe0. \xd2\xe5\xef\xe5\xf0\xfc \xed\xf3\xe6\xed\xe0 \xe5\xf9\xb8 \xee\xe4\xed\xe0 \xf1\xe5\xec\xfc\xff.", "OK");
    }
    return 1;
}

stock FamilyBattleSavePosition(playerid)
{
    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);
    SetPVarFloat(playerid, "fb_prev_x", x);
    SetPVarFloat(playerid, "fb_prev_y", y);
    SetPVarFloat(playerid, "fb_prev_z", z);
    SetPVarFloat(playerid, "fb_prev_a", a);
    SetPVarInt(playerid, "fb_prev_vw", GetPlayerVirtualWorld(playerid));
    SetPVarInt(playerid, "fb_prev_int", GetPlayerInterior(playerid));
    return 1;
}

stock FamilyBattleRestorePosition(playerid)
{
    if(!GetPVarInt(playerid, "fb_saved"))
        return 0;

    SetPlayerInterior(playerid, GetPVarInt(playerid, "fb_prev_int"));
    SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "fb_prev_vw"));
    SetPlayerPos(playerid,
        GetPVarFloat(playerid, "fb_prev_x"),
        GetPVarFloat(playerid, "fb_prev_y"),
        GetPVarFloat(playerid, "fb_prev_z")
    );
    SetPlayerFacingAngle(playerid, GetPVarFloat(playerid, "fb_prev_a"));
    SetCameraBehindPlayer(playerid);
    return 1;
}

stock FamilyBattleHideZoneForPlayer(playerid)
{
    if(g_family_battle_zone != -1)
        GangZoneHideForPlayer(playerid, g_family_battle_zone);
    DisablePlayerCheckpoint(playerid);
    return 1;
}

stock FamilyBattleExitPlayer(playerid, bool:notify = true)
{
    if(!GetPVarInt(playerid, "family_battle_member"))
        return 0;

    FamilyBattleHideZoneForPlayer(playerid);
    FamilyBattleRestorePosition(playerid);
    ResetPlayerWeapons(playerid);
    DeletePVar(playerid, "family_battle_member");
    DeletePVar(playerid, "fb_saved");
    DeletePVar(playerid, "fb_respawn_pending");
    DeletePVar(playerid, "fb_respawn_tick");
    DeletePVar(playerid, "fb_respawn_x");
    DeletePVar(playerid, "fb_respawn_y");
    DeletePVar(playerid, "fb_respawn_z");

    if(notify)
        ShowNotificationNew(playerid, 3, 5, 0, 0, "Вы покинули Битву семей.", "OK");

    return 1;
}

stock FamilyBattleEnterPlayer(playerid)
{
    new f = GetPlayerIdFamily(playerid);
    if(f == -1)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Вы не состоите в семье.", "OK");

    if(!g_family_battle_active)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Сейчас Битва семей не проводится.", "OK");

    if(!g_family_battle_registered[f])
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Ваша семья не зарегистрирована на эту битву.", "OK");

    if(GetPVarInt(playerid, "family_battle_member"))
        return ShowNotificationNew(playerid, 2, 5, 0, 0, "Вы уже участвуете в Битве семей.", "OK");

    FamilyBattleSavePosition(playerid);
    SetPVarInt(playerid, "fb_saved", 1);
    SetPVarInt(playerid, "family_battle_member", 1);
    DeletePVar(playerid, "fb_respawn_pending");
    DeletePVar(playerid, "fb_respawn_tick");
    FamilyBattle_DisableAgm(playerid);

    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, FAMILY_BATTLE_WORLD);
    // Arena location from the supplied in-game coordinates; split teams across opposite sides.
    if((f % 2) == 0)
        SetPlayerPos(playerid, -120.0 + float(random(8)), 1410.0 + float(random(12)), 15.399374);
    else
        SetPlayerPos(playerid, -102.0 + float(random(8)), 1420.0 + float(random(12)), 15.399374);
    SetPlayerFacingAngle(playerid, 352.471099);
    SetCameraBehindPlayer(playerid);
    ResetPlayerWeapons(playerid);
    GivePlayerWeapon(playerid, 24, 2000);
    SetPlayerArmedWeapon(playerid, 24);

    if(g_family_battle_zone != -1)
    {
        GangZoneShowForPlayer(playerid, g_family_battle_zone, 0xFF0000AA);
        GangZoneFlashForPlayer(playerid, g_family_battle_zone, 0xFFFF00AA);
    }
    SetPlayerCheckpoint(playerid, -111.010421, 1416.870605, 15.399374, 35.0);

    ShowNotificationNew(playerid, 3, 6, 0, 0, "Вы вошли в Битву семей. Очки начисляются за время в зоне и нокауты.", "OK");
    return 1;
}

stock FamilyBattleShowRating(playerid)
{
    new Cache:result = mysql_query(mysql,
        "SELECT r.family_id, f.name, r.points, r.wins, r.kills FROM family_battle_rating r LEFT JOIN familynew f ON f.id=r.family_id ORDER BY r.points DESC, r.wins DESC, r.kills DESC LIMIT 10",
        true
    );

    if(mysql_errno())
    {
        cache_delete(result);
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Не удалось загрузить рейтинг семей.", "OK");
    }

    new rows = cache_num_rows();
    new text[2200], name[40], rank_line[180];
    text[0] = EOS;

    if(!rows)
    {
        strcat(text, "Рейтинг пока пуст.\n");
    }
    else
    {
        for(new i; i < rows; i++)
        {
            cache_get_field_content(i, "name", name, mysql, sizeof name);
            new points = cache_get_field_content_int(i, "points");
            new wins = cache_get_field_content_int(i, "wins");
            new kills = cache_get_field_content_int(i, "kills");

            format(rank_line, sizeof rank_line, "{FFFF00}%d.{FFFFFF} %s  |  %d очков  |  побед: %d  |  нокаутов: %d\n",
                i + 1, name, points, wins, kills);
            strcat(text, rank_line);
        }
    }

    cache_delete(result);
    return Dialog(playerid, DIALOG_FAMILY_BATTLE_RATING, DIALOG_STYLE_MSGBOX,
        "{FFCC00}Рейтинг семей", text, "Назад", "");
}

stock FamilyBattleStart()
{
    if(g_family_battle_active)
        return 0;

    new registered;
    for(new f; f < MAX_FAM; f++)
    {
        if(!g_family_battle_registered[f]) continue;
        if(GetFamily(f, family_database) == -1)
        {
            g_family_battle_registered[f] = 0;
            continue;
        }
        g_family_battle_score[f] = 0;
        g_family_battle_kills[f] = 0;
        registered++;
    }

    if(registered < 2)
    {
        printf("[FAMILY_BATTLE] not started: registered=%d, need at least 2 families", registered);
        return 0;
    }

    g_family_battle_active = true;
    g_family_battle_left = FAMILY_BATTLE_DURATION;

    if(g_family_battle_area == -1)
    {
        g_family_battle_area = CreateDynamicRectangle(
            -132.0, 1395.0,
            -90.0, 1440.0,
            FAMILY_BATTLE_WORLD, 0
        );
    }

    if(g_family_battle_zone == -1)
        g_family_battle_zone = GangZoneCreate(-132.0, 1395.0, -90.0, 1440.0);

    foreach(new i : Player)
    {
        new f = GetPlayerIdFamily(i);
        if(f == -1 || !g_family_battle_registered[f]) continue;
        SendFamilyMessage(f, "Битва семей началась! Всем участникам выдан Desert Eagle с 2000 патронов.");
        if(!GetPVarInt(i, "family_battle_member"))
            FamilyBattleEnterPlayer(i);
        ShowNotificationNew(i, 4, 6, 0, 0, "Битва семей началась! Время: 15 минут.", "OK");
    }

    printf("[FAMILY_BATTLE] started, registered=%d", registered);
    return 1;
}

stock FamilyBattleEnd()
{
    if(!g_family_battle_active)
        return 0;

    g_family_battle_active = false;

    new winner = -1, winner_score = -1;
    for(new f; f < MAX_FAM; f++)
    {
        if(!g_family_battle_registered[f]) continue;
        if(g_family_battle_score[f] > winner_score)
        {
            winner = f;
            winner_score = g_family_battle_score[f];
        }
    }

    if(winner != -1)
    {
        new result_msg[512];
        format(result_msg, sizeof result_msg,
            "Битва семей завершена! Победила семья %s с результатом %d очков.",
            GetFamily(winner, family_name), winner_score
        );
        SendClientMessageToAll(0xFFCC00FF, result_msg);
    }

    for(new f; f < MAX_FAM; f++)
    {
        if(!g_family_battle_registered[f]) continue;
        new points = g_family_battle_score[f];
        new kills = g_family_battle_kills[f];
        if(points <= 0 && kills <= 0) continue;

        new query[420];
        mysql_format(mysql, query, sizeof query,
            "INSERT INTO family_battle_rating (family_id,points,wins,kills,updated_at) VALUES (%d,%d,%d,%d,%d) ON DUPLICATE KEY UPDATE points=points+VALUES(points), wins=wins+VALUES(wins), kills=kills+VALUES(kills), updated_at=VALUES(updated_at)",
            GetFamily(f, family_database), points, (f == winner), kills, gettime()
        );
        mysql_tquery(mysql, query);

        if(points > 0)
        {
            AddFamily(f, family_reputation, +, points / 2);
            AddFamily(f, family_moneti, +, points / 10);
            UpdateColumnFamilyInt(GetFamily(f, family_database), "reputation", GetFamily(f, family_reputation));
            UpdateColumnFamilyInt(GetFamily(f, family_database), "moneti", GetFamily(f, family_moneti));
        }
    }

    foreach(new i : Player)
    {
        if(GetPVarInt(i, "family_battle_member"))
            FamilyBattleExitPlayer(i, false);
        g_family_battle_player_score[i] = 0;
    }

    if(g_family_battle_area != -1)
    {
        DestroyDynamicArea(g_family_battle_area);
        g_family_battle_area = -1;
    }

    if(g_family_battle_zone != -1)
    {
        GangZoneDestroy(g_family_battle_zone);
        g_family_battle_zone = -1;
    }

    for(new f; f < MAX_FAM; f++)
    {
        g_family_battle_registered[f] = 0;
        g_family_battle_score[f] = 0;
        g_family_battle_kills[f] = 0;
    }

    g_family_battle_left = 0;
    printf("[FAMILY_BATTLE] ended");
    return 1;
}

public FamilyBattleTick()
{
    if(!g_family_battle_active)
        return 1;

    if(g_family_battle_left <= 0)
        return FamilyBattleEnd();

    g_family_battle_left -= FAMILY_BATTLE_TICK;

    foreach(new i : Player)
    {
        if(!GetPVarInt(i, "family_battle_member")) continue;

        if(GetPlayerIdFamily(i) == -1 || GetPlayerVirtualWorld(i) != FAMILY_BATTLE_WORLD)
        {
            FamilyBattleExitPlayer(i);
            continue;
        }

        if(!IsPlayerInDynamicArea(i, g_family_battle_area))
        {
            FamilyBattleExitPlayer(i);
            continue;
        }

        if(IsPlayerAFK(i)) continue;

        new f = GetPlayerIdFamily(i);
        g_family_battle_score[f]++;
        g_family_battle_player_score[i]++;
    }

    if(g_family_battle_left > 0 && (g_family_battle_left % 30) == 0)
    {
        foreach(new i : Player)
        {
            if(!GetPVarInt(i, "family_battle_member")) continue;
            new f = GetPlayerIdFamily(i);
            if(f == -1) continue;
            new msg[160];
            format(msg, sizeof msg, "Битва семей: осталось %d сек. | Ваша семья: %d очков.", g_family_battle_left, g_family_battle_score[f]);
            ShowNotificationNew(i, 4, 5, 0, 0, msg, "OK");
        }
    }

    if(g_family_battle_left <= 0)
        return FamilyBattleEnd();

    return 1;
}

public FamilyBattleRespawn(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(!g_family_battle_active || !GetPVarInt(playerid, "family_battle_member")) return 0;

    // Clear any wound/death overlay only for this family-battle respawn.
    WoundReset(playerid);
    WoundClose(playerid);
    WoundFadeHide(playerid);
    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, true);
    DeletePVar(playerid, "death_to_regular_spawn");
    DeletePVar(playerid, "spawn_case1_twice");

    // Pick and configure the actual spawn BEFORE SpawnPlayer. This prevents
    // the normal city spawn and its dark/death transition from being displayed.
    new Float:fb_x, Float:fb_y, Float:fb_z;
    // Family Battle always uses one fixed respawn point.
    fb_x = -111.156661;
    fb_y = 1419.539184;
    fb_z = 10.408114;
    SetPVarFloat(playerid, "fb_respawn_x", fb_x);
    SetPVarFloat(playerid, "fb_respawn_y", fb_y);
    SetPVarFloat(playerid, "fb_respawn_z", fb_z);
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, FAMILY_BATTLE_WORLD);
    SetSpawnInfo(playerid, 0, GetPlayerSkinEx(playerid), fb_x, fb_y, fb_z, float(random(360)), 24, 2000, 0, 0, 0, 0);
    SpawnPlayer(playerid);
    // The top-level OnPlayerSpawn wrapper reapplies arena state after all chained handlers.
    return 1;
}

stock FamilyBattleOnDisconnect(playerid)
{
    g_family_battle_player_score[playerid] = 0;
    DeletePVar(playerid, "family_battle_member");
    DeletePVar(playerid, "fb_saved");
    DeletePVar(playerid, "fb_respawn_pending");
    DeletePVar(playerid, "fb_respawn_tick");
    return 1;
}

CMD:fambattle(playerid)
{
    return FamilyBattleShowMenu(playerid);
}

CMD:leavebattle(playerid)
{
    if(GetPVarInt(playerid, "family_battle_member"))
        return FamilyBattleExitPlayer(playerid);

    return ShowNotificationNew(playerid, 2, 5, 0, 0, "Вы не участвуете в Битве семей.", "OK");
}

