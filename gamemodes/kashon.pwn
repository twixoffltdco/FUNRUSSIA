new bool:gDuelStatsLoaded[MAX_PLAYERS];

public OnPlayerSpawn(playerid)
{
    TaxiPark_HandleOnPlayerSpawn(playerid);
    new now_tick = GetTickCount();
    new delta_tick = now_tick - g_spawn_callback_tick[playerid];
    if(!(g_family_battle_active && GetPVarInt(playerid, "family_battle_member"))
        && g_spawn_callback_tick[playerid] != 0 && delta_tick >= 0 && delta_tick < 750)
    {
        printf("[SPAWN][DUP_CALLBACK] ignored player=%d dt=%d state=%d int=%d vw=%d",
            playerid, delta_tick, GetPlayerState(playerid), GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
        return 1;
    }
    g_spawn_callback_tick[playerid] = now_tick;
    if(GetPVarInt(playerid, "spawn_select_once") == 1)
        g_spawn_request_block_tick[playerid] = now_tick;

    SetPVarInt(playerid, "player_state_pickup", false);
    AutumnEvent_OnSpawn(playerid);

    new spawn_result = 1;
    #if defined fixp_OnPlayerSpawn
        spawn_result = fixp_OnPlayerSpawn(playerid);
    #endif

    // Apply battle state synchronously after all chained spawn handlers.
    // Delayed duplicate spawn timers caused camera snaps and weapon/state races.
    if(g_family_battle_active && GetPVarInt(playerid, "family_battle_member"))
        FamilyBattleApplySpawn(playerid);

    return spawn_result;
}
#if defined _ALS_OnPlayerSpawn
    #undef OnPlayerSpawn
#else
    #define _ALS_OnPlayerSpawn
#endif
#define OnPlayerSpawn fixp_OnPlayerSpawn
#if defined fixp_OnPlayerSpawn
    forward fixp_OnPlayerSpawn(playerid);
#endif

