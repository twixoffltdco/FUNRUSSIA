stock DestroySaleFlatPickups()
{
    for (new i = 0; i < FLATS_FOR_SALE_COUNT; i++)
    {
        if (gFlatSalePickup[i] != 0)
        {
            DestroyPickup(gFlatSalePickup[i]);
            gFlatSalePickup[i] = 0;
        }
    }
    return 1;
}

stock DestroySaleHousePickups()
{
    for (new i = 0; i < HOUSES_FOR_SALE_COUNT; i++)
    {
        if (gHouseSalePickup[i] != 0)
        {
            DestroyPickup(gHouseSalePickup[i]);
            gHouseSalePickup[i] = 0;
        }
    }
    return 1;
}

stock DestroyAllSaleRealtyPickups()
{
    DestroySaleHousePickups();
    return 1;
}

stock SendTurnSignalRPC(playerid, vehicleid, subtype)
{
    new BitStream:bs = BS_New();

    BS_WriteValue(
        bs,
        PR_UINT32, 3,
        PR_UINT16, vehicleid,
        PR_UINT8, subtype
    );

    PR_SendRPC(
        bs,
        playerid,
        97,
        PR_HIGH_PRIORITY,
        PR_RELIABLE_ORDERED
    );

    BS_Delete(bs);
	return 1;
}

public OnIncomingRPC(playerid, rpcid, BitStream:bs)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid)) return 1;

    if (rpcid == 97)
    {
        new firstValue;

        if (!BS_ReadUint32(bs, firstValue))
            return 1;

        if(firstValue == 2)
        {
            new weaponid = GetPlayerWeapon(playerid);
            if(weaponid < 22 || weaponid > 34)
                return 1;

            new tick = GetTickCount();
            if(GetPVarInt(playerid, "mobile_reload_tick") > tick)
                return 0;

            SetPVarInt(playerid, "mobile_reload_tick", tick + 500);

            new slot = GetWeaponSlot(weaponid);
            if(slot < 0 || slot >= MAX_WEAPON_SLOTS)
                return 1;

            new ammo = GetPlayerWeaponInfo(playerid, slot, TRACK_W_AMMO);
            if(ammo <= 0)
                return 1;

            SetPlayerAmmo(playerid, weaponid, ammo);
            SetPlayerArmedWeapon(playerid, weaponid);
            return 0;
        }

        if(firstValue == 3)
        {
            new vehicleid;
            new turnStatus;

            if(!BS_ReadUint16(bs, vehicleid)) return 1;
            if(!BS_ReadUint8(bs, turnStatus)) return 1;

            if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 1;
            if(!IsValidVehicle(vehicleid)) return 1;
            if(GetPlayerVehicleID(playerid) != vehicleid) return 1;
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
            if(turnStatus < 1 || turnStatus > 3) return 1;

            if(TurnSignalState[vehicleid] == turnStatus && TurnSignalDriver[vehicleid] == playerid)
            {
                StopVehicleTurnSignal(vehicleid);
            }
            else
            {
                StopVehicleTurnSignal(vehicleid);
                StartVehicleTurnSignal(playerid, vehicleid, turnStatus);
            }
            return 1;
        }
        if (firstValue == 1)
        {
            new vehicleNetId;
            new Float:damage;
            new damagedPiece;

            if (!BS_ReadUint16(bs, vehicleNetId)) return 1;
            if (!BS_ReadFloat(bs, damage)) return 1;
            if (!BS_ReadUint16(bs, damagedPiece)) return 1;

            new vehicleid = vehicleNetId;
            if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES || !IsValidVehicle(vehicleid)) return 1;
            if(damage != damage || damage <= 0.0 || damage > 1000.0) return 1;
            {
                new tick = GetTickCount();

                if (tick - gLastVehicleDamageTick[playerid] < 600)
                    return 0;

                gLastVehicleDamageTick[playerid] = tick;

                ApplyVehicleDamage(playerid, vehicleid, damage, damagedPiece);
            }
            return 1;
        }

        new action = firstValue;
        new actionSubtype;

        if (action == 14)
        {
            if (!BS_ReadUint8(bs, actionSubtype))
                return 1;

            switch (actionSubtype)
            {
                case 0:
                {
                    BlackPass_OpenTasksScreen(playerid);
                }
                case 1:
                {
                    BlackPass_OpenTasksScreen(playerid);
                }
                case 2:
                {
                    callcmd::donate(playerid);
                }
                case 3:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 4:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 5:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 6:
                {
                    ShowPlayerDialog_Example(playerid);
                }
            }
        }

        switch (action)
        {
            case 3:
            {
            }
            case 4:
            {
                callcmd::radial(playerid);
            }
            case 18:
            {
                if(AutumnEvent_HandleInteraction(playerid)) return 1;

                if(IsPlayerAtATM(playerid))
                {
                    return callcmd::bankomat(playerid, "");
                }

                if (IsPlayerInRangeOfAnyCasinoTable(playerid))
                {
                    return ShowCasinoDiceUi(playerid);
                }

                if (IsPlayerInRangeOfAnyBlackJackTable(playerid))
                {
                    return callcmd::blackjack(playerid);
                }

                if(FsinFull_OnContextInteraction(playerid))
                {
                    return 1;
                }

                if(Construction_TryInteract(playerid))
                {
                    return 1;
                }

                if(HRDepartment_TryInteract(playerid))
                {
                    return 1;
                }

                new hospital_bed = GetNearestMedBed(playerid, 2.8);
                if(hospital_bed != -1 && MedBed_IsPlayerInHospitalArea(playerid))
                {
                    ToggleInteractionWindow(playerid, false);
                    return MedBed_TryOccupy(playerid, hospital_bed);
                }

                if(IsPlayerNearVodolazCaptain(playerid))
                {
                    return callcmd::vodoact(playerid);
                }

                if(IsPlayerNearVodolazLoot(playerid))
                {
                    ToggleInteractionWindow(playerid, false);
                    return callcmd::vodolootyashik(playerid);
                }

                if (IsPlayerNearContainer(playerid))
                {
                    return callcmd::cont(playerid);
                }

                if(IsPlayerNearMotoSalonRange(playerid))
                {
                    DebugMotoSalonLog(playerid, "Interaction:MOTO_RANGE:open_market");
                    ToggleInteractionWindow(playerid, false);
                    return EnterPlayerBuyCarMarket(playerid, STATIC_BIZ_ID_MOTO_SALON);
                }

                return 1;
            }
        }

        return 1;
    }

    return 1;
}
CMD:rewardd(playerid)
{
    new playername[MAX_PLAYER_NAME], debugstr[512];

    GetPlayerName(playerid, playername, sizeof(playername));

    new JSON:root = JSON_Object();
    JSON_SetInt(root, "t", 0);

    new JSON:items = JSON_Array(
        JSON_Object(
            "id", JSON_Int(100),
            "n", JSON_String("Тестовый скин Дракона"),
            "td", JSON_Int(2),
            "st", JSON_Int(0),
            "el", JSON_Int(134),
            "c", JSON_Int(123),
            "ds", JSON_Int(0),
            "sp", JSON_Int(500),
            "r", JSON_Int(3),
            "ct", JSON_Int(1),
            "els", JSON_Array()
        ),
        JSON_Object(
            "id", JSON_Int(26),
            "n", JSON_String("LEXUS IS500F PERFOMANCE"),
            "td", JSON_Int(5),
            "st", JSON_Int(0),
            "el", JSON_Int(28697),
            "c", JSON_Int(0),
            "ds", JSON_Int(0),
            "sp", JSON_Int(450),
            "r", JSON_Int(4),
            "ct", JSON_Int(1),
            "els", JSON_Array()
        ),
        JSON_Object(
            "id", JSON_Int(101),
            "n", JSON_String("Редкий автомобиль"),
            "td", JSON_Int(5),
            "st", JSON_Int(30),
            "el", JSON_Int(9212),
            "c", JSON_Int(0),
            "ds", JSON_Int(7),
            "sp", JSON_Int(1000),
            "r", JSON_Int(4),
            "ct", JSON_Int(1),
            "els", JSON_Array()
        ),
        JSON_Object(
            "id", JSON_Int(102),
            "n", JSON_String("VIP статус"),
            "td", JSON_Int(9),
            "st", JSON_Int(0),
            "el", JSON_Int(0),
            "c", JSON_Int(0),
            "ds", JSON_Int(30),
            "sp", JSON_Int(200),
            "r", JSON_Int(2),
            "ct", JSON_Int(1),
            "els", JSON_Array()
        ),
        JSON_Object(
            "id", JSON_Int(9),
            "n", JSON_String("Вика Отличница"),
            "td", JSON_Int(11),
            "st", JSON_Int(0),
            "el", JSON_Int(134),
            "c", JSON_Int(5500044),
            "ds", JSON_Int(0),
            "sp", JSON_Int(160),
            "r", JSON_Int(3),
            "ct", JSON_Int(1),
            "els", JSON_Array()
        )
    );
    JSON_SetArray(root, "pr", items);

    new JSON:alarms = JSON_Array(
        JSON_Int(1),
        JSON_Int(2),
        JSON_Int(3),
        JSON_Int(4),
        JSON_Int(5),
        JSON_Int(6),
        JSON_Int(7),
        JSON_Int(11)
    );
    JSON_SetArray(root, "fl", alarms);

    JSON_Stringify(root, debugstr, sizeof(debugstr));
    format(debugstr, sizeof(debugstr), "[LOG] Игрок %s (ID: %d) вызвал /rewardd с JSON: %s", playername, playerid, debugstr);
    print(debugstr);

    new kills = GetPlayerScore(playerid);
    new deaths = 0;
    new score = GetPlayerScore(playerid);
    new money = GetPlayerMoney(playerid);

    format(debugstr, sizeof(debugstr), "Ник: %s | Убийства: %d | Смерти: %d | Счет: %d | Деньги: %d", playername, kills, deaths, score, money);
    SendClientMessage(playerid, -1, debugstr);
    SendClientMessage(playerid, -1, "Тестовые предметы: Скин Дракона, Lexus IS500F, Автомобиль, VIP статус, Вика Отличница");

    ShowPlayerGUI(playerid, BpRewardsGuiFragment, root);
    SendClientMessage(playerid, -1, "BP Rewards: Меню наград открыто с 5 тестовыми предметами");

    JSON_Cleanup(root);
    return 1;
}

forward OnSkinSaved(playerid);
public OnSkinSaved(playerid)
{
    printf("[DB] Скин успешно сохранен для игрока ID: %d", playerid);
    return 1;
}

stock LoadPlayerSkin(playerid)
{
    new query[128];
    mysql_format(mysql, query, sizeof(query),
        "SELECT skin_model, skin_name FROM player_skins WHERE player_id = %d ORDER BY obtained_date DESC LIMIT 1",
        playerid
    );
    mysql_tquery(mysql, query, "OnPlayerSkinLoaded", "i", playerid);
}

forward OnPlayerSkinLoaded(playerid);
public OnPlayerSkinLoaded(playerid)
{
    if(cache_num_rows() > 0)
    {
        new skinModel, skinName[128];

        cache_get_field_content(0, "skin_model", skinName, mysql, sizeof(skinName));
        skinModel = strval(skinName);

        cache_get_field_content(0, "skin_name", skinName, mysql, sizeof(skinName));

        SetPlayerSkin(playerid, skinModel);

        new msg[128];
        format(msg, sizeof(msg), "Ваш скин восстановлен: %s (модель: %d)", skinName, skinModel);
        SendClientMessage(playerid, -1, msg);

        printf("[DB] Загружен скин %d (%s) для игрока ID: %d", skinModel, skinName, playerid);
    }
    return 1;
}

