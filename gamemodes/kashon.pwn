    mysql_format(mysql, query, sizeof(query),
        "SELECT 1 FROM accessories_players WHERE player_id = %d AND slot = %d AND bone > 0 LIMIT 1",
        account_id, active_slot);

    new Cache:result = mysql_query(mysql, query, true);
