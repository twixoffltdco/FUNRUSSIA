Dialog_Response:TaxiPark_TMenuBoostBuy(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenBoosts(playerid, park_id);
	if(!TaxiPark_IsOwner(playerid, park_id)) return TaxiPark_OpenMainMenu(playerid);
	new boost = GetPVarInt(playerid, "TaxiBoostSel");
	new cost = 200000, need_orders = 50;
	switch(boost)
	{
		case 0: cost = 200000;
		case 1: cost = 200000;
		case 2: cost = 400000;
		case 3: cost = 500000;
		case 4: cost = 1000000;
		default: cost = 500000;
	}
	if(g_TaxiCompany[park_id][TC_BALANCE] < cost)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Недостаточно средств в сейфе компании", "");
		return TaxiPark_OpenBoosts(playerid, park_id);
	}
	if(g_TaxiCompany[park_id][TC_ORDERS] < need_orders)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Недостаточно выполненных заказов компании", "");
		return TaxiPark_OpenBoosts(playerid, park_id);
	}
	g_TaxiCompany[park_id][TC_BALANCE] -= cost;
	g_TaxiCompany[park_id][TC_ORDERS] -= need_orders;
	new until = gettime() + 24 * 3600;
	if(boost == 0) g_TaxiCompany[park_id][TC_BOOST_PROFIT] = until;
	else if(boost == 1) g_TaxiCompany[park_id][TC_BOOST_EXP] = until;
	else if(boost == 2) g_TaxiCompany[park_id][TC_BOOST_RATING] = until;
	else if(boost == 3) g_TaxiCompany[park_id][TC_BOOST_DELIVERY] = until;
	else if(boost == 4) g_TaxiCompany[park_id][TC_BOOST_CLIENT] = until;
	else g_TaxiCompany[park_id][TC_BOOST_FAST] = until;
	TaxiPark_SaveCompany(park_id);
	ShowNotificationNew(playerid, 3, 5, 0, 0, "Буст успешно приобретён на 24 часа", "");
	return TaxiPark_OpenBoosts(playerid, park_id);
}

