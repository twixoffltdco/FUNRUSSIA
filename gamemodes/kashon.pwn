		        {
		            case 1: Dialog(playerid, DIALOG_LEADER_MENU_UNINVITE, DIALOG_STYLE_INPUT,"Панель лидера","Введите имя сотрудника, которого хотите уволить!","Ввести","Закрыть");
				case 2: callcmd::showall(playerid, "");
				case 3: Dialog(playerid, DIALOG_LEADER_MENU_JOBS,DIALOG_STYLE_LIST,"Панель лидера","1. Создать вакансию\n2. Удалить вакансию","Выбрать","Закрыть");
				case 4: OrgWarehouse_ShowManageDialog(playerid);
		        }
		    }

			case DIALOG_LMENU_MAIN:
			{
				if(!response) return 1;
				switch(listitem)
				{
					case 0: Dialog(playerid, DIALOG_LMENU_COMPOSITION, DIALOG_STYLE_LIST, "Управление составом", "Пригласить сотрудника\nУволить сотрудника\nСписок сотрудников\nИзменить ранг\nУправление вакансиями", "Выбрать", "Назад");
					case 1: LeaderMenu_ShowFleet(playerid, GetPlayerTeamEx(playerid) - 1);
					case 2: OrgWarehouse_ShowManageDialog(playerid);
					case 3: Dialog(playerid, DIALOG_LMENU_FRACTION, DIALOG_STYLE_LIST, "Настройки фракции", "Объявление для состава\nИнформация о фракции", "Выбрать", "Назад");
					case 4: Dialog(playerid, DIALOG_LMENU_RANKS, DIALOG_STYLE_LIST, "Настройки рангов", "Изменить ранг сотрудника\nСписок сотрудников", "Выбрать", "Назад");
					case 5: Dialog(playerid, DIALOG_LMENU_EVENTS, DIALOG_STYLE_LIST, "Мероприятия", "Создать собеседование\nУдалить собеседование\nЖурнал вакансий", "Выбрать", "Назад");
					case 6: Dialog(playerid, DIALOG_LMENU_OTHER, DIALOG_STYLE_LIST, "Другие настройки", "Открыть список сотрудников\nУправление вакансиями", "Выбрать", "Назад");
				}
			}


            case DIALOG_LMENU_FLEET:
            {
                if(!response) return callcmd::lmenu(playerid);
                new action_id = GetPlayerListitemValue(playerid, 0);
                if(action_id < 0 || action_id >= sizeof(g_org_car)) return callcmd::lmenu(playerid);
                if(listitem == 4) return LeaderMenu_ShowFleetRankSettings(playerid, action_id);
                if(listitem < 0 || listitem >= 4 || g_org_car[action_id][O_MODEL][listitem] == 0) return LeaderMenu_ShowFleet(playerid, action_id);
                if(GetPlayerJob(playerid) < g_org_car_use_rank[action_id][listitem])
                {
                    new msg[160];
                    format(msg, sizeof(msg), "Для этого автомобиля нужен минимум %d ранг.", g_org_car_use_rank[action_id][listitem]);
                    SendClientMessage(playerid, -1, msg);
                    return LeaderMenu_ShowFleet(playerid, action_id);
                }
                // Используем существующий диалог выдачи автопарка, сохраняя выбранный слот.
                g_lmenu_fleet_pick[playerid] = true;
                g_lmenu_fleet_slot[playerid] = listitem;
                SetPlayerListitemValue(playerid, 0, action_id);
                new fleet_list[512], fleet_line[96];
                fleet_list[0] = EOS;
                new selected_model[64];
                GetVehicleModelName(g_org_car[action_id][O_MODEL][listitem], selected_model, sizeof(selected_model));
                format(fleet_line, sizeof(fleet_line), "{FFFFFF}%s\t{AAAAAA}с %d ранга\n", selected_model, g_org_car_use_rank[action_id][listitem]);
                strcat(fleet_list, fleet_line);
                return Dialog(playerid, DIALOG_ORG_CAR_GET, DIALOG_STYLE_LIST, g_org_car[action_id][O_NAME], fleet_list, "Выбрать", "Отмена");
            }

            case DIALOG_LMENU_FLEET_RANK:
            {
                if(!response) return LeaderMenu_ShowFleet(playerid, GetPlayerTeamEx(playerid) - 1);
                new action_id = GetPlayerListitemValue(playerid, 0);
                if(action_id < 0 || action_id >= sizeof(g_org_car)) return 1;
                if(listitem < 0 || listitem >= 4 || g_org_car[action_id][O_MODEL][listitem] == 0) return LeaderMenu_ShowFleetRankSettings(playerid, action_id);
                g_lmenu_fleet_action[playerid] = action_id;
                g_lmenu_fleet_slot[playerid] = listitem;
                new model_name[64], text[180];
                GetVehicleModelName(g_org_car[action_id][O_MODEL][listitem], model_name, sizeof(model_name));
                format(text, sizeof(text), "Автомобиль: %s\nТекущий минимальный ранг: %d\n\nВведите новый минимальный ранг (1-10):", model_name, g_org_car_use_rank[action_id][listitem]);
                return Dialog(playerid, DIALOG_LMENU_FLEET_RANK + 1, DIALOG_STYLE_INPUT, "Настройка доступа к автопарку", text, "Сохранить", "Назад");
            }

            case DIALOG_LMENU_FLEET_RANK + 1:
            {
                new action_id = g_lmenu_fleet_action[playerid];
                new slot = g_lmenu_fleet_slot[playerid];
                if(action_id < 0 || action_id >= sizeof(g_org_car) || slot < 0 || slot >= 4 || g_org_car[action_id][O_MODEL][slot] == 0)
                    return callcmd::lmenu(playerid);
                if(!response) return LeaderMenu_ShowFleetRankSettings(playerid, action_id);

                new rank = strval(inputtext);
                if(rank < 1 || rank > 10)
                {
                    return Dialog(playerid, DIALOG_LMENU_FLEET_RANK + 1, DIALOG_STYLE_INPUT, "\xcd\xe0\xf1\xf2\xf0\xee\xe9\xea\xe0 \xe4\xee\xf1\xf2\xf3\xef\xe0 \xea \xe0\xe2\xf2\xee\xef\xe0\xf0\xea\xf3", "\xc2\xe2\xe5\xe4\xe8\xf2\xe5 \xea\xee\xf0\xf0\xe5\xea\xf2\xed\xfb\xe9 \xec\xe8\xed\xe8\xec\xe0\xeb\xfc\xed\xfb\xe9 \xf0\xe0\xed\xe3 \xee\xf2 1 \xe4\xee 10:", "\xd1\xee\xf5\xf0\xe0\xed\xe8\xf2\xfc", "\xcd\xe0\xe7\xe0\xe4");
                }

                // Bugatti Divo 2570 always requires rank 7.
                if(g_org_car[action_id][O_MODEL][slot] == 2570)
                    rank = 7;

                g_org_car_use_rank[action_id][slot] = rank;

                new confirm[144], model_name[64];
                GetVehicleModelName(g_org_car[action_id][O_MODEL][slot], model_name, sizeof(model_name));
                format(confirm, sizeof(confirm), "\xd0\xe0\xed\xe3 \xe4\xee\xf1\xf2\xf3\xef\xe0 \xea %s \xf3\xf1\xef\xe8\xf8\xed\xee \xf3\xf1\xf2\xe0\xed\xee\xe2\xeb\xe5\xed: %d.", model_name, rank);
                SendClientMessage(playerid, 0x66CC66FF, confirm);
                return LeaderMenu_ShowFleetRankSettings(playerid, action_id);
            }

			case DIALOG_LMENU_COMPOSITION:
			{
				if(!response) return callcmd::lmenu(playerid);
				switch(listitem)
				{
					case 0: Dialog(playerid, DIALOG_LMENU_INVITE, DIALOG_STYLE_INPUT, "Приглашение", "Введите ID игрока, которого хотите пригласить:", "Пригласить", "Назад");
					case 1: Dialog(playerid, DIALOG_LMENU_UNINVITE, DIALOG_STYLE_INPUT, "Увольнение", "Введите: ID причина", "Уволить", "Назад");
					case 2: callcmd::showall(playerid, "");
					case 3: Dialog(playerid, DIALOG_LMENU_RANG, DIALOG_STYLE_INPUT, "Изменение ранга", "Введите: ID + или ID -", "Изменить", "Назад");
					case 4: Dialog(playerid, DIALOG_LEADER_MENU_JOBS, DIALOG_STYLE_LIST, "Вакансии", "Создать вакансию\nУдалить вакансию", "Выбрать", "Назад");
				}
			}

			case DIALOG_LMENU_FRACTION:
			{
				if(!response) return callcmd::lmenu(playerid);
				if(listitem == 0) Dialog(playerid, DIALOG_LMENU_ANNOUNCE, DIALOG_STYLE_INPUT, "Объявление фракции", "Введите текст объявления для всего состава:", "Отправить", "Назад");
				else { new text[256]; format(text, sizeof(text), "Фракция: %s\nВаш ранг: %d", GetTeamName(GetPlayerTeamEx(playerid)), GetPlayerJob(playerid)); Dialog(playerid, DIALOG_LMENU_FRACTION, DIALOG_STYLE_MSGBOX, "Информация о фракции", text, "Назад", ""); }
			}

			case DIALOG_LMENU_RANKS:
