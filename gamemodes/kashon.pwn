Dialog_Response:TaxiPark_TMenuSafe(playerid, response, listitem, inputtext[])
{
	if(!response) return TaxiPark_OpenMainMenu(playerid);
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	switch(listitem)
	{
		case 0:
		{
			new caption[72], info[280], y, m, d, h, mi, s;
			getdate(y, m, d);
			gettime(h, mi, s);
			format(caption, sizeof caption, "BLACK RUSSIA | %s", "Содержимое сейфа");
			format(info, sizeof info,
				"%s: %s\n%s: %d %s\n\n%s: %02d.%02d.%04d - %02d:%02d:%02d",
				"Таксокомпания", g_TaxiPark[park_id][TP_NAME],
				"Содержимое сейфа", g_TaxiCompany[park_id][TC_BALANCE], "рублей",
				"Дата и время", d, m, y, h, mi, s);
			Dialog_Open(playerid, "TaxiPark_TMenuSafeBack", DIALOG_STYLE_MSGBOX, caption, info, "Назад", "");
		}
		case 1:
		{
			new caption[72], info[160];
			format(caption, sizeof caption, "BLACK RUSSIA | %s", "Пополнение сейфа компании");
			format(info, sizeof info, "%s", "Введите сумму которую хотите пополнить:");
			Dialog_Open(playerid, "TaxiPark_TMenuSafeDeposit", DIALOG_STYLE_INPUT, caption, info, "Пополнить", "Назад");
		}
		case 2:
		{
			if(!TaxiPark_IsOwner(playerid, park_id))
			{
				ShowNotificationNew(playerid, 2, 5, 0, 0, "Взаимодействовать с этим может только директор", "");
				return TaxiPark_OpenSafeMenu(playerid, park_id);
			}
			new caption[72], info[220];
			format(caption, sizeof caption, "BLACK RUSSIA | %s", "Снятие денег с сейфа");
			format(info, sizeof info,
				"%s\n%s\n\n%s: %d",
				"Введите сумму которую хотите снять с сейфа таксопарка",
				"Примечание: сумма должна быть не больше 3000000 руб за раз",
				"Доступно", g_TaxiCompany[park_id][TC_BALANCE]);
			Dialog_Open(playerid, "TaxiPark_TMenuSafeWithdraw", DIALOG_STYLE_INPUT, caption, info, "Снять", "Назад");
		}
	}
	return 1;
}

Dialog_Response:TaxiPark_TMenuSafeBack(playerid, response, listitem, inputtext[])
{
	#pragma unused response, listitem, inputtext
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	return TaxiPark_OpenSafeMenu(playerid, park_id);
}

Dialog_Response:TaxiPark_TMenuSafeDeposit(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenSafeMenu(playerid, park_id);
	new amount = strval(inputtext);
	if(amount <= 0)
	{
		ShowNotificationNew(playerid, 2, 4, 0, 0, "Некорректная сумма", "");
		return TaxiPark_OpenSafeMenu(playerid, park_id);
	}
	if(GetPlayerMoney(playerid) < amount)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Недостаточно денег", "");
		return TaxiPark_OpenSafeMenu(playerid, park_id);
	}
	new maxs = TaxiPark_GetSafeMax(park_id);
	if(g_TaxiCompany[park_id][TC_BALANCE] + amount > maxs)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Превышен лимит сейфа компании", "");
		return TaxiPark_OpenSafeMenu(playerid, park_id);
	}
	GivePlayerMoneyEx(playerid, -amount, "TaxiPark", true, true);
	g_TaxiCompany[park_id][TC_BALANCE] += amount;
	TaxiPark_SaveCompany(park_id);
	new msg[96];
	format(msg, sizeof msg, "%s %d %s", "Вы пополнили", amount, "руб в сейф компании");
	ShowNotificationNew(playerid, 3, 5, 0, 0, msg, "");
	return TaxiPark_OpenSafeMenu(playerid, park_id);
}

Dialog_Response:TaxiPark_TMenuSafeWithdraw(playerid, response, listitem, inputtext[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(!response) return TaxiPark_OpenSafeMenu(playerid, park_id);
	if(!TaxiPark_IsOwner(playerid, park_id))
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Взаимодействовать с этим может только директор", "");
		return TaxiPark_OpenSafeMenu(playerid, park_id);
	}
	new amount = strval(inputtext);
	if(amount <= 0 || amount > 3000000)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Сумма от 1 до 3000000", "");
		return TaxiPark_OpenSafeMenu(playerid, park_id);
	}
	if(amount > g_TaxiCompany[park_id][TC_BALANCE])
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "На балансе сейфа недостаточно средств", "");
		return TaxiPark_OpenSafeMenu(playerid, park_id);
	}
	g_TaxiCompany[park_id][TC_BALANCE] -= amount;
	GivePlayerMoneyEx(playerid, amount, "TaxiPark", true, true);
	TaxiPark_SaveCompany(park_id);
	ShowNotificationNew(playerid, 3, 5, 0, 0, "Вы сняли деньги с сейфа компании", "");
	return TaxiPark_OpenSafeMenu(playerid, park_id);
}

