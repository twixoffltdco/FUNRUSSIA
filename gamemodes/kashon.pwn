Dialog_Response:TaxiPark_TMenuLeave(playerid, response, listitem, inputtext[])
{
	#pragma unused listitem, inputtext
	if(!response) return TaxiPark_OpenMainMenu(playerid);
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(TaxiPark_IsOwner(playerid, park_id))
	{
		ShowNotificationNew(playerid, 2, 6, 0, 0, "Владелец не может просто уйти. Продайте таксопарк государству", "");
		return TaxiPark_OpenMainMenu(playerid);
	}
	TaxiPark_DestroyPlayerVehicle(playerid);
	TaxiPark_CancelOrder(playerid);
	TaxiPark_RemovePlayerJob(playerid);
	ShowNotificationNew(playerid, 3, 5, 0, 0, "Вы покинули таксокомпанию", "");
	return 1;
}



forward TaxiPark_OnBusinessesLoaded();
forward TaxiPark_OnBusinessBought(playerid, businessid);
forward TaxiPark_OnBusinessSold(businessid);

stock TaxiPark_GetParkByBusiness(businessid)
{
	if(businessid < 0) return -1;
	for(new i = 0; i < TAXI_PARK_COUNT; i++)
	{
		if(g_TaxiParkBizID[i] == businessid) return i;
	}
	// Fallback: match by coordinates (within 15m of park enter)
	if(businessid < g_business_loaded)
	{
		new Float: bx = GetBusinessData(businessid, B_POS_X);
		new Float: by = GetBusinessData(businessid, B_POS_Y);
		new Float: bz = GetBusinessData(businessid, B_POS_Z);
		new Float: best = 99999.0;
		new best_id = -1;
		for(new i = 0; i < TAXI_PARK_COUNT; i++)
		{
			new Float: d = GetDistanceBetweenPoints(bx, by, bz, g_TaxiPark[i][TP_ENTER_X], g_TaxiPark[i][TP_ENTER_Y], g_TaxiPark[i][TP_ENTER_Z]);
			if(d < 15.0 && d < best)
			{
				best = d;
				best_id = i;
			}
		}
		if(best_id != -1)
		{
			g_TaxiParkBizID[best_id] = businessid;
			return best_id;
		}
	}
	return -1;
}

stock TaxiPark_SyncOwnerFromBusiness(park_id)
{
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	new biz = g_TaxiParkBizID[park_id];
	if(biz < 0 || biz >= g_business_loaded) return 0;
	new owner_id = GetBusinessData(biz, B_OWNER_ID);
	if(owner_id <= 0)
	{
		g_TaxiCompany[park_id][TC_OWNER_ID] = -1;
		format(g_TaxiCompanyOwnerName[park_id], 24, "%s", "Государство");
	}
	else
	{
		g_TaxiCompany[park_id][TC_OWNER_ID] = owner_id;
		format(g_TaxiCompanyOwnerName[park_id], 24, "%s", GetBusinessData(biz, B_OWNER_NAME));
	}
	g_TaxiCompany[park_id][TC_BALANCE] = GetBusinessData(biz, B_BALANCE);
	TaxiPark_SaveCompany(park_id);
	TaxiPark_UpdateEnterLabelText(park_id);
	return 1;
}

stock TaxiPark_UpdateEnterLabelText(park_id)
{
	#pragma unused park_id
	return 1;
}

stock TaxiPark_EnsureBusinessRow(const name[], Float:x, Float:y, Float:z, Float:ex, Float:ey, Float:ez, Float:ea)
{
	new query[640];
	// Fix any type=18 business near these coords that has empty/wrong name
	mysql_format(mysql, query, sizeof query,
		"UPDATE `business` SET `name`='%e', `x`=%f, `y`=%f, `z`=%f, `exit_x`=%f, `exit_y`=%f, `exit_z`=%f, `exit_angle`=%f, `price`=3000000, `rent_price`=15000, `type`=18 		WHERE `type`=18 AND (ABS(`x`-%f)<5.0 AND ABS(`y`-%f)<5.0) AND (`name`='' OR `name` IS NULL OR `name`!='%e')",
		name, x, y, z, ex, ey, ez, ea, x, y, name);
	mysql_query(mysql, query, false);
	// Insert only if no type=18 with this name AND no type=18 within 5m
	mysql_format(mysql, query, sizeof query,
		"INSERT INTO `business` (`name`,`owner_id`,`improvements`,`products`,`prod_price`,`balance`,`rent_time`,`price`,`rent_price`,`type`,`interior`,`enter_price`,`enter_music`,`lock`,`x`,`y`,`z`,`exit_x`,`exit_y`,`exit_z`,`exit_angle`,`eviction`) 		SELECT '%e',0,0,0,0,0,0,3000000,15000,18,0,0,0,0,%f,%f,%f,%f,%f,%f,%f,0 FROM DUAL 		WHERE NOT EXISTS (SELECT 1 FROM `business` WHERE `type`=18 AND (`name`='%e' OR (ABS(`x`-%f)<5.0 AND ABS(`y`-%f)<5.0)) LIMIT 1)",
		name, x, y, z, ex, ey, ez, ea, name, x, y);
	mysql_query(mysql, query, false);
	return 1;
}

public TaxiPark_OnBusinessesLoaded()
{
	// Migrate old taxi rows: in old mod type=14 was taxi, in new mod 14=Tech Center, 18=TAXI
	mysql_query(mysql, "UPDATE `business` SET `type`=18 WHERE `type`=14 AND (`name` LIKE '%Taxi%' OR `name` LIKE '%taxi%' OR `name`='Ya.Taxi' OR `name`='Black Taxi' OR `name`='Gett Taxi' OR `name`='Yandex' OR `name`='Gett')", false);
	mysql_query(mysql, "UPDATE `business` SET `type`=18 WHERE `type`=14 AND ((ABS(`x`-2223.925781)<5.0 AND ABS(`y`-(-1723.143432))<5.0) OR (ABS(`x`-2415.988281)<5.0 AND ABS(`y`-1394.843750)<5.0) OR (ABS(`x`-381.760650)<5.0 AND ABS(`y`-1372.741333)<5.0))", false);

	TaxiPark_EnsureBusinessRow("Ya.Taxi", 2223.925781, -1723.143432, 22.320137, 2223.755126, -1725.831787, 21.852500, 180.160858);
	TaxiPark_EnsureBusinessRow("Black Taxi", 2415.988281, 1394.843750, 12.687074, 2416.136718, 1392.381958, 12.191487, 178.377014);
	TaxiPark_EnsureBusinessRow("Gett Taxi", 381.760650, 1372.741333, 15.491137, 378.398803, 1373.023193, 15.343087, 80.821083);

	// Remove orphan type=18 rows with empty name (duplicates that break /buybiz)
	mysql_query(mysql, "DELETE FROM `business` WHERE `type`=18 AND (`name`='' OR `name` IS NULL)", false);

	mysql_tquery(mysql, "SELECT b.*, IFNULL(a.name, 'None') AS owner_name FROM business b LEFT JOIN accounts a ON a.id=b.owner_id WHERE b.type=18", "TaxiPark_OnTaxiBizQuery", "");
	return 1;
}

forward TaxiPark_OnTaxiBizQuery();
public TaxiPark_OnTaxiBizQuery()
{
	new rows = cache_num_rows();
	for(new r = 0; r < rows; r++)
	{
		new name[26];
		cache_get_field_content(r, "name", name, mysql, 26);
		new Float: bx = cache_get_field_content_float(r, "x");
		new Float: by = cache_get_field_content_float(r, "y");
		new Float: bz = cache_get_field_content_float(r, "z");
		new park_id = -1;
		if(!strcmp(name, "Ya.Taxi", true) || !strcmp(name, "Yandex", true) || !strcmp(name, "Ya Taxi", true))
			park_id = 0;
		else if(!strcmp(name, "Black Taxi", true) || !strcmp(name, "Black", true))
			park_id = 1;
		else if(!strcmp(name, "Gett Taxi", true) || !strcmp(name, "Gett", true) || !strcmp(name, "Gtaxi", true) || !strcmp(name, "G.Taxi", true))
			park_id = 2;
		if(park_id == -1)
		{
			new Float: best = 99999.0;
			for(new p = 0; p < TAXI_PARK_COUNT; p++)
			{
				new Float: d = GetDistanceBetweenPoints(bx, by, bz, g_TaxiPark[p][TP_ENTER_X], g_TaxiPark[p][TP_ENTER_Y], g_TaxiPark[p][TP_ENTER_Z]);
				if(d < 20.0 && d < best)
				{
					best = d;
					park_id = p;
				}
			}
		}
		if(park_id == -1) continue;

		new correct_name[32];
		format(correct_name, sizeof correct_name, "%s", g_TaxiPark[park_id][TP_NAME]);
		new sql_id = cache_get_field_content_int(r, "id");
		if(strcmp(name, correct_name, true))
		{
			new fixq[200];
			mysql_format(mysql, fixq, sizeof fixq,
				"UPDATE `business` SET `name`='%e', `x`=%f, `y`=%f, `z`=%f WHERE `id`=%d",
				correct_name, g_TaxiPark[park_id][TP_ENTER_X], g_TaxiPark[park_id][TP_ENTER_Y], g_TaxiPark[park_id][TP_ENTER_Z], sql_id);
			mysql_query(mysql, fixq, false);
			format(name, sizeof name, "%s", correct_name);
		}

		// Find already-loaded business: by SQL id OR type=18 near park enter (avoid 2nd slot)
		new biz_idx = -1;
		for(new i = 0; i < g_business_loaded; i++)
		{
			if(GetBusinessData(i, B_SQL_ID) == sql_id)
			{
				biz_idx = i;
				break;
			}
		}
		if(biz_idx == -1)
		{
			for(new i = 0; i < g_business_loaded; i++)
			{
				if(GetBusinessData(i, B_TYPE) != 18) continue;
				new Float: d = GetDistanceBetweenPoints(
					GetBusinessData(i, B_POS_X), GetBusinessData(i, B_POS_Y), GetBusinessData(i, B_POS_Z),
					g_TaxiPark[park_id][TP_ENTER_X], g_TaxiPark[park_id][TP_ENTER_Y], g_TaxiPark[park_id][TP_ENTER_Z]);
				if(d < 8.0)
				{
					biz_idx = i;
					break;
				}
			}
		}

		if(biz_idx == -1)
		{
			// Business not in memory yet — skip creating a second copy.
			// Main business loader already owns labels; only link next restart if needed.
			printf("[TaxiPark] biz sql=%d park=%d not in memory, skip duplicate create", sql_id, park_id);
			continue;
		}

		format(g_business[biz_idx][B_NAME], 24, "%s", g_TaxiPark[park_id][TP_NAME]);
		SetBusinessData(biz_idx, B_POS_X, g_TaxiPark[park_id][TP_ENTER_X]);
		SetBusinessData(biz_idx, B_POS_Y, g_TaxiPark[park_id][TP_ENTER_Y]);
		SetBusinessData(biz_idx, B_POS_Z, g_TaxiPark[park_id][TP_ENTER_Z]);
		SetBusinessData(biz_idx, B_TYPE, 18);
		g_TaxiParkBizID[park_id] = biz_idx;
		TaxiPark_SyncOwnerFromBusiness(park_id);
		CallLocalFunction("UpdateBusinessLabel", "i", biz_idx);
	}

	// Destroy DUPLICATE type=18 labels at same coords (keep first per park)
	for(new i = 0; i < g_business_loaded; i++)
	{
		if(GetBusinessData(i, B_TYPE) != 18) continue;
		for(new j = i + 1; j < g_business_loaded; j++)
		{
			if(GetBusinessData(j, B_TYPE) != 18) continue;
			new Float: d = GetDistanceBetweenPoints(
				GetBusinessData(i, B_POS_X), GetBusinessData(i, B_POS_Y), GetBusinessData(i, B_POS_Z),
				GetBusinessData(j, B_POS_X), GetBusinessData(j, B_POS_Y), GetBusinessData(j, B_POS_Z));
			if(d < 8.0)
			{
				new Text3D:lab = Text3D:GetBusinessData(j, B_LABEL);
				if(_:lab != 0)
				{
					DestroyDynamic3DTextLabel(lab);
					SetBusinessData(j, B_LABEL, 0);
					printf("[TaxiPark] removed duplicate 3D label biz=%d near biz=%d", j, i);
				}
			}
		}
	}

	// DB: delete type=18 rows with empty name or exact coord duplicates (keep lowest id)
	mysql_query(mysql, "DELETE FROM `business` WHERE `type`=18 AND (`name`='' OR `name` IS NULL)", false);
	mysql_query(mysql,
		"DELETE b1 FROM `business` b1 INNER JOIN `business` b2 \
		WHERE b1.type=18 AND b2.type=18 AND b1.id > b2.id \
		AND ABS(b1.x-b2.x)<3.0 AND ABS(b1.y-b2.y)<3.0", false);

	printf("[TaxiPark] Businesses linked: %d %d %d", g_TaxiParkBizID[0], g_TaxiParkBizID[1], g_TaxiParkBizID[2]);
	return 1;
}

public TaxiPark_OnBusinessBought(playerid, businessid)
{
	new park_id = TaxiPark_GetParkByBusiness(businessid);
	if(park_id == -1) return 0;
	// Link and fix name
	g_TaxiParkBizID[park_id] = businessid;
	format(g_business[businessid][B_NAME], 24, "%s", g_TaxiPark[park_id][TP_NAME]);
	new fixq[192];
	mysql_format(mysql, fixq, sizeof fixq, "UPDATE `business` SET `name`='%e' WHERE `id`=%d",
		g_TaxiPark[park_id][TP_NAME], GetBusinessData(businessid, B_SQL_ID));
	mysql_query(mysql, fixq, false);
	GetPlayerName(playerid, g_TaxiCompanyOwnerName[park_id], 24);
	g_TaxiCompany[park_id][TC_OWNER_ID] = GetBusinessData(businessid, B_OWNER_ID);
	g_TaxiCompany[park_id][TC_RENT_DAYS] = 7;
	g_TaxiCompany[park_id][TC_BALANCE] = 0;
	TaxiPark_SaveCompany(park_id);
	CallLocalFunction("UpdateBusinessLabel", "i", businessid);
	// If was employed elsewhere - leave old job first
	new old_job = TaxiPark_GetPlayerJob(playerid);
	if(old_job != -1 && old_job != park_id)
		TaxiPark_RemovePlayerJob(playerid);
	g_TaxiDriverRank[playerid] = TAXI_RANK_DIRECTOR;
	TaxiPark_SetPlayerJob(playerid, park_id);
	new msg[96];
	format(msg, sizeof msg, "%s %s", "Вы приобрели таксокомпанию", g_TaxiPark[park_id][TP_NAME]);
	ShowNotificationNew(playerid, 3, 6, 0, 0, msg, "");
	ShowNotificationNew(playerid, 3, 6, 0, 0, "Управление: /tmenu и /business", "");
	return 1;
}

public TaxiPark_OnBusinessSold(businessid)
{
	new park_id = TaxiPark_GetParkByBusiness(businessid);
	if(park_id == -1) return 0;
	g_TaxiCompany[park_id][TC_OWNER_ID] = -1;
	format(g_TaxiCompanyOwnerName[park_id], 24, "%s", "Государство");
	g_TaxiCompany[park_id][TC_BALANCE] = 0;
	TaxiPark_SaveCompany(park_id);
	return 1;
}



CMD:trank(playerid, params[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1)
	{
		SendClientMessage(playerid, 0xAAAAAAFF, "Введите /trank [id игрока] [id должности] ( 0 - эконом  1 - комфорт 2 - бизнес 3 - заместитель директора)");
		return 1;
	}
	if(!TaxiPark_IsOwner(playerid, park_id) && g_TaxiDriverRank[playerid] != TAXI_RANK_DIRECTOR)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "У вас нету прав на использование этой команды", "");
		return 1;
	}
	new target_id, rank_id;
	if(sscanf(params, "ii", target_id, rank_id))
	{
		SendClientMessage(playerid, 0xAAAAAAFF, "Введите /trank [id игрока] [id должности] ( 0 - эконом  1 - комфорт 2 - бизнес 3 - заместитель директора)");
		return 1;
	}
	if(!IsPlayerConnected(target_id))
	{
		ShowNotificationNew(playerid, 2, 4, 0, 0, "Игрок не в сети", "");
		return 1;
	}
	if(TaxiPark_GetPlayerJob(target_id) != park_id)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Данного игрока нет в списке работников таксопарка", "");
		return 1;
	}
	if(rank_id < 0 || rank_id > 3)
	{
		ShowNotificationNew(playerid, 2, 4, 0, 0, "ID должности: 0-3", "");
		return 1;
	}
	TaxiPark_SetPlayerRank(target_id, rank_id);
	new tname[24], msg[128];
	GetPlayerName(target_id, tname, sizeof tname);
	format(msg, sizeof msg, "%s %s %s %s", "Вы выдали ранг", g_TaxiRankNames[park_id][rank_id], "игроку", tname);
	ShowNotificationNew(playerid, 3, 5, 0, 0, msg, "");
	format(msg, sizeof msg, "%s %s", "Вам выдан ранг", g_TaxiRankNames[park_id][rank_id]);
	ShowNotificationNew(target_id, 3, 5, 0, 0, msg, "");
	return 1;
}


stock TaxiPark_HandleOnPlayerPickUpPickupEx(playerid, pickupid, action_type, action_id)
{
    #pragma unused pickupid
    if(action_type == PICKUP_ACTION_TYPE_TAXI_PARK_ENT)
    {
        TaxiPark_OnEnter(playerid, action_id);
        return 1;
    }
    if(action_type == TAXI_PARK_ACTION_EXIT)
    {
        TaxiPark_OnExit(playerid, action_id);
        return 1;
    }
    if(action_type == TAXI_PARK_ACTION_HIRE)
    {
        TaxiPark_OnHirePickup(playerid, action_id);
        return 1;
    }
    if(action_type == TAXI_PARK_ACTION_AUTOPARK)
    {
        TaxiPark_OnAutoparkPickup(playerid, action_id);
        return 1;
    }
    return 0;
}

stock TaxiPark_HandleOnPlayerEnterDynamicArea(playerid, areaid)
{
    for(new i = 0; i < TAXI_PARK_COUNT; i++)
    {
        if(areaid == g_TaxiAreaExit[i])
        {
            TaxiPark_OnExit(playerid, i);
            return 1;
        }
        if(areaid == g_TaxiAreaHire[i])
        {
            TaxiPark_OnHirePickup(playerid, i);
            return 1;
        }
        if(areaid == g_TaxiAreaAutopark[i])
        {
            TaxiPark_OnAutoparkPickup(playerid, i);
            return 1;
        }
    }
    return 0;
}

stock TaxiPark_HandleOnPlayerSpawn(playerid)
{
    if(IsPlayerLogged(playerid) && GetPVarInt(playerid, "TaxiJobLoaded") == 0)
    {
        SetPVarInt(playerid, "TaxiJobLoaded", 1);
        TaxiPark_LoadJobFromDB(playerid);
    }
    return 1;
}

stock TaxiPark_HandleOnPlayerConnect(playerid)
{
    SetPVarInt(playerid, "TaxiJobLoaded", 0);
    SetPVarInt(playerid, TAXI_PARK_PVAR_JOB, 0);
    g_TaxiDriverRank[playerid] = 0;
    g_TaxiDriverCarClass[playerid] = 0;
    g_TaxiDriverFleetSlot[playerid] = -1;
    g_TaxiReturnTD[playerid] = PlayerText:0;
    g_TaxiReturnSeconds[playerid] = 0;
    g_TaxiPassengerLeaveTimer[playerid] = 0;
    g_TaxiPassengerLeaveSeconds[playerid] = 0;
    g_TaxiPassengerLeaveTD[playerid] = PlayerText:0;
    return 1;
}

stock TaxiPark_HandleOnPlayerStateChange(playerid, newstate, oldstate)
{
    if(newstate == PLAYER_STATE_PASSENGER)
    {
        if(g_TaxiPlayerOrder[playerid][TPO_STATE] == TAXI_PLAYER_ORDER_PICKUP ||
           g_TaxiPlayerOrder[playerid][TPO_STATE] == TAXI_PLAYER_ORDER_ACCEPTED)
        {
            new driver = g_TaxiPlayerOrder[playerid][TPO_DRIVER];
            if(driver != INVALID_PLAYER_ID && IsPlayerConnected(driver))
            {
                TaxiPark_StartPlayerTrip(driver, playerid);
                SetTimerEx("TaxiPark_DelayedStartTrip", 300, false, "ii", driver, playerid);
                SetTimerEx("TaxiPark_DelayedStartTrip", 800, false, "ii", driver, playerid);
            }
        }
    }
    if(oldstate == PLAYER_STATE_DRIVER && newstate == PLAYER_STATE_ONFOOT)
    {
        new vehicleid = GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE);
        if(vehicleid != 0)
            TaxiPark_StartReturnTimer(playerid);
    }
    if(newstate == PLAYER_STATE_DRIVER)
    {
        new vehicleid = GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE);
        if(vehicleid != 0 && IsPlayerInVehicle(playerid, vehicleid))
        {
            if(g_TaxiPark_PlayerReturnTimer[playerid] != 0)
            {
                KillTimer(g_TaxiPark_PlayerReturnTimer[playerid]);
                g_TaxiPark_PlayerReturnTimer[playerid] = 0;
            }
            if(_:g_TaxiReturnTD[playerid] != 0)
            {
                PlayerTextDrawHide(playerid, g_TaxiReturnTD[playerid]);
                PlayerTextDrawDestroy(playerid, g_TaxiReturnTD[playerid]);
                g_TaxiReturnTD[playerid] = PlayerText:0;
            }
            g_TaxiReturnSeconds[playerid] = 0;
        }
    }
    if(oldstate == PLAYER_STATE_PASSENGER && newstate == PLAYER_STATE_ONFOOT)
    {
        if(g_TaxiPlayerOrder[playerid][TPO_STATE] == TAXI_PLAYER_ORDER_DRIVE)
        {
            new driver = g_TaxiPlayerOrder[playerid][TPO_DRIVER];
            if(driver != INVALID_PLAYER_ID && IsPlayerConnected(driver))
            {
                new veh = GetPVarInt(driver, TAXI_PARK_PVAR_VEHICLE);
                if(veh != 0)
                {
                    g_TaxiPassengerLeaveSeconds[playerid] = 60;
                    SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы вышли из такси, если вы не сядете в такси в течении 60 секунд, ваш вызов будет отменен");
                    if(_:g_TaxiPassengerLeaveTD[playerid] != 0)
                    {
                        PlayerTextDrawDestroy(playerid, g_TaxiPassengerLeaveTD[playerid]);
                        g_TaxiPassengerLeaveTD[playerid] = PlayerText:0;
                    }
                    g_TaxiPassengerLeaveTD[playerid] = CreatePlayerTextDraw(playerid, 280.0, 200.0, "60");
                    PlayerTextDrawFont(playerid, g_TaxiPassengerLeaveTD[playerid], 2);
                    PlayerTextDrawLetterSize(playerid, g_TaxiPassengerLeaveTD[playerid], 0.6, 2.2);
                    PlayerTextDrawColor(playerid, g_TaxiPassengerLeaveTD[playerid], 0x33FF33FF);
                    PlayerTextDrawSetOutline(playerid, g_TaxiPassengerLeaveTD[playerid], 1);
                    PlayerTextDrawSetProportional(playerid, g_TaxiPassengerLeaveTD[playerid], 1);
                    PlayerTextDrawShow(playerid, g_TaxiPassengerLeaveTD[playerid]);
                    if(g_TaxiPassengerLeaveTimer[playerid] != 0) KillTimer(g_TaxiPassengerLeaveTimer[playerid]);
                    g_TaxiPassengerLeaveTimer[playerid] = SetTimerEx("TaxiPark_PassengerLeaveTimer", 1000, false, "i", playerid);
                }
            }
        }
    }
    if(newstate == PLAYER_STATE_PASSENGER)
    {
        if(g_TaxiPlayerOrder[playerid][TPO_STATE] == TAXI_PLAYER_ORDER_DRIVE ||
           g_TaxiPlayerOrder[playerid][TPO_STATE] == TAXI_PLAYER_ORDER_PICKUP)
        {
            if(g_TaxiPassengerLeaveTimer[playerid] != 0)
            {
                KillTimer(g_TaxiPassengerLeaveTimer[playerid]);
                g_TaxiPassengerLeaveTimer[playerid] = 0;
            }
            if(_:g_TaxiPassengerLeaveTD[playerid] != 0)
            {
                PlayerTextDrawHide(playerid, g_TaxiPassengerLeaveTD[playerid]);
                PlayerTextDrawDestroy(playerid, g_TaxiPassengerLeaveTD[playerid]);
                g_TaxiPassengerLeaveTD[playerid] = PlayerText:0;
            }
            g_TaxiPassengerLeaveSeconds[playerid] = 0;
        }
    }
    return 1;
}

forward TaxiPark_PassengerLeaveTimer(playerid);
public TaxiPark_PassengerLeaveTimer(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	if(g_TaxiPlayerOrder[playerid][TPO_STATE] != TAXI_PLAYER_ORDER_DRIVE)
	{
		if(_:g_TaxiPassengerLeaveTD[playerid] != 0)
		{
			PlayerTextDrawHide(playerid, g_TaxiPassengerLeaveTD[playerid]);
			PlayerTextDrawDestroy(playerid, g_TaxiPassengerLeaveTD[playerid]);
			g_TaxiPassengerLeaveTD[playerid] = PlayerText:0;
		}
		g_TaxiPassengerLeaveTimer[playerid] = 0;
		return 0;
	}
	new driver = g_TaxiPlayerOrder[playerid][TPO_DRIVER];
	new veh = 0;
	if(driver != INVALID_PLAYER_ID && IsPlayerConnected(driver))
		veh = GetPVarInt(driver, TAXI_PARK_PVAR_VEHICLE);
	if(veh != 0 && IsPlayerInVehicle(playerid, veh))
	{
		// Returned
		if(_:g_TaxiPassengerLeaveTD[playerid] != 0)
		{
			PlayerTextDrawHide(playerid, g_TaxiPassengerLeaveTD[playerid]);
			PlayerTextDrawDestroy(playerid, g_TaxiPassengerLeaveTD[playerid]);
			g_TaxiPassengerLeaveTD[playerid] = PlayerText:0;
		}
		g_TaxiPassengerLeaveTimer[playerid] = 0;
		return 1;
	}
	g_TaxiPassengerLeaveSeconds[playerid]--;
	if(g_TaxiPassengerLeaveSeconds[playerid] <= 0)
	{
		if(_:g_TaxiPassengerLeaveTD[playerid] != 0)
		{
			PlayerTextDrawHide(playerid, g_TaxiPassengerLeaveTD[playerid]);
			PlayerTextDrawDestroy(playerid, g_TaxiPassengerLeaveTD[playerid]);
			g_TaxiPassengerLeaveTD[playerid] = PlayerText:0;
		}
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вызов отменён — вы не вернулись в такси");
		if(driver != INVALID_PLAYER_ID && IsPlayerConnected(driver))
		{
			ShowNotificationNew(driver, 2, 5, 0, 0, "Клиент не вернулся в машину, заказ отменён", "");
			TaxiPark_CancelOrder(driver);
		}
		TaxiPark_ResetPlayerOrder(playerid);
		g_TaxiPassengerLeaveTimer[playerid] = 0;
		return 1;
	}
	new str[16];
	format(str, sizeof str, "%d", g_TaxiPassengerLeaveSeconds[playerid]);
	if(_:g_TaxiPassengerLeaveTD[playerid] != 0)
		PlayerTextDrawSetString(playerid, g_TaxiPassengerLeaveTD[playerid], str);
	g_TaxiPassengerLeaveTimer[playerid] = SetTimerEx("TaxiPark_PassengerLeaveTimer", 1000, false, "i", playerid);
	return 1;
}

stock TaxiPark_HandleOnPlayerDisconnect(playerid, reason)
{
    #pragma unused reason
	// If passenger disconnects
	if(g_TaxiPlayerOrder[playerid][TPO_STATE] != TAXI_PLAYER_ORDER_NONE)
	{
		new driver = g_TaxiPlayerOrder[playerid][TPO_DRIVER];
		new order_state = g_TaxiPlayerOrder[playerid][TPO_STATE];
		new price = g_TaxiPlayerOrder[playerid][TPO_PRICE];
		if(driver != INVALID_PLAYER_ID && IsPlayerConnected(driver))
		{
			// If taxi already arrived (PICKUP or DRIVE) - half payment
			if(order_state == TAXI_PLAYER_ORDER_PICKUP || order_state == TAXI_PLAYER_ORDER_DRIVE)
			{
				new half = price / 2;
				if(half > 0)
				{
					GivePlayerMoneyEx(driver, half, "TaxiPark", true, true);
					new _park = TaxiPark_GetPlayerJob(driver);
					if(_park != -1)
					{
						new class_id = g_TaxiDriverCarClass[driver];
						if(class_id < 0) class_id = 0;
						if(class_id > 2) class_id = 2;
						new drv_pct = g_TaxiDriverPct[_park][class_id];
						if(drv_pct < 20) drv_pct = 20;
						if(drv_pct > 75) drv_pct = 75;
						new company_share = half - (half * drv_pct / 100);
						if(company_share > 0)
						{
							if(g_TaxiCompany[_park][TC_BALANCE] + company_share <= TaxiPark_GetSafeMax(_park))
								g_TaxiCompany[_park][TC_BALANCE] += company_share;
							TaxiPark_AddProfit(_park, company_share);
							GivePlayerMoneyEx(driver, -company_share, "TaxiPark", true, true);
						}
						TaxiPark_SaveCompany(_park);
					}
					new msg[96];
					format(msg, sizeof msg, "{33FF33}| {ffffff}Клиент вышел. Получена половина оплаты: %d руб", half);
					SendClientMessage(driver, -1, msg);
				}
			}
			else
			{
				ShowNotificationNew(driver, 2, 5, 0, 0, "Клиент вышел с сервера, заказ отменён", "");
			}
			TaxiPark_CancelOrder(driver);
		}
		TaxiPark_ResetPlayerOrder(playerid);
	}
	// Driver disconnect - destroy vehicle and cancel order
	if(GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE) != 0)
	{
		TaxiPark_CancelOrder(playerid);
		TaxiPark_DestroyPlayerVehicle(playerid);
	}
	// Cleanup timers/textdraws
	if(g_TaxiPark_PlayerReturnTimer[playerid] != 0)
	{
		KillTimer(g_TaxiPark_PlayerReturnTimer[playerid]);
		g_TaxiPark_PlayerReturnTimer[playerid] = 0;
	}
	if(_:g_TaxiReturnTD[playerid] != 0)
	{
		PlayerTextDrawDestroy(playerid, g_TaxiReturnTD[playerid]);
		g_TaxiReturnTD[playerid] = PlayerText:0;
	}
	if(g_TaxiPassengerLeaveTimer[playerid] != 0)
	{
		KillTimer(g_TaxiPassengerLeaveTimer[playerid]);
		g_TaxiPassengerLeaveTimer[playerid] = 0;
	}
	if(_:g_TaxiPassengerLeaveTD[playerid] != 0)
	{
		PlayerTextDrawDestroy(playerid, g_TaxiPassengerLeaveTD[playerid]);
		g_TaxiPassengerLeaveTD[playerid] = PlayerText:0;
	}
	if(g_TaxiDistTimer[playerid] != 0)
	{
		KillTimer(g_TaxiDistTimer[playerid]);
		g_TaxiDistTimer[playerid] = 0;
	}
	return 1;
}

public DelayedPutPlayerInVehicle(playerid, vehicleid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	if(vehicleid == 0 || vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid)) return 0;
	PutPlayerInVehicle(playerid, vehicleid, 0);
	return 1;
}


