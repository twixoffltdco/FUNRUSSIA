TextDrawSetString(zakaz3_TD[3], fmt_text);
TextDrawShowForPlayer(playerid, zakaz3_TD[3]);
}
}
if(minferma==0 && sicferma==0)
{
KillTimer(timersecfer);
}
}
}
}
