stock GetVehicleComponents(model, &start, &count)
{
    if(model < 0 || model >= sizeof(gVehicleComponentOffset))
        return 0;

    start = gVehicleComponentOffset[model];
    count = gVehicleComponentCount[model];

    if(start == -1 || count == 0)
        return 0;

    return 1;
}

stock IsStoredTuneItemAllowedForModel(modelid, itemid)
{
    if(itemid < 0 || itemid > MAX_TUNE_ITEM_ID) return 0;

    new jsonid = GetVehicleJsonIdFromModel(modelid);
    if(jsonid < 0) return 0;

    new start, count;
    if(!GetVehicleComponents(jsonid, start, count)) return 0;

    for(new i; i < count; i++)
    {
        if(gVehicleComponentList[start + i] == itemid)
            return 1;
    }
    return 0;
}

stock bool:HRDepartment_IsSupportedOrg(org_id)
{
    switch(org_id)
    {
        case TEAM_GOVERNMENT, TEAM_ARMY, TEAM_HOSPITAL, TEAM_RADIO, TEAM_DPS, TEAM_PPS: return true;
    }
    return false;
}

#define HR_DEPARTMENT_NOTIFY_ID (9103)
#define PVAR_HR_NOTIFY_SHOWN     "HRNotifyShown"
#define PVAR_HR_NOTIFY_ORG       "HRNotifyOrg"

stock HRDepartment_GetNearbyOrg(playerid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || GetPlayerInterior(playerid) != 1)
        return TEAM_NONE;

    switch(GetPlayerVirtualWorld(playerid))
    {
        case 1:
        {
            if(IsPlayerInRangeOfPoint(playerid, 2.8, 498.718017,1511.595458,1501.000000)) return TEAM_ARMY;
            if(IsPlayerInRangeOfPoint(playerid, 2.8, 1502.981933,2500.498535,2501.000000)) return TEAM_HOSPITAL;
            if(IsPlayerInRangeOfPoint(playerid, 2.8, 1985.329711,-3.292105,1381.003540)) return TEAM_RADIO;
            if(IsPlayerInRangeOfPoint(playerid, 2.8, -887.145874,-1567.841796,1398.501098)) return TEAM_GOVERNMENT;
            if(IsPlayerInRangeOfPoint(playerid, 2.8, -1106.177490,1513.784179,1499.953247)) return TEAM_DPS;
        }
        case 2:
        {
            if(IsPlayerInRangeOfPoint(playerid, 2.8, -1105.977539,1513.604003,1499.985961)) return TEAM_PPS;
        }
    }
    return TEAM_NONE;
}

stock HRDepartment_Open(playerid, org_id)
{
    if(!HRDepartment_IsSupportedOrg(org_id)) return 0;

    new hr_text[520];
    SetPVarInt(playerid, "HRDepartmentOrg", org_id);
    SetPVarInt(playerid, "HRDepartmentStage", 0);
    format(hr_text, sizeof hr_text,
        "Приветствую, {FFFF00}%s!\n\n{FFFFFF}Вы находитесь в отделе кадров организации {FFFF00}%s{FFFFFF}.\n"\
        "Для поступления необходимо:\n\n"\
        "{FFFF00}1.{FFFFFF} Игровой уровень 3 или выше\n"\
        "{FFFF00}2.{FFFFFF} Медицинская карта\n"\
        "{FFFF00}3.{FFFFFF} Водительские права категории B\n"\
        "{FFFF00}4.{FFFFFF} Успешно пройти RP-тест\n\n"\
        "После теста Вы будете приняты на 1 ранг.",
        GetPlayerNameEx(playerid), g_organization[org_id][O_NAME]);
    Dialog(playerid, DIALOG_OTD, DIALOG_STYLE_MSGBOX,
        "{00FFFF}"SERVER_NAME"{FFFFFF} | Отдел кадров", hr_text, "Начать", "Закрыть");
    return 1;
}

stock bool:HRDepartment_TryInteract(playerid)
{

    if(GetPVarInt(playerid, "HRDepartmentStage") > 0) return false;

    new org_id = HRDepartment_GetNearbyOrg(playerid);
    if(org_id == TEAM_NONE) return false;
    HRDepartment_Open(playerid, org_id);
    return true;
}

stock HRDepartment_UpdateNotification(playerid)
{

    if(GetPVarInt(playerid, "HRDepartmentStage") > 0)
    {
        if(GetPVarInt(playerid, PVAR_HR_NOTIFY_SHOWN))
        {
            ToggleInteractionWindow(playerid, false);
            DeletePVar(playerid, PVAR_HR_NOTIFY_SHOWN);
            DeletePVar(playerid, PVAR_HR_NOTIFY_ORG);
        }
        return 1;
    }

    new org_id = HRDepartment_GetNearbyOrg(playerid);
    if(org_id == TEAM_NONE)
    {
        if(GetPVarInt(playerid, PVAR_HR_NOTIFY_SHOWN))
        {
            ToggleInteractionWindow(playerid, false);
            DeletePVar(playerid, PVAR_HR_NOTIFY_SHOWN);
            DeletePVar(playerid, PVAR_HR_NOTIFY_ORG);
        }
        return 0;
    }

    if(!GetPVarInt(playerid, PVAR_HR_NOTIFY_SHOWN) ||
       GetPVarInt(playerid, PVAR_HR_NOTIFY_ORG) != org_id)
    {
        ToggleInteractionWindow(playerid, true);
        SetPVarInt(playerid, PVAR_HR_NOTIFY_SHOWN, 1);
        SetPVarInt(playerid, PVAR_HR_NOTIFY_ORG, org_id);
    }
    return 1;
}

stock HRDepartment_HandleNotification(playerid, notify_type, notify_id, notify_sub_id)
{
    if(notify_id != HR_DEPARTMENT_NOTIFY_ID) return 0;
    if(notify_type != 0) return 1;

    if(GetPVarInt(playerid, "HRDepartmentStage") > 0)
        return 1;

    new org_id = HRDepartment_GetNearbyOrg(playerid);
    if(org_id == TEAM_NONE || !HRDepartment_IsSupportedOrg(org_id))
        return SendClientMessage(playerid, 0xCECECEFF, "Подойдите ближе к сотруднику отдела кадров"), 1;

    if(notify_sub_id != org_id && GetPVarInt(playerid, PVAR_HR_NOTIFY_ORG) != org_id)
        return 1;

    HRDepartment_Open(playerid, org_id);
    return 1;
}

stock HRDepartment_ShowQuestion(playerid)
{
    switch(GetPVarInt(playerid, "HRDepartmentStage"))
    {
        case 1: Dialog(playerid, DIALOG_OPR, DIALOG_STYLE_TABLIST_HEADERS, "RP-тест: вопрос 1/4", "Что означает RP?\nУбийство по RP\nИгра по ролям\nВоображение себя героем", "Выбрать", "Отмена");
        case 2: Dialog(playerid, DIALOG_OPR, DIALOG_STYLE_TABLIST_HEADERS, "RP-тест: вопрос 2/4", "Что означает DM?\nУбийство без причины\nЗелёная зона\nОтыгровка RP", "Выбрать", "Отмена");
        case 3: Dialog(playerid, DIALOG_OPR, DIALOG_STYLE_TABLIST_HEADERS, "RP-тест: вопрос 3/4", "Что означает УК?\nУказ\nУголовный кодекс", "Выбрать", "Отмена");
        case 4: Dialog(playerid, DIALOG_OPR, DIALOG_STYLE_TABLIST_HEADERS, "RP-тест: вопрос 4/4", "Что такое зелёная зона?\nЗона, где разрешён DM\nЗона, где запрещено нападать", "Выбрать", "Отмена");
        default: return 0;
    }
    return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    if(SilverGateSystem_OnKeyStateChange(playerid, newkeys)) return 1;

    if(PRESSED(KEY_CROUCH) && RaceSto_TryEnterOnHorn(playerid)) return 1;
    if((newkeys & KEY_YES) && SeatNpc_OnButton(playerid)) return 1;
    if(FsinFull_OnPlayerKeyStateChange(playerid,newkeys,oldkeys)) return 1;
    if(GarageSys_OnKeyStateChange(playerid, newkeys, oldkeys)) return 1;
    if(PRESSED(KEY_CROUCH))
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
