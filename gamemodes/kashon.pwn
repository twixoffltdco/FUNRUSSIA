    JSON_Cleanup(root);
}

CMD:goto(playerid, params[])
{
    if(!SRAdmin_TeleportAllowed(playerid)) return 1;
    new targetid;
    if(sscanf(params, "d", targetid)) return SendClientMessage(playerid, -1, "Используйте: /goto [id игрока]");
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return SendClientMessage(playerid, 0xCECECEFF, "Такого игрока нет.");
    new my_admin = GetPlayerAdminEx(playerid);
    new target_admin = GetPlayerAdminEx(targetid);
    if(my_admin >= 1 && my_admin <= 11 && target_admin >= 12 && target_admin <= 13)
    {
        if(g_admin_goto_requester[targetid] != -1)
            return SendClientMessage(playerid, 0xFF0000FF, "Администратор уже имеет другой запрос на телепортацию.");
        g_admin_goto_requester[targetid] = playerid;
        g_admin_goto_request_time[targetid] = GetTickCount();
        new request_text[256];
        format(request_text, sizeof request_text, "{FFFFFF}Администратор {FFCC00}%s [%d]{FFFFFF} хочет телепортироваться к вам.\n\n{FFFFFF}Принять запрос на телепортацию?", GetPlayerNameEx(playerid), playerid);
        SetPlayerData(targetid, P_LAST_DIALOG, DIALOG_ADMIN_GOTO_REQUEST);
        ShowPlayerDialog(targetid, DIALOG_ADMIN_GOTO_REQUEST, DIALOG_STYLE_MSGBOX, "{FFCC00}Телепортация администратора", request_text, "Принять", "Отклонить");
        SendClientMessage(playerid, 0xFFCC00FF, "Запрос на телепортацию отправлен администратору.");
        return 1;
    }
    if(!SRAdmin_TeleportTarget(playerid, targetid)) return 1;
    return SRAdmin_MoveNear(playerid, playerid, targetid);
}

alias:goto("g")

CMD:gethere(playerid, params[])
{
    if(!SRAdmin_TeleportAllowed(playerid)) return 1;
    new targetid;
    if(sscanf(params, "d", targetid)) return SendClientMessage(playerid, -1, "Используйте: /gethere [id игрока]");
    if(!SRAdmin_TeleportTarget(playerid, targetid)) return 1;
    if(GetPlayerAdminEx(targetid) > 0 && SRAdmin_Level(targetid) == 0) return 1;
    if(SRAdmin_Level(targetid) > SRAdmin_Level(playerid))
        return SendClientMessage(playerid, -1, "Нельзя телепортировать к себе администратора выше вашего уровня.");
    return SRAdmin_MoveNear(playerid, targetid, playerid);
}

alias:gethere("gh")

CMD:updatevisual(playerid, params[])
{
    #pragma unused params
    if(!IsPlayerLogged(playerid)) return 1;
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
        return SendClientMessage(playerid, -1, "Для обновления визуала выйдите из транспорта.");
    if(g_stability_visual_timer[playerid]) return 1;
    new interior = GetPlayerInterior(playerid);
    new world = GetPlayerVirtualWorld(playerid);
    if(world > 2147482647) return 1;

    g_stability_visual_timer[playerid] = SetTimerEx("RestorePlayerAndVehicles", 100, false,
        "iiii", playerid, interior, world, g_BRAuthEpoch[playerid]);
    if(!g_stability_visual_timer[playerid]) return 1;
    SetPlayerVirtualWorld(playerid, world + 1000);
    return 1;
}

forward RestorePlayerAndVehicles(playerid, interior, world, epoch);
public RestorePlayerAndVehicles(playerid, interior, world, epoch)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid)) return 1;
    if(epoch != g_BRAuthEpoch[playerid]) return 1;
    g_stability_visual_timer[playerid] = 0;
    if(!IsPlayerLogged(playerid)) return 1;
// Do not undo a teleport/spawn that took place while the timer was pending.
    if(GetPlayerVirtualWorld(playerid) != world + 1000 || GetPlayerInterior(playerid) != interior) return 1;
    SetPlayerVirtualWorld(playerid, world);
    Streamer_Update(playerid);
    SendClientMessage(playerid, -1, "Визуальное обновление выполнено!");
    return 1;
}

stock SyncOwnableVehicleTuningData(vehicleid)
{
    if(!IsAOwnableCar(vehicleid)) return 0;

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index < 0) return 0;

    vInfo[index][vSQLID] = GetOwnableCarData(index, OC_SQL_ID);
    vInfo[index][vModelID] = GetOwnableCarData(index, OC_MODEL_ID);
    vInfo[index][vFstate] = GetOwnableCarData(index, OC_FSTATE);
    vInfo[index][vNitro] = GetOwnableCarData(index, OC_NITRO);
    vInfo[index][vLaunchControl] = GetOwnableCarData(index, OC_LAUCH);
    vInfo[index][vExhaustSound] = GetOwnableCarData(index, OC_EXHAUST);
    vInfo[index][vHornSound] = GetOwnableCarData(index, OC_HORN);
    vInfo[index][vStrob] = GetOwnableCarData(index, OC_STROBOSCOPE);
    vInfo[index][IsHydroActive] = GetOwnableCarData(index, OC_isHydroActive);
    vInfo[index][IsHydroBought] = GetOwnableCarData(index, OC_isHydroBought);
    vInfo[index][IsFarLightActive] = GetOwnableCarData(index, OC_isFarLightActive);
    vInfo[index][IsFarLightBought] = GetOwnableCarData(index, OC_isFarLightBought);
    vInfo[index][SelectedPnevmo] = GetOwnableCarData(index, OC_PnevmoSelected);
    vInfo[index][IsPnevmoBought] = GetOwnableCarData(index, OC_isPnevmoBought);
    vInfo[index][iscase] = GetOwnableCarData(index, OC_ISCASE);
    vInfo[index][pdvradar] = GetOwnableCarData(index, OC_PDVRADAR);
    vInfo[index][percentofclirness] = GetOwnableCarData(index, OC_percentofclirness);
    vInfo[index][percentofclirnessz] = GetOwnableCarData(index, OC_percentofclirnessZ);
    vInfo[index][wheel_offset_ft] = GetOwnableCarData(index, OC_wheel_offset_ft);
    if(vInfo[index][wheel_offset_ft] == 0) vInfo[index][wheel_offset_ft] = 50;
    vInfo[index][wheel_offset_rr] = GetOwnableCarData(index, OC_wheel_offset_rr);
    if(vInfo[index][wheel_offset_rr] == 0) vInfo[index][wheel_offset_rr] = 50;
    vInfo[index][align_ft] = GetOwnableCarData(index, OC_align_ft);
    vInfo[index][align_rr] = GetOwnableCarData(index, OC_align_rr);
    vInfo[index][width_ft] = GetOwnableCarData(index, OC_width_ft);
    if(vInfo[index][width_ft] == 0) vInfo[index][width_ft] = 40;
    vInfo[index][width_rr] = GetOwnableCarData(index, OC_width_rr);
    if(vInfo[index][width_rr] == 0) vInfo[index][width_rr] = 40;
    vInfo[index][wheel_radius] = GetOwnableCarData(index, OC_wheel_radius);
    vInfo[index][wheel_colors] = GetOwnableCarData(index, OC_wheelcolors);
    vInfo[index][lights_color] = GetOwnableCarData(index, OC_lights_color);
    vInfo[index][underlights_color] = GetOwnableCarData(index, OC_underlights_color);
    vInfo[index][underlights_color_lf] = GetOwnableCarData(index, OC_underlights_color_lf);
    vInfo[index][underlights_color_rt] = GetOwnableCarData(index, OC_underlights_color_rt);
    vInfo[index][body_colors] = GetOwnableCarData(index, OC_body_colors);
    vInfo[index][tonir_ft] = GetOwnableCarData(index, OC_tonir_ft);
    vInfo[index][tonir_rr] = GetOwnableCarData(index, OC_tonir_rr);
    vInfo[index][wheel_comp] = GetOwnableCarData(index, OC_wheelcomp);
    vInfo[index][vComfort] = GetOwnableCarData(index, OC_COMFORT_PL);
    vInfo[index][vSport] = GetOwnableCarData(index, OC_SPORT);
    vInfo[index][vDrift] = GetOwnableCarData(index, OC_DRIFT);
    vInfo[index][vSportPlus] = GetOwnableCarData(index, OC_SPORT_PL);
    vInfo[index][vComfort1] = GetOwnableCarData(index, OC_COMFORT1);
    vInfo[index][vSport1] = GetOwnableCarData(index, OC_SPORT1);
    vInfo[index][vDrift1] = GetOwnableCarData(index, OC_DRIFT1);
    vInfo[index][vSportPlus1] = GetOwnableCarData(index, OC_SPORT_PL1);
    vInfo[index][vComfort2] = GetOwnableCarData(index, OC_COMFORT2);
    vInfo[index][vSport2] = GetOwnableCarData(index, OC_SPORT2);
    vInfo[index][vDrift2] = GetOwnableCarData(index, OC_DRIFT2);
    vInfo[index][vSportPlus2] = GetOwnableCarData(index, OC_SPORT_PL2);
    vInfo[index][vComfort3] = GetOwnableCarData(index, OC_COMFORT3);
    vInfo[index][vSport3] = GetOwnableCarData(index, OC_SPORT3);
    vInfo[index][vDrift3] = GetOwnableCarData(index, OC_DRIFT3);
    vInfo[index][vSportPlus3] = GetOwnableCarData(index, OC_SPORT_PL3);
    vInfo[index][vComfort4] = GetOwnableCarData(index, OC_COMFORT4);
    vInfo[index][vSport4] = GetOwnableCarData(index, OC_SPORT4);
    vInfo[index][vDrift4] = GetOwnableCarData(index, OC_DRIFT4);
    vInfo[index][vSportPlus4] = GetOwnableCarData(index, OC_SPORT_PL4);
    vInfo[index][vEnableNeon] = GetOwnableCarData(index, OC_EnableNeon);
    vInfo[index][exhsuast_current] = GetOwnableCarData(index, OC_exhsuast_current);
    vInfo[index][strab_current] = GetOwnableCarData(index, OC_strab_current);
    vInfo[index][horn_current] = GetOwnableCarData(index, OC_horn_current);
    vInfo[index][vinil_current] = GetOwnableCarData(index, OC_vinil_current);
    vInfo[index][vTonerFront] = GetOwnableCarData(index, OC_TONER_FRONT);
    vInfo[index][vTonerRear] = GetOwnableCarData(index, OC_TONER_REAR);
    vInfo[index][vLightColor] = GetOwnableCarData(index, OC_LIGHT_COLOR);
    vInfo[index][vNeon][0] = GetOwnableCarData(index, OC_NEON_CENTER);
    vInfo[index][vNeon][1] = GetOwnableCarData(index, OC_NEON_RIGHT);
    vInfo[index][vNeon][2] = GetOwnableCarData(index, OC_NEON_LEFT);
    format(vInfo[index][vynil_name], 32, "%s", g_ownable_car[index][OC_VINYL]);

    SetOwnableCarData(index, OC_SQL_ID, vInfo[index][vSQLID]);
    vInfo[vehicleid][vModelID] = vInfo[index][vModelID];
    vInfo[vehicleid][vFstate] = vInfo[index][vFstate];
    vInfo[vehicleid][vNitro] = vInfo[index][vNitro];
    vInfo[vehicleid][vExhaustSound] = vInfo[index][vExhaustSound];
    vInfo[vehicleid][vHornSound] = vInfo[index][vHornSound];
    vInfo[vehicleid][vStrob] = vInfo[index][vStrob];
    vInfo[vehicleid][strab_current] = vInfo[index][strab_current];
    vInfo[vehicleid][horn_current] = vInfo[index][horn_current];
    vInfo[vehicleid][vEnableNeon] = vInfo[index][vEnableNeon];
    return 1;
}
stock LoadTuning(playerid)
{
    new id = GetPlayerOwnableCar(playerid);
    if(id == -1 || id == INVALID_VEHICLE_ID) return printf("ID личного транспорта игрока не найден");

    new i = GetVehicleData(id, V_ACTION_ID);
    new Float:brake_power;

    if(GetOwnableCarData(i, OC_wheelcomp) == 0)
    {
        new disk_query[128];
        mysql_format(mysql, disk_query, sizeof disk_query, "SELECT diski FROM ownable_cars WHERE id=%d LIMIT 1", GetOwnableCarData(i, OC_SQL_ID));
        new Cache:disk_cache = mysql_query(mysql, disk_query, true);
        if(cache_num_rows(disk_cache))
        {
            new legacy_disk = cache_get_field_content_int(0, "diski", disk_cache);
            if(legacy_disk >= 1 && legacy_disk <= 3)
            {
                SetOwnableCarData(i, OC_wheelcomp, legacy_disk);
                vInfo[i][wheel_comp] = legacy_disk;
            }
        }
        cache_delete(disk_cache);
    }
CarLights[GetPlayerOwnableCar(playerid)] = true;
CarLock[GetPlayerOwnableCar(playerid)] = true;
CarEngine[GetPlayerOwnableCar(playerid)] = true;
CarKey[GetPlayerOwnableCar(playerid)] = true;
    RemoveVehicleComponent(id, 1008);
    RemoveVehicleComponent(id, 1009);
    RemoveVehicleComponent(id, 1010);

    switch(GetOwnableCarData(i, OC_BRAKE))
    {
        case 1:
        {
            brake_power = 1.5;
            vInfo[id][vBrakePower] = brake_power;
            ApplyBrakePower(id, brake_power);
        }
        case 2:
        {
            brake_power = 2.0;
            vInfo[id][vBrakePower] = brake_power;
            ApplyBrakePower(id, brake_power);
        }
        case 3:
        {
            brake_power = 2.5;
            vInfo[id][vBrakePower] = brake_power;
            ApplyBrakePower(id, brake_power);
        }
        case 4:
        {
            brake_power = 3.0;
            vInfo[id][vBrakePower] = brake_power;
            ApplyBrakePower(id, brake_power);
        }
    }
    printf("[LoadTun] Set Brake_Power");

    if(GetOwnableCarData(i, OC_HIGHLIGHT))
    {
        vInfo[id][vHighLights] = 299;
        SetVehicleHighLight(id, 299, 1);
        printf("[LoadTun] Set HighLights");
    }

    vInfo[i][vStrob] = GetOwnableCarData(i, OC_STROBOSCOPE);
    vInfo[id][vStrob] = vInfo[i][vStrob];
    vInfo[i][strab_current] = GetOwnableCarData(i, OC_strab_current);
    vInfo[id][strab_current] = vInfo[i][strab_current];
    EnableStrob[id] = false;

    SetVehicleStroboscope(id, 5, 0);
    if(vInfo[i][vStrob] != 0)
        printf("[LoadTun] Stroboscope installed type=%d item=%d", vInfo[i][vStrob], vInfo[i][strab_current]);

    printf("[LoadTun] Set Exhaust");
    vInfo[i][vExhaustSound] = GetOwnableCarData(i, OC_EXHAUST);
    vInfo[id][vExhaustSound] = vInfo[i][vExhaustSound];
    if(vInfo[i][vExhaustSound] != 0)
        SetVehicleExhaust(id, vInfo[i][vExhaustSound], 1);

    vInfo[i][vHornSound] = GetOwnableCarData(i, OC_HORN);
    vInfo[id][vHornSound] = vInfo[i][vHornSound];
// Do not send horn_id=0 while loading tuning; stock horn needs no RPC.

    if(GetOwnableCarData(i, OC_HYDRAULICS))
    {
        printf("[LoadTun] Set Hydraulics");
    }

    if(strlen(g_ownable_car[i][OC_VINYL]) != 0)
    {
        printf("[LoadTun] Set Vinyl %s", g_ownable_car[i][OC_VINYL]);
        format(vInfo[i][vynil_name], 32, "%s", g_ownable_car[i][OC_VINYL]);
        format(vInfo[id][vynil_name], 32, "%s", g_ownable_car[i][OC_VINYL]);
        SetVehicleVinylForPlayer(playerid, id, g_ownable_car[i][OC_VINYL]);
    }

    vInfo[i][vLaunchControl] = GetOwnableCarData(i, OC_LAUCH);
    vInfo[id][vLaunchControl] = vInfo[i][vLaunchControl];
    launch[playerid] = vInfo[i][vLaunchControl];

    if(GetOwnableCarData(i, OC_ISCASE) == 2)
    {
        // Donate-shop cars must load with completely stock performance.
        vInfo[i][vLaunchControl] = 0;
        vInfo[id][vLaunchControl] = 0;
        launch[playerid] = 0;
        vInfo[i][vNitro] = 0;
        new stock_perf_query[160];
        mysql_format(mysql, stock_perf_query, sizeof stock_perf_query, "UPDATE ownable_cars SET launch=0, nitro=0, fstate=0 WHERE id=%d", GetOwnableCarData(i, OC_SQL_ID));
        mysql_tquery(mysql, stock_perf_query);
        SetOwnableCarData(i, OC_LAUCH, 0);
        SetOwnableCarData(i, OC_NITRO, 0);
        SetOwnableCarData(i, OC_FSTATE, FSTATE_NONE);
    }
	vInfo[id][vSQLID] = GetOwnableCarData(i, OC_SQL_ID);
	vInfo[id][vModelID] = GetOwnableCarData(i, OC_MODEL_ID);
	vInfo[i][vFstate] = GetOwnableCarData(i, OC_FSTATE);
    vInfo[id][vFstate] = vInfo[i][vFstate];
    TechCenter_ApplyPerformance(id);
	printf("[LoadTun] Set Firmware %d", vInfo[i][vFstate]);

	vInfo[i][vNitro]        = GetOwnableCarData(i, OC_NITRO);
    if(GetOwnableCarData(i, OC_ISCASE) == 2)
    {
        vInfo[i][vNitro] = 0;
        vInfo[id][vNitro] = 0;
    }
	vInfo[i][IsHydroActive]        = GetOwnableCarData(i, OC_isHydroActive);
	vInfo[i][IsHydroBought]        = GetOwnableCarData(i, OC_isHydroBought);
	vInfo[i][IsFarLightActive]        = GetOwnableCarData(i, OC_isFarLightActive);
	vInfo[i][IsFarLightBought]        = GetOwnableCarData(i, OC_isFarLightBought);
	vInfo[i][SelectedPnevmo]        = GetOwnableCarData(i, OC_PnevmoSelected);
	vInfo[i][IsPnevmoBought]        = GetOwnableCarData(i, OC_isPnevmoBought);
	vInfo[i][iscase]        = GetOwnableCarData(i, OC_ISCASE);
	vInfo[i][pdvradar]        = GetOwnableCarData(i, OC_PDVRADAR);
	vInfo[i][percentofclirness]        = GetOwnableCarData(i, OC_percentofclirness);
	vInfo[i][percentofclirnessz]        = GetOwnableCarData(i, OC_percentofclirnessZ);
	vInfo[i][wheel_offset_ft] = GetOwnableCarData(i, OC_wheel_offset_ft);
	if (vInfo[i][wheel_offset_ft] == 0){
		vInfo[i][wheel_offset_ft] = 50;
	}
	vInfo[i][wheel_offset_rr] = GetOwnableCarData(i, OC_wheel_offset_rr);
	if (vInfo[i][wheel_offset_rr] == 0){
		vInfo[i][wheel_offset_rr] = 50;
	}
	vInfo[i][align_ft] = GetOwnableCarData(i, OC_align_ft);
	vInfo[i][align_rr] = GetOwnableCarData(i, OC_align_rr);
	vInfo[i][width_ft] = GetOwnableCarData(i, OC_width_ft);
	if (vInfo[i][width_ft] == 0){
		vInfo[i][width_ft] = 40;
	}
	vInfo[i][width_rr] = GetOwnableCarData(i, OC_width_rr);
	if (vInfo[i][width_rr] == 0){
		vInfo[i][width_rr] = 40;
	}
	vInfo[i][wheel_radius] = GetOwnableCarData(i, OC_wheel_radius);
	vInfo[i][wheel_colors]        = GetOwnableCarData(i, OC_wheelcolors);

	vInfo[i][lights_color]           = GetOwnableCarData(i, OC_lights_color);
    vInfo[i][underlights_color]      = GetOwnableCarData(i, OC_underlights_color);
    vInfo[i][underlights_color_lf]   = GetOwnableCarData(i, OC_underlights_color_lf);
    vInfo[i][underlights_color_rt]   = GetOwnableCarData(i, OC_underlights_color_rt);

	vInfo[i][body_colors]        = GetOwnableCarData(i, OC_body_colors);
	vInfo[i][tonir_ft]        = GetOwnableCarData(i, OC_tonir_ft);
	vInfo[i][tonir_rr]        = GetOwnableCarData(i, OC_tonir_rr);
	vInfo[i][wheel_comp]        = GetOwnableCarData(i, OC_wheelcomp);
    vInfo[i][vComfort]     = GetOwnableCarData(i, OC_COMFORT_PL);
    vInfo[i][vSport]       = GetOwnableCarData(i, OC_SPORT);
    vInfo[i][vDrift]       = GetOwnableCarData(i, OC_DRIFT);
    vInfo[i][vSportPlus]   = GetOwnableCarData(i, OC_SPORT_PL);
	vInfo[i][vEnableNeon]    = GetOwnableCarData(i, OC_EnableNeon);
	vInfo[i][exhsuast_current]    = GetOwnableCarData(i, OC_exhsuast_current);

	vInfo[i][strab_current]    = GetOwnableCarData(i, OC_strab_current);

	vInfo[i][horn_current]    = GetOwnableCarData(i, OC_horn_current);

    vInfo[i][vinil_current]      = GetOwnableCarData(i, OC_vinil_current);

    vInfo[id][vNitro] = vInfo[i][vNitro];
    vInfo[id][vExhaustSound] = vInfo[i][vExhaustSound];
    vInfo[id][vHornSound] = vInfo[i][vHornSound];
    vInfo[id][vStrob] = vInfo[i][vStrob];
    vInfo[id][strab_current] = vInfo[i][strab_current];
    vInfo[id][horn_current] = vInfo[i][horn_current];
    vInfo[id][IsHydroActive] = vInfo[i][IsHydroActive];
    vInfo[id][IsFarLightActive] = vInfo[i][IsFarLightActive];

    vInfo[i][vComfort1]    = GetOwnableCarData(i, OC_COMFORT1);
    vInfo[i][vSport1]      = GetOwnableCarData(i, OC_SPORT1);
    vInfo[i][vDrift1]      = GetOwnableCarData(i, OC_DRIFT1);
    vInfo[i][vSportPlus1]  = GetOwnableCarData(i, OC_SPORT_PL1);

    vInfo[i][vComfort2]    = GetOwnableCarData(i, OC_COMFORT2);
    vInfo[i][vSport2]      = GetOwnableCarData(i, OC_SPORT2);
    vInfo[i][vDrift2]      = GetOwnableCarData(i, OC_DRIFT2);
    vInfo[i][vSportPlus2]  = GetOwnableCarData(i, OC_SPORT_PL2);

    vInfo[i][vComfort3]    = GetOwnableCarData(i, OC_COMFORT3);
    vInfo[i][vSport3]      = GetOwnableCarData(i, OC_SPORT3);
    vInfo[i][vDrift3]      = GetOwnableCarData(i, OC_DRIFT3);
    vInfo[i][vSportPlus3]  = GetOwnableCarData(i, OC_SPORT_PL3);

    vInfo[i][vComfort4]    = GetOwnableCarData(i, OC_COMFORT4);
    vInfo[i][vSport4]      = GetOwnableCarData(i, OC_SPORT4);
    vInfo[i][vDrift4]      = GetOwnableCarData(i, OC_DRIFT4);
    vInfo[i][vSportPlus4]  = GetOwnableCarData(i, OC_SPORT_PL4);

    if(vInfo[i][vNitro] != 0) printf("[LoadTun] Set Nitro (%d)", vInfo[i][vNitro]);

    ChangeVehicleColor(id, GetOwnableCarData(i, OC_COLOR_1), GetOwnableCarData(i, OC_COLOR_2));
    printf("Vehicle colors: %d, %d", GetOwnableCarData(i, OC_COLOR_1), GetOwnableCarData(i, OC_COLOR_2));

    new hex = GetOwnableCarData(i, OC_LIGHT_COLOR);
    SetVehicleLightColor(id, hex, 1);
    printf("Light Color: %x", GetOwnableCarData(i, OC_LIGHT_COLOR));

    if(GetOwnableCarData(i, OC_TONER_FRONT))
    {
        printf("[LoadTun] Set TonerFront (%d)", GetOwnableCarData(i, OC_TONER_FRONT));
        vInfo[id][vTonerFront] = GetOwnableCarData(i, OC_TONER_FRONT);
        SetVehicleTint(id, GetOwnableCarData(i, OC_TONER_FRONT), 1);
    }

    if(GetOwnableCarData(i, OC_TONER_REAR))
    {
        printf("[LoadTun] Set TonerRear (%d)", GetOwnableCarData(i, OC_TONER_REAR));
        vInfo[id][vTonerRear] = GetOwnableCarData(i, OC_TONER_REAR);
        SetVehicleTint(id, GetOwnableCarData(i, OC_TONER_REAR), 1);
    }

    if(GetOwnableCarData(i, OC_NEON_CENTER) != 0)
    {
        printf("[LoadTun] Set NeonCenter");
        SetVehicleLightingColor(id, GetOwnableCarData(i, OC_NEON_CENTER), vInfo[id][vNeon][1], vInfo[id][vNeon][2], 1);
    }

    if(GetOwnableCarData(i, OC_NEON_RIGHT) != 0)
    {
        printf("[LoadTun] Set NeonRight");
        SetVehicleLightingColor(id, vInfo[id][vNeon][0], GetOwnableCarData(i, OC_NEON_RIGHT), vInfo[id][vNeon][2], 1);
    }

    if(GetOwnableCarData(i, OC_NEON_LEFT) != 0)
    {
        SetVehicleLightingColor(id, vInfo[id][vNeon][0], vInfo[id][vNeon][1], GetOwnableCarData(i, OC_NEON_LEFT), 1);
        printf("[LoadTun] Set NeonLeft");
    }

    // Apply saved tire-center disks, including legacy values 1/2/3.
    new saved_wheel = GetOwnableCarData(i, OC_wheelcomp);
    new saved_wheel_component = GetWheelTuneComponentId(saved_wheel);
    if(saved_wheel_component > 0) AddVehicleComponent(id, saved_wheel_component);
    else
    {
        switch(saved_wheel)
        {
            case 1: AddVehicleComponent(id, 1073);
            case 2: AddVehicleComponent(id, 1074);
            case 3: AddVehicleComponent(id, 1075);
        }
    }
	ApplyOwnableVehicleNitro(playerid, id, vInfo[i][vNitro]);
	ApplyOwnableVehicleColors(id, i);
	Styling_QueueSuspension(id);
    TechCenter_ApplyPerformance(id);

    return 1;
}

CMD:testcasino(playerid, params[])
{
    TextDrawShowForPlayer(playerid, casino_TD[0]);
    SelectTextDraw(playerid, 0x00FF00FF);
    SendClientMessage(playerid, -1, "Текстдрав казино отображен! Кликни по нему.");
    return 1;
}

// ============================================================================
// INLINED MARKETPLACE MODULES - no external marketplace.pwn dependency
// ============================================================================
#if defined _vigsa_market_module_included
    #endinput
#endif
#define _vigsa_market_module_included

// Marketplace adapter for this Black Russia build (Inventory11).
#define MAX_INVENTORY_SLOTS (INVENTORY11_MAX_SLOTS + 1)
#define MAX_ACTIVE_SLOTS (0)
#define MARKET_SOURCE_ACTIVE_BASE (1000)
#define MARKET_SOURCE_ACCESSORY_BASE (2000)
#define MARKET_SOURCE_ACCESSORY_SLOTS (10)

stock Market_ReadSlot(playerid, slot, &item_id, &model_id, &amount, &extra_1, &extra_2, &old_skin, &sim_value, &oldsim_value)
{
    item_id = 0;
    model_id = 0;
    amount = 0;
    extra_1 = 0;
    extra_2 = 0;
    old_skin = 0;
    sim_value = 0;
    oldsim_value = 0;

    if(slot < 1 || slot > INVENTORY11_MAX_SLOTS) return 0;
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0) return 0;

    new query[320];
    mysql_format(mysql, query, sizeof(query),
        "SELECT item_id,model_id,amount,extra_1,extra_2,old_skin,sim,oldsim FROM inventory WHERE account_id=%d AND slot=%d LIMIT 1",
        account_id, slot);
    new Cache:result = mysql_query(mysql, query, true);
    if(mysql_errno() || cache_num_rows() <= 0)
    {
        cache_delete(result);
        return 0;
    }

    item_id = cache_get_field_content_int(0, "item_id");
    model_id = cache_get_field_content_int(0, "model_id");
    amount = cache_get_field_content_int(0, "amount");
    extra_1 = cache_get_field_content_int(0, "extra_1");
    extra_2 = cache_get_field_content_int(0, "extra_2");
    old_skin = cache_get_field_content_int(0, "old_skin");
    sim_value = cache_get_field_content_int(0, "sim");
    oldsim_value = cache_get_field_content_int(0, "oldsim");
    cache_delete(result);

    if(amount <= 0) amount = 1;
    return item_id > 0;
}

stock Market_GetAccessoryCanonicalItemByStoredId(item_id)
{
    return Inventory11_IsAccessoryItem(item_id) ? item_id : -1;
}

stock Market_GetAccessoryModelByCanonicalItem(item_id)
{
    return Inv11_GetAccModelByItem(item_id);
}

stock Market_GetAccessoryModelByStoredId(item_id)
{
    return Inv11_GetAccModelByItem(item_id);
}

stock Market_IsAccessoryInventoryItem(item_id)
{
    return Inventory11_IsAccessoryItem(item_id);
}

stock Market_ClearAccessoryCache(playerid)
{
    #pragma unused playerid
    return 1;
}

stock Market_RefreshAccessoryCache(playerid)
{
    #pragma unused playerid
    return 1;
}

stock Market_IsAccessorySource(source_id)
{
    #pragma unused source_id
    return 0;
}

stock Market_MakeAccessorySource(accessory_slot)
{
    return MARKET_SOURCE_ACCESSORY_BASE + accessory_slot;
}

stock Market_GetAccessorySlotFromSource(source_id)
{
    #pragma unused source_id
    return -1;
}

stock Market_IsActiveSource(source_id)
{
    #pragma unused source_id
    return 0;
}

stock Market_MakeActiveSource(active_slot)
{
    return MARKET_SOURCE_ACTIVE_BASE + active_slot;
}

stock Market_GetActiveSlotFromSource(source_id)
{
    #pragma unused source_id
    return -1;
}

stock Market_GetAccessoryModelFromSource(playerid, source_id)
{
    new item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value;
    if(!Market_ReadSlot(playerid, source_id, item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value)) return -1;
    if(!Inventory11_IsAccessoryItem(item_id)) return -1;

    if(extra_1 > 0) return extra_1;
    if(model_id > 1) return model_id;
    return Inv11_GetAccModelByItem(item_id);
}

stock Market_IsSingleInventoryEntity(item_id)
{
    if(item_id == 58 || item_id == 134) return 1;
    if(Inventory11_IsAccessoryItem(item_id)) return 1;
    if(Inventory11_IsPlateItem(item_id)) return 1;
    return 0;
}

stock Market_IsSellableInventoryItem(item_id)
{
    // Marketplace policy: only skins and accessories can be listed.
    // SIM cards, vehicle plates and all other inventory items are rejected.
    if(item_id == 134) return 1;
    if(Inventory11_IsAccessoryItem(item_id)) return 1;
    return 0;
}

stock Market_GetSourceItemId(playerid, source_id)
{
    new item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value;
    if(!Market_ReadSlot(playerid, source_id, item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value)) return 0;
    return item_id;
}

stock Market_GetSourceItemCount(playerid, source_id)
{
    new item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value;
    if(!Market_ReadSlot(playerid, source_id, item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value)) return 0;

    if(item_id == 134)
    {
        if(old_skin > 0) return old_skin;
        return model_id;
    }
    if(item_id == 58)
    {
        if(oldsim_value > 0) return oldsim_value;
        if(extra_1 > 0) return extra_1;
        if(model_id > 0) return model_id;
        if(sim_value > 0) return sim_value;
    }
    return amount > 0 ? amount : 1;
}

stock Market_GetSourcePlate(playerid, source_id, meta[], meta_size)
{
    meta[0] = EOS;

    new item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value;
    if(!Market_ReadSlot(playerid, source_id, item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value)) return 0;

    if(item_id == 58)
    {
        new number = oldsim_value;
        if(number <= 0) number = extra_1;
        if(number <= 0) number = model_id;
        if(number <= 0) number = sim_value;
        if(number > 0) format(meta, meta_size, "%d", number);
        return 1;
    }

    if(Inventory11_IsAccessoryItem(item_id))
    {
        new accessory_model = extra_1;
        if(accessory_model <= 0 && model_id > 1) accessory_model = model_id;
        if(accessory_model <= 0) accessory_model = Inv11_GetAccModelByItem(item_id);
        format(meta, meta_size, "A|%d", accessory_model);
        return 1;
    }

    if(Inventory11_IsPlateItem(item_id))
    {
        new plate_type, plate[16], region[8];
        if(Inventory11_GetPlateData(playerid, source_id, plate_type, plate, sizeof(plate), region, sizeof(region)))
            format(meta, meta_size, "P|%d|%s|%s", plate_type, plate, region);
        return 1;
    }
    return 1;
}

stock Market_CanSellSource(playerid, source_id)
{
    new max_slots = Inventory11_GetMaxSlots(playerid);
    if(max_slots < 1 || max_slots > INVENTORY11_MAX_SLOTS) max_slots = INVENTORY11_MAX_SLOTS;
    if(source_id < 1 || source_id > max_slots)
    {
        printf("[MARKET_DEBUG] CanSellSource: BAD RANGE source_id=%d max_slots=%d", source_id, max_slots);
        return 0;
    }
    new item_id = Market_GetSourceItemId(playerid, source_id);
    new sellable = Market_IsSellableInventoryItem(item_id);
    printf("[MARKET_DEBUG] CanSellSource: source_id=%d max_slots=%d item_id=%d sellable=%d", source_id, max_slots, item_id, sellable);
    return sellable;
}

stock Market_DeleteInventorySlot(playerid, slot)
{
    if(!Market_CanSellSource(playerid, slot)) return 0;
    return Inventory11_DeleteSlotFromDatabase(playerid, slot);
}

stock Market_DeleteActiveSource(playerid, active_slot)
{
    #pragma unused playerid
    #pragma unused active_slot
    return 0;
}

stock Market_DeleteAccessorySource(playerid, accessory_slot)
{
    #pragma unused playerid
    #pragma unused accessory_slot
    return 0;
}

stock Market_DeleteSource(playerid, source_id)
{
    return Market_DeleteInventorySlot(playerid, source_id);
}

stock Inventory_GetFreeSlot(playerid)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0) return -1;

    new max_slots = Inventory11_GetMaxSlots(playerid);
    if(max_slots < 1 || max_slots > INVENTORY11_MAX_SLOTS) max_slots = INVENTORY11_MAX_SLOTS;

    new bool:used[INVENTORY11_MAX_SLOTS + 1];
    new query[196];
    mysql_format(mysql, query, sizeof(query),
        "SELECT slot FROM inventory WHERE account_id=%d AND slot BETWEEN 1 AND %d",
        account_id, max_slots);
    new Cache:result = mysql_query(mysql, query, true);
    if(mysql_errno())
    {
        cache_delete(result);
        return -1;
    }

    new rows = cache_num_rows();
    for(new i = 0; i < rows; i++)
    {
        new slot = cache_get_field_content_int(i, "slot");
        if(slot >= 1 && slot <= max_slots) used[slot] = true;
    }
    cache_delete(result);

    for(new slot = 1; slot <= max_slots; slot++)
        if(!used[slot]) return slot;
    return -1;
}

stock Inventory_GetDeliverySlot(playerid, item_id)
{
    // Medkits are stackable in Inventory11 and can be delivered even when
    // every regular slot is occupied, as long as a medkit stack already exists.
    if(item_id == 22)
    {
        new query[192];
        mysql_format(mysql, query, sizeof(query),
            "SELECT slot FROM inventory WHERE account_id=%d AND item_id=22 ORDER BY slot ASC LIMIT 1",
            GetPlayerAccountID(playerid));
        new Cache:result = mysql_query(mysql, query, true);
        if(!mysql_errno() && cache_num_rows() > 0)
        {
            new stack_slot = cache_get_field_content_int(0, "slot");
            cache_delete(result);
            if(stack_slot >= 1 && stack_slot <= Inventory11_GetMaxSlots(playerid)) return stack_slot;
        }
        else cache_delete(result);
    }
    return Inventory_GetFreeSlot(playerid);
}

stock Inventory_RemoveItem(playerid, slot, remove_amount)
{
    if(remove_amount <= 0) return 0;

    new item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value;
    if(!Market_ReadSlot(playerid, slot, item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value)) return 0;

    if(Market_IsSingleInventoryEntity(item_id) || remove_amount >= amount)
        return Inventory11_DeleteSlotFromDatabase(playerid, slot);

    new left_amount = amount - remove_amount;
    if(left_amount <= 0) return Inventory11_DeleteSlotFromDatabase(playerid, slot);

    new query[224];
    if(item_id == 22)
    {
        mysql_format(mysql, query, sizeof(query),
            "UPDATE inventory SET amount=%d,model_id=%d WHERE account_id=%d AND slot=%d AND item_id=%d LIMIT 1",
            left_amount, left_amount, GetPlayerAccountID(playerid), slot, item_id);
    }
    else
    {
        mysql_format(mysql, query, sizeof(query),
            "UPDATE inventory SET amount=%d WHERE account_id=%d AND slot=%d AND item_id=%d LIMIT 1",
            left_amount, GetPlayerAccountID(playerid), slot, item_id);
    }
    new Cache:result = mysql_query(mysql, query, true);
    new changed = cache_affected_rows(mysql);
    cache_delete(result);
    return changed > 0;
}

stock Inventory_AddItem(playerid, item_id, preferred_slot, item_count, item_meta[])
{
    #pragma unused preferred_slot
    if(item_count <= 0) item_count = 1;

    new model_id = item_id, amount = item_count, extra_1 = 0, extra_2 = 0;
    new plate_type = -1, plate[16], region[8];
    plate[0] = EOS;
    region[0] = EOS;

    if(item_id == 134)
    {
        model_id = item_count;
        amount = 1;
    }
    else if(item_id == 58)
    {
        new sim_number = strval(item_meta);
        if(sim_number <= 0) sim_number = item_count;
        model_id = sim_number;
        extra_1 = sim_number;
        amount = 1;
    }
    else if(Inventory11_IsAccessoryItem(item_id))
    {
        new accessory_model, marker[2];
        if(sscanf(item_meta, "p<|>s[2]i", marker, accessory_model)) accessory_model = 0;
        if(accessory_model <= 0) accessory_model = Inv11_GetAccModelByItem(item_id);
        // Inventory11 stores the actual accessory model in extra_1; model_id
        // remains 1, exactly like the built-in player-to-player trade system.
        model_id = 1;
        extra_1 = accessory_model;
        amount = 1;
    }
    else if(Inventory11_IsPlateItem(item_id))
    {
        new marker[2];
        if(sscanf(item_meta, "p<|>s[2]is[16]s[8]", marker, plate_type, plate, region))
        {
            plate_type = PlateCountryToType(PlateItemIdToCountry(item_id));
            plate[0] = EOS;
            region[0] = EOS;
        }
        model_id = PlateItemIdToModel(item_id);
        amount = 1;
    }

    new new_slot = Inventory11_AddItemToDatabase(playerid, item_id, model_id, amount, extra_1, extra_2);
    if(new_slot == -1) return 0;

    if(Inventory11_IsPlateItem(item_id) && plate_type >= 0 && strlen(plate))
    {
        if(!Inventory11_SavePlateData(playerid, new_slot, plate_type, plate, region))
        {
            Inventory11_DeleteSlotFromDatabase(playerid, new_slot);
            return 0;
        }
    }

    // Return the real Inventory11 slot. Existing callers only test for zero,
    // while reward rollback needs the exact slot (medkits may merge into a stack).
    return new_slot;
}

stock Market_GetItemName(item_id, model_id, name[], name_size)
{
    name[0] = EOS;
    switch(item_id)
    {
        case 22: format(name, name_size, "Аптечка");
        case 58: format(name, name_size, "SIM-карта");
        case 59: format(name, name_size, "Госномер России");
        case 81: format(name, name_size, "Госномер Украины");
        case 82: format(name, name_size, "Госномер Беларуси");
        case 83: format(name, name_size, "Госномер Казахстана");
        case 134: format(name, name_size, "Скин");
        default:
        {
            if(Inventory11_IsAccessoryItem(item_id))
            {
                if(model_id <= 0) model_id = Inv11_GetAccModelByItem(item_id);
                new index = AccessoryGetIndexByModel(model_id);
                if(index >= 0) format(name, name_size, "%s", accessory[index][NAME_ACCESSORY]);
                else format(name, name_size, "Аксессуар #%d", item_id);
            }
            else format(name, name_size, "Предмет #%d", item_id);
        }
    }
    return 1;
}

stock GetItemName(item_id, name[], name_size)
{
    return Market_GetItemName(item_id, 0, name, name_size);
}

stock GetItemNameById(item_id, name[], name_size)
{
    return Market_GetItemName(item_id, Inv11_GetAccModelByItem(item_id), name, name_size);
}

stock SendPacketToClient(playerid, guiid, Node:json)
{
    if(guiid == MarketplaceGuiFragment && GetPVarInt(playerid, "market_open_pending"))
    {
        JSON_SetInt(json, "o", 1);
        DeletePVar(playerid, "market_open_pending");
    }
    if(guiid == BpRewardsGuiFragment && GetPVarInt(playerid, "mpreward_open_pending"))
    {
        JSON_SetInt(json, "o", 1);
        DeletePVar(playerid, "mpreward_open_pending");
    }
    OnPacketIncoming(playerid, guiid, json);
    return 1;
}
