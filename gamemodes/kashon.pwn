stock RaceSto_GetVehicleComponents(model, &start, &count)
{
    if(model < 0 || model >= sizeof(RaceStoVehicleComponentOffset))
        return 0;

    start = RaceStoVehicleComponentOffset[model];
    count = RaceStoVehicleComponentCount[model];

    // Signal that this model has no dedicated component map. The caller
    // will use the universal STO kit instead of showing an empty menu.
    if(start == -1 || count == 0)
    {
        start = -1;
        count = 0;
    }

    return 1;
}

stock RaceSto_EnsureDatabaseTable()
{
    // Create synchronously: the table must exist before cars and tuning are loaded.
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS `vehicle_store_components` (`vehicleid` INT NOT NULL,`componentid` INT NOT NULL,`state` TINYINT NOT NULL DEFAULT 0,PRIMARY KEY (`vehicleid`,`componentid`)) ENGINE=InnoDB DEFAULT CHARSET=cp1251", false);
    return 1;
}

stock RaceSto_GetSqlId(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID || vehicleid == 0) return 0;
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR) return 0;
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index < 0) return 0;
    return GetOwnableCarData(index, OC_SQL_ID);
}

stock RaceSto_SendComponentAction(playerid, vehicleid, action, componentid)
{
    if(!IsPlayerConnected(playerid) || !IsValidVehicle(vehicleid)) return 0;
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT8, 15);
    BS_WriteValue(bs, PR_UINT8, action);
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT16, componentid);
    PR_SendRPC(bs, playerid, RACE_STO_RPC_VEHICLE_COMPONENT, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock RaceSto_ApplyComponentToStream(vehicleid, itemid, bool:install)
{
    new componentid = RaceSto_GetTuneIdFromItem(itemid);
    if(componentid <= 0) return 0;
    for(new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        if(IsPlayerConnected(playerid) && IsVehicleStreamedIn(vehicleid, playerid))
            RaceSto_SendComponentAction(playerid, vehicleid, install ? 0 : 3, componentid);
    }
    return 1;
}

// Universal STO kit for custom/modified vehicle models that do not have
// a separate component map.
static const RaceStoUniversalComponentItems[] =
{
    1291, 1294, 1295, 1296, 1297, 1298, 1299, 1300,
    1314, 1315, 1316, 1317, 1318, 1319, 1320, 1322, 1323, 1324, 1325
};

stock RaceSto_IsUniversalItem(itemid)
{
    for(new i = 0; i < sizeof(RaceStoUniversalComponentItems); i++)
        if(RaceStoUniversalComponentItems[i] == itemid) return 1;
    return 0;
}

stock RaceSto_IsItemAvailable(vehicleid, itemid)
{
    new modelid = GetVehicleData(vehicleid, V_MODELID);
    if(modelid <= 0) modelid = GetVehicleModel(vehicleid);
    new jsonid = RaceSto_GetVehicleJsonIdFromModel(modelid);
    new start, count;
    if(jsonid < 0)
    {
        return RaceSto_IsUniversalItem(itemid);
    }
    if(!RaceSto_GetVehicleComponents(jsonid, start, count)) return 0;
    if(start < 0 || count <= 0) return RaceSto_IsUniversalItem(itemid);
    for(new i = 0; i < count; i++)
        if(RaceStoVehicleComponentList[start + i] == itemid) return 1;
    return 0;
}

stock RaceSto_SyncForPlayer(playerid, vehicleid)
{
    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0 || !IsVehicleStreamedIn(vehicleid, playerid)) return 0;

    new query[180], Cache:result;
    mysql_format(mysql, query, sizeof(query),
        "SELECT `componentid` FROM `vehicle_store_components` WHERE `vehicleid`=%d AND `state`=2",
        sql_id
    );
    result = mysql_query(mysql, query, true);
    new rows = cache_num_rows();
    for(new row = 0; row < rows; row++)
    {
        new itemid = cache_get_field_content_int(row, "componentid");
        new componentid = RaceSto_GetTuneIdFromItem(itemid);
        if(componentid > 0) RaceSto_SendComponentAction(playerid, vehicleid, 0, componentid);
    }
    cache_delete(result);
    return 1;
}

forward RaceSto_DelayedSync(playerid, vehicleid);
public RaceSto_DelayedSync(playerid, vehicleid)
{
    if(IsPlayerConnected(playerid) && IsValidVehicle(vehicleid))
    {
        RaceSto_SyncForPlayer(playerid, vehicleid);
    }
    return 1;
}

stock RaceSto_GetComponentState(vehicleid, itemid)
{
    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0) return -1;

    new query[180], Cache:result, component_state = 0;
    mysql_format(mysql, query, sizeof(query),
        "SELECT `state` FROM `vehicle_store_components` WHERE `vehicleid`=%d AND `componentid`=%d LIMIT 1",
        sql_id, itemid
    );
    result = mysql_query(mysql, query, true);
    if(cache_num_rows() > 0) component_state = cache_get_field_content_int(0, "state");
    cache_delete(result);
    return component_state;
}

stock RaceSto_BuyComponent(playerid, vehicleid, itemid)
{
    if(RaceSto_GetOwnedVehicleIndexCompat(playerid, vehicleid) == -1) return 0;
    if(!RaceSto_IsItemAvailable(vehicleid, itemid)) return 0;
    new componentid = RaceSto_GetTuneIdFromItem(itemid);
    if(componentid <= 0) return 0;

    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0 || RaceSto_GetComponentState(vehicleid, itemid) == 2) return 0;

    new pay = RaceSto_GetComponentPriceCompat(RaceSto_GetVehiclePriceCompat(vehicleid));
    if(GetPlayerMoneyEx(playerid) < pay) return 0;
    GivePlayerMoneyEx(playerid, -pay);

    new query[220];
    mysql_format(mysql, query, sizeof(query),
        "INSERT INTO `vehicle_store_components` (`vehicleid`,`componentid`,`state`) VALUES (%d,%d,2) ON DUPLICATE KEY UPDATE `state`=2",
        sql_id, itemid
    );
    // Синхронная запись гарантирует сохранение покупки при быстром перезаходе.
    mysql_query(mysql, query, false);
    RaceSto_ApplyComponentToStream(vehicleid, itemid, true);
    return 1;
}

stock RaceSto_RemoveComponent(playerid, vehicleid, itemid)
{
    if(RaceSto_GetOwnedVehicleIndexCompat(playerid, vehicleid) == -1) return 0;
    if(!RaceSto_IsItemAvailable(vehicleid, itemid)) return 0;
    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0 || RaceSto_GetComponentState(vehicleid, itemid) != 2) return 0;

    new query[180];
    mysql_format(mysql, query, sizeof(query),
        "UPDATE `vehicle_store_components` SET `state`=0 WHERE `vehicleid`=%d AND `componentid`=%d",
        sql_id, itemid
    );
    mysql_query(mysql, query, false);
    RaceSto_ApplyComponentToStream(vehicleid, itemid, false);
    return 1;
}

stock ShowRaceStoGUI(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID || vehicleid == 0)
        return RaceSto_NotifyError(playerid, "Вы должны быть в машине!");
    new index = RaceSto_GetOwnedVehicleIndexCompat(playerid, vehicleid);
    if(index == -1)
        return RaceSto_NotifyError(playerid, "Это не ваш личный транспорт!");

    new modelid = vInfo[vehicleid][vModelID];
    if(modelid <= 0) modelid = GetVehicleModel(vehicleid);

    // Используем те же таблицы/функции, что и уже рабочие тюнинг-центры в
    // основном гейммоде (GetVehicleJsonIdFromModel/GetVehicleComponents/
    // gVehicleComponentList), а не собственные дублирующие RaceSto-таблицы.
    // Раньше клиент получал componentid из другой нумерации, и кнопка
    // "купить" не находила соответствие — ничего не происходило.
    new jsonid = GetVehicleJsonIdFromModel(modelid);
    new start, count;
    new bool:universal_sto = false;
    if(jsonid < 0)
    {
        // Custom model without a JSON mapping: use the universal STO kit.
        universal_sto = true;
        jsonid = GetVehicleJsonIdFromModel(400);
        if(jsonid < 0) jsonid = 1;
        start = 0;
        count = sizeof(RaceStoUniversalComponentItems);
    }
    else if(!GetVehicleComponents(jsonid, start, count))
    {
        return RaceSto_NotifyError(playerid, "\xc4\xeb\xff \xfd\xf2\xeeй \xec\xeeд\xe5\xebи \xedе\xf2 \xe4\xeeступных \xeeб\xe2ес\xeeв");
    }
    else if(start < 0 || count <= 0)
    {
        universal_sto = true;
        start = 0;
        count = sizeof(RaceStoUniversalComponentItems);
    }

    new sql_id = vInfo[vehicleid][vSQLID];
        return RaceSto_NotifyError(playerid, "Для этой модели нет доступных обвесов");

    new sql_id = vInfo[vehicleid][vSQLID];
    if(sql_id <= 0) sql_id = GetOwnableCarData(index, OC_SQL_ID);

    new query[220], Cache:result;
    mysql_format(mysql, query, sizeof(query),
        "SELECT `componentid`,`state` FROM `vehicle_store_components` WHERE `vehicleid`=%d",
        sql_id
    );
    result = mysql_query(mysql, query, true);
    new rows = cache_num_rows();

    new Node:tuning_json = JSON_Object();
    new Node:component_array = JSON_Array();
    new Node:detail_array = JSON_Array();

    for(new x = 0; x < count; x++)
    {
        new itemid;
        if(universal_sto) itemid = RaceStoUniversalComponentItems[x];
        else itemid = RaceStoVehicleComponentList[start + x];
        new component_state = 0, found = 0;
        for(new row = 0; row < rows; row++)
        {
            if(cache_get_field_content_int(row, "componentid") == itemid)
            {
                component_state = cache_get_field_content_int(row, "state");
                found = 1;
                break;
            }
        }
        component_array = JSON_Append(component_array, JSON_Array(JSON_Int(itemid)));
        component_array = JSON_Append(component_array, JSON_Array(JSON_Int(component_state)));
        if(!found)
        {
            mysql_format(mysql, query, sizeof(query),
                "INSERT IGNORE INTO `vehicle_store_components` (`vehicleid`,`componentid`,`state`) VALUES (%d,%d,0)",
                sql_id, itemid
            );
            mysql_query(mysql, query, false);
        }
    }
    cache_delete(result);

    for(new i = 0; i < 7; i++)
        detail_array = JSON_Append(detail_array, JSON_Array(JSON_Int(100)));

    new name[64];
    GetVehicleModelName(modelid, name, sizeof(name));

    JSON_SetInt(tuning_json, "o", 1);
    JSON_SetInt(tuning_json, "w", 1);
    JSON_SetInt(tuning_json, "t", 0);
    JSON_SetInt(tuning_json, "j", GetVehiclePriceByModel(modelid));
    JSON_SetInt(tuning_json, "s", jsonid);
    JSON_SetString(tuning_json, "nm", GetPlayerNameEx(playerid));
    JSON_SetString(tuning_json, "n", name);
    JSON_SetInt(tuning_json, "m", GetPlayerMoneyEx(playerid));
    JSON_SetInt(tuning_json, "engine", 1);
    JSON_SetInt(tuning_json, "brakes", 2);
    JSON_SetInt(tuning_json, "suspension", 3);
    JSON_SetArray(tuning_json, "d", detail_array);
    JSON_SetArray(tuning_json, "k", component_array);

    new bool:already_inside = (RaceStyleCenterType[playerid] == 1 && RaceStyleReturnSaved[playerid]);
    InStailing[playerid] = false;

    if(!already_inside)
    {
        RaceSto_SaveReturnCompat(playerid, vehicleid);
        RaceStyleCenterType[playerid] = 1;

        new vw = vehicleid;
        SetPlayerVirtualWorld(playerid, vw);
        SetVehicleVirtualWorld(vehicleid, vw);
        LinkVehicleToInterior(vehicleid, 1);
        SetPlayerInterior(playerid, 1);
        RaceSto_SetOccupantsEnvironmentCompat(vehicleid, vw, 1);
        SetVehiclePos(vehicleid, 2508.3931, 1504.2278, 1497.5000);
        SetVehicleZAngle(vehicleid, 0.0);
        PutPlayerInVehicle(playerid, vehicleid, 0);
    }

    SetPVarInt(playerid, "RaceStoSession", 1);
    TogglePlayerControllable(playerid, false);
    RaceSto_SyncForPlayer(playerid, vehicleid);
    SetTimerEx("RaceSto_DelayedSync", 700, false, "dd", playerid, vehicleid);
    SetPlayerCameraPos(playerid, 2501.2969, 1511.0194, 1500.2665);
    SetPlayerCameraLookAt(playerid, 2502.0427, 1510.3536, 1500.0214);

    ShowPlayerGUI(playerid, 28, tuning_json);
    JSON_Cleanup(tuning_json);
    return 1;
}

// Вход по гудку (KEY_CROUCH) рядом со СТО, а не по команде — см. хук в
// RaceSto_TryEnterOnHorn(), который нужно вызвать из основного
// OnPlayerKeyStateChange (сюда его нельзя дублировать: этот колбэк уже
// объявлен в основном .pwn, а Pawn не разрешает объявлять public с тем же
// именем дважды в одной сборке).
#define RACE_STO_ENTER_RADIUS (3.0)

// Fiksirovannaya tochka vyezda so STO (vyezdnye vorota), a ne pozitsiya do
// vhoda - tak mashina vsegda poyavlyaetsya v odnom i tom zhe izvestnom meste.
#define RACE_STO_EXIT_X         (1843.664794)
#define RACE_STO_EXIT_Y         (-112.974449)
#define RACE_STO_EXIT_Z         (14.944688)
#define RACE_STO_EXIT_ANGLE     (355.141937)
#define RACE_STO_EXIT_INTERIOR  (0)
#define RACE_STO_EXIT_WORLD     (0)

// Vozvrashaet igroka i mashinu iz STO na fiksirovannuyu tochku vyezda.
// Bez etoy funktsii mashina navsegda ostavalas' v izolirovannom virtual_world
// (ravnom vehicleid) i interior 1 - imenno poetomu mashiny "propadali" na STO:
// oni fizicheski nikuda ne devalis', no vernut'sya ottuda bylo nechem.
stock RaceSto_ExitCompat(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(RaceStyleCenterType[playerid] != 1 || !RaceStyleReturnSaved[playerid]) return 0;

    new vehicleid = RaceStyleReturnVehicle[playerid];
    new vw = RACE_STO_EXIT_WORLD;
    new interiorid = RACE_STO_EXIT_INTERIOR;

    if(IsValidVehicle(vehicleid))
    {
        SetVehicleVirtualWorld(vehicleid, vw);
        LinkVehicleToInterior(vehicleid, interiorid);
        SetVehiclePos(vehicleid, RACE_STO_EXIT_X, RACE_STO_EXIT_Y, RACE_STO_EXIT_Z);
        SetVehicleZAngle(vehicleid, RACE_STO_EXIT_ANGLE);
        RaceSto_SetOccupantsEnvironmentCompat(vehicleid, vw, interiorid);
    }

    SetPlayerVirtualWorld(playerid, vw);
    SetPlayerInterior(playerid, interiorid);

    if(IsValidVehicle(vehicleid) && GetPlayerVehicleID(playerid) != vehicleid)
    {
        PutPlayerInVehicle(playerid, vehicleid, 0);
    }
    else
    {
        SetPlayerPos(playerid, RACE_STO_EXIT_X, RACE_STO_EXIT_Y, RACE_STO_EXIT_Z);
        SetPlayerFacingAngle(playerid, RACE_STO_EXIT_ANGLE);
    }

    TogglePlayerControllable(playerid, true);
    DeletePVar(playerid, "RaceStoSession");
    InStailing[playerid] = false;
    RaceStyleCenterType[playerid] = 0;
    RaceStyleReturnSaved[playerid] = false;
    RaceStyleReturnVehicle[playerid] = INVALID_VEHICLE_ID;

    return 1;
}

stock RaceSto_TryEnterOnHorn(playerid)
{
    // Esli igrok uzhe vnutri STO - vtoroy gudok vyhodit obratno, chtoby
    // mashina ne ostavalas' zaperta v tehnicheskom virtual_world naveki.
    if(RaceStyleCenterType[playerid] == 1 && RaceStyleReturnSaved[playerid])
    {
        return RaceSto_ExitCompat(playerid);
    }

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 0;

    if(IsPlayerInRangeOfPoint(playerid, RACE_STO_ENTER_RADIUS, 1871.219604, -122.645393, 15.749794))
    {
        ShowRaceStoGUI(playerid);
        return 1;
    }
    return 0;
}

// Strahovka: esli igrok otklyuchilsya (vylet, zakrytie igry i t.d.) poka
// nahodilsya vnutri STO, vozvrashchaem ego mashinu na mesto DO disconnecta,
// inache ona tak i ostanetsya v izolirovannom virtual_world navsegda.
stock RaceSto_OnDisconnectCompat(playerid)
{
    if(RaceStyleCenterType[playerid] == 1 && RaceStyleReturnSaved[playerid])
    {
        RaceSto_ExitCompat(playerid);
    }
    return 1;
}



#endif

#define FW_COLOR                 0xE7B548FF
#define FW_GREEN                 0x2ECC71FF
#define FW_RED                   0xE74C3CFF
#define FW_WHITE                 0xFFFFFFFF
#define FW_GRAY                  0xBFC0C2FF

#define FW_WORLD_BASE            12000
// Family Wars integrated forwards
#define FW_MAX_SCORE             50
#define FW_DEFAULT_DURATION      900     
#define FW_MIN_PLAYERS           2       
#define FW_MAX_ROSTER            20

#define FW_WIN_FAMILY_REWARD     500000
#define FW_WIN_PLAYER_REWARD     75000
#define FW_LOSE_PLAYER_REWARD    20000
#define FW_MVP_REWARD            150000

#define FW_POINTS_WIN            3
#define FW_POINTS_DRAW           1

#define FW_CONTAINER_BRONZE      1
#define FW_CONTAINER_SILVER      2
#define FW_CONTAINER_GOLD        3

#define DIALOG_FW_LIST           9300
#define DIALOG_FW_STATS          9301
#define DIALOG_FW_HISTORY        9302
#define DIALOG_FW_ROSTER         9303
#define DIALOG_FW_CONTAINER      9304

enum E_FW_STATE
{
    FW_STATE_NONE = 0,
    FW_STATE_SCHEDULED,
    FW_STATE_RUNNING,
    FW_STATE_FINISHED,
    FW_STATE_CANCELLED
};

enum E_FW_PLAYER
{
    bool:fwInWar,
    fwWarID,
    fwTeam,
    fwKills,
    fwDeaths,
    bool:fwRegistered,
    fwRegisteredWarID,
    Float:fwOldX,
    Float:fwOldY,
    Float:fwOldZ,
    Float:fwOldA,
    Float:fwOldHP,
    Float:fwOldArmour,
    fwOldVW,
    fwOldInterior
};

new FWPlayer[MAX_PLAYERS][E_FW_PLAYER];

new FWOldWeapon[MAX_PLAYERS][13];
new FWOldAmmo[MAX_PLAYERS][13];

new gFWCurrentWarID = 0;
new gFWFamily1 = 0;
new gFWFamily2 = 0;
new gFWScore1 = 0;
new gFWScore2 = 0;
new gFWWorld = 0;
new gFWEndTime = 0;
new gFWStartTime = 0;
new gFWTargetScore = FW_MAX_SCORE;
new gFWDuration = FW_DEFAULT_DURATION;
new gFWSeasonID = 1;
new gFWTimer = -1;

new Float:gFWSpawn1[4] = {2200.0, -1140.0, 1029.8, 90.0};
new Float:gFWSpawn2[4] = {2230.0, -1140.0, 1029.8, 270.0};
new gFWInterior = 15;

stock FW_GetAccountID(playerid)
{
    return GetPlayerAccountID(playerid);
}

stock FW_GetFamilyID(playerid)
{
    return GetPlayerData(playerid, P_FAMILY);
}

stock bool:FW_IsFamilyLeader(playerid)
{
    return (GetPlayerData(playerid, P_FAMILY) >= 0 && GetPlayerData(playerid, P_FAMILY_RANK) >= 10);
}

stock bool:FW_IsAdmin(playerid)
{
    return (GetPlayerAdminEx(playerid) >= 5);
}

stock FW_AddMoney(playerid, amount)
{
    if(!IsPlayerConnected(playerid)) return 0;
    GivePlayerMoneyEx(playerid, amount, "Family War", true, false);
    return 1;
}

stock FW_AddFamilyBalance(familyid, amount)
{
    if(familyid < 0 || familyid >= MAX_FAM) return 0;
    if(GetFamily(familyid, family_database) < 0) return 0;

    AddFamily(familyid, family_money, +, amount);
    UpdateColumnFamilyInt(GetFamily(familyid, family_database), "money", GetFamily(familyid, family_money));
    return 1;
}

stock FW_GetFamilyName(familyid, output[], size)
{
    if(familyid >= 0 && familyid < MAX_FAM && GetFamily(familyid, family_database) >= 0)
        format(output, size, "%s", GetFamily(familyid, family_name));
    else
        format(output, size, "Family #%d", familyid);
    return 1;
}

stock FW_EnsureTables()
{
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS family_war_seasons (id INT NOT NULL AUTO_INCREMENT, name VARCHAR(64) NOT NULL DEFAULT 'Season 1', active TINYINT(1) NOT NULL DEFAULT 1, start_time INT NOT NULL DEFAULT 0, end_time INT NOT NULL DEFAULT 0, PRIMARY KEY (id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS family_wars (id INT NOT NULL AUTO_INCREMENT, season_id INT NOT NULL DEFAULT 0, family1_id INT NOT NULL, family2_id INT NOT NULL, start_time INT NOT NULL DEFAULT 0, duration INT NOT NULL DEFAULT 900, target_score INT NOT NULL DEFAULT 50, status INT NOT NULL DEFAULT 1, actual_start INT NOT NULL DEFAULT 0, actual_end INT NOT NULL DEFAULT 0, score1 INT NOT NULL DEFAULT 0, score2 INT NOT NULL DEFAULT 0, mvp_account_id INT NOT NULL DEFAULT 0, PRIMARY KEY (id), KEY idx_fw_status_start (status,start_time), KEY idx_fw_season (season_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS family_war_roster (war_id INT NOT NULL, family_id INT NOT NULL, account_id INT NOT NULL, player_name VARCHAR(32) NOT NULL DEFAULT '', PRIMARY KEY (war_id,account_id), KEY idx_fw_roster_family (war_id,family_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS family_war_kills (id BIGINT NOT NULL AUTO_INCREMENT, war_id INT NOT NULL, killer_account_id INT NOT NULL DEFAULT 0, victim_account_id INT NOT NULL DEFAULT 0, killer_family_id INT NOT NULL DEFAULT 0, victim_family_id INT NOT NULL DEFAULT 0, weapon_id INT NOT NULL DEFAULT 0, created_at INT NOT NULL DEFAULT 0, PRIMARY KEY (id), KEY idx_fw_kills_war (war_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS family_war_player_results (id BIGINT NOT NULL AUTO_INCREMENT, war_id INT NOT NULL, account_id INT NOT NULL, family_id INT NOT NULL, kills INT NOT NULL DEFAULT 0, deaths INT NOT NULL DEFAULT 0, reward INT NOT NULL DEFAULT 0, result INT NOT NULL DEFAULT 0, created_at INT NOT NULL DEFAULT 0, PRIMARY KEY (id), UNIQUE KEY uq_fw_result (war_id,account_id), KEY idx_fw_result_account (account_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS family_war_player_stats (account_id INT NOT NULL, family_id INT NOT NULL, wins INT NOT NULL DEFAULT 0, losses INT NOT NULL DEFAULT 0, draws INT NOT NULL DEFAULT 0, kills INT NOT NULL DEFAULT 0, deaths INT NOT NULL DEFAULT 0, points INT NOT NULL DEFAULT 0, PRIMARY KEY (account_id,family_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS family_war_family_stats (season_id INT NOT NULL, family_id INT NOT NULL, wins INT NOT NULL DEFAULT 0, losses INT NOT NULL DEFAULT 0, draws INT NOT NULL DEFAULT 0, points INT NOT NULL DEFAULT 0, kills INT NOT NULL DEFAULT 0, deaths INT NOT NULL DEFAULT 0, PRIMARY KEY (season_id,family_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS family_containers (family_id INT NOT NULL, container_type INT NOT NULL, amount INT NOT NULL DEFAULT 0, PRIMARY KEY (family_id,container_type)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", false);
    return 1;
}

public FW_Init()
{
    FW_EnsureTables();
    if(gFWTimer != -1)
        KillTimer(gFWTimer);

    gFWTimer = SetTimer("FW_GlobalTick", 5000, true);
    FW_LoadSeason();
    FW_CheckScheduledWar();
    return 1;
}

public FW_InitPlayer(playerid)
{
    FWPlayer[playerid][fwInWar] = false;
    FWPlayer[playerid][fwWarID] = 0;
    FWPlayer[playerid][fwTeam] = 0;
    FWPlayer[playerid][fwKills] = 0;
    FWPlayer[playerid][fwDeaths] = 0;
    FWPlayer[playerid][fwRegistered] = false;
    FWPlayer[playerid][fwRegisteredWarID] = 0;
    return 1;
}

stock FW_LoadSeason()
{
    mysql_tquery(
        mysql,
        "SELECT id FROM family_war_seasons WHERE active=1 ORDER BY id DESC LIMIT 1",
        "FW_OnSeasonLoaded"
    );
    return 1;
}

forward FW_OnSeasonLoaded();
public FW_OnSeasonLoaded()
{
    if(cache_num_rows())
    {
        cache_get_field_content_int(0, "id", gFWSeasonID);
    }
    else
    {
        mysql_tquery(
            mysql,
            "INSERT INTO family_war_seasons (name, active) VALUES ('Season 1', 1)"
        );
        gFWSeasonID = 1;
    }
    return 1;
}

forward FW_GlobalTick();
public FW_GlobalTick()
{
    if(gFWCurrentWarID == 0)
    {
        FW_CheckScheduledWar();
    }
    else
    {
        if(gettime() >= gFWEndTime)
        {
            FW_FinishWar(0);
        }
    }
    return 1;
}

stock FW_CheckScheduledWar()
{
    if(gFWCurrentWarID != 0)
        return 0;

    new query[512];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "SELECT id,family1_id,family2_id,start_time,duration,target_score \
         FROM family_wars \
         WHERE status=%d AND start_time<=UNIX_TIMESTAMP() \
         ORDER BY start_time ASC LIMIT 1",
        FW_STATE_SCHEDULED
    );

    mysql_tquery(mysql, query, "FW_OnScheduledWarFound");
    return 1;
}

forward FW_OnScheduledWarFound();
public FW_OnScheduledWarFound()
{
    if(gFWCurrentWarID != 0 || !cache_num_rows())
        return 1;

    new warid, fam1, fam2, starttime, duration, target;

    cache_get_field_content_int(0, "id", warid);
    cache_get_field_content_int(0, "family1_id", fam1);
    cache_get_field_content_int(0, "family2_id", fam2);
    cache_get_field_content_int(0, "start_time", starttime);
    cache_get_field_content_int(0, "duration", duration);
    cache_get_field_content_int(0, "target_score", target);

    FW_StartWar(warid, fam1, fam2, starttime, duration, target);
    return 1;
}

stock FW_CreateWar(family1, family2, startUnix, duration = FW_DEFAULT_DURATION, targetScore = FW_MAX_SCORE)
{
    if(family1 <= 0 || family2 <= 0 || family1 == family2)
        return 0;

    new query[700];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "INSERT INTO family_wars \
        (season_id,family1_id,family2_id,start_time,duration,target_score,status) \
        VALUES (%d,%d,%d,%d,%d,%d,%d)",
        gFWSeasonID,
        family1,
        family2,
        startUnix,
        duration,
        targetScore,
        FW_STATE_SCHEDULED
    );

    mysql_tquery(mysql, query);
    return 1;
}

stock FW_CMD_fwcreate(playerid, params[])
{
    if(!FW_IsAdmin(playerid))
        return SendClientMessage(playerid, FW_RED, "\xCD\xE5\xE4\xEE\xF1\xF2\xE0\xF2\xEE\xF7\xED\xEE \xEF\xF0\xE0\xE2.");

    new family1, family2, minutes, duration, target;

    if(sscanf(params, "iiiii", family1, family2, minutes, duration, target))
    {
        return SendClientMessage(
            playerid,
            FW_WHITE,
            "\xC8\xF1\xEF\xEE\xEB\xFC\xE7\xF3\xE9\xF2\xE5: /fwcreate [family1] [family2] [\xF7\xE5\xF0\xE5\xE7 \xEC\xE8\xED\xF3\xF2] [\xE4\xEB\xE8\xF2\xE5\xEB\xFC\xED\xEE\xF1\xF2\xFC \xF1\xE5\xEA] [\xF6\xE5\xEB\xFC \xEA\xE8\xEB\xEB\xEE\xE2]"
        );
    }

    if(minutes < 1 || duration < 60 || target < 1)
        return SendClientMessage(playerid, FW_RED, "\xCD\xE5\xEA\xEE\xF0\xF0\xE5\xEA\xF2\xED\xFB\xE5 \xEF\xE0\xF0\xE0\xEC\xE5\xF2\xF0\xFB.");

    FW_CreateWar(family1, family2, gettime() + minutes * 60, duration, target);

    SendClientMessage(playerid, FW_GREEN, "\xD1\xE5\xEC\xE5\xE9\xED\xE0\xFF \xE2\xEE\xE9\xED\xE0 \xE4\xEE\xE1\xE0\xE2\xEB\xE5\xED\xE0 \xE2 \xF0\xE0\xF1\xEF\xE8\xF1\xE0\xED\xE8\xE5.");
    return 1;
}

stock FW_CMD_fwarreg(playerid, params[])
{
    new warid;
    if(sscanf(params, "i", warid))
        return SendClientMessage(playerid, FW_WHITE, "\xC8\xF1\xEF\xEE\xEB\xFC\xE7\xF3\xE9\xF2\xE5: /fwarreg [ID \xE2\xEE\xE9\xED\xFB]");

    new familyid = FW_GetFamilyID(playerid);
    if(familyid <= 0)
        return SendClientMessage(playerid, FW_RED, "\xC2\xFB \xED\xE5 \xF1\xEE\xF1\xF2\xEE\xE8\xF2\xE5 \xE2 \xF1\xE5\xEC\xFC\xE5.");

    if(FWPlayer[playerid][fwInWar])
        return SendClientMessage(playerid, FW_RED, "\xC2\xFB \xF3\xE6\xE5 \xF3\xF7\xE0\xF1\xF2\xE2\xF3\xE5\xF2\xE5 \xE2 \xE2\xEE\xE9\xED\xE5.");

    new query[700];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "SELECT id,family1_id,family2_id,start_time,status FROM family_wars \
         WHERE id=%d LIMIT 1",
        warid
    );

    mysql_tquery(mysql, query, "FW_OnRegisterCheck", "dd", playerid, warid);
    return 1;
}

forward FW_OnRegisterCheck(playerid, warid);
public FW_OnRegisterCheck(playerid, warid)
{
    if(!IsPlayerConnected(playerid))
        return 1;

    if(!cache_num_rows())
        return SendClientMessage(playerid, FW_RED, "\xC2\xEE\xE9\xED\xE0 \xED\xE5 \xED\xE0\xE9\xE4\xE5\xED\xE0.");

    new fam1, fam2, starttime, status;
    cache_get_field_content_int(0, "family1_id", fam1);
    cache_get_field_content_int(0, "family2_id", fam2);
    cache_get_field_content_int(0, "start_time", starttime);
    cache_get_field_content_int(0, "status", status);

    if(status != FW_STATE_SCHEDULED)
        return SendClientMessage(playerid, FW_RED, "\xD0\xE5\xE3\xE8\xF1\xF2\xF0\xE0\xF6\xE8\xFF \xED\xE0 \xFD\xF2\xF3 \xE2\xEE\xE9\xED\xF3 \xE7\xE0\xEA\xF0\xFB\xF2\xE0.");

    if(gettime() >= starttime)
        return SendClientMessage(playerid, FW_RED, "\xC2\xEE\xE9\xED\xE0 \xF3\xE6\xE5 \xE4\xEE\xEB\xE6\xED\xE0 \xE1\xFB\xEB\xE0 \xED\xE0\xF7\xE0\xF2\xFC\xF1\xFF.");

    new familyid = FW_GetFamilyID(playerid);
    if(familyid != fam1 && familyid != fam2)
        return SendClientMessage(playerid, FW_RED, "\xC2\xE0\xF8\xE0 \xF1\xE5\xEC\xFC\xFF \xED\xE5 \xF3\xF7\xE0\xF1\xF2\xE2\xF3\xE5\xF2 \xE2 \xFD\xF2\xEE\xE9 \xE2\xEE\xE9\xED\xE5.");

    new query[800];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "SELECT COUNT(*) AS cnt FROM family_war_roster \
         WHERE war_id=%d AND family_id=%d",
        warid,
        familyid
    );

    mysql_tquery(mysql, query, "FW_OnRosterCount", "ddd", playerid, warid, familyid);
    return 1;
}

forward FW_OnRosterCount(playerid, warid, familyid);
public FW_OnRosterCount(playerid, warid, familyid)
{
    if(!IsPlayerConnected(playerid))
        return 1;

    new count;
    cache_get_field_content_int(0, "cnt", count);

    if(count >= FW_MAX_ROSTER)
        return SendClientMessage(playerid, FW_RED, "\xD1\xEE\xF1\xF2\xE0\xE2 \xF1\xE5\xEC\xFC\xE8 \xED\xE0 \xFD\xF2\xF3 \xE2\xEE\xE9\xED\xF3 \xF3\xE6\xE5 \xE7\xE0\xEF\xEE\xEB\xED\xE5\xED.");

    new name[MAX_PLAYER_NAME + 1];
    GetPlayerName(playerid, name, sizeof(name));

    new query[900];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "INSERT INTO family_war_roster \
        (war_id,family_id,account_id,player_name) \
        VALUES (%d,%d,%d,'%e') \
        ON DUPLICATE KEY UPDATE family_id=VALUES(family_id),player_name=VALUES(player_name)",
        warid,
        familyid,
        FW_GetAccountID(playerid),
        name
    );

    mysql_tquery(mysql, query);

    FWPlayer[playerid][fwRegistered] = true;
    FWPlayer[playerid][fwRegisteredWarID] = warid;

    SendClientMessage(playerid, FW_GREEN, "\xC2\xFB \xE7\xE0\xF0\xE5\xE3\xE8\xF1\xF2\xF0\xE8\xF0\xEE\xE2\xE0\xED\xFB \xE2 \xF1\xEE\xF1\xF2\xE0\xE2\xE5 \xED\xE0 \xF1\xE5\xEC\xE5\xE9\xED\xF3\xFE \xE2\xEE\xE9\xED\xF3.");
    return 1;
}

stock FW_CMD_fwarunreg(playerid, params[])
{
    new warid;
    if(sscanf(params, "i", warid))
        return SendClientMessage(playerid, FW_WHITE, "\xC8\xF1\xEF\xEE\xEB\xFC\xE7\xF3\xE9\xF2\xE5: /fwarunreg [ID \xE2\xEE\xE9\xED\xFB]");

    new query[500];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "DELETE FROM family_war_roster WHERE war_id=%d AND account_id=%d",
        warid,
        FW_GetAccountID(playerid)
    );
    mysql_tquery(mysql, query);

    if(FWPlayer[playerid][fwRegisteredWarID] == warid)
    {
        FWPlayer[playerid][fwRegistered] = false;
        FWPlayer[playerid][fwRegisteredWarID] = 0;
    }

    SendClientMessage(playerid, FW_GRAY, "\xD0\xE5\xE3\xE8\xF1\xF2\xF0\xE0\xF6\xE8\xFF \xEE\xF2\xEC\xE5\xED\xE5\xED\xE0.");
    return 1;
}

stock FW_CMD_fwars(playerid, params[])
{
    new query[700];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "SELECT id,family1_id,family2_id,start_time,status,target_score \
         FROM family_wars \
         WHERE season_id=%d \
         ORDER BY id DESC LIMIT 20",
        gFWSeasonID
    );

    mysql_tquery(mysql, query, "FW_OnWarsList", "d", playerid);
    return 1;
}

forward FW_OnWarsList(playerid);
public FW_OnWarsList(playerid)
{
    if(!IsPlayerConnected(playerid))
        return 1;

    new rows = cache_num_rows();
    if(!rows)
    {
        return ShowPlayerDialog(
            playerid,
            DIALOG_FW_LIST,
            DIALOG_STYLE_MSGBOX,
            "\xD1\xE5\xEC\xE5\xE9\xED\xFB\xE5 \xE2\xEE\xE9\xED\xFB",
            "\xC2 \xFD\xF2\xEE\xEC \xF1\xE5\xE7\xEE\xED\xE5 \xE2\xEE\xE9\xED \xEF\xEE\xEA\xE0 \xED\xE5\xF2.",
            "\xC7\xE0\xEA\xF0\xFB\xF2\xFC",
            ""
        );
    }

    new text[3500];
    strcat(text, "ID\t\xD1\xE5\xEC\xFC\xFF 1\t\xD1\xE5\xEC\xFC\xFF 2\t\xD1\xF2\xE0\xF2\xF3\xF1\t\xD6\xE5\xEB\xFC\n");

    for(new i = 0; i < rows; i++)
    {
        new id, f1, f2, status, target;
        cache_get_field_content_int(i, "id", id);
        cache_get_field_content_int(i, "family1_id", f1);
        cache_get_field_content_int(i, "family2_id", f2);
        cache_get_field_content_int(i, "status", status);
        cache_get_field_content_int(i, "target_score", target);

        new n1[32], n2[32], statusName[24], fwrow[220];
        FW_GetFamilyName(f1, n1, sizeof(n1));
        FW_GetFamilyName(f2, n2, sizeof(n2));

        switch(status)
        {
            case FW_STATE_SCHEDULED: format(statusName, sizeof(statusName), "\xCE\xE6\xE8\xE4\xE0\xE5\xF2\xF1\xFF");
            case FW_STATE_RUNNING: format(statusName, sizeof(statusName), "\xC8\xE4\xB8\xF2");
            case FW_STATE_FINISHED: format(statusName, sizeof(statusName), "\xC7\xE0\xE2\xE5\xF0\xF8\xE5\xED\xE0");
            case FW_STATE_CANCELLED: format(statusName, sizeof(statusName), "\xCE\xF2\xEC\xE5\xED\xE5\xED\xE0");
            default: format(statusName, sizeof(statusName), "-");
        }

        format(fwrow, sizeof(fwrow), "%d\t", id);
        strcat(fwrow, n1);
        strcat(fwrow, "\t");
        strcat(fwrow, n2);
        strcat(fwrow, "\t");
        strcat(fwrow, statusName);
        format(fwrow, sizeof(fwrow), "%s%d\n", fwrow, target);
        strcat(text, fwrow);
    }

    ShowPlayerDialog(
        playerid,
        DIALOG_FW_LIST,
        DIALOG_STYLE_TABLIST_HEADERS,
        "\xD1\xE5\xEC\xE5\xE9\xED\xFB\xE5 \xE2\xEE\xE9\xED\xFB | \xD1\xE5\xE7\xEE\xED",
        text,
        "\xC7\xE0\xEA\xF0\xFB\xF2\xFC",
        ""
    );

    return 1;
}

stock FW_StartWar(warid, fam1, fam2, starttime, duration, targetScore)
{
    if(gFWCurrentWarID != 0)
        return 0;

    gFWCurrentWarID = warid;
    gFWFamily1 = fam1;
    gFWFamily2 = fam2;
    gFWScore1 = 0;
    gFWScore2 = 0;
    gFWWorld = FW_WORLD_BASE + warid;
    gFWStartTime = starttime;
    gFWDuration = duration;
    gFWTargetScore = targetScore;
    gFWEndTime = gettime() + duration;

    new query[500];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "UPDATE family_wars SET status=%d,actual_start=UNIX_TIMESTAMP() WHERE id=%d",
        FW_STATE_RUNNING,
        warid
    );
    mysql_tquery(mysql, query);

    new count1 = 0, count2 = 0;

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i))
            continue;

        if(FWPlayer[i][fwRegisteredWarID] != warid)
            continue;

        new fam = FW_GetFamilyID(i);

        if(fam == fam1)
        {
            count1++;
            FW_EnterWar(i, 1);
        }
        else if(fam == fam2)
        {
            count2++;
            FW_EnterWar(i, 2);
        }
    }

    if(count1 < FW_MIN_PLAYERS || count2 < FW_MIN_PLAYERS)
    {
        FW_CancelWarForLowPlayers(count1, count2);
        return 0;
    }

    new msg[256];
    format(
        msg,
        sizeof(msg),
        "FAMILY WAR: \xE2\xEE\xE9\xED\xE0 #%d \xED\xE0\xF7\xE0\xEB\xE0\xF1\xFC! \xD1\xF7\xB8\xF2 %d:%d, \xF6\xE5\xEB\xFC %d \xF3\xE1\xE8\xE9\xF1\xF2\xE2.",
        warid,
        gFWScore1,
        gFWScore2,
        gFWTargetScore
    );
    SendClientMessageToAll(FW_COLOR, msg);
    return 1;
}

stock FW_CancelWarForLowPlayers(count1, count2)
{
    new warid = gFWCurrentWarID;

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && FWPlayer[i][fwInWar] && FWPlayer[i][fwWarID] == warid)
        {
            FW_LeaveWar(i);
            SendClientMessage(i, FW_RED, "\xC2\xEE\xE9\xED\xE0 \xEE\xF2\xEC\xE5\xED\xE5\xED\xE0: \xED\xE5\xE4\xEE\xF1\xF2\xE0\xF2\xEE\xF7\xED\xEE \xF3\xF7\xE0\xF1\xF2\xED\xE8\xEA\xEE\xE2.");
        }
    }

    new query[500];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "UPDATE family_wars SET status=%d,score1=%d,score2=%d,actual_end=UNIX_TIMESTAMP() WHERE id=%d",
        FW_STATE_CANCELLED,
        count1,
        count2,
        warid
    );
    mysql_tquery(mysql, query);

    FW_ResetCurrentWar();
    return 1;
}

stock FW_SavePlayerState(playerid)
{
    GetPlayerPos(
        playerid,
        FWPlayer[playerid][fwOldX],
        FWPlayer[playerid][fwOldY],
        FWPlayer[playerid][fwOldZ]
    );
    GetPlayerFacingAngle(playerid, FWPlayer[playerid][fwOldA]);
    GetPlayerHealth(playerid, FWPlayer[playerid][fwOldHP]);
    GetPlayerArmour(playerid, FWPlayer[playerid][fwOldArmour]);

    FWPlayer[playerid][fwOldVW] = GetPlayerVirtualWorld(playerid);
    FWPlayer[playerid][fwOldInterior] = GetPlayerInterior(playerid);

    for(new slot = 0; slot < 13; slot++)
    {
        GetPlayerWeaponData(
            playerid,
            slot,
            FWOldWeapon[playerid][slot],
            FWOldAmmo[playerid][slot]
        );
    }

    return 1;
}

stock FW_EnterWar(playerid, team)
{
    FW_SavePlayerState(playerid);

    FWPlayer[playerid][fwInWar] = true;
    FWPlayer[playerid][fwWarID] = gFWCurrentWarID;
    FWPlayer[playerid][fwTeam] = team;
    FWPlayer[playerid][fwKills] = 0;
    FWPlayer[playerid][fwDeaths] = 0;

    ResetPlayerWeapons(playerid);
    GivePlayerWeapon(playerid, 24, 150);
    GivePlayerWeapon(playerid, 31, 500);
    GivePlayerWeapon(playerid, 34, 30);

    SetPlayerHealth(playerid, 100.0);
    SetPlayerArmour(playerid, 100.0);

    FW_SetWarSpawn(playerid);
    return 1;
}

stock FW_SetWarSpawn(playerid)
{
    if(!FWPlayer[playerid][fwInWar])
        return 0;

    SetPlayerVirtualWorld(playerid, gFWWorld);
    SetPlayerInterior(playerid, gFWInterior);

    if(FWPlayer[playerid][fwTeam] == 1)
    {
        SetPlayerPos(playerid, gFWSpawn1[0], gFWSpawn1[1], gFWSpawn1[2]);
        SetPlayerFacingAngle(playerid, gFWSpawn1[3]);
    }
    else
    {
        SetPlayerPos(playerid, gFWSpawn2[0], gFWSpawn2[1], gFWSpawn2[2]);
        SetPlayerFacingAngle(playerid, gFWSpawn2[3]);
    }

    SetPlayerHealth(playerid, 100.0);
    SetPlayerArmour(playerid, 100.0);
    return 1;
}

stock FW_LeaveWar(playerid)
{
    FWPlayer[playerid][fwInWar] = false;
    FWPlayer[playerid][fwWarID] = 0;
    FWPlayer[playerid][fwTeam] = 0;

    SetPlayerVirtualWorld(playerid, FWPlayer[playerid][fwOldVW]);
    SetPlayerInterior(playerid, FWPlayer[playerid][fwOldInterior]);

    SetPlayerPos(
        playerid,
        FWPlayer[playerid][fwOldX],
        FWPlayer[playerid][fwOldY],
        FWPlayer[playerid][fwOldZ]
    );
    SetPlayerFacingAngle(playerid, FWPlayer[playerid][fwOldA]);

    SetPlayerHealth(playerid, FWPlayer[playerid][fwOldHP]);
    SetPlayerArmour(playerid, FWPlayer[playerid][fwOldArmour]);

    ResetPlayerWeapons(playerid);

    for(new slot = 0; slot < 13; slot++)
    {
        if(FWOldWeapon[playerid][slot] != 0)
        {
            GivePlayerWeapon(
                playerid,
                FWOldWeapon[playerid][slot],
                FWOldAmmo[playerid][slot]
            );
        }
    }

    return 1;
}

public FW_OnPlayerDeath(playerid, killerid)
{
    if(!FWPlayer[playerid][fwInWar])
        return 0;

    if(FWPlayer[playerid][fwWarID] != gFWCurrentWarID)
        return 0;

    FWPlayer[playerid][fwDeaths]++;

    if(
        killerid != INVALID_PLAYER_ID &&
        IsPlayerConnected(killerid) &&
        FWPlayer[killerid][fwInWar] &&
        FWPlayer[killerid][fwWarID] == gFWCurrentWarID &&
        FWPlayer[killerid][fwTeam] != FWPlayer[playerid][fwTeam]
    )
    {
        FWPlayer[killerid][fwKills]++;

        if(FWPlayer[killerid][fwTeam] == 1)
            gFWScore1++;
        else
            gFWScore2++;

        FW_SaveKill(killerid, playerid);

        new msg[160];
        format(
            msg,
            sizeof(msg),
            "FAMILY WAR | \xD1\xF7\xB8\xF2: %d : %d | \xC2\xE0\xF8\xE8 \xF3\xE1\xE8\xE9\xF1\xF2\xE2\xE0: %d",
            gFWScore1,
            gFWScore2,
            FWPlayer[killerid][fwKills]
        );
        SendClientMessage(killerid, FW_COLOR, msg);

        if(gFWScore1 >= gFWTargetScore || gFWScore2 >= gFWTargetScore)
        {
            FW_FinishWar((gFWScore1 > gFWScore2) ? 1 : 2);
        }
    }

    return 1;
}

stock FW_SaveKill(killerid, victimid)
{
    new query[900];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "INSERT INTO family_war_kills \
        (war_id,killer_account_id,victim_account_id,killer_family_id,victim_family_id,weapon_id,created_at) \
        VALUES (%d,%d,%d,%d,%d,%d,UNIX_TIMESTAMP())",
        gFWCurrentWarID,
        FW_GetAccountID(killerid),
        FW_GetAccountID(victimid),
        FW_GetFamilyID(killerid),
        FW_GetFamilyID(victimid),
        GetPlayerWeapon(killerid)
    );

    mysql_tquery(mysql, query);
    return 1;
}

public FW_OnPlayerSpawn(playerid)
{
    if(!FWPlayer[playerid][fwInWar])
        return 0;

    SetTimerEx("FW_RespawnWarPlayer", 500, false, "d", playerid);
    return 1;
}

forward FW_RespawnWarPlayer(playerid);
public FW_RespawnWarPlayer(playerid)
{
    if(!IsPlayerConnected(playerid) || !FWPlayer[playerid][fwInWar])
        return 1;

    ResetPlayerWeapons(playerid);
    GivePlayerWeapon(playerid, 24, 150);
    GivePlayerWeapon(playerid, 31, 500);
    GivePlayerWeapon(playerid, 34, 30);

    FW_SetWarSpawn(playerid);
    return 1;
}

public FW_OnPlayerDisconnect(playerid)
{
    if(FWPlayer[playerid][fwInWar])
    {
        FW_SavePlayerResult(playerid);
    }

    FW_InitPlayer(playerid);
    return 1;
}

stock FW_FinishWar(winnerTeam = 0)
{
    if(gFWCurrentWarID == 0)
        return 0;

    if(winnerTeam == 0)
    {
        if(gFWScore1 > gFWScore2)
            winnerTeam = 1;
        else if(gFWScore2 > gFWScore1)
            winnerTeam = 2;
        else
            winnerTeam = 0;
    }

    new winnerFamily = 0;
    new loserFamily = 0;

    if(winnerTeam == 1)
    {
        winnerFamily = gFWFamily1;
        loserFamily = gFWFamily2;
    }
    else if(winnerTeam == 2)
    {
        winnerFamily = gFWFamily2;
        loserFamily = gFWFamily1;
    }

    new mvpPlayer = INVALID_PLAYER_ID;
    new mvpKills = -1;

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i))
            continue;

        if(!FWPlayer[i][fwInWar] || FWPlayer[i][fwWarID] != gFWCurrentWarID)
            continue;

        FW_SavePlayerResult(i);

        if(FWPlayer[i][fwKills] > mvpKills)
        {
            mvpKills = FWPlayer[i][fwKills];
            mvpPlayer = i;
        }
    }

    if(winnerFamily > 0)
    {
        FW_AddFamilyBalance(winnerFamily, FW_WIN_FAMILY_REWARD);
        FW_AddContainer(winnerFamily, FW_CONTAINER_GOLD, 1);
        FW_UpdateFamilySeason(winnerFamily, 1, gFWScore1, gFWScore2);
        FW_UpdateFamilySeason(loserFamily, 0, gFWScore1, gFWScore2);
    }
    else
    {
        FW_UpdateFamilySeason(gFWFamily1, 2, gFWScore1, gFWScore2);
        FW_UpdateFamilySeason(gFWFamily2, 2, gFWScore1, gFWScore2);
        FW_AddContainer(gFWFamily1, FW_CONTAINER_SILVER, 1);
        FW_AddContainer(gFWFamily2, FW_CONTAINER_SILVER, 1);
    }

    if(mvpPlayer != INVALID_PLAYER_ID && IsPlayerConnected(mvpPlayer))
    {
        FW_AddMoney(mvpPlayer, FW_MVP_REWARD);

        new mvpMsg[200];
        format(
            mvpMsg,
            sizeof(mvpMsg),
            "\xC2\xFB MVP \xF1\xE5\xEC\xE5\xE9\xED\xEE\xE9 \xE2\xEE\xE9\xED\xFB! \xD3\xE1\xE8\xE9\xF1\xF2\xE2: %d | \xCD\xE0\xE3\xF0\xE0\xE4\xE0: %d \xF0\xF3\xE1.",
            mvpKills,
            FW_MVP_REWARD
        );
        SendClientMessage(mvpPlayer, FW_GREEN, mvpMsg);
    }

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i))
            continue;

        if(!FWPlayer[i][fwInWar] || FWPlayer[i][fwWarID] != gFWCurrentWarID)
            continue;

        new fam = FW_GetFamilyID(i);

        if(winnerFamily > 0 && fam == winnerFamily)
            FW_AddMoney(i, FW_WIN_PLAYER_REWARD);
        else if(winnerFamily > 0)
            FW_AddMoney(i, FW_LOSE_PLAYER_REWARD);

        FW_LeaveWar(i);
    }

    new query[800];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "UPDATE family_wars \
        SET status=%d,score1=%d,score2=%d,winner_family_id=%d,actual_end=UNIX_TIMESTAMP(),mvp_account_id=%d \
        WHERE id=%d",
        FW_STATE_FINISHED,
        gFWScore1,
        gFWScore2,
        winnerFamily,
        (mvpPlayer == INVALID_PLAYER_ID ? 0 : FW_GetAccountID(mvpPlayer)),
        gFWCurrentWarID
    );
    mysql_tquery(mysql, query);

    new n1[32], n2[32], msg[256];
    FW_GetFamilyName(gFWFamily1, n1, sizeof(n1));
    FW_GetFamilyName(gFWFamily2, n2, sizeof(n2));

    format(
        msg,
        sizeof(msg),
        "FAMILY WAR \xE7\xE0\xE2\xE5\xF0\xF8\xE5\xED\xE0: %s %d : %d %s.",
        n1,
        gFWScore1,
        gFWScore2,
        n2
    );
    SendClientMessageToAll(FW_COLOR, msg);

    FW_ResetCurrentWar();
    return 1;
}

stock FW_SavePlayerResult(playerid)
{
    new query[1000];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "INSERT INTO family_war_player_results \
        (war_id,season_id,family_id,account_id,kills,deaths) \
        VALUES (%d,%d,%d,%d,%d,%d) \
        ON DUPLICATE KEY UPDATE kills=VALUES(kills),deaths=VALUES(deaths)",
        gFWCurrentWarID,
        gFWSeasonID,
        FW_GetFamilyID(playerid),
        FW_GetAccountID(playerid),
        FWPlayer[playerid][fwKills],
        FWPlayer[playerid][fwDeaths]
    );

    mysql_tquery(mysql, query);

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "INSERT INTO family_war_player_stats \
        (season_id,account_id,family_id,kills,deaths,wars) \
        VALUES (%d,%d,%d,%d,%d,1) \
        ON DUPLICATE KEY UPDATE \
        kills=kills+VALUES(kills),deaths=deaths+VALUES(deaths),wars=wars+1,family_id=VALUES(family_id)",
        gFWSeasonID,
        FW_GetAccountID(playerid),
        FW_GetFamilyID(playerid),
        FWPlayer[playerid][fwKills],
        FWPlayer[playerid][fwDeaths]
    );

    mysql_tquery(mysql, query);
    return 1;
}

stock FW_UpdateFamilySeason(familyid, result, score1, score2)
{
    new points = 0, wins = 0, losses = 0, draws = 0;

    switch(result)
    {
        case 1:
        {
            points = FW_POINTS_WIN;
            wins = 1;
        }
        case 0:
        {
            losses = 1;
        }
        case 2:
        {
            points = FW_POINTS_DRAW;
            draws = 1;
        }
    }

    new kills = (familyid == gFWFamily1) ? score1 : score2;
    new deaths = (familyid == gFWFamily1) ? score2 : score1;

    new query[1100];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "INSERT INTO family_war_family_stats \
        (season_id,family_id,points,wins,losses,draws,kills,deaths,wars) \
        VALUES (%d,%d,%d,%d,%d,%d,%d,%d,1) \
        ON DUPLICATE KEY UPDATE \
        points=points+VALUES(points),wins=wins+VALUES(wins),losses=losses+VALUES(losses), \
        draws=draws+VALUES(draws),kills=kills+VALUES(kills),deaths=deaths+VALUES(deaths),wars=wars+1",
        gFWSeasonID,
        familyid,
        points,
        wins,
        losses,
        draws,
        kills,
        deaths
    );

    mysql_tquery(mysql, query);
    return 1;
}

stock FW_ResetCurrentWar()
{
    gFWCurrentWarID = 0;
    gFWFamily1 = 0;
    gFWFamily2 = 0;
    gFWScore1 = 0;
    gFWScore2 = 0;
    gFWWorld = 0;
    gFWStartTime = 0;
    gFWEndTime = 0;
    gFWTargetScore = FW_MAX_SCORE;
    gFWDuration = FW_DEFAULT_DURATION;
    return 1;
}

stock FW_CMD_fwrating(playerid, params[])
{
    new query[900];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "SELECT family_id,points,wins,losses,draws,kills,deaths,wars \
        FROM family_war_family_stats \
        WHERE season_id=%d \
        ORDER BY points DESC,wins DESC,kills DESC LIMIT 20",
        gFWSeasonID
    );

    mysql_tquery(mysql, query, "FW_OnRatingLoaded", "d", playerid);
    return 1;
}

forward FW_OnRatingLoaded(playerid);
public FW_OnRatingLoaded(playerid)
{
    if(!IsPlayerConnected(playerid))
        return 1;

    new rows = cache_num_rows();

    if(!rows)
        return SendClientMessage(playerid, FW_GRAY, "\xD0\xE5\xE9\xF2\xE8\xED\xE3 \xF1\xE5\xEC\xE5\xE9 \xEF\xEE\xEA\xE0 \xEF\xF3\xF1\xF2.");

    new text[4000];
    strcat(text, "#\t\xD1\xE5\xEC\xFC\xFF\t\xCE\xF7\xEA\xE8\t\xC2\t\xCF\tK/D\n");

    for(new i = 0; i < rows; i++)
    {
        new familyid, points, wins, losses, kills, deaths;
        cache_get_field_content_int(i, "family_id", familyid);
        cache_get_field_content_int(i, "points", points);
        cache_get_field_content_int(i, "wins", wins);
        cache_get_field_content_int(i, "losses", losses);
        cache_get_field_content_int(i, "kills", kills);
        cache_get_field_content_int(i, "deaths", deaths);

        new name[40], fwrow[220];
        FW_GetFamilyName(familyid, name, sizeof(name));

        format(fwrow, sizeof(fwrow), "%d\t", i + 1);
        strcat(fwrow, name);
        format(fwrow, sizeof(fwrow), "%s\t%d\t%d\t%d\t%d/%d\n", fwrow, points, wins, losses, kills, deaths);
        strcat(text, fwrow);
    }

    ShowPlayerDialog(
        playerid,
        DIALOG_FW_STATS,
        DIALOG_STYLE_TABLIST_HEADERS,
        "\xD1\xE5\xE7\xEE\xED\xED\xFB\xE9 \xF0\xE5\xE9\xF2\xE8\xED\xE3 \xF1\xE5\xEC\xE5\xE9",
        text,
        "\xC7\xE0\xEA\xF0\xFB\xF2\xFC",
        ""
    );

    return 1;
}

stock FW_CMD_fwarhistory(playerid, params[])
{
    new familyid = FW_GetFamilyID(playerid);

    if(familyid <= 0)
        return SendClientMessage(playerid, FW_RED, "\xC2\xFB \xED\xE5 \xF1\xEE\xF1\xF2\xEE\xE8\xF2\xE5 \xE2 \xF1\xE5\xEC\xFC\xE5.");

    new query[1000];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "SELECT id,family1_id,family2_id,score1,score2,winner_family_id,actual_end \
        FROM family_wars \
        WHERE status=%d AND (family1_id=%d OR family2_id=%d) \
        ORDER BY id DESC LIMIT 20",
        FW_STATE_FINISHED,
        familyid,
        familyid
    );

    mysql_tquery(mysql, query, "FW_OnHistoryLoaded", "dd", playerid, familyid);
    return 1;
}

forward FW_OnHistoryLoaded(playerid, familyid);
public FW_OnHistoryLoaded(playerid, familyid)
{
    if(!IsPlayerConnected(playerid))
        return 1;

    new rows = cache_num_rows();

    if(!rows)
        return SendClientMessage(playerid, FW_GRAY, "\xC8\xF1\xF2\xEE\xF0\xE8\xFF \xE2\xEE\xE9\xED \xF1\xE5\xEC\xFC\xE8 \xEF\xEE\xEA\xE0 \xEF\xF3\xF1\xF2\xE0\xFF.");

    new text[3500];
    strcat(text, "ID\t\xD1\xEE\xEF\xE5\xF0\xED\xE8\xEA\t\xD1\xF7\xB8\xF2\t\xD0\xE5\xE7\xF3\xEB\xFC\xF2\xE0\xF2\n");

    for(new i = 0; i < rows; i++)
    {
        new id, f1, f2, s1, s2, winner;
        cache_get_field_content_int(i, "id", id);
        cache_get_field_content_int(i, "family1_id", f1);
        cache_get_field_content_int(i, "family2_id", f2);
        cache_get_field_content_int(i, "score1", s1);
        cache_get_field_content_int(i, "score2", s2);
        cache_get_field_content_int(i, "winner_family_id", winner);

        new opponent = (f1 == familyid) ? f2 : f1;
        new ownScore = (f1 == familyid) ? s1 : s2;
        new enemyScore = (f1 == familyid) ? s2 : s1;

        new name[40], result[24], fwrow[220];
        FW_GetFamilyName(opponent, name, sizeof(name));

        if(winner == 0)
            format(result, sizeof(result), "DRAW");
        else if(winner == familyid)
            format(result, sizeof(result), "WIN");
        else
            format(result, sizeof(result), "LOSE");

        format(fwrow, sizeof(fwrow), "%d\t", id);
        strcat(fwrow, name);
        format(fwrow, sizeof(fwrow), "%s\t%d:%d\t", fwrow, ownScore, enemyScore);
        strcat(fwrow, result);
        strcat(fwrow, "\n");

        strcat(text, fwrow);
    }

    ShowPlayerDialog(
        playerid,
        DIALOG_FW_HISTORY,
        DIALOG_STYLE_TABLIST_HEADERS,
        "\xC8\xF1\xF2\xEE\xF0\xE8\xFF \xF1\xE5\xEC\xE5\xE9\xED\xFB\xF5 \xE2\xEE\xE9\xED",
        text,
        "\xC7\xE0\xEA\xF0\xFB\xF2\xFC",
        ""
    );

    return 1;
}

stock FW_AddContainer(familyid, type, amount = 1)
{
    new query[700];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "INSERT INTO family_containers (family_id,container_type,amount) \
        VALUES (%d,%d,%d) \
        ON DUPLICATE KEY UPDATE amount=amount+VALUES(amount)",
        familyid,
        type,
        amount
    );

    mysql_tquery(mysql, query);
    return 1;
}

stock FW_CMD_fcontainers(playerid, params[])
{
    new familyid = FW_GetFamilyID(playerid);

    if(familyid <= 0)
        return SendClientMessage(playerid, FW_RED, "\xC2\xFB \xED\xE5 \xF1\xEE\xF1\xF2\xEE\xE8\xF2\xE5 \xE2 \xF1\xE5\xEC\xFC\xE5.");

    new query[600];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "SELECT container_type,amount FROM family_containers WHERE family_id=%d ORDER BY container_type",
        familyid
    );

    mysql_tquery(mysql, query, "FW_OnContainersLoaded", "d", playerid);
    return 1;
}

forward FW_OnContainersLoaded(playerid);
public FW_OnContainersLoaded(playerid)
{
    if(!IsPlayerConnected(playerid))
        return 1;

    new bronze = 0, silver = 0, gold = 0;

    for(new i = 0; i < cache_num_rows(); i++)
    {
        new type, amount;
        cache_get_field_content_int(i, "container_type", type);
        cache_get_field_content_int(i, "amount", amount);

        switch(type)
        {
            case FW_CONTAINER_BRONZE: bronze = amount;
            case FW_CONTAINER_SILVER: silver = amount;
            case FW_CONTAINER_GOLD: gold = amount;
        }
    }

    new text[600];
    format(
        text,
        sizeof(text),
        "{CD7F32}Bronze\t{FFFFFF}%d\n{C0C0C0}Silver\t{FFFFFF}%d\n{FFD700}Gold\t{FFFFFF}%d\n\n\
        {AAAAAA}\xCE\xF2\xEA\xF0\xFB\xF2\xFC: /fcontaineropen [1-3]\n\
        1 - Bronze, 2 - Silver, 3 - Gold",
        bronze,
        silver,
        gold
    );

    ShowPlayerDialog(
        playerid,
        DIALOG_FW_CONTAINER,
        DIALOG_STYLE_MSGBOX,
        "\xD1\xE5\xEC\xE5\xE9\xED\xFB\xE5 \xEA\xEE\xED\xF2\xE5\xE9\xED\xE5\xF0\xFB",
        text,
        "\xC7\xE0\xEA\xF0\xFB\xF2\xFC",
        ""
    );

    return 1;
}

stock FW_CMD_fcontaineropen(playerid, params[])
{
    if(!FW_IsFamilyLeader(playerid))
        return SendClientMessage(playerid, FW_RED, "\xCE\xF2\xEA\xF0\xFB\xE2\xE0\xF2\xFC \xF1\xE5\xEC\xE5\xE9\xED\xFB\xE5 \xEA\xEE\xED\xF2\xE5\xE9\xED\xE5\xF0\xFB \xEC\xEE\xE6\xE5\xF2 \xF2\xEE\xEB\xFC\xEA\xEE \xEB\xE8\xE4\xE5\xF0.");

    new type;
    if(sscanf(params, "i", type))
        return SendClientMessage(playerid, FW_WHITE, "\xC8\xF1\xEF\xEE\xEB\xFC\xE7\xF3\xE9\xF2\xE5: /fcontaineropen [1-3]");

    if(type < FW_CONTAINER_BRONZE || type > FW_CONTAINER_GOLD)
        return SendClientMessage(playerid, FW_RED, "\xD2\xE8\xEF \xEA\xEE\xED\xF2\xE5\xE9\xED\xE5\xF0\xE0: 1 Bronze, 2 Silver, 3 Gold.");

    new familyid = FW_GetFamilyID(playerid);

    new query[600];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "SELECT amount FROM family_containers \
        WHERE family_id=%d AND container_type=%d LIMIT 1",
        familyid,
        type
    );

    mysql_tquery(mysql, query, "FW_OnContainerOpenCheck", "ddd", playerid, familyid, type);
    return 1;
}

forward FW_OnContainerOpenCheck(playerid, familyid, type);
public FW_OnContainerOpenCheck(playerid, familyid, type)
{
    if(!IsPlayerConnected(playerid))
        return 1;

    if(!cache_num_rows())
        return SendClientMessage(playerid, FW_RED, "\xD3 \xF1\xE5\xEC\xFC\xE8 \xED\xE5\xF2 \xF2\xE0\xEA\xEE\xE3\xEE \xEA\xEE\xED\xF2\xE5\xE9\xED\xE5\xF0\xE0.");

    new amount;
    cache_get_field_content_int(0, "amount", amount);

    if(amount <= 0)
        return SendClientMessage(playerid, FW_RED, "\xD3 \xF1\xE5\xEC\xFC\xE8 \xED\xE5\xF2 \xF2\xE0\xEA\xEE\xE3\xEE \xEA\xEE\xED\xF2\xE5\xE9\xED\xE5\xF0\xE0.");

    new minReward, maxReward;

    switch(type)
    {
        case FW_CONTAINER_BRONZE:
        {
            minReward = 100000;
            maxReward = 250000;
        }
        case FW_CONTAINER_SILVER:
        {
            minReward = 300000;
            maxReward = 600000;
        }
        case FW_CONTAINER_GOLD:
        {
            minReward = 700000;
            maxReward = 1500000;
        }
    }

    new reward = minReward + random(maxReward - minReward + 1);

    new query[600];
    mysql_format(
        mysql,
        query,
        sizeof(query),
        "UPDATE family_containers SET amount=amount-1 \
        WHERE family_id=%d AND container_type=%d AND amount>0",
        familyid,
        type
    );
    mysql_tquery(mysql, query);

    FW_AddFamilyBalance(familyid, reward);

    new msg[220];
    format(
        msg,
        sizeof(msg),
        "\xD1\xE5\xEC\xE5\xE9\xED\xFB\xE9 \xEA\xEE\xED\xF2\xE5\xE9\xED\xE5\xF0 \xEE\xF2\xEA\xF0\xFB\xF2. \xC2 \xEA\xE0\xE7\xED\xF3 \xF1\xE5\xEC\xFC\xE8 \xED\xE0\xF7\xE8\xF1\xEB\xE5\xED\xEE %d \xF0\xF3\xE1.",
        reward
    );
    SendClientMessage(playerid, FW_GREEN, msg);
    return 1;
}

stock FW_CloseSeason(newSeasonName[])
{
    new query[1000];

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "UPDATE family_war_seasons SET active=0,end_time=UNIX_TIMESTAMP() WHERE id=%d",
        gFWSeasonID
    );
    mysql_tquery(mysql, query);

    mysql_format(
        mysql,
        query,
        sizeof(query),
        "INSERT INTO family_war_seasons (name,active,start_time) VALUES ('%e',1,UNIX_TIMESTAMP())",
        newSeasonName
    );
    mysql_tquery(mysql, query, "FW_OnNewSeasonCreated");

    return 1;
}

