stock LicenseB_Start(playerid)
{
    if(GetPlayerData(playerid, P_DRIVING_LIC) >= 2)
    {
        SendClientMessage(playerid, 0x66CC00FF, "У Вас уже есть лицензия категории B.");
        return 1;
    }

    if(GetPlayerMoney(playerid) < LICENSE_B_PRICE)
    {
        SendClientMessage(playerid, 0xFF5555FF, "Для покупки лицензии необходимо иметь 8.500 рублей.");
        return 1;
    }

    g_LicenseB_Test[playerid] = 0;
    g_LicenseB_Question[playerid] = 0;
    LicenseB_ShowQuestion(playerid);
    return 1;
}

public LicenseB_ForceSeat(playerid, vehicleid)
{
    if(!IsPlayerConnected(playerid))
        return 1;

    if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
        return 1;

    if(GetPlayerVirtualWorld(playerid) != 0)
        SetPlayerVirtualWorld(playerid, 0);

    SetPlayerInterior(playerid, 0);
    SetVehicleVirtualWorld(vehicleid, 0);
    PutPlayerInVehicle(playerid, vehicleid, 0);
    return 1;
}

stock LicenseB_StartPractical(playerid)
{
    if(GetPlayerData(playerid, P_DRIVING_LIC) >= 2)
        return 1;

    // После сдачи теории экзамен всегда продолжается в виртуальном мире 0.
    SetPlayerVirtualWorld(playerid, 0);
    SetPlayerInterior(playerid, 0);

    g_LicenseB_Test[playerid] = -1;
    g_LicenseB_Question[playerid] = 0;
    g_LicenseB_Route[playerid] = 1;

    SetPlayerPos(playerid, -2650.956787, -11.301878, 27.272661);
    SetPlayerFacingAngle(playerid, 157.490982);
    SetCameraBehindPlayer(playerid);

    new old_vehicleid = g_LicenseB_Vehicle[playerid];
    if(old_vehicleid != INVALID_VEHICLE_ID && IsValidVehicle(old_vehicleid))
        DestroyVehicle(old_vehicleid);

    // Красная BMW E36, экзаменационная машина.
    new license_vehicle = CreateVehicle(2618, -2650.956787, -11.301878, 27.272661, 157.490982, 3, 3, 300);
    g_LicenseB_Vehicle[playerid] = license_vehicle;

    if(license_vehicle != INVALID_VEHICLE_ID)
    {
        SetVehicleDataAll(license_vehicle, 2618, -2650.956787, -11.301878, 27.272661, 157.490982, 3, 3, 300, 0, VEHICLE_ACTION_TYPE_NONE, VEHICLE_ACTION_ID_NONE);
        SetVehicleColor(license_vehicle, GetVehicleRGBAColorById(3), GetVehicleRGBAColorById(3), 1);

        // Машина и игрок гарантированно находятся в одном VW 0.
        SetVehicleVirtualWorld(license_vehicle, 0);

        // Сразу сажаем игрока.
        PutPlayerInVehicle(playerid, license_vehicle, 0);

        // И повторно через 250 мс — чтобы клиент не остался пешком
        // из-за телепорта/создания машины в момент переключения VW.
        SetTimerEx("LicenseB_ForceSeat", 250, false, "dd", playerid, license_vehicle);
    }

    DisablePlayerCheckpoint(playerid);
    SetPlayerCheckpoint(playerid, g_LicenseB_RoutePoints[0][0], g_LicenseB_RoutePoints[0][1], g_LicenseB_RoutePoints[0][2], 4.0);

    SendClientMessage(playerid, 0x66CC00FF, "\xcf\xee\xeb\xe8\xe3\xee\xed\xe0\xe9! \xd2\xe5\xef\xe5\xf0\xfc \xef\xf0\xee\xe4\xe8\xf2\xe5 \xef\xf0\xe0\xea\xf2\xe8\xf7\xe5\xf1\xea\xf3\xfe \xf7\xe0\xf1\xf2\xfc \xfd\xea\xe7\xe0\xec\xe5\xed\xe0. \xd1\xeb\xe5\xe4\xf3\xe9\xf2\xe5 \xef\xee \xec\xe5\xf2\xea\xe0\xec \xe4\xee \xf4\xe8\xed\xe8\xf8\xe0.");
    return 1;
}


stock LicenseB_Complete(playerid)
{
    if(g_LicenseB_Route[playerid] <= 0)
        return 1;

    DisablePlayerCheckpoint(playerid);
    g_LicenseB_Route[playerid] = 0;

    if(GetPlayerData(playerid, P_DRIVING_LIC) >= 2)
        return 1;

    if(GetPlayerMoney(playerid) < LICENSE_B_PRICE)
    {
        SendClientMessage(playerid, 0xFF5555FF, "\xd3 \xc2\xe0\xf1 \xed\xe5\xe4\xee\xf1\xf2\xe0\xf2\xee\xf7\xed\xee \xe4\xe5\xed\xe5\xe3 \xe4\xeb\xff \xef\xee\xea\xf3\xef\xea\xe8 \xeb\xe8\xf6\xe5\xed\xe7\xe8\xe8. \xcd\xe5\xee\xe1\xf5\xee\xe4\xe8\xec\xee 8.500 \xf0\xf3\xe1\xeb\xe5\xe9.");
        return 1;
    }

    GivePlayerMoneyEx(playerid, -LICENSE_B_PRICE, "\xcf\xee\xea\xf3\xef\xea\xe0 \xeb\xe8\xf6\xe5\xed\xe7\xe8\xe8 B", true, true);
    SetPlayerData(playerid, P_DRIVING_LIC, 2);
    UpdatePlayerDatabaseInt(playerid, "driving_lic", 2);

    new license_vehicle = g_LicenseB_Vehicle[playerid];
    if(license_vehicle != INVALID_VEHICLE_ID && IsValidVehicle(license_vehicle))
    {
        DestroyVehicle(license_vehicle);
    }
    g_LicenseB_Vehicle[playerid] = INVALID_VEHICLE_ID;

    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
        "{66CC00}\xc2\xfb \xf3\xf1\xef\xe5\xf8\xed\xee \xf1\xe4\xe0\xeb\xe8 \xef\xf0\xe0\xe2\xe0!",
        "{FFFFFF}\xcb\xe8\xf6\xe5\xed\xe7\xe8\xff \xe4\xe5\xe9\xf1\xf2\xe2\xf3\xe5\xf2 \xe4\xee 30 \xe4\xed\xe5\xe9.\n\xd3\xe4\xe0\xf7\xed\xee\xe9 \xe4\xee\xf0\xee\xe3\xe8!",
        "OK", "");
    return 1;
}

stock LicenseB_HandleRouteCheckpoint(playerid)
{
    new route = g_LicenseB_Route[playerid];
    if(route <= 0 || route > 7)
        return 0;

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != g_LicenseB_Vehicle[playerid])
        return 1;

    if(route == 7)
        return LicenseB_Complete(playerid);

    g_LicenseB_Route[playerid]++;
    DisablePlayerCheckpoint(playerid);

    new next = g_LicenseB_Route[playerid] - 1;
    SetPlayerCheckpoint(playerid, g_LicenseB_RoutePoints[next][0], g_LicenseB_RoutePoints[next][1], g_LicenseB_RoutePoints[next][2], 4.0);
    return 1;
}

stock LicenseB_CreatePickup()
{
    if(g_LicenseB_Pickup != -1) return 1;

    // Координаты с точки на скриншоте из чата администратора.
    g_LicenseB_Pickup = CreatePickup(1239, 23, -598.663391, -306.964355, 799.029172, 1);

    CreateDynamic3DTextLabel(
        "{FFD700}Покупка Лицензии\n{FFFFFF}Категория B\n{66CC00}8.500 рублей",
        -1,
        -598.663391, -306.964355, 800.029172,
        15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, 0);

    return 1;
}

stock LicenseB_OnPickup(playerid, pickupid)
{
    if(pickupid != g_LicenseB_Pickup) return 0;

    if(!IsPlayerLogged(playerid)) return 1;

    LicenseB_ShowMain(playerid);
    return 1;
}

public OnGameModeInit()
{

    LoadMySQLSettings();
	LoadNEWSettings();

    print("[SECURITY] Hardcoded server IP lock disabled; continuing startup...");

    Music_InitDatabase();
    RaceSto_EnsureDatabaseTable();
    SeatNpc_Load();

    mysql_query(mysql, "UPDATE accounts SET job=0 WHERE job=3", false);
    print("[INIT_TRACE] 01 main init entered");
	new gPlayerBlockedPickup[MAX_PLAYERS] = { -1, ... };
	SetTimer("CorrectTimerMinute", 60000, true);
	SetTimer("GunWarn_Init", 3000, false);
    SetTimer("UpdateVehicleTurnSignals", 500, true);
    for(new i = 0; i < MAX_VEHICLES; i++)
    {
        TurnSignalDriver[i] = INVALID_PLAYER_ID;
        TurnSignalModel[i] = 0;
    }
    print("[INIT_TRACE] 02 before containers");
	ContForNewCreate();
	LoadTextDraw();
    print("[INIT_TRACE] 03 base systems created");
    StartCont();
    LoadSvetfor();
	CreateHouseATMpickups();
    pickup_rent_main = CreatePickup(1239, 23, 1786.0, -1898.0, 13.5, -1);
    LicenseB_CreatePickup();

    report_edit_TD = TextDrawCreate(7.499990, 314.444396, "REP:_0");
