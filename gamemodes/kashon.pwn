stock TaxiPark_GetPlayerJob(playerid)
{
	new job = GetPVarInt(playerid, TAXI_PARK_PVAR_JOB);
	if(job <= 0) return -1;
	return job - 1;
}

stock TaxiPark_SetPlayerJob(playerid, park_id)
{
	SetPVarInt(playerid, TAXI_PARK_PVAR_JOB, park_id + 1);
	UpdatePlayerDatabaseInt(playerid, "taxi_park", park_id);
	if(park_id >= 0)
	{
		if(g_TaxiDriverRating[playerid] < 0.1) g_TaxiDriverRating[playerid] = 5.00;
		if(g_TaxiDriverRank[playerid] < 0) g_TaxiDriverRank[playerid] = 0;
		UpdatePlayerDatabaseInt(playerid, "taxi_rank", g_TaxiDriverRank[playerid]);
	}
	else
	{
		g_TaxiDriverRank[playerid] = 0;
		UpdatePlayerDatabaseInt(playerid, "taxi_rank", 0);
	}
	return 1;
}

stock TaxiPark_SetPlayerRank(playerid, rank)
{
	if(rank < 0) rank = 0;
	if(rank > 4) rank = 4;
	g_TaxiDriverRank[playerid] = rank;
	UpdatePlayerDatabaseInt(playerid, "taxi_rank", rank);
	return 1;
}

stock TaxiPark_RemovePlayerJob(playerid)
{
	SetPVarInt(playerid, TAXI_PARK_PVAR_JOB, 0);
	g_TaxiDriverRank[playerid] = 0;
	UpdatePlayerDatabaseInt(playerid, "taxi_park", -1);
	UpdatePlayerDatabaseInt(playerid, "taxi_rank", 0);
	TaxiPark_DestroyPlayerVehicle(playerid);
	TaxiPark_CancelOrder(playerid);
	return 1;
}

stock TaxiPark_LoadJobFromDB(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	if(!IsPlayerLogged(playerid)) return 0;
	new query[200];
	mysql_format(mysql, query, sizeof query,
		"SELECT `taxi_park`,`taxi_rank` FROM `accounts` WHERE `id`=%d LIMIT 1",
		GetPlayerAccountID(playerid));
	mysql_tquery(mysql, query, "TaxiPark_OnJobLoaded", "i", playerid);
	return 1;
}

public TaxiPark_OnJobLoaded(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new rows = cache_num_rows();
	if(rows <= 0)
	{
		SetPVarInt(playerid, TAXI_PARK_PVAR_JOB, 0);
		g_TaxiDriverRank[playerid] = 0;
		return 1;
	}
	new park_id = cache_get_field_content_int(0, "taxi_park");
	new rank = cache_get_field_content_int(0, "taxi_rank");
	if(park_id >= 0 && park_id < TAXI_PARK_COUNT)
	{
		SetPVarInt(playerid, TAXI_PARK_PVAR_JOB, park_id + 1);
		if(rank < 0) rank = 0;
		if(rank > 4) rank = 4;
		g_TaxiDriverRank[playerid] = rank;
		if(TaxiPark_IsOwner(playerid, park_id))
			g_TaxiDriverRank[playerid] = TAXI_RANK_DIRECTOR;
	}
	else
	{
		SetPVarInt(playerid, TAXI_PARK_PVAR_JOB, 0);
		g_TaxiDriverRank[playerid] = 0;
	}
	return 1;
}

stock TaxiPark_Init()
{
	new hire_label[144], auto_label[144];
	mysql_tquery(mysql, "ALTER TABLE `accounts` ADD COLUMN IF NOT EXISTS `taxi_park` INT NOT NULL DEFAULT -1");
	mysql_tquery(mysql, "ALTER TABLE `accounts` ADD COLUMN IF NOT EXISTS `taxi_rank` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "CREATE TABLE IF NOT EXISTS `taxi_by_workk` (		`park_id` INT NOT NULL PRIMARY KEY,		`owner_id` INT NOT NULL DEFAULT 0,		`owner_name` VARCHAR(24) NOT NULL DEFAULT '',		`balance` INT NOT NULL DEFAULT 0,		`rating` FLOAT NOT NULL DEFAULT 5.0,		`orders` INT NOT NULL DEFAULT 0,		`cars` INT NOT NULL DEFAULT 0,		`rent_days` INT NOT NULL DEFAULT 0,		`price_eco` INT NOT NULL DEFAULT 100,		`price_com` INT NOT NULL DEFAULT 150,		`price_biz` INT NOT NULL DEFAULT 220,		`pct_eco` INT NOT NULL DEFAULT 70,		`pct_com` INT NOT NULL DEFAULT 70,		`pct_biz` INT NOT NULL DEFAULT 70	) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");

	// Ensure all taxi_by_workk columns exist (owner, fleet, upgrades)
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `owner_id` INT NOT NULL DEFAULT -1");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `owner_name` VARCHAR(24) NOT NULL DEFAULT ''");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `balance` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `rating` FLOAT NOT NULL DEFAULT 5.0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `orders` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `cars` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `rent_days` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `price_eco` INT NOT NULL DEFAULT 300");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `price_com` INT NOT NULL DEFAULT 500");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `price_biz` INT NOT NULL DEFAULT 750");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `pct_eco` INT NOT NULL DEFAULT 40");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `pct_com` INT NOT NULL DEFAULT 40");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `pct_biz` INT NOT NULL DEFAULT 50");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `upg_fleet` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `upg_staff` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `upg_safe` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `upg_gas` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `upg_disp` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `upg_boost_cd` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `boost_profit` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `boost_exp` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `boost_rating` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `boost_delivery` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `boost_client` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `boost_fast` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f0_en` TINYINT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f0_model` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f0_name` VARCHAR(32) NOT NULL DEFAULT ''");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f0_price` INT NOT NULL DEFAULT 1000");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f0_rank` TINYINT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f0_class` TINYINT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f1_en` TINYINT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f1_model` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f1_name` VARCHAR(32) NOT NULL DEFAULT ''");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f1_price` INT NOT NULL DEFAULT 1000");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f1_rank` TINYINT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f1_class` TINYINT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f2_en` TINYINT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f2_model` INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f2_name` VARCHAR(32) NOT NULL DEFAULT ''");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f2_price` INT NOT NULL DEFAULT 1000");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f2_rank` TINYINT NOT NULL DEFAULT 0");
	mysql_tquery(mysql, "ALTER TABLE `taxi_by_workk` ADD COLUMN IF NOT EXISTS `f2_class` TINYINT NOT NULL DEFAULT 0");

	mysql_tquery(mysql, "CREATE TABLE IF NOT EXISTS `taxi_order_log` (		`id` INT NOT NULL AUTO_INCREMENT PRIMARY KEY,		`park_id` INT NOT NULL DEFAULT -1,		`driver_id` INT NOT NULL DEFAULT 0,		`passenger_id` INT NOT NULL DEFAULT 0,		`order_type` TINYINT NOT NULL DEFAULT 0,		`price` INT NOT NULL DEFAULT 0,		`driver_share` INT NOT NULL DEFAULT 0,		`company_share` INT NOT NULL DEFAULT 0,		`created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP	) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
	mysql_tquery(mysql, "CREATE TABLE IF NOT EXISTS `taxi_driver_stats` (		`account_id` INT NOT NULL PRIMARY KEY,		`trips` INT NOT NULL DEFAULT 0,		`income` INT NOT NULL DEFAULT 0,		`skill` INT NOT NULL DEFAULT 0,		`park_id` INT NOT NULL DEFAULT -1	) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");

	CreatePickup(1239, 1, 0.0, 0.0, 0.0, 999999);

	for(new i = 0; i < TAXI_PARK_COUNT; i++)
	{
		for(new s = 0; s < TAXI_PARK_CAR_COUNT; s++)
			g_TaxiFleetTaken[i][s] = INVALID_PLAYER_ID;
		g_TaxiPark[i][TP_VIRTUAL_WORLD] = TAXI_PARK_VW_BASE + i;

		g_TaxiPark[i][TP_PICKUP_ENTER_ID] = CreatePickup(19132, 23,
			g_TaxiPark[i][TP_ENTER_X], g_TaxiPark[i][TP_ENTER_Y], g_TaxiPark[i][TP_ENTER_Z],
			0, PICKUP_ACTION_TYPE_TAXI_PARK_ENT, i);



		g_TaxiPark[i][TP_PICKUP_EXIT_ID] = CreatePickup(TAXI_PARK_EXIT_PICKUP_MODEL, 23,
			TAXI_PARK_EXIT_X, TAXI_PARK_EXIT_Y, TAXI_PARK_EXIT_Z,
			g_TaxiPark[i][TP_VIRTUAL_WORLD], TAXI_PARK_ACTION_EXIT, i);
		g_TaxiAreaExit[i] = CreateDynamicSphere(TAXI_PARK_EXIT_X, TAXI_PARK_EXIT_Y, TAXI_PARK_EXIT_Z, 1.5, g_TaxiPark[i][TP_VIRTUAL_WORLD], TAXI_PARK_INTERIOR_ID, -1);
		CreateDynamic3DTextLabel("{FFCC00}Выход", 0xFFFFFFFF,
			TAXI_PARK_EXIT_X, TAXI_PARK_EXIT_Y, TAXI_PARK_EXIT_Z + 0.4, 10.0,
			INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, g_TaxiPark[i][TP_VIRTUAL_WORLD], TAXI_PARK_INTERIOR_ID);


		g_TaxiPark[i][TP_PICKUP_HIRE_ID] = CreatePickup(TAXI_PARK_HIRE_PICKUP_MODEL, 23,
			TAXI_PARK_HIRE_X, TAXI_PARK_HIRE_Y, TAXI_PARK_HIRE_Z,
			g_TaxiPark[i][TP_VIRTUAL_WORLD], TAXI_PARK_ACTION_HIRE, i);
		g_TaxiAreaHire[i] = CreateDynamicSphere(TAXI_PARK_HIRE_X, TAXI_PARK_HIRE_Y, TAXI_PARK_HIRE_Z, 1.5, g_TaxiPark[i][TP_VIRTUAL_WORLD], -1, -1);


		format(hire_label, sizeof hire_label,
			"{FFCC00}%s\n{FFFFFF}%s {FFCC00}%s",
			"Трудоустройство",
			"Подойдите для",
			"взаимодействия");
		CreateDynamic3DTextLabel(hire_label, 0xFFFFFFFF,
			TAXI_PARK_HIRE_X, TAXI_PARK_HIRE_Y, TAXI_PARK_HIRE_Z + 0.30, 15.0,
			INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, g_TaxiPark[i][TP_VIRTUAL_WORLD], TAXI_PARK_INTERIOR_ID);

		g_TaxiPark[i][TP_PICKUP_AUTOPARK_ID] = CreatePickup(TAXI_PARK_AUTOPARK_PICKUP_MODEL, 23,
			g_TaxiPark[i][TP_AUTOPARK_X], g_TaxiPark[i][TP_AUTOPARK_Y], g_TaxiPark[i][TP_AUTOPARK_Z],
			0, TAXI_PARK_ACTION_AUTOPARK, i);
		g_TaxiAreaAutopark[i] = CreateDynamicSphere(g_TaxiPark[i][TP_AUTOPARK_X], g_TaxiPark[i][TP_AUTOPARK_Y], g_TaxiPark[i][TP_AUTOPARK_Z], 1.5, 0, -1, -1);


		format(auto_label, sizeof auto_label,
			"{FFCC00}%s\n{FFFFFF}%s {FFCC00}%s",
			"Аренда транспорта",
			"Подойдите для",
			"взаимодействия");
		CreateDynamic3DTextLabel(auto_label, 0xFFFFFFFF,
			g_TaxiPark[i][TP_AUTOPARK_X], g_TaxiPark[i][TP_AUTOPARK_Y], g_TaxiPark[i][TP_AUTOPARK_Z] + 0.30, 15.0,
			INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	}

	
	for(new c = 0; c < TAXI_PARK_COUNT; c++)
	{
		g_TaxiCompany[c][TC_OWNER_ID] = -1;
		format(g_TaxiCompanyOwnerName[c], 24, "Государство");
		g_TaxiCompany[c][TC_BALANCE] = 0;
		g_TaxiCompany[c][TC_RATING] = 5.00;
		g_TaxiCompany[c][TC_ORDERS] = 0;
		g_TaxiCompany[c][TC_CARS] = 0;
		g_TaxiCompany[c][TC_DRIVERS] = 0;
		g_TaxiCompany[c][TC_RENT_DAYS] = 27;
		g_TaxiCompany[c][TC_PRICE_ECO] = 300;
		g_TaxiCompany[c][TC_PRICE_COM] = 500;
		g_TaxiCompany[c][TC_PRICE_BIZ] = 750;
		g_TaxiCompany[c][TC_UPG_FLEET] = 0;
		g_TaxiCompany[c][TC_UPG_STAFF] = 0;
		g_TaxiCompany[c][TC_UPG_SAFE] = 0;
		g_TaxiCompany[c][TC_UPG_GAS] = 0;
		g_TaxiCompany[c][TC_UPG_DISP] = 0;
		g_TaxiCompany[c][TC_UPG_BOOST_CD] = 0;
		g_TaxiCompany[c][TC_BOOST_PROFIT] = 0;
		g_TaxiCompany[c][TC_BOOST_EXP] = 0;
		g_TaxiCompany[c][TC_BOOST_RATING] = 0;
		g_TaxiCompany[c][TC_BOOST_DELIVERY] = 0;
		g_TaxiCompany[c][TC_BOOST_CLIENT] = 0;
		g_TaxiCompany[c][TC_BOOST_FAST] = 0;
	}
	
	for(new c = 0; c < TAXI_PARK_COUNT; c++)
	{
		format(g_TaxiRankNames[c][0], 24, "%s", "Эконом");
		format(g_TaxiRankNames[c][1], 24, "%s", "Комфорт");
		format(g_TaxiRankNames[c][2], 24, "%s", "Бизнес");
		format(g_TaxiRankNames[c][3], 24, "%s", "Заместитель директора");
		format(g_TaxiRankNames[c][4], 24, "%s", "Директор");
		g_TaxiDriverPct[c][0] = 40;
		g_TaxiDriverPct[c][1] = 40;
		g_TaxiDriverPct[c][2] = 50;
		for(new v = 0; v < TAXI_PARK_CAR_COUNT; v++)
		{
			g_TaxiFleetPrice[c][v] = 1000;
			g_TaxiFleetEnabled[c][v] = 0;
			g_TaxiFleetRank[c][v] = 0;
			g_TaxiFleetClass[c][v] = 0;
			g_TaxiFleetModel[c][v] = 0;
			g_TaxiFleetName[c][v][0] = 0;
		}
	}
	TaxiPark_LoadCompanies();
	printf("[TaxiPark] загружено таксопарков: %d (пикапы + 3D-тексты созданы)", TAXI_PARK_COUNT);
	return 1;
}

stock TaxiPark_OnEnter(playerid, park_id)
{
	SetPVarInt(playerid, "player_state_pickup", false);
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	SetPlayerInterior(playerid, TAXI_PARK_INTERIOR_ID);
	SetPlayerVirtualWorld(playerid, g_TaxiPark[park_id][TP_VIRTUAL_WORLD]);
	SetPlayerPos(playerid, TAXI_PARK_INSIDE_X, TAXI_PARK_INSIDE_Y, TAXI_PARK_INSIDE_Z);
	SetPlayerFacingAngle(playerid, TAXI_PARK_INSIDE_A);
	// Owner of this park - ensure job is set to this park
	if(TaxiPark_IsOwner(playerid, park_id))
	{
		new job = TaxiPark_GetPlayerJob(playerid);
		if(job != park_id)
		{
			if(job != -1) TaxiPark_RemovePlayerJob(playerid);
			g_TaxiDriverRank[playerid] = TAXI_RANK_DIRECTOR;
			TaxiPark_SetPlayerJob(playerid, park_id);
		}
	}
	return 1;
}

stock TaxiPark_OnExit(playerid, park_id)
{
	SetPVarInt(playerid, "player_state_pickup", false);
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	if(GetPVarInt(playerid, "TaxiParkActFlood") > GetTickCount()) return 1;
	SetPVarInt(playerid, "TaxiParkActFlood", GetTickCount() + 1500);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerPos(playerid, g_TaxiPark[park_id][TP_EXIT_X], g_TaxiPark[park_id][TP_EXIT_Y], g_TaxiPark[park_id][TP_EXIT_Z]);
	SetPlayerFacingAngle(playerid, g_TaxiPark[park_id][TP_EXIT_A]);
	return 1;
}

stock TaxiPark_OnHirePickup(playerid, park_id)
{
	SetPVarInt(playerid, "player_state_pickup", false);
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	if(GetPVarInt(playerid, "TaxiParkActFlood") > GetTickCount()) return 1;
	SetPVarInt(playerid, "TaxiParkActFlood", GetTickCount() + 1500);
	new current_job = TaxiPark_GetPlayerJob(playerid);
	if(current_job == park_id)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы уже устроены в этом таксопарке, если вы хотите уволиться введите /tmenu");
		return 1;
	}
	if(current_job != -1)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы уже устроены в другом таксопарке, если вы хотите уволиться введите /tmenu");
		return 1;
	}
	g_TaxiPark_PendingHire[playerid] = park_id;
	new caption[64], info[160];
	format(caption, sizeof caption, "%s | Устроиться?", g_TaxiPark[park_id][TP_NAME]);
	format(info, sizeof info, "Вы хотите устроиться работать в %s?", g_TaxiPark[park_id][TP_NAME]);
	Dialog_Open(playerid, "TaxiPark_HireResponse", DIALOG_STYLE_MSGBOX, caption, info, "Да", "Нет");
	return 1;
}

Dialog_Response:TaxiPark_HireResponse(playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new park_id = g_TaxiPark_PendingHire[playerid];
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 1;
	new current_job = TaxiPark_GetPlayerJob(playerid);
	if(current_job != -1)
	{
		if(current_job == park_id)
			SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы уже устроены в этом таксопарке, если вы хотите уволиться введите /tmenu");
		else
			SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы уже устроены в другом таксопарке, если вы хотите уволиться введите /tmenu");
		return 1;
	}
	g_TaxiDriverRank[playerid] = TAXI_RANK_ECO;
	TaxiPark_SetPlayerJob(playerid, park_id);
	new msg[144];
	format(msg, sizeof msg, "%s %s", "Вы успешно устроились в таксокомпанию", g_TaxiPark[park_id][TP_NAME]);
	ShowNotificationNew(playerid, 3, 6, 0, 0, msg, "");
	ShowNotificationNew(playerid, 3, 6, 0, 0, "Используйте команду /tmenu для ознакомления.", "");
	return 1;
}

stock TaxiPark_OnAutoparkPickup(playerid, park_id)
{
	SetPVarInt(playerid, "player_state_pickup", false);
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	if(GetPVarInt(playerid, "TaxiParkActFlood") > GetTickCount()) return 1;
	SetPVarInt(playerid, "TaxiParkActFlood", GetTickCount() + 1500);
	new current_job = TaxiPark_GetPlayerJob(playerid);
	// Owner of this park can always use autopark (auto-hire as director if needed)
	if(TaxiPark_IsOwner(playerid, park_id))
	{
		if(current_job != park_id)
		{
			g_TaxiDriverRank[playerid] = TAXI_RANK_DIRECTOR;
			TaxiPark_SetPlayerJob(playerid, park_id);
			current_job = park_id;
		}
	}
	else if(current_job == -1)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы не устроены в таксопарк, зайдите в таксопарк и устройтесь");
		return 1;
	}
	else if(current_job != park_id)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы находитесь в другом таксопарке, используйте автопарк вашего таксопарка, или увольтесь");
		return 1;
	}
	if(GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE) != 0)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}У вас уже есть арендованный транспорт");
		return 1;
	}
	new caption[64], list[512];
	format(caption, sizeof caption, "BLACK RUSSIA | Автопарк");
	format(list, sizeof list,
		"Название\tДоступно с ранга\tКласс\tСтоимость аренды\n");
	new shown = 0;
	new map_idx[TAXI_PARK_CAR_COUNT];
	for(new i = 0; i < TAXI_PARK_CAR_COUNT; i++)
	{
		if(!g_TaxiFleetEnabled[park_id][i]) continue;
		// Skip occupied cars
		if(g_TaxiFleetTaken[park_id][i] != INVALID_PLAYER_ID && IsPlayerConnected(g_TaxiFleetTaken[park_id][i]))
			continue;
		new r = g_TaxiFleetRank[park_id][i];
		if(r < 0) r = 0; if(r > 2) r = 2;
		new c = g_TaxiFleetClass[park_id][i];
		if(c < 0) c = 0; if(c > 2) c = 2;
		format(list, sizeof list, "%s%s\t%s\t%s\t%d %s\n",
			list,
			g_TaxiFleetName[park_id][i],
			g_TaxiRankNames[park_id][r],
			g_TaxiRankNames[park_id][c],
			g_TaxiFleetPrice[park_id][i],
			"рублей");
		map_idx[shown] = i;
		shown++;
	}
	if(shown == 0)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "На данный момент свободных машин нету", "");
		return 1;
	}
	for(new m = 0; m < shown; m++)
		SetPVarInt(playerid, "TaxiRentMap", map_idx[m]); // overwrite - need per index
	SetPVarInt(playerid, "TaxiRentShown", shown);
	for(new m = 0; m < shown; m++)
	{
		new pvn[24];
		format(pvn, sizeof pvn, "TaxiRentMap%d", m);
		SetPVarInt(playerid, pvn, map_idx[m]);
	}
	SetPVarInt(playerid, TAXI_PARK_PVAR_PENDING_CAR, park_id);
	Dialog_Open(playerid, "TaxiPark_AutoparkResponse", DIALOG_STYLE_TABLIST_HEADERS, caption, list, "Выбрать", "Закрыть");
	return 1;
}

Dialog_Response:TaxiPark_AutoparkResponse(playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new park_id = GetPVarInt(playerid, TAXI_PARK_PVAR_PENDING_CAR);
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 1;
	new shown = GetPVarInt(playerid, "TaxiRentShown");
	if(listitem < 0 || listitem >= shown) return 1;
	new pvn[24];
	format(pvn, sizeof pvn, "TaxiRentMap%d", listitem);
	listitem = GetPVarInt(playerid, pvn);
	if(listitem < 0 || listitem >= TAXI_PARK_CAR_COUNT) return 1;
	if(!g_TaxiFleetEnabled[park_id][listitem])
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "В таксопарке не найдено автомобилей", "");
		return 1;
	}
	if(GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE) != 0)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}У вас уже есть арендованный транспорт");
		return 1;
	}
	new rent_price = g_TaxiFleetPrice[park_id][listitem];
	if(GetPlayerMoney(playerid) < rent_price)
	{
		new msg[96];
		format(msg, sizeof msg, "{ff2400}| {ffffff}Недостаточно средств. Нужно %d руб", rent_price);
		SendClientMessage(playerid, -1, msg);
		return 1;
	}
	new slot = random(TAXI_PARK_PARKING_SPOTS);
	new Float: px, Float: py, Float: pz, Float: pa;
	switch(slot)
	{
		case 0: { px = g_TaxiPark[park_id][TP_PARK1_X]; py = g_TaxiPark[park_id][TP_PARK1_Y]; pz = g_TaxiPark[park_id][TP_PARK1_Z]; pa = g_TaxiPark[park_id][TP_PARK1_A]; }
		case 1: { px = g_TaxiPark[park_id][TP_PARK2_X]; py = g_TaxiPark[park_id][TP_PARK2_Y]; pz = g_TaxiPark[park_id][TP_PARK2_Z]; pa = g_TaxiPark[park_id][TP_PARK2_A]; }
		default: { px = g_TaxiPark[park_id][TP_PARK3_X]; py = g_TaxiPark[park_id][TP_PARK3_Y]; pz = g_TaxiPark[park_id][TP_PARK3_Z]; pa = g_TaxiPark[park_id][TP_PARK3_A]; }
	}
	new model = g_TaxiFleetModel[park_id][listitem];
	if(model < 400) model = g_TaxiParkCars[listitem];
	new vehicleid = CreateVehicle(model, px, py, pz, pa, 1, 1, -1);
	if(vehicleid == INVALID_VEHICLE_ID || vehicleid == 0)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Не удалось создать машину, попробуйте позже");
		return 1;
	}
	GivePlayerMoneyEx(playerid, -rent_price, "TaxiPark", true, true);
	if(g_TaxiCompany[park_id][TC_BALANCE] + rent_price <= TaxiPark_GetSafeMax(park_id))
		g_TaxiCompany[park_id][TC_BALANCE] += rent_price;
	TaxiPark_AddProfit(park_id, rent_price);
	TaxiPark_SaveCompany(park_id);
	SetVehicleVirtualWorld(vehicleid, 0);
	LinkVehicleToInterior(vehicleid, 0);
	SetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE, vehicleid);
	// Store car class and mark fleet slot taken
	new car_class = g_TaxiFleetClass[park_id][listitem];
	if(car_class < 0) car_class = 0;
	if(car_class > 2) car_class = 2;
	g_TaxiDriverCarClass[playerid] = car_class;
	g_TaxiDriverFleetSlot[playerid] = listitem;
	g_TaxiFleetTaken[park_id][listitem] = playerid;
	SetTimerEx("DelayedPutPlayerInVehicle", 150, false, "ii", playerid, vehicleid);

	new label_str[64];
	format(label_str, sizeof label_str, "Такси%c%s", 10, g_TaxiPark[park_id][TP_NAME]);
	new Text3D:label = CreateDynamic3DTextLabel(label_str, 0xFFFF00FF, 0.0, 0.0, 1.3, 30.0, INVALID_PLAYER_ID, vehicleid);
	SetPVarInt(playerid, TAXI_PARK_PVAR_LABEL, _:label);

	new icon = GetPVarInt(playerid, TAXI_PARK_PVAR_ICON);
	if(icon != 0)
		RemovePlayerMapIcon(playerid, 99);
	SetPlayerMapIcon(playerid, 99, px, py, pz, 55, 0, MAPICON_LOCAL);
	SetPVarInt(playerid, TAXI_PARK_PVAR_ICON, 99);

	new caption[72], info[512];
	format(caption, sizeof caption, "%s | Начало работы в такси", g_TaxiPark[park_id][TP_NAME]);
	format(info, sizeof info,
		"Вы начали работу на линии с агрегатором %s.\n\n\
Пожалуйста, соблюдайте все правила дорожного движения и помните:\n\
в случае нарушения правил дорожного движения или низкого рейтинга\n\
Вам будет закрыт доступ к работе в таксопарке.\n\n\
- /tord для ознакомления со списком заказов",
		g_TaxiPark[park_id][TP_NAME]);
	Dialog_Open(playerid, "TaxiPark_StartWorkResponse", DIALOG_STYLE_MSGBOX, caption, info, "Понятно", "");

	TaxiPark_StartOrderTimer(playerid);
	return 1;
}

Dialog_Response:TaxiPark_StartWorkResponse(playerid, response, listitem, inputtext[])
{
	return 1;
}

stock TaxiPark_DestroyPlayerVehicle(playerid)
{
	new vehicleid = GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE);
	new label = GetPVarInt(playerid, TAXI_PARK_PVAR_LABEL);
	if(label != 0)
	{
		DestroyDynamic3DTextLabel(Text3D:label);
		SetPVarInt(playerid, TAXI_PARK_PVAR_LABEL, 0);
	}
	if(GetPVarInt(playerid, TAXI_PARK_PVAR_ICON) != 0)
	{
		RemovePlayerMapIcon(playerid, 99);
		SetPVarInt(playerid, TAXI_PARK_PVAR_ICON, 0);
	}
	if(vehicleid != 0 && GetVehicleModel(vehicleid) != 0)
		DestroyVehicle(vehicleid);
	SetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE, 0);
	// Free fleet slot
	new slot = g_TaxiDriverFleetSlot[playerid];
	new park = TaxiPark_GetPlayerJob(playerid);
	if(slot >= 0 && slot < TAXI_PARK_CAR_COUNT && park >= 0 && park < TAXI_PARK_COUNT)
	{
		if(g_TaxiFleetTaken[park][slot] == playerid)
			g_TaxiFleetTaken[park][slot] = INVALID_PLAYER_ID;
	}
	g_TaxiDriverFleetSlot[playerid] = -1;
	g_TaxiDriverCarClass[playerid] = 0;
	if(g_TaxiPark_PlayerReturnTimer[playerid] != 0)
	{
		KillTimer(g_TaxiPark_PlayerReturnTimer[playerid]);
		g_TaxiPark_PlayerReturnTimer[playerid] = 0;
	}
	// Hide return TextDraw
	if(_:g_TaxiReturnTD[playerid] != 0)
	{
		PlayerTextDrawHide(playerid, g_TaxiReturnTD[playerid]);
		PlayerTextDrawDestroy(playerid, g_TaxiReturnTD[playerid]);
		g_TaxiReturnTD[playerid] = PlayerText:0;
	}
	g_TaxiReturnSeconds[playerid] = 0;
	return 1;
}

public TaxiPark_ReturnVehicleTimer(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new vehicleid = GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE);
	if(vehicleid == 0)
	{
		g_TaxiPark_PlayerReturnTimer[playerid] = 0;
		return 0;
	}
	if(IsPlayerInVehicle(playerid, vehicleid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		// Cancelled - player returned
		if(_:g_TaxiReturnTD[playerid] != 0)
		{
			PlayerTextDrawHide(playerid, g_TaxiReturnTD[playerid]);
			PlayerTextDrawDestroy(playerid, g_TaxiReturnTD[playerid]);
			g_TaxiReturnTD[playerid] = PlayerText:0;
		}
		g_TaxiReturnSeconds[playerid] = 0;
		g_TaxiPark_PlayerReturnTimer[playerid] = 0;
		return 1;
	}
	g_TaxiReturnSeconds[playerid]--;
	if(g_TaxiReturnSeconds[playerid] <= 0)
	{
		if(_:g_TaxiReturnTD[playerid] != 0)
		{
			PlayerTextDrawHide(playerid, g_TaxiReturnTD[playerid]);
			PlayerTextDrawDestroy(playerid, g_TaxiReturnTD[playerid]);
			g_TaxiReturnTD[playerid] = PlayerText:0;
		}
		TaxiPark_DestroyPlayerVehicle(playerid);
		TaxiPark_CancelOrder(playerid);
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Машина возвращена в автопарк");
		g_TaxiPark_PlayerReturnTimer[playerid] = 0;
		return 1;
	}
	// Update TextDraw
	new str[32];
	format(str, sizeof str, "%d", g_TaxiReturnSeconds[playerid]);
	if(_:g_TaxiReturnTD[playerid] != 0)
		PlayerTextDrawSetString(playerid, g_TaxiReturnTD[playerid], str);
	g_TaxiPark_PlayerReturnTimer[playerid] = SetTimerEx("TaxiPark_ReturnVehicleTimer", 1000, false, "i", playerid);
	return 1;
}

stock TaxiPark_StartReturnTimer(playerid)
{
	if(g_TaxiPark_PlayerReturnTimer[playerid] != 0)
		KillTimer(g_TaxiPark_PlayerReturnTimer[playerid]);
	g_TaxiReturnSeconds[playerid] = TAXI_PARK_RETURN_TIME;
	SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы вышли из машины, если вы не вернетесь в нее в течении 60 секунд то она будет возвращена в автопарк");
	if(_:g_TaxiReturnTD[playerid] != 0)
	{
		PlayerTextDrawDestroy(playerid, g_TaxiReturnTD[playerid]);
		g_TaxiReturnTD[playerid] = PlayerText:0;
	}
	g_TaxiReturnTD[playerid] = CreatePlayerTextDraw(playerid, 280.0, 200.0, "60");
	PlayerTextDrawFont(playerid, g_TaxiReturnTD[playerid], 2);
	PlayerTextDrawLetterSize(playerid, g_TaxiReturnTD[playerid], 0.6, 2.2);
	PlayerTextDrawColor(playerid, g_TaxiReturnTD[playerid], 0x33FF33FF);
	PlayerTextDrawSetOutline(playerid, g_TaxiReturnTD[playerid], 1);
	PlayerTextDrawSetProportional(playerid, g_TaxiReturnTD[playerid], 1);
	PlayerTextDrawShow(playerid, g_TaxiReturnTD[playerid]);
	g_TaxiPark_PlayerReturnTimer[playerid] = SetTimerEx("TaxiPark_ReturnVehicleTimer", 1000, false, "i", playerid);
	return 1;
}

public TaxiPark_UpdateReturnText(playerid, seconds)
{
	if(!IsPlayerConnected(playerid)) return 0;
	if(g_TaxiPark_PlayerReturnTimer[playerid] == 0) return 0;
	new vehicleid = GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE);
	if(vehicleid == 0) return 0;
	if(IsPlayerInVehicle(playerid, vehicleid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		g_TaxiPark_PlayerReturnTimer[playerid] = 0;
		return 1;
	}
	if(seconds <= 0) return 1;
	new str[32];
	format(str, sizeof str, "~g~%d", seconds);
	GameTextForPlayer(playerid, str, 1000, 4);
	SetTimerEx("TaxiPark_UpdateReturnText", 1000, false, "ii", playerid, seconds - 1);
	return 1;
}

stock TaxiPark_StartOrderTimer(playerid)
{
	if(g_TaxiPark_PlayerOrderTimer[playerid] != 0)
		KillTimer(g_TaxiPark_PlayerOrderTimer[playerid]);
	new delay = TAXI_PARK_ORDER_MIN_TIME + random(TAXI_PARK_ORDER_MAX_TIME - TAXI_PARK_ORDER_MIN_TIME + 1);
	g_TaxiPark_PlayerOrderTimer[playerid] = SetTimerEx("TaxiPark_OrderTimer", delay * 1000, false, "i", playerid);
	return 1;
}

stock TaxiPark_NotifyParkDrivers(park_id, shared_slot)
{
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(TaxiPark_GetPlayerJob(i) != park_id) continue;
		if(GetPVarInt(i, TAXI_PARK_PVAR_VEHICLE) == 0) continue;
		if(GetPVarInt(i, TAXI_PARK_PVAR_ORDER_STAGE) != 0) continue;
		// subId = shared_slot + 1 (0 reserved)
		ShowNotificationNew(i, 4, 8, TAXI_PARK_NOTIFICATION_ID, shared_slot + 1, "У вас новый вызов", "открыть");
	}
	return 1;
}

stock TaxiPark_AddSharedDelivery(park_id)
{
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return -1;
	new slot = -1;
	for(new s = 0; s < TAXI_SHARED_MAX; s++)
	{
		if(g_TaxiShared[park_id][s][TS_ACTIVE] == 0)
		{
			slot = s;
			break;
		}
	}
	if(slot == -1) return -1;

	new npc = random(TAXI_PARK_NPC_COUNT);
	new dest = random(TAXI_PARK_DEST_COUNT);
	new tries = 0;
	while(tries < 20)
	{
		new d = random(TAXI_PARK_DEST_COUNT);
		new Float: dd = GetDistanceBetweenPoints(
			g_TaxiParkNpcPos[npc][0], g_TaxiParkNpcPos[npc][1], g_TaxiParkNpcPos[npc][2],
			g_TaxiParkDestPos[d][0], g_TaxiParkDestPos[d][1], g_TaxiParkDestPos[d][2]);
		if(dd >= TAXI_PARK_MIN_DEST_DIST)
		{
			dest = d;
			break;
		}
		tries++;
	}
	new Float: trip = GetDistanceBetweenPoints(
		g_TaxiParkNpcPos[npc][0], g_TaxiParkNpcPos[npc][1], g_TaxiParkNpcPos[npc][2],
		g_TaxiParkDestPos[dest][0], g_TaxiParkDestPos[dest][1], g_TaxiParkDestPos[dest][2]);
	new price = TaxiPark_CalcPrice(trip, 0);

	g_TaxiShared[park_id][slot][TS_ACTIVE] = 1;
	g_TaxiShared[park_id][slot][TS_NPC] = npc;
	g_TaxiShared[park_id][slot][TS_TO_X] = g_TaxiParkDestPos[dest][0];
	g_TaxiShared[park_id][slot][TS_TO_Y] = g_TaxiParkDestPos[dest][1];
	g_TaxiShared[park_id][slot][TS_TO_Z] = g_TaxiParkDestPos[dest][2];
	g_TaxiShared[park_id][slot][TS_PRICE] = price;
	g_TaxiShared[park_id][slot][TS_TAKEN_BY] = INVALID_PLAYER_ID;
	g_TaxiSharedCount[park_id]++;

	TaxiPark_NotifyParkDrivers(park_id, slot);
	return slot;
}

public TaxiPark_OrderTimer(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new vehicleid = GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE);
	if(vehicleid == 0)
	{
		g_TaxiPark_PlayerOrderTimer[playerid] = 0;
		return 0;
	}
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1)
	{
		g_TaxiPark_PlayerOrderTimer[playerid] = 0;
		return 0;
	}

	// Count waiting shared deliveries
	new waiting = 0;
	for(new s = 0; s < TAXI_SHARED_MAX; s++)
		if(g_TaxiShared[park_id][s][TS_ACTIVE] == 1) waiting++;

	// Rare delivery spawn (max 3 waiting per park)
	if(waiting < 3)
	{
		TaxiPark_AddSharedDelivery(park_id);
	}
	TaxiPark_StartOrderTimer(playerid);
	return 1;
}

stock Float: GetDistanceBetweenPoints(Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2)
{
	return floatsqroot(floatpower(x1 - x2, 2.0) + floatpower(y1 - y2, 2.0) + floatpower(z1 - z2, 2.0));
}

public TaxiPark_NotificationClick(playerid, sub_id)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1) return 1;
	if(GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE) == 0) return 1;
	if(GetPVarInt(playerid, TAXI_PARK_PVAR_ORDER_STAGE) != 0)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "У вас уже есть активный заказ такси", "");
		return 1;
	}
	TaxiPark_BuildDriverOrders(playerid);
	if(g_TaxiDriverOrderCount[playerid] <= 0)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "Нет доступных вызовов", "");
		return 1;
	}
	// sub_id from notification: shared_slot+1 for delivery. Open that order in list.
	g_TaxiDriverOrderIdx[playerid] = 0;
	if(sub_id > 0)
	{
		new slot = sub_id - 1;
		for(new i = 0; i < g_TaxiDriverOrderCount[playerid]; i++)
		{
			if(g_TaxiDriverOrderType[playerid][i] == 0 && g_TaxiDriverOrderId[playerid][i] == slot)
			{
				g_TaxiDriverOrderIdx[playerid] = i;
				break;
			}
		}
	}
	ShowTaxiGUI(playerid, 0.11, g_TaxiDriverOrderCount[playerid], g_TaxiDayIncome[playerid]);
	return 1;
}


stock TaxiPark_StartPlayerTrip(driverid, passenger)
{
	if(!IsPlayerConnected(driverid) || !IsPlayerConnected(passenger)) return 0;
	if(g_TaxiPlayerOrder[passenger][TPO_STATE] == TAXI_PLAYER_ORDER_DRIVE) return 0;

	// Accept PICKUP or ACCEPTED (or even WAITING if somehow seated)
	new st = g_TaxiPlayerOrder[passenger][TPO_STATE];
	if(st != TAXI_PLAYER_ORDER_PICKUP && st != TAXI_PLAYER_ORDER_ACCEPTED)
	{
		printf("[TAXI TRIP] bad state=%d pass=%d", st, passenger);
		return 0;
	}
	if(g_TaxiPlayerOrder[passenger][TPO_DRIVER] != driverid)
	{
		printf("[TAXI TRIP] driver mismatch order=%d me=%d (force link)", g_TaxiPlayerOrder[passenger][TPO_DRIVER], driverid);
		// still link if order was accepted by this driver via PVar
		if(GetPVarInt(driverid, "TaxiOrderPassenger") != passenger)
			return 0;
	}
	g_TaxiPlayerOrder[passenger][TPO_DRIVER] = driverid;

	// Vehicle: prefer ACTUAL vehicle driver sits in, then PVar
	new vehicleid = GetPlayerVehicleID(driverid);
	if(vehicleid == 0)
		vehicleid = GetPVarInt(driverid, TAXI_PARK_PVAR_VEHICLE);
	if(vehicleid == 0)
	{
		printf("[TAXI TRIP] no vehicle driver=%d", driverid);
		return 0;
	}

	new pveh = GetPlayerVehicleID(passenger);
	new pstate = GetPlayerState(passenger);
	printf("[TAXI TRIP try] drv=%d pass=%d dveh=%d pveh=%d pstate=%d stage=%d",
		driverid, passenger, vehicleid, pveh, pstate, GetPVarInt(driverid, TAXI_PARK_PVAR_ORDER_STAGE));

	if(pveh == 0 || pveh != vehicleid)
		return 0;

	new Float: dx = g_TaxiPlayerOrder[passenger][TPO_TO_X];
	new Float: dy = g_TaxiPlayerOrder[passenger][TPO_TO_Y];
	new Float: dz = g_TaxiPlayerOrder[passenger][TPO_TO_Z];
	if(dx == 0.0 && dy == 0.0)
	{
		dx = g_TaxiPendingToX[passenger];
		dy = g_TaxiPendingToY[passenger];
		dz = g_TaxiPendingToZ[passenger];
	}
	if(dx == 0.0 && dy == 0.0)
	{
		new d = random(TAXI_PARK_DEST_COUNT);
		dx = g_TaxiParkDestPos[d][0];
		dy = g_TaxiParkDestPos[d][1];
		dz = g_TaxiParkDestPos[d][2];
	}
	g_TaxiPlayerOrder[passenger][TPO_TO_X] = dx;
	g_TaxiPlayerOrder[passenger][TPO_TO_Y] = dy;
	g_TaxiPlayerOrder[passenger][TPO_TO_Z] = dz;

	if(g_TaxiDistTimer[passenger] != 0)
	{
		KillTimer(g_TaxiDistTimer[passenger]);
		g_TaxiDistTimer[passenger] = 0;
	}
	if(GetPVarInt(driverid, "TaxiBoardTimer") != 0)
	{
		KillTimer(GetPVarInt(driverid, "TaxiBoardTimer"));
		SetPVarInt(driverid, "TaxiBoardTimer", 0);
	}

	DisablePlayerGPS(driverid);
	DisablePlayerGPS(passenger);

	g_TaxiPlayerOrder[passenger][TPO_STATE] = TAXI_PLAYER_ORDER_DRIVE;
	SetPVarInt(driverid, TAXI_PARK_PVAR_ORDER_STAGE, 2);
	SetPVarInt(driverid, "TaxiOrderIsPlayer", 1);
	SetPVarInt(driverid, "TaxiOrderPassenger", passenger);
	SetPVarFloat(driverid, TAXI_PARK_PVAR_DEST_X, dx);
	SetPVarFloat(driverid, TAXI_PARK_PVAR_DEST_Y, dy);
	SetPVarFloat(driverid, TAXI_PARK_PVAR_DEST_Z, dz);

	ShowNotificationNew(driverid, 3, 6, 0, 0, "Клиент сел в машину, точка отмечена на карте", "");
	ShowNotificationNew(passenger, 3, 6, 0, 0, "Поездка началась", "");
	SendClientMessage(driverid, -1, "{33FF33}| {ffffff}Клиент в машине. Везите по GPS к точке назначения.");
	SendClientMessage(passenger, -1, "{33FF33}| {ffffff}Поездка началась. Точка назначения отмечена на карте.");

	EnablePlayerGPS(driverid, 0, dx, dy, dz, "Довезите клиента");
	EnablePlayerGPS(passenger, 0, dx, dy, dz, "Точка назначения");

	// ensure arrive timer still runs for stage 2
	if(g_TaxiPark_ArriveTimer[driverid] == 0)
		g_TaxiPark_ArriveTimer[driverid] = SetTimerEx("TaxiPark_CheckArrive", 1000, true, "i", driverid);

	printf("[TAXI TRIP START OK] drv=%d pass=%d veh=%d -> %.2f %.2f %.2f", driverid, passenger, vehicleid, dx, dy, dz);
	return 1;
}

forward TaxiPark_BoardWatch(driverid);
public TaxiPark_BoardWatch(driverid)
{
	if(!IsPlayerConnected(driverid))
	{
		SetPVarInt(driverid, "TaxiBoardTimer", 0);
		return 0;
	}
	if(GetPVarInt(driverid, TAXI_PARK_PVAR_ORDER_STAGE) != 1)
	{
		SetPVarInt(driverid, "TaxiBoardTimer", 0);
		return 0;
	}
	new passenger = GetPVarInt(driverid, "TaxiOrderPassenger");
	if(!IsPlayerConnected(passenger))
	{
		SetPVarInt(driverid, "TaxiBoardTimer", 0);
		return 0;
	}
	if(g_TaxiPlayerOrder[passenger][TPO_STATE] == TAXI_PLAYER_ORDER_DRIVE)
	{
		SetPVarInt(driverid, "TaxiBoardTimer", 0);
		return 0;
	}

	new dveh = GetPlayerVehicleID(driverid);
	if(dveh == 0)
		dveh = GetPVarInt(driverid, TAXI_PARK_PVAR_VEHICLE);

	new pveh = GetPlayerVehicleID(passenger);

	if(dveh != 0 && pveh == dveh)
	{
		printf("[TAXI BOARD] passenger seated - start trip");
		if(TaxiPark_StartPlayerTrip(driverid, passenger))
		{
			SetPVarInt(driverid, "TaxiBoardTimer", 0);
			return 1;
		}
	}

	// unlock doors when passenger near so they can press F
	if(dveh != 0 && GetPlayerState(passenger) == PLAYER_STATE_ONFOOT)
	{
		new Float: vx, Float: vy, Float: vz;
		GetVehiclePos(dveh, vx, vy, vz);
		if(IsPlayerInRangeOfPoint(passenger, 8.0, vx, vy, vz))
		{
			if(GetPVarInt(driverid, "TaxiNearTicks") == 0)
			{
				new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(dveh, engine, lights, alarm, doors, bonnet, boot, objective);
				SetVehicleParamsEx(dveh, engine, lights, alarm, 0, bonnet, boot, objective);
				SetPVarInt(driverid, "TaxiNearTicks", 1);
			}
		}
		else SetPVarInt(driverid, "TaxiNearTicks", 0);
	}

	SetPVarInt(driverid, "TaxiBoardTimer", SetTimerEx("TaxiPark_BoardWatch", 250, false, "i", driverid));
	return 1;
}

stock TaxiPark_StartBoardWatch(driverid)
{
	if(!IsPlayerConnected(driverid)) return 0;
	if(GetPVarInt(driverid, "TaxiBoardTimer") != 0)
		KillTimer(GetPVarInt(driverid, "TaxiBoardTimer"));
	SetPVarInt(driverid, "TaxiBoardTick", 0);
	SetPVarInt(driverid, "TaxiNearTicks", 0);
	SetPVarInt(driverid, "TaxiPutTried", 0);
	SetPVarInt(driverid, "TaxiBoardTimer", SetTimerEx("TaxiPark_BoardWatch", 250, false, "i", driverid));
	printf("[TAXI BOARD] watch started for driver=%d pass=%d", driverid, GetPVarInt(driverid, "TaxiOrderPassenger"));
	return 1;
}

forward TaxiPark_DelayedStartTrip(driverid, passenger);
forward TaxiPark_DelayedStartTrip(driverid, passenger);
forward TaxiPark_DelayedStartTrip(driverid, passenger);
public TaxiPark_DelayedStartTrip(driverid, passenger)
{
	return TaxiPark_StartPlayerTrip(driverid, passenger);
}

public TaxiPark_CheckArrive(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new stage = GetPVarInt(playerid, TAXI_PARK_PVAR_ORDER_STAGE);
	if(stage == 0) return 0;
	new vehicleid = GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE);
	if(vehicleid == 0 || !IsPlayerInVehicle(playerid, vehicleid)) return 1;

	new is_player_order = GetPVarInt(playerid, "TaxiOrderIsPlayer");

	if(stage == 1)
	{
		if(is_player_order)
		{
			new passenger = GetPVarInt(playerid, "TaxiOrderPassenger");
			if(!IsPlayerConnected(passenger))
			{
				SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Клиент вышел с сервера, заказ отменён");
				TaxiPark_CancelOrder(playerid);
				return 1;
			}
			// Always try trip if same vehicle
			new dveh = GetPlayerVehicleID(playerid);
			if(dveh == 0) dveh = vehicleid;
			new pveh = GetPlayerVehicleID(passenger);
			if(dveh != 0 && pveh == dveh)
			{
				TaxiPark_StartPlayerTrip(playerid, passenger);
				return 1;
			}
			if(g_TaxiPlayerOrder[passenger][TPO_STATE] == TAXI_PLAYER_ORDER_ACCEPTED &&
			   IsPlayerInRangeOfPlayer(playerid, passenger, 20.0))
			{
				if(g_TaxiDistTimer[passenger] != 0)
				{
					KillTimer(g_TaxiDistTimer[passenger]);
					g_TaxiDistTimer[passenger] = 0;
				}
				g_TaxiPlayerOrder[passenger][TPO_STATE] = TAXI_PLAYER_ORDER_PICKUP;
				ShowNotificationNew(playerid, 3, 5, 0, 0, "Вы приехали, ожидайте пока клиент сядет в машину", "");
				ShowNotificationNew(passenger, 3, 5, 0, 0, "Ваш таксист подъехал, садитесь в машину", "");
				new Float: vx, Float: vy, Float: vz;
				new usev = dveh;
				if(usev == 0) usev = vehicleid;
				GetVehiclePos(usev, vx, vy, vz);
				EnablePlayerGPS(passenger, 0, vx, vy, vz, "Садитесь в такси");
				{
					new engine, lights, alarm, doors, bonnet, boot, objective;
					GetVehicleParamsEx(usev, engine, lights, alarm, doors, bonnet, boot, objective);
					SetVehicleParamsEx(usev, engine, lights, alarm, 0, bonnet, boot, objective);
				}
				TaxiPark_StartBoardWatch(playerid);
				printf("[TAXI ARRIVE] driver=%d passenger=%d -> PICKUP + board watch", playerid, passenger);
			}
			else if(g_TaxiPlayerOrder[passenger][TPO_STATE] == TAXI_PLAYER_ORDER_PICKUP)
			{
				if(GetPVarInt(playerid, "TaxiBoardTimer") == 0)
					TaxiPark_StartBoardWatch(playerid);
			}
		}
		else
		{
			new npc_idx = g_TaxiPark_SelectedOrder[playerid];
			new Float: nx = g_TaxiParkNpcPos[npc_idx][0];
			new Float: ny = g_TaxiParkNpcPos[npc_idx][1];
			new Float: nz = g_TaxiParkNpcPos[npc_idx][2];
			if(IsPlayerInRangeOfPoint(playerid, 8.0, nx, ny, nz))
			{
				new actorid = GetPVarInt(playerid, TAXI_PARK_PVAR_ACTOR);
				if(actorid != 0)
				{
					DestroyActor(actorid);
					SetPVarInt(playerid, TAXI_PARK_PVAR_ACTOR, 0);
				}
				DisablePlayerGPS(playerid);
				new dest_idx = -1, tries = 0;
				while(tries < 30)
				{
					new idx = random(TAXI_PARK_DEST_COUNT);
					new Float: ddist = GetDistanceBetweenPoints(nx, ny, nz, g_TaxiParkDestPos[idx][0], g_TaxiParkDestPos[idx][1], g_TaxiParkDestPos[idx][2]);
					if(ddist >= TAXI_PARK_MIN_DEST_DIST)
					{
						dest_idx = idx;
						break;
					}
					tries++;
				}
				if(dest_idx == -1) dest_idx = random(TAXI_PARK_DEST_COUNT);
				new Float: dx = g_TaxiParkDestPos[dest_idx][0];
				new Float: dy = g_TaxiParkDestPos[dest_idx][1];
				new Float: dz = g_TaxiParkDestPos[dest_idx][2];
				SetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_X, dx);
				SetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_Y, dy);
				SetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_Z, dz);
				new Float: trip_dist = GetDistanceBetweenPoints(nx, ny, nz, dx, dy, dz);
				SetPVarFloat(playerid, TAXI_PARK_PVAR_ORDER_DIST, trip_dist);
				SetPVarInt(playerid, TAXI_PARK_PVAR_ORDER_STAGE, 2);
				ShowNotificationNew(playerid, 3, 5, 0, 0, "Вы подобрали клиента, довезите его до нужного места.", "");
				EnablePlayerGPS(playerid, 0, dx, dy, dz, "????В разработке ???????? ?? ?????");
			}
		}
	}
	else if(stage == 2)
	{
		if(is_player_order)
		{
			new passenger = GetPVarInt(playerid, "TaxiOrderPassenger");
			if(!IsPlayerConnected(passenger))
			{
				TaxiPark_CancelOrder(playerid);
				return 1;
			}
			new Float: dx = g_TaxiPlayerOrder[passenger][TPO_TO_X];
			new Float: dy = g_TaxiPlayerOrder[passenger][TPO_TO_Y];
			new Float: dz = g_TaxiPlayerOrder[passenger][TPO_TO_Z];
			if(IsPlayerInRangeOfPoint(playerid, 8.0, dx, dy, dz))
			{
				DisablePlayerGPS(playerid);
				DisablePlayerGPS(passenger);
				new payment = g_TaxiPlayerOrder[passenger][TPO_PRICE];
				new pay_method = g_TaxiPlayerOrder[passenger][TPO_PAYMENT];

				if(pay_method == 1)
				{
					
					
					
					if(GetPlayerMoney(passenger) >= payment)
						GivePlayerMoneyEx(passenger, -payment, "TaxiPark", true, true);
				}
				else
				{
					if(GetPlayerMoney(passenger) >= payment)
						GivePlayerMoneyEx(passenger, -payment, "TaxiPark", true, true);
				}
				TaxiPark_CheckDay(playerid);
				new _park = TaxiPark_GetPlayerJob(playerid);
				new driver_share = payment;
				new company_share = 0;
				if(_park != -1)
				{
					g_TaxiCompany[_park][TC_ORDERS]++;
					new class_id = g_TaxiDriverCarClass[playerid];
					if(class_id < 0) class_id = 0;
					if(class_id > 2) class_id = 2;
					new drv_pct = g_TaxiDriverPct[_park][class_id];
					if(drv_pct < 20) drv_pct = 20;
					if(drv_pct > 75) drv_pct = 75;
					driver_share = payment * drv_pct / 100;
					company_share = payment - driver_share;
					if(g_TaxiCompany[_park][TC_BALANCE] + company_share <= TaxiPark_GetSafeMax(_park))
						g_TaxiCompany[_park][TC_BALANCE] += company_share;
					TaxiPark_AddProfit(_park, company_share);
					if(TaxiPark_BoostActive(_park, TC_BOOST_EXP))
						g_TaxiDriverSkill[playerid] += 2;
					else
						g_TaxiDriverSkill[playerid] += 1;
					TaxiPark_SaveCompany(_park);
				}
				// Percent already taken from payment — credit only driver share
				GivePlayerMoneyEx(playerid, driver_share, "TaxiPark", true, true);
				g_TaxiDayTrips[playerid]++;
				g_TaxiDayIncome[playerid] += driver_share;
				new msg[128];
				format(msg, sizeof msg, "{33FF33}| {ffffff}Вызов выполнен. Получено: %d руб (из %d)", driver_share, payment);
				SendClientMessage(playerid, -1, msg);
				SendClientMessage(passenger, -1, "{33FF33}| {ffffff}Вы приехали на точку назначения, выйдите пожалуйста из машины");
				ShowNotificationNew(passenger, 3, 5, 0, 0, "Вы приехали на точку назначения, выйдите пожалуйста из машины", "");
				ShowNotificationNew(playerid, 3, 5, 0, 0, "Вызов выполнен", "");
				TaxiPark_ResetPlayerOrder(passenger);
				TaxiPark_CancelOrder(playerid);
			}
		}
		else
		{
			new Float: dx = GetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_X);
			new Float: dy = GetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_Y);
			new Float: dz = GetPVarFloat(playerid, TAXI_PARK_PVAR_DEST_Z);
			if(IsPlayerInRangeOfPoint(playerid, 8.0, dx, dy, dz))
			{
				DisablePlayerGPS(playerid);
				new payment = GetPVarInt(playerid, "TaxiOrderPrice");
				if(payment <= 0)
				{
					new Float: trip_dist = GetPVarFloat(playerid, TAXI_PARK_PVAR_ORDER_DIST);
					payment = floatround(trip_dist / 100.0) * TAXI_PARK_PAY_PER_100M;
					if(payment < 500) payment = 500;
				}
				TaxiPark_CheckDay(playerid);
				new _park = TaxiPark_GetPlayerJob(playerid);
				new driver_share = payment;
				new company_share = 0;
				if(_park != -1)
				{
					g_TaxiCompany[_park][TC_ORDERS]++;
					new class_id = g_TaxiDriverCarClass[playerid];
					if(class_id < 0) class_id = 0;
					if(class_id > 2) class_id = 2;
					new drv_pct = g_TaxiDriverPct[_park][class_id];
					if(drv_pct < 20) drv_pct = 20;
					if(drv_pct > 75) drv_pct = 75;
					driver_share = payment * drv_pct / 100;
					company_share = payment - driver_share;
					if(g_TaxiCompany[_park][TC_BALANCE] + company_share <= TaxiPark_GetSafeMax(_park))
						g_TaxiCompany[_park][TC_BALANCE] += company_share;
					TaxiPark_AddProfit(_park, company_share);
					if(TaxiPark_BoostActive(_park, TC_BOOST_EXP))
						g_TaxiDriverSkill[playerid] += 2;
					else
						g_TaxiDriverSkill[playerid] += 1;
					TaxiPark_SaveCompany(_park);
				}
				GivePlayerMoneyEx(playerid, driver_share, "TaxiPark", true, true);
				g_TaxiDayTrips[playerid]++;
				g_TaxiDayIncome[playerid] += driver_share;
				new msg[128];
				format(msg, sizeof msg, "{33FF33}| {ffffff}Вызов выполнен. Получено: %d руб (из %d)", driver_share, payment);
				ShowNotificationNew(playerid, 3, 5, 0, 0, "Вызов выполнен", "");
				SendClientMessage(playerid, -1, msg);
				TaxiPark_CancelOrder(playerid);
			}
		}
	}
	return 1;
}

stock TaxiPark_CancelOrder(playerid)
{
	if(GetPVarInt(playerid, TAXI_PARK_PVAR_ORDER_STAGE) == 0) return 1;
	new actorid = GetPVarInt(playerid, TAXI_PARK_PVAR_ACTOR);
	if(actorid != 0)
	{
		DestroyActor(actorid);
		SetPVarInt(playerid, TAXI_PARK_PVAR_ACTOR, 0);
	}
	DisablePlayerGPS(playerid);
	if(g_TaxiPark_ArriveTimer[playerid] != 0)
	{
		KillTimer(g_TaxiPark_ArriveTimer[playerid]);
		g_TaxiPark_ArriveTimer[playerid] = 0;
	}
	if(GetPVarInt(playerid, "TaxiOrderIsPlayer"))
	{
		new passenger = GetPVarInt(playerid, "TaxiOrderPassenger");
		if(IsPlayerConnected(passenger) && g_TaxiPlayerOrder[passenger][TPO_DRIVER] == playerid)
		{
			if(g_TaxiPlayerOrder[passenger][TPO_STATE] != TAXI_PLAYER_ORDER_NONE)
			{
				g_TaxiPlayerOrder[passenger][TPO_STATE] = TAXI_PLAYER_ORDER_WAITING;
				g_TaxiPlayerOrder[passenger][TPO_DRIVER] = INVALID_PLAYER_ID;
				SendClientMessage(passenger, -1, "{ff2400}| {ffffff}???????? ??????? ?????. ???? ???????...");
			}
		}
	}
	// Free shared delivery slot if any
	new slot = GetPVarInt(playerid, "TaxiSharedSlot");
	new park = TaxiPark_GetPlayerJob(playerid);
	if(slot >= 0 && slot < TAXI_SHARED_MAX && park != -1)
	{
		if(g_TaxiShared[park][slot][TS_TAKEN_BY] == playerid)
		{
			g_TaxiShared[park][slot][TS_ACTIVE] = 0;
			g_TaxiShared[park][slot][TS_TAKEN_BY] = INVALID_PLAYER_ID;
		}
	}
	SetPVarInt(playerid, "TaxiSharedSlot", -1);
	SetPVarInt(playerid, "TaxiOrderIsDelivery", 0);
	SetPVarInt(playerid, TAXI_PARK_PVAR_ORDER_STAGE, 0);
	SetPVarFloat(playerid, TAXI_PARK_PVAR_ORDER_DIST, 0.0);
	SetPVarInt(playerid, "TaxiOrderIsPlayer", 0);
	g_TaxiPark_SelectedOrder[playerid] = -1;
	return 1;
}

stock TaxiPark_CheckDay(playerid)
{
	new day, month, year;
	getdate(year, month, day);
	new stamp = year * 10000 + month * 100 + day;
	if(g_TaxiDayStamp[playerid] != stamp)
	{
		g_TaxiDayStamp[playerid] = stamp;
		g_TaxiDayTrips[playerid] = 0;
		g_TaxiDayIncome[playerid] = 0;
	}
	return 1;
}

stock ShowTaxiGUI(playerid, Float:rating, orders, cash, bool:is_open = true)
{
	#pragma unused orders, cash
	TaxiPark_CheckDay(playerid);

	new idx = g_TaxiDriverOrderIdx[playerid];
	new count = g_TaxiDriverOrderCount[playerid];

	new start_str[64], end_str[64], dist_str[32], time_str[32], type_str[16];
	new price = 0;
	format(start_str, sizeof start_str, "-");
	format(end_str, sizeof end_str, "-");
	format(dist_str, sizeof dist_str, "-");
	format(time_str, sizeof time_str, "-");
	format(type_str, sizeof type_str, "-");

	if(count > 0 && idx >= 0 && idx < count)
	{
		new Float: fx, Float: fy, Float: fz, Float: tx, Float: ty, Float: tz;
		if(g_TaxiDriverOrderType[playerid][idx] == 0)
		{
			// Delivery: OrderId = shared slot
			new slot = g_TaxiDriverOrderId[playerid][idx];
			new park_id = TaxiPark_GetPlayerJob(playerid);
			new npc = 0;
			if(park_id != -1 && slot >= 0 && slot < TAXI_SHARED_MAX)
				npc = g_TaxiShared[park_id][slot][TS_NPC];
			fx = g_TaxiParkNpcPos[npc][0];
			fy = g_TaxiParkNpcPos[npc][1];
			fz = g_TaxiParkNpcPos[npc][2];
			tx = g_TaxiDriverOrderToX[playerid][idx];
			ty = g_TaxiDriverOrderToY[playerid][idx];
			tz = g_TaxiDriverOrderToZ[playerid][idx];
			price = g_TaxiDriverOrderPrice[playerid][idx];
			if(price < 300)
			{
				new Float: trip0 = GetDistanceBetweenPoints(fx, fy, fz, tx, ty, tz);
				price = TaxiPark_CalcPrice(trip0, 0);
				g_TaxiDriverOrderPrice[playerid][idx] = price;
			}
			format(type_str, sizeof type_str, "Доставка");
		}
		else
		{
			new pass = g_TaxiDriverOrderId[playerid][idx];
			fx = g_TaxiPlayerOrder[pass][TPO_FROM_X];
			fy = g_TaxiPlayerOrder[pass][TPO_FROM_Y];
			fz = g_TaxiPlayerOrder[pass][TPO_FROM_Z];
			tx = g_TaxiPlayerOrder[pass][TPO_TO_X];
			ty = g_TaxiPlayerOrder[pass][TPO_TO_Y];
			tz = g_TaxiPlayerOrder[pass][TPO_TO_Z];
			price = g_TaxiPlayerOrder[pass][TPO_PRICE];
			format(type_str, sizeof type_str, "Игрок");
		}
		new Float: trip = GetDistanceBetweenPoints(fx, fy, fz, tx, ty, tz);
		new etime = floatround(trip / 850.0);
		if(etime < 1) etime = 1;

		TaxiPark_FormatCity(fx, fy, start_str, sizeof(start_str));
		TaxiPark_FormatCity(tx, ty, end_str, sizeof(end_str));
		format(dist_str, sizeof dist_str, "%.0f m", trip);
		format(time_str, sizeof time_str, "%d min", etime);
	}

	if(is_open)
	{
		new Node:hdr = JSON_Object();
		JSON_SetInt(hdr, "t", 1);
		JSON_SetFloat(hdr, "r", rating);
		JSON_SetInt(hdr, "n", g_TaxiDayTrips[playerid]);
		JSON_SetInt(hdr, "m", g_TaxiDayIncome[playerid]);
		JSON_SetInt(hdr, "o", 1);
		SendPacketToClient(playerid, 16, hdr);
		JSON_Cleanup(hdr);
	}

	new Node:order = JSON_Object();
	JSON_SetInt(order, "t", 1);
	JSON_SetString(order, "s", start_str);
	JSON_SetString(order, "e", end_str);
	JSON_SetString(order, "d", dist_str);
	JSON_SetString(order, "ti", time_str);
	JSON_SetInt(order, "m", price);
	JSON_SetString(order, "ty", type_str);
	JSON_SetString(order, "co", "");
	if(is_open)
		JSON_SetInt(order, "o", 0);
	SendPacketToClient(playerid, 16, order);
	JSON_Cleanup(order);
	return 1;
}


stock TaxiPark_IsParkOwned(park_id)
{
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	if(g_TaxiCompany[park_id][TC_OWNER_ID] <= 0) return 0;
	if(!strcmp(g_TaxiCompanyOwnerName[park_id], "Государство", true)) return 0;
	return 1;
}

stock TaxiPark_CalcPrice(Float:dist, rate = 0)
{
	// GTA units ~ meters. Price per 100m by class.
	new per100 = 100;
	if(rate == 1) per100 = 150;
	else if(rate == 2) per100 = 220;
	new meters = floatround(dist);
	if(meters < 200) meters = 200;
	new price = (meters * per100) / 100;
	if(price < 300) price = 300;
	if(price > 50000) price = 50000;
	return price;
}

stock TaxiPark_CalcPriceForPark(park_id, Float:dist, rate = 0)
{
	// Prices work for both private and state-owned parks (defaults: 300/500/750)
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) park_id = 0;
	new per = g_TaxiCompany[park_id][TC_PRICE_ECO];
	if(rate == 1) per = g_TaxiCompany[park_id][TC_PRICE_COM];
	else if(rate == 2) per = g_TaxiCompany[park_id][TC_PRICE_BIZ];
	if(per <= 0)
	{
		if(rate == 1) per = 500;
		else if(rate == 2) per = 750;
		else per = 300;
	}
	new segs = floatround(dist / 300.0);
	if(segs < 1) segs = 1;
	return per * segs;
}

// Drivers on shift who took a taxi car from this park
stock TaxiPark_CountDriversWithCar(park_id)
{
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT) return 0;
	new count = 0;
	for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(TaxiPark_GetPlayerJob(i) != park_id) continue;
		new vehid = GetPVarInt(i, TAXI_PARK_PVAR_VEHICLE);
		if(vehid != 0 && IsValidVehicle(vehid))
			count++;
	}
	return count;
}

stock TaxiPark_GetRankName(park_id, rank)
{
	static name[24];
	if(park_id < 0 || park_id >= TAXI_PARK_COUNT || rank < 0 || rank > 4)
	{
		format(name, sizeof name, "-");
		return name;
	}
	format(name, sizeof name, "%s", g_TaxiRankNames[park_id][rank]);
	return name;
}


stock TaxiPark_FillOrderPrices(Float:dist, &ye, &yc, &yb, &ce, &cc, &cb, &ge, &gc, &gb)
{
	ye = TaxiPark_CalcPriceForPark(0, dist, 0);
	yc = TaxiPark_CalcPriceForPark(0, dist, 1);
	yb = TaxiPark_CalcPriceForPark(0, dist, 2);
	ce = TaxiPark_CalcPriceForPark(1, dist, 0);
	cc = TaxiPark_CalcPriceForPark(1, dist, 1);
	cb = TaxiPark_CalcPriceForPark(1, dist, 2);
	ge = TaxiPark_CalcPriceForPark(2, dist, 0);
	gc = TaxiPark_CalcPriceForPark(2, dist, 1);
	gb = TaxiPark_CalcPriceForPark(2, dist, 2);
}

stock TaxiPark_FormatCity(Float:x, Float:y, dest[], size = sizeof(dest))
{
	new city[MAX_ZONES_NAME + 1];
	if(GetCityName(x, y, city, sizeof(city)) != -1 && city[0])
	{
		format(dest, size, "%s", city);
		return 1;
	}
	format(dest, size, "Неизвестно");
	return 0;
}

stock ShowTaxiOrderGUI(playerid, placeName[], Float:x, Float:y, fastestIndex, demandedIndex,
	moneyCash, moneyCard,
	priceYandexEconomy, priceYandexComfort, priceYandexBusiness,
	priceCityMobileEconomy, priceCityMobileComfort, priceCityMobileBusiness,
	priceGettEconomy, priceGettComfort, priceGettBusiness,
	bool:is_open = true)
{
	new Node:json = JSON_Object();

	new plbuf[64];
	format(plbuf, sizeof plbuf, "%s", placeName);

	JSON_SetString(json, "pl", plbuf, sizeof(plbuf));
	JSON_SetFloat(json, "x", x);
	JSON_SetFloat(json, "y", y);
	JSON_SetInt(json, "f", fastestIndex);
	JSON_SetInt(json, "s", demandedIndex);
	JSON_SetInt(json, "m", moneyCash);
	JSON_SetInt(json, "ca", moneyCard);

	new Node:prices = JSON_Array(
		JSON_Int(priceYandexEconomy),     JSON_Int(priceYandexComfort),     JSON_Int(priceYandexBusiness),
		JSON_Int(priceCityMobileEconomy), JSON_Int(priceCityMobileComfort), JSON_Int(priceCityMobileBusiness),
		JSON_Int(priceGettEconomy),       JSON_Int(priceGettComfort),       JSON_Int(priceGettBusiness)
	);
	JSON_SetArray(json, "p", prices);

	if(is_open)
		JSON_SetInt(json, "o", 1);
	else
		JSON_SetInt(json, "t", 2);

	new dbg[512];
	JSON_Stringify(json, dbg, sizeof(dbg));
	if(is_open)
		printf("[TAXI GUI -> CLIENT OPEN] pid=%d json=%s", playerid, dbg);
	else
		printf("[TAXI GUI -> CLIENT UPD] pid=%d json=%s", playerid, dbg);

	SendPacketToClient(playerid, TAXI_PARK_ORDER_GUI_ID, json);
	JSON_Cleanup(json);
	return 1;
}

stock CloseTaxiOrderGUI(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new Node:json = JSON_Object();
	JSON_SetInt(json, "o", 0);
	JSON_SetInt(json, "t", 0);
	new dbg[128];
	JSON_Stringify(json, dbg, sizeof(dbg));
	printf("[TAXI GUI -> CLIENT CLOSE] pid=%d json=%s", playerid, dbg);
	SendPacketToClient(playerid, TAXI_PARK_ORDER_GUI_ID, json);
	JSON_Cleanup(json);
	return 1;
}

stock TaxiPark_UpdateTaxiOrderDriverFound(playerid, driverid)
{
	if(!IsPlayerConnected(playerid) || !IsPlayerConnected(driverid)) return 0;

	new dname[24];
	GetPlayerName(driverid, dname, sizeof dname);

	new veh_name[64];
	format(veh_name, sizeof veh_name, "Такси");
	new vehicleid = GetPVarInt(driverid, TAXI_PARK_PVAR_VEHICLE);
	if(vehicleid != 0 && IsValidVehicle(vehicleid))
	{
		new model = GetVehicleModel(vehicleid);
		GetVehicleModelName(model, veh_name, sizeof veh_name);
		if(!veh_name[0])
			format(veh_name, sizeof veh_name, "Авто #%d", model);
	}

	new phone[8];
	format(phone, sizeof phone, "-");

	// Official CEF protocol: t=0, n=name, nu=phone, a=car
	new Node:json = JSON_Object();
	JSON_SetInt(json, "t", 0);
	JSON_SetString(json, "n", dname, sizeof dname);
	JSON_SetString(json, "nu", phone, sizeof phone);
	JSON_SetString(json, "a", veh_name, sizeof veh_name);

	new dbg[256];
	JSON_Stringify(json, dbg, sizeof(dbg));
	printf("[TAXI GUI -> DRIVER FOUND] pid=%d json=%s", playerid, dbg);

	SendPacketToClient(playerid, TAXI_PARK_ORDER_GUI_ID, json);
	JSON_Cleanup(json);
	return 1;
}

stock TaxiPark_SendFoundState(playerid, driverid)
{
	if(!IsPlayerConnected(playerid) || !IsPlayerConnected(driverid)) return 0;

	new dname[24];
	GetPlayerName(driverid, dname, sizeof dname);

	new veh_name[64];
	format(veh_name, sizeof veh_name, "Такси");
	new vehicleid = GetPVarInt(driverid, TAXI_PARK_PVAR_VEHICLE);
	if(vehicleid != 0 && IsValidVehicle(vehicleid))
	{
		new model = GetVehicleModel(vehicleid);
		GetVehicleModelName(model, veh_name, sizeof veh_name);
		if(!veh_name[0])
			format(veh_name, sizeof veh_name, "Авто #%d", model);
	}

	new phone[8];
	format(phone, sizeof phone, "-");

	new Float: tx = g_TaxiPlayerOrder[playerid][TPO_TO_X];
	new Float: ty = g_TaxiPlayerOrder[playerid][TPO_TO_Y];
	new Float: px, Float: py, Float: pz;
	GetPlayerPos(playerid, px, py, pz);
	new placeName[64];
	TaxiPark_FormatCity(px, py, placeName, sizeof placeName);
	new Float: dist = GetDistanceBetweenPoints(px, py, pz, tx, ty, g_TaxiPlayerOrder[playerid][TPO_TO_Z]);
	new ye, yc, yb, ce, cc, cb, ge, gc, gb;
	TaxiPark_FillOrderPrices(dist, ye, yc, yb, ce, cc, cb, ge, gc, gb);

	new Node:json = JSON_Object();
	// o=2 hypothesized "found car" view (o=1 open, o=0 close)
	JSON_SetInt(json, "o", 2);
	JSON_SetInt(json, "t", 2);

	new plbuf[64];
	format(plbuf, sizeof plbuf, "%s", placeName);
	JSON_SetString(json, "pl", plbuf, sizeof plbuf);
	JSON_SetFloat(json, "x", tx);
	JSON_SetFloat(json, "y", ty);
	JSON_SetInt(json, "f", 0);
	JSON_SetInt(json, "s", 1);
	JSON_SetInt(json, "m", GetPlayerMoney(playerid));
	JSON_SetInt(json, "ca", GetPlayerMoney(playerid));
	new Node:prices = JSON_Array(
		JSON_Int(ye), JSON_Int(yc), JSON_Int(yb),
		JSON_Int(ce), JSON_Int(cc), JSON_Int(cb),
		JSON_Int(ge), JSON_Int(gc), JSON_Int(gb)
	);
	JSON_SetArray(json, "p", prices);

	JSON_SetString(json, "n", dname, sizeof dname);
	JSON_SetString(json, "name", dname, sizeof dname);
	JSON_SetString(json, "dn", dname, sizeof dname);
	JSON_SetString(json, "nm", dname, sizeof dname);
	JSON_SetString(json, "tn", dname, sizeof dname);
	JSON_SetString(json, "driverName", dname, sizeof dname);

	JSON_SetString(json, "ph", phone, sizeof phone);
	JSON_SetString(json, "num", phone, sizeof phone);
	JSON_SetString(json, "phone", phone, sizeof phone);
	JSON_SetString(json, "number", phone, sizeof phone);
	JSON_SetString(json, "tp", phone, sizeof phone);

	JSON_SetString(json, "car", veh_name, sizeof veh_name);
	JSON_SetString(json, "auto", veh_name, sizeof veh_name);
	JSON_SetString(json, "vn", veh_name, sizeof veh_name);
	JSON_SetString(json, "tc", veh_name, sizeof veh_name);
	JSON_SetString(json, "vehicle", veh_name, sizeof veh_name);
	JSON_SetString(json, "vehicleName", veh_name, sizeof veh_name);

	new Node:info = JSON_Array(JSON_String(dname), JSON_String(phone), JSON_String(veh_name));
	JSON_SetArray(json, "info", info);

	if(vehicleid != 0) JSON_SetInt(json, "vid", vehicleid);
	new company = g_TaxiPlayerOrder[playerid][TPO_COMPANY];
	if(company < 0) company = 0;
	JSON_SetInt(json, "c", company);

	new dbg[900];
	JSON_Stringify(json, dbg, sizeof(dbg));
	printf("[TAXI GUI -> FOUND STATE o=2 t=2] %s", dbg);
	SendPacketToClient(playerid, TAXI_PARK_ORDER_GUI_ID, json);
	JSON_Cleanup(json);
	return 1;
}

forward TaxiPark_FillFoundGUI(playerid, driverid);
public TaxiPark_FillFoundGUI(playerid, driverid)
{
	return TaxiPark_UpdateTaxiOrderDriverFound(playerid, driverid);
}

stock TaxiPark_BuildDriverOrders(playerid)
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	new count = 0;
	// Shared delivery orders of this park (all classes)
	if(park_id != -1)
	{
		for(new s = 0; s < TAXI_SHARED_MAX && count < 10; s++)
		{
			if(g_TaxiShared[park_id][s][TS_ACTIVE] != 1) continue;
			g_TaxiDriverOrderType[playerid][count] = 0; // delivery
			g_TaxiDriverOrderId[playerid][count] = s; // shared slot id
			g_TaxiDriverOrderToX[playerid][count] = g_TaxiShared[park_id][s][TS_TO_X];
			g_TaxiDriverOrderToY[playerid][count] = g_TaxiShared[park_id][s][TS_TO_Y];
			g_TaxiDriverOrderToZ[playerid][count] = g_TaxiShared[park_id][s][TS_TO_Z];
			g_TaxiDriverOrderPrice[playerid][count] = g_TaxiShared[park_id][s][TS_PRICE];
			count++;
		}
	}
	if(park_id != -1)
	{
		for(new i = 0, j = GetPlayerPoolSize(); i <= j && count < 10; i++)
		{
			if(!IsPlayerConnected(i)) continue;
			if(g_TaxiPlayerOrder[i][TPO_STATE] != TAXI_PLAYER_ORDER_WAITING) continue;
			if(g_TaxiPlayerOrder[i][TPO_COMPANY] != park_id) continue;
			// Class matching: order rate must match driver's car class
			new order_rate = g_TaxiPlayerOrder[i][TPO_RATE];
			if(order_rate < 0) order_rate = 0;
			if(order_rate > 2) order_rate = 2;
			if(g_TaxiDriverCarClass[playerid] != order_rate) continue;
			g_TaxiDriverOrderType[playerid][count] = 1;
			g_TaxiDriverOrderId[playerid][count] = i;
			g_TaxiDriverOrderToX[playerid][count] = g_TaxiPlayerOrder[i][TPO_TO_X];
			g_TaxiDriverOrderToY[playerid][count] = g_TaxiPlayerOrder[i][TPO_TO_Y];
			g_TaxiDriverOrderToZ[playerid][count] = g_TaxiPlayerOrder[i][TPO_TO_Z];
			g_TaxiDriverOrderPrice[playerid][count] = g_TaxiPlayerOrder[i][TPO_PRICE];
			count++;
		}
	}
	g_TaxiDriverOrderCount[playerid] = count;
	if(count <= 0) g_TaxiDriverOrderIdx[playerid] = 0;
	else if(g_TaxiDriverOrderIdx[playerid] >= count) g_TaxiDriverOrderIdx[playerid] = count - 1;
	else if(g_TaxiDriverOrderIdx[playerid] < 0) g_TaxiDriverOrderIdx[playerid] = 0;
	return count;
}

cmd:tord(playerid, params[])
{
	new park_id = TaxiPark_GetPlayerJob(playerid);
	if(park_id == -1)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы не устроены ни в одном таксопарке");
		return 1;
	}
	if(GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE) == 0)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Сначала возьмите машину в автопарке");
		return 1;
	}
	TaxiPark_BuildDriverOrders(playerid);
	if(g_TaxiDriverOrderCount[playerid] <= 0)
	{
		ShowNotificationNew(playerid, 2, 5, 0, 0, "На данный момент заказов нету", "");
		return 1;
	}
	g_TaxiDriverOrderIdx[playerid] = 0;
	ShowTaxiGUI(playerid, 0.11, g_TaxiDriverOrderCount[playerid], g_TaxiDayIncome[playerid]);
	return 1;
}

cmd:taxi(playerid, params[])
{
	#pragma unused params
	if(TaxiPark_GetPlayerJob(playerid) != -1 && GetPVarInt(playerid, TAXI_PARK_PVAR_VEHICLE) != 0)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы на смене водителя. Используйте /tord");
		return 1;
	}
	if(g_TaxiPlayerOrder[playerid][TPO_STATE] != TAXI_PLAYER_ORDER_NONE)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}У вас уже есть активный заказ такси");
		return 1;
	}

	
	g_TaxiPendingDest[playerid] = 0;

	new Float:px, Float:py, Float:pz;
	GetPlayerPos(playerid, px, py, pz);
	g_TaxiPendingToX[playerid] = 0.0;
	g_TaxiPendingToY[playerid] = 0.0;
	g_TaxiPendingToZ[playerid] = 0.0;
	g_TaxiDestSelected[playerid] = false;
	g_TaxiPendingPrice[playerid] = 300;

	new priceYE, priceYC, priceYB, priceCE, priceCC, priceCB, priceGE, priceGC, priceGB;
	TaxiPark_FillOrderPrices(300.0, priceYE, priceYC, priceYB, priceCE, priceCC, priceCB, priceGE, priceGC, priceGB);

	new placeName[64];
	TaxiPark_FormatCity(px, py, placeName, sizeof(placeName));

	ShowTaxiOrderGUI(playerid,
		placeName,
		px, py,
		0, 1,
		GetPlayerMoney(playerid),
		GetPlayerMoney(playerid),
		priceYE, priceYC, priceYB,
		priceCE, priceCC, priceCB,
		priceGE, priceGC, priceGB);
	return 1;
}

stock TaxiPark_OpenDestDialog(playerid)
{
	if(g_TaxiPlayerOrder[playerid][TPO_STATE] != TAXI_PLAYER_ORDER_NONE)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}У вас уже есть активный заказ такси");
		return 1;
	}

	new list[768];
	format(list, sizeof list,
		"1. Важные места\n"\
		"2. Работы для новичков\n"\
		"3. Основные работы\n"\
		"4. Государственные организации\n"\
		"5. Преступные группировки\n"\
		"6. Таксопарки\n"\
		"7. Развлечения\n"\
		"8. Банки\n"\
		"9. Причалы\n"\
		"10. Автосалоны\n"\
		"11. СТО и тюнинг-ателье\n"\
		"12. Города и населенные пункты\n"\
		"13. Вокзалы\n"\
		"14. Поиск ближайших мест"
	);

	Dialog_Open(playerid, "TaxiPark_DestMainResponse", DIALOG_STYLE_LIST,
		"Workk RP | Выбор места поездки",
		list, "Выбрать", "Закрыть");
	return 1;
}

stock TaxiPark_ApplyDestCoords(playerid, Float:tx, Float:ty, Float:tz)
{
	if(g_TaxiPlayerOrder[playerid][TPO_STATE] != TAXI_PLAYER_ORDER_NONE)
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}У вас уже есть активный заказ такси");
		return 1;
	}

	g_TaxiPendingToX[playerid] = tx;
	g_TaxiPendingToY[playerid] = ty;
	g_TaxiPendingToZ[playerid] = tz;
	g_TaxiPendingDest[playerid] = 0;
	g_TaxiDestSelected[playerid] = true;

	new Float:px, Float:py, Float:pz;
	GetPlayerPos(playerid, px, py, pz);

	new Float:dist = GetDistanceBetweenPoints(px, py, pz, tx, ty, tz);
	new priceYE, priceYC, priceYB, priceCE, priceCC, priceCB, priceGE, priceGC, priceGB;
	TaxiPark_FillOrderPrices(dist, priceYE, priceYC, priceYB, priceCE, priceCC, priceCB, priceGE, priceGC, priceGB);
	g_TaxiPendingPrice[playerid] = priceYE;

	new placeName[64];
	TaxiPark_FormatCity(px, py, placeName, sizeof(placeName));

	ShowTaxiOrderGUI(playerid, placeName,
		tx, ty,
		0, 1,
		GetPlayerMoney(playerid), GetPlayerMoney(playerid),
		priceYE, priceYC, priceYB,
		priceCE, priceCC, priceCB,
		priceGE, priceGC, priceGB,
		false);

	return 1;
}

Dialog_Response:TaxiPark_DestMainResponse(playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(listitem < 0 || listitem > 13) return 1;

	new title[64];
	format(title, sizeof title, "Workk RP | Выбор места поездки");

	switch(listitem + 1)
	{
		case 1:
		{
			Dialog_Open(playerid, "TaxiPark_DestPublicResponse", DIALOG_STYLE_LIST, title,
				"1. Правительство\n2. Автошкола\n3. Военкомат\n4. Городская больница г.Арзамас",
				"Выбрать", "Назад");
		}
		case 2:
		{
			Dialog_Open(playerid, "TP_DestNewbie", DIALOG_STYLE_LIST, title,
				"1. Шахта\n2. Грузчик\n3. Завод",
				"Выбрать", "Назад");
		}
		case 3:
		{
