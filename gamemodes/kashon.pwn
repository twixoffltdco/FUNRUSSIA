   }

    if(newkeys == KEY_CROUCH)
    {
        if((IsPlayerInRangeOfPoint(playerid, 2.5, pos_tuning [ 0 ] [ 0 ], pos_tuning [ 0 ] [ 1 ], pos_tuning [ 0 ] [ 2 ])
		|| IsPlayerInRangeOfPoint(playerid, 2.5, pos_tuning [ 1 ] [ 0 ], pos_tuning [ 1 ] [ 1 ], pos_tuning [ 1 ] [ 2 ])
		|| IsPlayerInRangeOfPoint(playerid, 2.5, pos_tuning [ 2 ] [ 0 ], pos_tuning [ 2 ] [ 1 ], pos_tuning [ 2 ] [ 2 ])
		|| IsPlayerInRangeOfPoint(playerid, 2.5, pos_tuning [ 3 ] [ 0 ], pos_tuning [ 3 ] [ 1 ], pos_tuning [ 3 ] [ 2 ])) && GetPlayerState(playerid) == 2)
		{
		    if(!IsPlayerInVehicle(playerid, GetPlayerOwnableCar(playerid))) return SendClientMessage(playerid, -1, ""USC"Вы должны быть за рулем своего автомобиля");
            if((GetVehicleModel(GetPlayerVehicleID(playerid)) == 448) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 461) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 462) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 463) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 468) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 521) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 522) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 523) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 581) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 586) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 640) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 741) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 754) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 28659) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 28727) || (GetVehicleModel(GetPlayerVehicleID(playerid)) == 28703)) return SendClientMessage(playerid, -1, "Мотоциклам въезд в этот центр запрещен.");

			SetCameraBehindPlayer(playerid);

            ShowTuneShowPlayerDialog(playerid);

			return true;
		}
		}

	if(PRESSED(KEY_NO))
		callcmd::no(playerid, "");

	if(PRESSED(KEY_YES))
		callcmd::yes(playerid, "");

	if(IsPlayerInAnyVehicle(playerid))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{

			if(GetPlayerSettingData(playerid, S_VEH_CONTROL) == SETTING_TYPE_ON)
			{
				if(PRESSED(KEY_HANDBRAKE | KEY_FIRE))
				{
					if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
					{
						callcmd::lock(playerid, "1");
					}
				}
				if(PRESSED(KEY_ACTION))
				{
				}
				if(PRESSED(KEY_FIRE))
				{

				}
				if(PRESSED(KEY_ANALOG_UP))
				{
					callcmd::b(playerid, "");
				}
				if(PRESSED(KEY_ANALOG_DOWN))
				{
					callcmd::i(playerid, "");
				}
				if(PRESSED(KEY_ANALOG_LEFT))
				{
					callcmd::sl(playerid, "");
				}
				if(PRESSED(KEY_ANALOG_RIGHT))
				{
					callcmd::alarm(playerid, "");
				}
			}

			if(PRESSED(KEY_SUBMISSION))
			{
				if(!IsPlayerInVehicle(playerid, GetPlayerOwnableCar(playerid)))
				{
					new job_car = GetPlayerJobCar(playerid);
					if(IsPlayerInVehicle(playerid, job_car))
					{
						new action_type = GetVehicleData(job_car, V_ACTION_TYPE);
						new car_type = (action_type - VEHICLE_ACTION_TYPE_BUS_DRIVER) + 1;

						new job_id = GetPlayerJob(playerid);
						if(job_id == car_type)
						{
							switch(job_id)
							{
								case JOB_BUS_DRIVER:
								{
									if(IsPlayerInJob(playerid))
									{
										Dialog
										(
											playerid, DIALOG_END_JOB, DIALOG_STYLE_MSGBOX,
											"{FFCD00}Диспетчер автопарка",
											"{FFFFFF}Вы уверены что хотите завершить рабочий день?",
											"Да", "Нет"
										);
									}
					else
									{
										Dialog
										(
											playerid, DIALOG_BUS_ROUTE_COST, DIALOG_STYLE_INPUT,
											"{FFCD00}Стоимость проезда",
											"{FFFFFF}Сколько будет стоить проезд?\n"\
											"Укажите цену от 0 до 100 рублей",
											"Далее", "Отмена"
										);
									}
								}
								case 6:
								{
									if(IsPlayerInJob(playerid))
									{
										Dialog
										(
											playerid, DIALOG_END_JOB, DIALOG_STYLE_MSGBOX,
											"{FFCD00}Диспетчер таксопарка",
											"{FFFFFF}Вы уверены что хотите завершить рабочий день?",
											"Да", "Нет"
										);
									}
					else
									{
										Dialog
										(
											playerid, DIALOG_TAXI_NAME, DIALOG_STYLE_INPUT,
											"{FFCD00}Название такси",
											"{FFFFFF}Придумайте название для вашего такси\n"\
											"Максимальная длина 15 символов\n\n"\
											"Если вы не хотите как-то называться\n"\
											"нажмите кнопку \"Пропустить\"",
											"Далее", "Пропустить"
										);
									}
								}
								case JOB_UNUSED_3:
								{
									if(IsPlayerInJob(playerid))
									{
										Dialog
										(
											playerid, DIALOG_END_JOB, DIALOG_STYLE_MSGBOX,
											"{FFCD00}Автомеханик",
											"{FFFFFF}Вы уверены что хотите завершить рабочий день?",
											"Да", "Нет"
										);
									}
					else
									{
										Dialog
										(
											playerid, DIALOG_UNUSED_LEGACY_7, DIALOG_STYLE_MSGBOX,
											"{FFCD00}Диспетчер",
											"{FFFFFF}Вы хотите начать работу автомеханика?",
											"Да", "Нет"
										);
									}
								}
								case JOB_TRUCKER:
								{
									if(IsPlayerInJob(playerid))
									{
										Dialog
										(
											playerid, DIALOG_END_JOB, DIALOG_STYLE_MSGBOX,
											"{FFCD00}Диспетчер автопарка",
											"{FFFFFF}Вы уверены что хотите завершить рабочий день?",
											"Да", "Нет"
										);
									}
					else
									{
										Dialog
										(
											playerid, DIALOG_TRUCKER_START_JOB, DIALOG_STYLE_MSGBOX,
											"{FFCD00}Дальнобойщик",
											"{FFFFFF}Вы хотите начать работу дальнобойщика?",
											"Да", "Нет"
										);
									}
								}
							}
						}
					}
				}
					else callcmd::car(playerid, "");
			}
			if(HOLDING(KEY_CROUCH))
			{
				CallLocalFunction("CheckNearestGate", "i", playerid);
			}
			if(newkeys == KEY_CROUCH)
			{
				if(IsPlayerInRangeOfPoint(playerid,  10.0, -0.2940,2006.1187,1554.2031) && GetPlayerInHouse(playerid) == GetPlayerHouse(playerid) && GetPlayerState(playerid) == 2)
		        {
		        	new houseid = GetPlayerHouse(playerid);
		            SetVehiclePos
		            (
		                GetPlayerOwnableCar(playerid),
		                GetHouseData(houseid, H_CAR_POS_X),
		                GetHouseData(houseid, H_CAR_POS_Y),
		                GetHouseData(houseid, H_CAR_POS_Z)
		            );
		            SetVehicleZAngle(GetPlayerOwnableCar(playerid), GetHouseData(houseid, H_CAR_ANGLE));
		            SetCameraBehindPlayer(playerid);
		            LinkVehicleToInterior(GetPlayerOwnableCar(playerid),0);
		            SetPlayerInterior(playerid,0);
		            SetPlayerVirtualWorld(playerid,0);
		            SetVehicleVirtualWorld(GetPlayerOwnableCar(playerid), 0);
		            return true;
		        }
			}
		}
	}
					else
	{
		if(PRESSED(KEY_FIRE))
		{
			if(GetPlayerData(playerid, P_SNACK))
			{
				SetPlayerData(playerid, P_SNACK, false);

				SetPlayerHealthEx(playerid, 25.0, true);
				GameTextForPlayer(playerid, "~g~~h~+25 hp", 2500, 6);

				ApplyAnimationEx(playerid, "FOOD", "EAT_Chicken", 4.0, 0, 0, 0, 0, 0, 0);

			}
			if(GetPlayerData(playerid, P_DRINK_STEP) >= 1)
			{
				AddPlayerData(playerid, P_DRINK_STEP, -, 1);
				if(!GetPlayerData(playerid, P_DRINK_STEP))
				{
					SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
				}
			}
		}

		if(PRESSED(KEY_WALK))
		{
			if(GetPlayerInHouse(playerid) != -1)
			{
				new houseid = GetPlayerInHouse(playerid);
				if(GetHouseData(houseid, H_IMPROVEMENTS) > 5)
				{
					Dialog
					(
						playerid, DIALOG_ACTION_EXIT_HOUSE, DIALOG_STYLE_LIST,
						"{FFCC00}Выход",
						"1. Улица\n\
						2. Гараж",
						"Далее", "Закрыть"
					);
					return 1;
				}
					else
					ExitPlayerFromHouse(playerid, 3.0);
			}
					else if(GetPlayerData(playerid, P_IN_HOTEL_ROOM) != -1)
			{
				ExitPlayerFromHotelRoom(playerid);
			}

			if(IsPlayerInRangeOfPoint(playerid, 2.0, -109.4100,968.7141,12.3526))
			{
  				ShowPlayerQuestMenu(playerid);
			}
			if(IsPlayerInRangeOfPoint(playerid, 2.0, 1802.2566,2513.8135,15.8725))
			{
  				ShowPlayerQuestMenu(playerid);
			}

			if(IsPlayerInRangeOfPoint(playerid, 3.0, 609.434875,1729.022583,12.078809))
			{
				Dialog
				(
					playerid, DIALOG_CONTENER1, DIALOG_STYLE_MSGBOX,
					"{FFCD00}Может выпасть:",
					"- Аптечки\n"\
					"- Ремонтные комлекты\n"\
					"- Аксессуар на спину\n"\
					"- Пачка денег\n"\
					"- Сертификат на опыт\n"\
					"- Любое оружие",
					"Выбрать", "Закрыть"
				);

			}
			if(IsPlayerInRangeOfPoint(playerid, 3.0, 617.468688,1729.151977,12.078809))
			{
				Dialog
				(
					playerid, DIALOG_CONTENER2, DIALOG_STYLE_MSGBOX,
					"{FFCD00}Может выпасть:",
					"- Одежда работника ДПС\n"\
					"- Одежда генирала армии\n"\
					"- Одежда снегурочки\n"\
					"- Одежда 'Илья'\n"\
					"- Одежда генирала ФСБ\n"\
					"- Одежда работника медицинской службы",
					"Понятно", "Закрыть"
				);

			}
			if(GetNearestMedBed(playerid, 1.8) != -1)
			{
				MedBed_TryOccupy(playerid);
			}

			if(GetPlayerInHouse(playerid) != -1)
			{
				new houseid = GetPlayerInHouse(playerid);
				if(GetHouseData(houseid, H_IMPROVEMENTS) >= 1)
				{
					ExitPlayerFromHouse(playerid, 1.1);
				}
			}

			if(GetPlayerData(playerid, P_IN_HOTEL_ROOM) != -1)
			{
				ExitPlayerFromHotelRoom(playerid);
			}
		}
		if(PRESSED(KEY_HANDBRAKE | KEY_WALK))
		{
			new targetid = GetPlayerTargetPlayer(playerid);

			if(targetid != INVALID_PLAYER_ID && !GetPlayerWeapon(playerid))
			{
				SetPlayerData(playerid, P_TARGET_ID, targetid);

				new fmt_str[64];
				format(fmt_str, sizeof fmt_str, "{FFCD00}Действия (%s)", GetPlayerNameEx(targetid));

				Dialog
				(
					playerid, DIALOG_ACTION, DIALOG_STYLE_LIST,
					fmt_str,
					"1. Приветствие\n\
					2. Показать паспорт\n\
					3. Показать лицензии\n\
					4. Показать навыки",
					"Выбрать", "Закрыть"
				);
			}
		}
		if(PRESSED(KEY_HANDBRAKE))
		{
			if(GetPVarInt(playerid, "have_jerrican") == 1 && GetPlayerSpeed(playerid) == 0.0)
			{
				new vehicleid = GetNearestVehicleID(playerid, 2.3);
				if(vehicleid != INVALID_VEHICLE_ID)
				{
					SetPVarInt(playerid, "jerrican_fill_car", vehicleid);

					Dialog
					(
						playerid, DIALOG_JERRICAN_FILL_CAR, DIALOG_STYLE_MSGBOX,
						"{6699FF}Канистра",
						"{FFFFFF}Вы хотите заправить этот транспорт с канистры?",
						"Да", "Нет"
					);
				}
			}
		}
		if(PRESSED(KEY_CTRL_BACK | KEY_HANDBRAKE))
		{
			if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
			{
				callcmd::car(playerid, "");
			}
		}
					else if(PRESSED(KEY_CTRL_BACK))
		{
			callcmd::trunk(playerid, "");
		}
	}
	return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
	return 1;
}

stock MultiplyVehicleMoveSpeed(vehicleid, Float:multiplier)
{
    new Float:vx, vy, vz;
    GetVehicleVelocity(vehicleid, vx, vy, vz);

    new Float:rotation;
    GetVehicleZAngle(vehicleid, rotation);

    new Float:add = 0.002;

    new Int:angle = floatround(rotation);
    new Int:sinval = floatsin(angle);
    new Int:cosval = floatcos(angle);

    new Float:sx = sinval / 32768.0;
    new Float:sy = cosval / 32768.0;

    if (sx < 0.0) vx += add;
    else          vx -= add;

    if (sy < 0.0) vy += add;
    else          vy -= add;

    SetVehicleVelocity(vehicleid, vx, vy, vz);
}
stock MultiplyVehicleMoveSpeeds(vehicleid, Float:multiplier)
{
    new Float:vx, vy, vz;
    GetVehicleVelocity(vehicleid, vx, vy, vz);

    new Float:rotation;
    GetVehicleZAngle(vehicleid, rotation);

    new Float:add = 0.002;

    new Int:angle = floatround(rotation);
    new Int:sinval = floatsin(angle);
    new Int:cosval = floatcos(angle);

    new Float:sx = sinval / 32768.0;
    new Float:sy = cosval / 32768.0;

    if (sx < 0.0) vx += add;
    else          vx -= add;

    if (sy < 0.0) vy += add;
    else          vy -= add;

    SetVehicleVelocity(vehicleid, 1000, 1000, vz);
}

#define FSTATE_NONE        0
#define FSTATE_DRIFT       1
#define FSTATE_COMFORT     2
#define FSTATE_SPORT       3
#define FSTATE_SPORT_PLUS  4

#define TC_FW_SPEED_COMFORT    (1.04)
#define TC_FW_SPEED_DRIFT      (1.08)
#define TC_FW_SPEED_SPORT      (1.14)
#define TC_FW_SPEED_SPORT_PLUS (1.22)

stock Float:TechCenter_GetFirmwareSpeedMultiplier(firmware_state)
{
    switch(firmware_state)
    {
        case FSTATE_DRIFT:      return TC_FW_SPEED_DRIFT;
        case FSTATE_COMFORT:    return TC_FW_SPEED_COMFORT;
        case FSTATE_SPORT:      return TC_FW_SPEED_SPORT;
        case FSTATE_SPORT_PLUS: return TC_FW_SPEED_SPORT_PLUS;
    }
    return 1.0;
}

stock Float:TechCenter_GetFirmwareAccelerationPercent(firmware_state)
{
    switch(firmware_state)
    {
        case FSTATE_COMFORT:    return 6.0;
        case FSTATE_DRIFT:      return 10.0;
        case FSTATE_SPORT:      return 3.5; // was 6.0
        case FSTATE_SPORT_PLUS: return 4.5; // was 9.0 - insane accel, toned down to ~1.5x stock
    }
    return 0.0;
}

stock Float:TechCenter_GetEngineSpeedBonus(index)
{
    if(index < 0 || index >= MAX_OWNABLE_CARS) return 0.0;

    new level = GetOwnableCarData(index, OC_PT_ENGINE);
    if(level < 0) level = 0;
    if(level > 5) level = 5;

    new Float:bonus = 0.0;
    for(new n = 0; n < level; n++)
        bonus += engine_ptune_boost[n];

    new turbo_level = GetOwnableCarData(index, OC_PT_TURBO);
    if(turbo_level < 0) turbo_level = 0;
    if(turbo_level > 5) turbo_level = 5;
    bonus += float(turbo_level) * 0.08;

    new super_level = GetOwnableCarData(index, OC_SUPERCHARGER);
    if(super_level < 0) super_level = 0;
    if(super_level > 5) super_level = 5;
    bonus += float(super_level) * 0.09;
    return bonus;
}

stock TechCenter_ApplyPerformance(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid) || !IsAOwnableCar(vehicleid)) return 0;

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index < 0 || index >= MAX_OWNABLE_CARS) return 0;

    new bool:is_donate_owned = (GetOwnableCarData(index, OC_ISCASE) == 2);

    new firmware_state = GetOwnableCarData(index, OC_FSTATE);
    if(firmware_state < FSTATE_NONE || firmware_state > FSTATE_SPORT_PLUS)
        firmware_state = vInfo[index][vFstate];
    if(is_donate_owned)
        firmware_state = FSTATE_NONE;

    vInfo[index][vFstate] = firmware_state;
    vInfo[vehicleid][vFstate] = firmware_state;

    foreach(new streamed_player: Player)
    {
        if(!IsVehicleStreamedIn(vehicleid, streamed_player) && GetPlayerVehicleID(streamed_player) != vehicleid)
            continue;

        switch(firmware_state)
        {
            case FSTATE_DRIFT:
            {
                SetVehicleDriftForPlayer(streamed_player, vehicleid, 1);
            }
            case FSTATE_COMFORT:
            {
                SetVehicleDriftForPlayer(streamed_player, vehicleid, 0);
                SendCarFirmware(streamed_player, FSTATE_COMFORT);
            }
            case FSTATE_SPORT:
            {
                SetVehicleDriftForPlayer(streamed_player, vehicleid, 0);
                SendCarFirmware(streamed_player, FSTATE_SPORT);

                // Firmware changes acceleration only.
                // Uses the same acceleration RPC as the vehicle acceleration code.
                SetVehicleAccelerationForPlayer(streamed_player, vehicleid, 7.0);
            }
            case FSTATE_SPORT_PLUS:
            {
                SetVehicleDriftForPlayer(streamed_player, vehicleid, 0);
                SendCarFirmware(streamed_player, FSTATE_SPORT_PLUS);

                // Firmware changes acceleration only.
                // Sport+ = acceleration 9.0, without changing vehicle speed/physics.
                SetVehicleAccelerationForPlayer(streamed_player, vehicleid, 9.0);
            }
            default:
            {
                SetVehicleDriftForPlayer(streamed_player, vehicleid, 0);
            }
        }
    }

    printf("[TECHCENTER][FIRMWARE] vehicle=%d car=%d state=%d",
        vehicleid, index, firmware_state);

    return 1;
}

stock TuningStream_ReconcilePlayer(playerid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 0;

    foreach(new vehicleid : Vehicle)
    {
        new action_type = GetVehicleData(vehicleid, V_ACTION_TYPE);
        if(action_type != VEHICLE_ACTION_TYPE_OWNABLE_CAR && action_type != VEHICLE_ACTION_TYPE_FAMILY_CAR)
            continue;

        new bool:actually_streamed = IsVehicleStreamedIn(vehicleid, playerid) || GetPlayerVehicleID(playerid) == vehicleid;
        new bool:cached_streamed = Iter_Contains(vehicle_in_stream[playerid], vehicleid);

        if(!actually_streamed)
        {
            if(cached_streamed)
            {
                Iter_Remove(vehicle_in_stream[playerid], vehicleid);
                Iter_Remove(streamed_players_in_veh[vehicleid], playerid);
            }
            continue;
        }

        if(cached_streamed) continue;

        Iter_Add(vehicle_in_stream[playerid], vehicleid);
        if(!Iter_Contains(streamed_players_in_veh[vehicleid], playerid))
            Iter_Add(streamed_players_in_veh[vehicleid], playerid);

        UpdateVehicleVisualForPlayer(playerid, vehicleid);
        PermanentTuning_ApplyVehicleForPlayer(playerid, vehicleid);
        QueueVehicleStreamTuningReplay(playerid, vehicleid);
    }

    return 1;
}

stock TuningStreamWatch_OnPlayerUpdate(playerid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 0;

    new now = GetTickCount();
    if(now - g_tuning_stream_watch_tick[playerid] < 350) return 0;
    g_tuning_stream_watch_tick[playerid] = now;

    if(now - g_tuning_stream_reconcile_tick[playerid] >= 1500)
    {
        g_tuning_stream_reconcile_tick[playerid] = now;
        TuningStream_ReconcilePlayer(playerid);
    }

    new interior = GetPlayerInterior(playerid);
    new world = GetPlayerVirtualWorld(playerid);
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    if(!g_tuning_stream_watch_init[playerid])
    {
        g_tuning_stream_watch_init[playerid] = true;
        g_tuning_stream_watch_interior[playerid] = interior;
        g_tuning_stream_watch_world[playerid] = world;
        g_tuning_stream_watch_x[playerid] = x;
        g_tuning_stream_watch_y[playerid] = y;
        g_tuning_stream_watch_z[playerid] = z;
        return 1;
    }

    new bool:context_changed =
        (interior != g_tuning_stream_watch_interior[playerid]) ||
        (world != g_tuning_stream_watch_world[playerid]);

    new Float:dx = x - g_tuning_stream_watch_x[playerid];
    new Float:dy = y - g_tuning_stream_watch_y[playerid];
    new Float:dz = z - g_tuning_stream_watch_z[playerid];

    new bool:position_jump = (dx*dx + dy*dy + dz*dz) >= 3600.0;

    g_tuning_stream_watch_interior[playerid] = interior;
    g_tuning_stream_watch_world[playerid] = world;
    g_tuning_stream_watch_x[playerid] = x;
    g_tuning_stream_watch_y[playerid] = y;
    g_tuning_stream_watch_z[playerid] = z;

    if(context_changed || position_jump)
    {

        ResetPlayerVehicleStreamCache(playerid);
        QueuePlayerVehicleVisualRefresh(playerid);
    }
    return 1;
}

stock TryOpenGibddFleetMenu(playerid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 0;
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 0;
    if(GetPlayerData(playerid, P_TEAM) != TEAM_DPS) return 0;

    // GIBDD fleet pickup (g_org_car index 4). Some mobile clients do not
    // deliver OnPlayerPickUpPickup for this pickup, so call the existing
    // org-car pickup handler directly when the player is near the point.
    new action_id = 4;
    new Float:px = g_org_car[action_id][O_PICKUP][0];
    new Float:py = g_org_car[action_id][O_PICKUP][1];
    new Float:pz = g_org_car[action_id][O_PICKUP][2];

    if(!IsPlayerInRangeOfPoint(playerid, 8.0, px, py, pz))
    {
        DeletePVar(playerid, "gibdd_fleet_pickup_opened");
        return 0;
    }

    if(GetPVarInt(playerid, "gibdd_fleet_pickup_opened")) return 0;
    SetPVarInt(playerid, "gibdd_fleet_pickup_opened", 1);

    return OnPlayerPickUpPickupEx(playerid, g_org_car[action_id][O_PICKUP_ID], PICKUP_ACTION_TYPE_ORG_CAR, action_id);
}

public OnPlayerUpdate(playerid)
{
    TryOpenGibddFleetMenu(playerid);
    FamilyBattle_UpdateInteraction(playerid);
    g_sync_update_tick[playerid] = GetTickCount();
    FireExtVisual_Update(playerid);
	FixBugMoneyMinus(playerid);
    TuningStreamWatch_OnPlayerUpdate(playerid);
	SetPlayerData(playerid, P_AFK_TIME, 0);

	if(p_tc_order_progress[playerid] >= 2)
		TC_ForceTrailerLock(playerid, true);

    new hint_tick = GetTickCount();
    if(hint_tick - g_stability_hint_tick[playerid] >= 500)
    {
        g_stability_hint_tick[playerid] = hint_tick;
        HRDepartment_UpdateNotification(playerid);

        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && ContNewSystem_GetNearestContainer(playerid) != 0)
        {
            ToggleInteractionWindow(playerid, true);
        }

        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new near_vehicle = INVALID_VEHICLE_ID;
            if(TrunkTest_GetNearbyPersonalVehicle(playerid, near_vehicle, 4.5))
            {
                new now_tick = GetTickCount();
                new lock_status = GetVehicleParam(near_vehicle, V_LOCK);

                if(lock_status)
                {
                    new exit_tick = GetPVarInt(playerid, PVAR_CARLOCK_EXIT_TICK);
                    new lock_hint_vehicle = GetPVarInt(playerid, PVAR_CARLOCK_HINT_VEHICLE);

                    if((exit_tick <= 0 || (now_tick - exit_tick) >= 11000) && (lock_hint_vehicle != near_vehicle || !GetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN)))
                    {
                        ShowNotificationNew(playerid, 5, 10, 9102, near_vehicle, "Двери автомобиля закрыты", "ОТКРЫТЬ");
                        SetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN, 1);
                        SetPVarInt(playerid, PVAR_CARLOCK_HINT_VEHICLE, near_vehicle);
                        SetPVarInt(playerid, PVAR_CARLOCK_HINT_TICK, now_tick);
                    }
                }
                else
                {
                    DeletePVar(playerid, PVAR_CARLOCK_HINT_SHOWN);
                    DeletePVar(playerid, PVAR_CARLOCK_HINT_VEHICLE);
                    DeletePVar(playerid, PVAR_CARLOCK_HINT_TICK);
                }

                if(TrunkTest_IsPlayerNearVehicleRear(playerid, near_vehicle, 2.8))
                {
                    new exit_trunk_tick = GetPVarInt(playerid, PVAR_TRUNKTEST_EXIT_TICK);
                    new trunk_hint_vehicle = GetPVarInt(playerid, PVAR_TRUNKTEST_HINT_VEHICLE);

                    if((exit_trunk_tick <= 0 || (now_tick - exit_trunk_tick) >= 5000) && (trunk_hint_vehicle != near_vehicle || !GetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN)))
                    {
                        ShowNotificationNew(playerid, 5, 10, 9101, near_vehicle, "Багажник транспорта закрыт", "ОТКРЫТЬ");
                        SetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN, 1);
                        SetPVarInt(playerid, PVAR_TRUNKTEST_HINT_VEHICLE, near_vehicle);
                        SetPVarInt(playerid, PVAR_TRUNKTEST_HINT_TICK, now_tick);
                    }
                }
                else
                {
                    DeletePVar(playerid, PVAR_TRUNKTEST_HINT_SHOWN);
                    DeletePVar(playerid, PVAR_TRUNKTEST_HINT_VEHICLE);
                    DeletePVar(playerid, PVAR_TRUNKTEST_HINT_TICK);
                }
            }
            else if(GetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN) || GetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN))
            {
                DeletePVar(playerid, PVAR_TRUNKTEST_HINT_SHOWN);
                DeletePVar(playerid, PVAR_TRUNKTEST_HINT_VEHICLE);
                DeletePVar(playerid, PVAR_TRUNKTEST_HINT_TICK);
                DeletePVar(playerid, PVAR_CARLOCK_HINT_SHOWN);
                DeletePVar(playerid, PVAR_CARLOCK_HINT_VEHICLE);
                DeletePVar(playerid, PVAR_CARLOCK_HINT_TICK);
            }
        }
        else if(GetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN) || GetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN))
        {
            DeletePVar(playerid, PVAR_TRUNKTEST_HINT_SHOWN);
            DeletePVar(playerid, PVAR_TRUNKTEST_HINT_VEHICLE);
            DeletePVar(playerid, PVAR_TRUNKTEST_HINT_TICK);
            DeletePVar(playerid, PVAR_CARLOCK_HINT_SHOWN);
            DeletePVar(playerid, PVAR_CARLOCK_HINT_VEHICLE);
            DeletePVar(playerid, PVAR_CARLOCK_HINT_TICK);
        }

    }
	new green_zone_id = GetPVarInt(playerid, "player_in_green_zone") - 1;
	new bool:fb_fighter = (g_family_battle_active && GetPVarInt(playerid, "family_battle_member") && GetPlayerVirtualWorld(playerid) == FAMILY_BATTLE_WORLD);
	if(!fb_fighter && ((IsPlayerInGovernmentInteriorGreenZone(playerid) && !(IsPlayerInPoliceTeam(playerid) && GetPlayerWeapon(playerid) == WEAPON_NITESTICK)) ||
		(green_zone_id >= 0 && green_zone_id < g_green_zones_loaded && g_green_zones[green_zone_id][GZ_NO_WEAPON])))
	{
		new current_weapon = GetPlayerWeapon(playerid);
		if(current_weapon != 0)
		{
			SetPlayerArmedWeapon(playerid, 0);
		}
	}

// CreateLogo is disabled. Do not send text to unassigned textdraw ID 0.
	if(logo_PTD[playerid][0] != PlayerText:INVALID_TEXT_DRAW && g_stability_logo_power[playerid] != Config[sDonPower])
	{
		new string[50];
		format(string, sizeof string, "X%d", Config[sDonPower]);
		PlayerTextDrawSetString(playerid, logo_PTD[playerid][0], string);
		g_stability_logo_power[playerid] = Config[sDonPower];
	}
	new online = Iter_Count(Player);
	if(logo_PTD[playerid][1] != PlayerText:INVALID_TEXT_DRAW && g_stability_logo_online[playerid] != online)
	{
		new string[50];
		format(string, sizeof string, "%d/1000", online);
		PlayerTextDrawSetString(playerid, logo_PTD[playerid][1], string);
		g_stability_logo_online[playerid] = online;
	}

	if(IsPlayerDriver(playerid))
	{
		new keys, gas_brake, left_right;

		GetPlayerKeys(playerid, keys, gas_brake, left_right);

		new pedal_type = PEDAL_TYPE_NONE;

		if((keys & KEY_SPRINT) && !(keys & KEY_JUMP || keys & KEY_HANDBRAKE))
			pedal_type = PEDAL_TYPE_GAS;

		else if(keys & KEY_JUMP && !(keys & KEY_SPRINT || keys & KEY_HANDBRAKE))
			pedal_type = PEDAL_TYPE_BRAKE;

		player_press_pedal[playerid] = pedal_type;

		new vehicleid = GetPlayerVehicleID(playerid);

        if(vehicleid != INVALID_VEHICLE_ID && IsAOwnableCar(vehicleid))
        {
            new ownable_index = GetVehicleData(vehicleid, V_ACTION_ID);
            if(ownable_index >= 0 && ownable_index < MAX_OWNABLE_CARS)
            {
                new Float:v_speed = floatabs(GetVehicleSpeed(vehicleid));
                new bool:auto_lock_enabled = ((GetOwnableCarData(ownable_index, OC_PDVRADAR) & OWNABLE_CAR_PDVRADAR_FLAG_AUTOLOCK_DISABLED) == 0);

                if(auto_lock_enabled && v_speed >= 70.0 && !GetVehicleParam(vehicleid, V_LOCK))
                {
                    if(!GetPVarInt(playerid, "car_autolock_by_speed"))
                    {
                        SetVehicleParam(vehicleid, V_LOCK, VEHICLE_PARAM_ON);
                        SetPVarInt(playerid, "car_autolock_by_speed", 1);
                        ShowNotificationNew(playerid, 3, 6, 0, 0, "Транспорт был автоматически закрыт", " ");
                        PlayAudioStreamURL(playerid, "vehicle_sound_door.mp3");
                    }
                }
                else if(v_speed < 65.0 || !GetVehicleParam(vehicleid, V_LOCK))
                {
                    DeletePVar(playerid, "car_autolock_by_speed");
                }
            }
        }
	}
	if(gPlayerBlockedPickup[playerid] != -1 && !IsValidDynamicPickup(gPlayerBlockedPickup[playerid]))
        gPlayerBlockedPickup[playerid] = -1;
	if (gPlayerBlockedPickup[playerid] != -1)
    {
        new Float:px, Float:py, Float:pz;
        new Float:x, Float:y, Float:z;

        GetPlayerPos(playerid, px, py, pz);

        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, gPlayerBlockedPickup[playerid], E_STREAMER_X, x);
        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, gPlayerBlockedPickup[playerid], E_STREAMER_Y, y);
        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, gPlayerBlockedPickup[playerid], E_STREAMER_Z, z);

        if (GetPlayerDistanceFromPoint(playerid, x, y, z) > 2.0)
        {
            gPlayerBlockedPickup[playerid] = -1;
        }
    }

	if(GetPlayerTempJobCheckAnim(playerid))
	{
		new anim_index = GetPlayerAnimationIndex(playerid);

		switch(GetPlayerTempJob(playerid))
		{
			case TEMP_JOB_LOADER:
			{
				if(!GetPlayerSex(playerid))
				{
					if(!(anim_index == 259 || anim_index == 1189 || anim_index == 1224))
					{
						anim_index = -1;
					}
				}
					else
				{
					if(!(anim_index == 259 || anim_index == 260 || anim_index == 1275 || anim_index == 1276 || anim_index == 1289))
					{
						anim_index = -1;
					}
				}

				if(anim_index == -1)
				{
					SetPlayerTempJobCheckAnim(playerid, false);
					SetPlayerTempJobState(playerid, TEMP_JOB_STATE_LOADER_DROP_LOAD);
				}
			}
			case TEMP_JOB_MINER:
			{
				if(GetPlayerTempJobState(playerid) == TEMP_JOB_STATE_MINER_UNLOAD)
				{
					if(!(anim_index == 616 || anim_index == 1189 || anim_index == 1224))
						SetPlayerTempJobState(playerid, TEMP_JOB_STATE_MINER_DROP_LOAD);
				}
			}
			case TEMP_JOB_FACTORY:
			{
				if(!GetPlayerSex(playerid))
				{
					if(!(anim_index == 259 || anim_index == 949 || anim_index == 1189 || anim_index == 1224 || anim_index == 1257 || anim_index == 1269))
					{
						anim_index = -1;
					}
				}
					else
				{
					if(!(anim_index == 259 || anim_index == 1196 || anim_index == 1275 || anim_index == 1276 || anim_index == 1269 || anim_index == 1283))
					{
						anim_index = -1;
					}
				}

				if(anim_index == -1)
				{
					SetPlayerTempJobCheckAnim(playerid, false);
					SetPlayerTempJobState(playerid, TEMP_JOB_STATE_FACTORY_DROP_P);
				}
			}
			case TEMP_JOB_LUMBERJACK:
			{
				if(!(anim_index == 1189 || anim_index == 1224 || anim_index == 260 || anim_index == 1275 || anim_index == 1276))
				{
					anim_index = -1;
				}

				if(anim_index == -1)
					SetPlayerTempJobState(playerid, TEMP_JOB_STATE_LUMBERJACK_DROP);
			}
			default:
			{
				SetPlayerTempJobCheckAnim(playerid, false);
			}
		}
	}

	if(GetPVarInt(playerid, "test") == 1)
	{
		new fmt_str[64];

		format(fmt_str, sizeof fmt_str, "a_index: %d", GetPlayerAnimationIndex(playerid));
		SendClientMessage(playerid, 0xCECECEFF, fmt_str);
	}

	if(GetPlayerWeaponState(playerid) == 2) SetPlayerData(playerid, P_WEAPON_RELOADING, false);
	if(GetPlayerWeaponState(playerid) == 3 && !GetPlayerData(playerid, P_WEAPON_RELOADING))
	{
		SetPlayerData(playerid, P_WEAPON_RELOADING, true);

		switch(GetPlayerWeapon(playerid))
		{
			case 22:
			{
				if(GetPlayerData(playerid, P_SKILL_COLT) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][0]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[0] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][0] = 0;

						AddPlayerData(playerid, P_SKILL_COLT, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_colt", GetPlayerData(playerid, P_SKILL_COLT));

						SetPlayerSkillLevel(playerid, 0, GetPlayerData(playerid, P_SKILL_COLT) * 10);
					}
				}
			}
			case 23:
			{
				if(GetPlayerData(playerid, P_SKILL_SDPISTOL) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][1]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[1] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][1] = 0;

						AddPlayerData(playerid, P_SKILL_SDPISTOL, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_sdpistol", GetPlayerData(playerid, P_SKILL_SDPISTOL));

						SetPlayerSkillLevel(playerid, 1, GetPlayerData(playerid, P_SKILL_SDPISTOL) * 10);
					}
				}
			}
			case 24:
			{
				if(GetPlayerData(playerid, P_SKILL_DEAGLE) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][2]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[2] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][2] = 0;

						AddPlayerData(playerid, P_SKILL_DEAGLE, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_deagle", GetPlayerData(playerid, P_SKILL_DEAGLE));

						SetPlayerSkillLevel(playerid, 2, GetPlayerData(playerid, P_SKILL_DEAGLE) * 10);
					}
				}
			}
			case 25:
			{
				if(GetPlayerData(playerid, P_SKILL_SHOTGUN) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][3]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[3] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][3] = 0;

						AddPlayerData(playerid, P_SKILL_SHOTGUN, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_shotgun", GetPlayerData(playerid, P_SKILL_SHOTGUN));

						SetPlayerSkillLevel(playerid, 3, GetPlayerData(playerid, P_SKILL_SHOTGUN) * 10);
					}
				}
			}
			case 29:
			{
				if(GetPlayerData(playerid, P_SKILL_MP5) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][4]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[4] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][4] = 0;

						AddPlayerData(playerid, P_SKILL_MP5, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_mp5", GetPlayerData(playerid, P_SKILL_MP5));

						SetPlayerSkillLevel(playerid, 7, GetPlayerData(playerid, P_SKILL_MP5) * 10);
					}
				}
			}
			case 30:
			{
				if(GetPlayerData(playerid, P_SKILL_AK47) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][5]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[5] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][5] = 0;

						AddPlayerData(playerid, P_SKILL_AK47, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_ak47", GetPlayerData(playerid, P_SKILL_AK47));

						SetPlayerSkillLevel(playerid, 8, GetPlayerData(playerid, P_SKILL_AK47) * 10);
					}
				}
			}
			case 31:
			{
				if(GetPlayerData(playerid, P_SKILL_M4) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][6]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[6] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][6] = 0;

						AddPlayerData(playerid, P_SKILL_M4, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_m4", GetPlayerData(playerid, P_SKILL_M4));

						SetPlayerSkillLevel(playerid, 9, GetPlayerData(playerid, P_SKILL_M4) * 10);
					}
				}
			}
			case 34:
			{
				if(GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][7]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[7] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][7] = 0;

						AddPlayerData(playerid, P_SKILL_SNIPER_RIFLE, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_sniper_rifle", GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE));

						SetPlayerSkillLevel(playerid, 10, GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE) * 10);
					}
				}
			}
			case 26:
			{
				if(GetPlayerData(playerid, P_SKILL_SAWNOFF) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][8]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[8] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][8] = 0;

						AddPlayerData(playerid, P_SKILL_SAWNOFF, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_sawnoff", GetPlayerData(playerid, P_SKILL_SAWNOFF));

						SetPlayerSkillLevel(playerid, 4, GetPlayerData(playerid, P_SKILL_SAWNOFF) * 10);
					}
				}
			}
			case 27:
			{
				if(GetPlayerData(playerid, P_SKILL_COMBAT_SG) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][9]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[9] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][9] = 0;

						AddPlayerData(playerid, P_SKILL_COMBAT_SG, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_combat_sg", GetPlayerData(playerid, P_SKILL_COMBAT_SG));

						SetPlayerSkillLevel(playerid, 5, GetPlayerData(playerid, P_SKILL_COMBAT_SG) * 10);
					}
				}
			}
			case 28:
			{
				if(GetPlayerData(playerid, P_SKILL_MICRO_UZI) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][10]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[10] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][10] = 0;

						AddPlayerData(playerid, P_SKILL_MICRO_UZI, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_micro_uzi", GetPlayerData(playerid, P_SKILL_MICRO_UZI));

						SetPlayerSkillLevel(playerid, 6, GetPlayerData(playerid, P_SKILL_MICRO_UZI) * 10);
					}
				}
			}
		}
	}
	return 1;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
	return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
	return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN_CAR) return 1;

    UpdateVehicleVisualForPlayer(forplayerid, vehicleid);
    if(GetPlayerData(forplayerid, P_BUY_CAR) == vehicleid)
    {
        ApplyAutosalonPreviewColor(forplayerid);
    }

    if(!Iter_Contains(streamed_players_in_veh[vehicleid], forplayerid))
        Iter_Add(streamed_players_in_veh[vehicleid], forplayerid);
    if(!Iter_Contains(vehicle_in_stream[forplayerid], vehicleid))
        Iter_Add(vehicle_in_stream[forplayerid], vehicleid);

    PermanentTuning_ApplyVehicleForPlayer(forplayerid, vehicleid);

    QueueVehicleStreamTuningReplay(forplayerid, vehicleid);
    return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
    Iter_Remove(streamed_players_in_veh[vehicleid], forplayerid);
    Iter_Remove(vehicle_in_stream[forplayerid], vehicleid);
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(Duel_OnDialogResponse(playerid, dialogid, response, listitem, inputtext))
        return 1;
    if(Diner_OnDialogResponse(playerid, dialogid, response, listitem, inputtext))
        return 1;
    if(dialogid == DIALOG_FAMILY_BATTLE_RATING)
        return FamilyBattleShowMenu(playerid);

    if(dialogid == DIALOG_FAMILY_BATTLE_MENU)
    {
        if(!response) return 1;

        switch(listitem)
        {
            case 0:
            {
                ShowNotificationNew(playerid, 3, 8, 0, 0, "Битва проходит каждый час с 30:00 до 40:00. Очки дают время в зоне и нокауты. Семья регистрируется лидером у NPC.", "OK");
                return 1;
            }
            case 1: return FamilyBattleRegister(playerid);
            case 2: return FamilyBattleEnterPlayer(playerid);
            case 3: return FamilyBattleExitPlayer(playerid);
            case 4: return FamilyBattleShowRating(playerid);
        }
        return 1;
    }

    if(dialogid >= DIALOG_APANEL_MAIN && dialogid <= DIALOG_APANEL_ANNOUNCE)
    {
        if(GetPlayerAdminEx(playerid) < 13) return 1;
        if(!response) return 1;
        switch(dialogid)
        {
            case DIALOG_APANEL_MAIN:
            {
                switch(listitem)
                {
                    case 0: return Dialog(playerid, DIALOG_APANEL_SERVER, DIALOG_STYLE_LIST, "Управление сервером", "Включить/выключить приём игроков\nПополнить продукты всех бизнесов\nПоказать статус сервера\nПерезапустить сервер", "Выбрать", "Закрыть");
                    case 1:
                    {
                        new text[4096], name[MAX_PLAYER_NAME], apbuf[96];
                        text[0] = EOS;
                        for(new i = 0; i <= GetPlayerPoolSize(); i++)
                        {
                            if(!IsPlayerConnected(i)) continue;
                            new admin = GetPlayerAdminEx(i);
                            if(admin < 1) continue;
                            GetPlayerName(i, name, sizeof(name));
                            apbuf[0] = EOS;
                            strcat(apbuf, "[");
                            valstr(apbuf, i);
                            strcat(apbuf, "] ");
                            strcat(apbuf, name);
                            strcat(apbuf, " — ");
                            valstr(apbuf, admin);
                            strcat(apbuf, " LVL\n");
                            strcat(text, apbuf);
                        }
                        if(!strlen(text)) strcat(text, "Нет администраторов онлайн.");
                        return Dialog(playerid, DIALOG_APANEL_ADMINS, DIALOG_STYLE_MSGBOX, "Список администраторов", text, "Закрыть", "");
                    }
                    case 2:
                    {
                        new text[4096], name[MAX_PLAYER_NAME], apbuf[128];
                        text[0] = EOS;
                        for(new i = 0; i <= GetPlayerPoolSize(); i++)
                        {
                            if(!IsPlayerConnected(i)) continue;
                            if(!(1 <= GetPlayerTeamEx(i) <= 7)) continue;
                            if(!(9 <= GetPlayerJob(i) <= 10)) continue;
                            GetPlayerName(i, name, sizeof(name));
                            apbuf[0] = EOS;
                            strcat(apbuf, "[");
                            valstr(apbuf, i);
                            strcat(apbuf, "] ");
                            strcat(apbuf, name);
                            strcat(apbuf, " — ");
                            strcat(apbuf, GetTeamName(GetPlayerTeamEx(i)));
                            strcat(apbuf, ", ранг ");
                            valstr(apbuf, GetPlayerJob(i));
                            strcat(apbuf, "\n");
                            strcat(text, apbuf);
                        }
                        if(!strlen(text)) strcat(text, "Лидеров онлайн нет.");
                        return Dialog(playerid, DIALOG_APANEL_LEADERS, DIALOG_STYLE_MSGBOX, "Список лидеров", text, "Закрыть", "");
                    }
                    case 3: return Dialog(playerid, DIALOG_APANEL_ANNOUNCE, DIALOG_STYLE_INPUT, "Объявление сервера", "Введите текст объявления для всех игроков:", "Отправить", "Закрыть");
                }
            }
            case DIALOG_APANEL_SERVER:
            {
                switch(listitem)
                {
                    case 0:
                    {
                        g_server_closed = !g_server_closed;
                        new msg[144];
                        format(msg, sizeof(msg), "Приём новых игроков %s.", g_server_closed ? "выключен" : "включён");
                        SendClientMessage(playerid, 0x55DD77FF, msg);
                    }
                    case 1:
                    {
                        new query[160];
                        for(new i = 0; i < g_business_loaded; i++)
                        {
                            new max_products = GetBusinessMaxProd(i);
                            if(max_products <= 0) max_products = 10000;
                            SetBusinessData(i, B_PRODS, max_products);
                            mysql_format(mysql, query, sizeof(query), "UPDATE business SET products=%d WHERE id=%d LIMIT 1", GetBusinessData(i, B_PRODS), GetBusinessData(i, B_SQL_ID));
                            mysql_tquery(mysql, query);
                        }
                        SendClientMessage(playerid, 0x55DD77FF, "Продукты всех загруженных бизнесов пополнены до максимума.");
                    }
                    case 2:
                    {
                        new status[128], count;
                        for(new i = 0; i <= GetPlayerPoolSize(); i++) if(IsPlayerConnected(i)) count++;
                        format(status, sizeof(status), "Сервер: %s\nИгроков онлайн: %d", g_server_closed ? "закрыт для новых игроков" : "открыт", count);
                        return Dialog(playerid, DIALOG_APANEL_MAIN, DIALOG_STYLE_MSGBOX, "Статус сервера", status, "Закрыть", "");
                    }
                    case 3:
                    {
                        SendClientMessageToAll(0xFFAA00FF, "Сервер будет перезапущен администрацией.");
                        SendRconCommand("gmx");
                        return 1;
                    }
                }
                return Dialog(playerid, DIALOG_APANEL_SERVER, DIALOG_STYLE_LIST, "Управление сервером", "Включить/выключить приём игроков\nПополнить продукты всех бизнесов\nПоказать статус сервера\nПерезапустить сервер", "Выбрать", "Закрыть");
            }
            case DIALOG_APANEL_ANNOUNCE:
            {
                if(strlen(inputtext) < 2) return Dialog(playerid, DIALOG_APANEL_ANNOUNCE, DIALOG_STYLE_INPUT, "Объявление сервера", "Введите текст объявления для всех игроков:", "Отправить", "Закрыть");
                utf8_to_cp1251(inputtext);
                new msg[512];
                format(msg, sizeof(msg), "{FFAA00}[СЕРВЕР] {FFFFFF}%s", inputtext);
                SendClientMessageToAll(-1, msg);
                return 1;
            }
        }
        return 1;
    }

    if(FW_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;

    if(dialogid == DIALOG_LICENSE_B_MAIN)
    {
        if(!response) return 1;

        if(listitem == 0)
            return LicenseB_Start(playerid);

        return 1;
    }

    if(dialogid == DIALOG_LICENSE_B_QUESTION)
    {
        if(!response)
        {
            g_LicenseB_Test[playerid] = -1;
            g_LicenseB_Question[playerid] = 0;
            return 1;
        }

        if(g_LicenseB_Test[playerid] < 0 || g_LicenseB_Test[playerid] > 4)
            return 1;
        return LicenseB_ShowAnswers(playerid);
    }

    if(dialogid == DIALOG_LICENSE_B_TEST)
    {
        if(!response)
        {
            g_LicenseB_Test[playerid] = -1;
            g_LicenseB_Question[playerid] = 0;
            return 1;
        }

        if(g_LicenseB_Test[playerid] < 0 || g_LicenseB_Test[playerid] > 4)
            return 1;

        new answer = 0;

        switch(g_LicenseB_Test[playerid] * 4 + g_LicenseB_Question[playerid])
        {
            case 0:  answer = 0;
            case 1:  answer = 1;
            case 2:  answer = 2;
            case 3:  answer = 1;

            case 4:  answer = 2;
            case 5:  answer = 0;
            case 6:  answer = 1;
            case 7:  answer = 0;

            case 8:  answer = 1;
            case 9:  answer = 0;
            case 10: answer = 1;
            case 11: answer = 1;

            case 12: answer = 1;
            case 13: answer = 1;
            case 14: answer = 0;
            case 15: answer = 2;

            case 16: answer = 1;
            case 17: answer = 0;
            case 18: answer = 0;
            case 19: answer = 1;
        }

        if(listitem != answer)
        {
            g_LicenseB_Test[playerid] = -1;
            g_LicenseB_Question[playerid] = 0;
            SendClientMessage(playerid, 0xFF5555FF, "Вы провалили тест, попробуйте заново.");
            return 1;
        }

        g_LicenseB_Question[playerid]++;

        if(g_LicenseB_Question[playerid] >= 4)
        {
            g_LicenseB_Test[playerid]++;

            if(g_LicenseB_Test[playerid] >= 5)
                return LicenseB_StartPractical(playerid);

            g_LicenseB_Question[playerid] = 0;
            SendClientMessage(playerid, 0x66CC00FF, "Тест пройден! Переходим к следующему тесту ПДД.");
        }

        return LicenseB_ShowQuestion(playerid);
    }


    if(dialogid == DIALOG_ADMIN_ACS_INVENTORY)
    {
        if(!response) return 1;
        if(GetPlayerAdminEx(playerid) < 1) return 1;

        new acs_count = g_admin_acs_display_count[playerid];

        if(listitem == acs_count)
        {
            Inventory11_RemoveAllActiveAccessories(playerid);
            SendClientMessage(playerid, -1, "{FF4500}Внимание:{FFFFFF} Все аксессуары были сняты.");
            return 1;
        }

        if(listitem < 0 || listitem >= acs_count) return 1;
        new modelid = g_admin_acs_display_model[playerid][listitem];
        if(FindAccsDataIndexByModel(modelid) < 0) return SendClientMessage(playerid, 0xFF5252FF, "{FF5252}Ошибка:{FFFFFF} аксессуар не найден.");
        if(Inv11_AdminAcsGive(playerid, modelid) == -1) return SendClientMessage(playerid, 0xFF5252FF, "{FF5252}Ошибка:{FFFFFF} не удалось добавить аксессуар в инвентарь.");
        SendClientMessage(playerid, 0x66CC00FF, "{FFFFFF}Аксессуар добавлен в {FF5252}инвентарь{FFFFFF}.");
        return 1;
    }

    if(FsinFull_OnDialogResponse(playerid,dialogid,response,listitem,inputtext)) return 1;
    if(Construction_OnDialogResponse(playerid, dialogid, response)) return 1;
    if(GarageSys_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;

    if(TC_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(Market_OnDialogResponse(playerid, dialogid, response, listitem, inputtext))
    {
        return 1;
    }

    if(dialogid == DIALOG_ANTIDM_ZONES)
    {
        if(!response) return 1;

        new green_zone_id = GetPlayerListitemValue(playerid, listitem);
        return ShowAntiDmGreenZoneInfo(playerid, green_zone_id);
    }

    if(dialogid == DIALOG_ANTIDM_INFO)
    {
        return ShowAntiDmGreenZonesDialog(playerid);
    }

    if(dialogid == 34150)
    {
        if(!response) return 1;
        return StartAutosalonTestDrive(playerid);
    }

    if(dialogid == DIALOG_ID_INV11_ACC_CUSTOMIZE)
    {
        if(response)
        {
            new acc_slot = GetPVarInt(playerid, "inv11_acc_edit_slot");
            if(!Inv11_OpenAccEditorBySlot(playerid, acc_slot))
            {
                ShowNotificationNew(playerid, 2, 6, 0, 0, "Не удалось открыть редактирование аксессуара", " ");
            }
        }

        DeletePVar(playerid, "inv11_acc_edit_slot");
        return 1;
    }

    if(dialogid == DIALOG_INV11_TRADE_SELECT)
    {
        if(!response) return 1;

        if(listitem < 0 || listitem >= g_inv11_trade_dialog_count[playerid])
        {
            return 1;
        }

        new targetid = g_inv11_trade_dialog_target[playerid][listitem];
        if(targetid == -1 || !IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Игрок недоступен", " ");
            return 1;
        }

        if(!Inv11Trade_IsNear(playerid, targetid, INV11_TRADE_NEAR_RANGE))
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Игрок слишком далеко для трейда", " ");
            return 1;
        }

        if(g_inv11_trade_active[playerid] || g_inv11_trade_active[targetid])
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Один из игроков уже в трейде", " ");
            return 1;
        }

        if(g_inv11_trade_invite_from[targetid] != -1 && g_inv11_trade_invite_from[targetid] != playerid && gettime() - g_inv11_trade_invite_time[targetid] <= INV11_TRADE_INVITE_TIMEOUT)
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Игрок уже получил другое предложение", " ");
            return 1;
        }

        g_inv11_trade_invite_from[targetid] = playerid;
        g_inv11_trade_invite_time[targetid] = gettime();
        g_inv11_trade_invite_to[playerid] = targetid;

        new wait_msg[128];
        format(wait_msg, sizeof(wait_msg), "Ожидайте принятия трейда от %s", GetPlayerNameEx(targetid));
        SendClientMessage(playerid, 0xFFFFFFFF, wait_msg);
        ShowNotificationNew(playerid, 3, 6, 0, 0, "Вы отправили предложения трейда, ожидайте принятия.", " ");
        new incoming_msg[128];
        format(incoming_msg, sizeof(incoming_msg), "Игрок %s предлагает вам трейд", GetPlayerNameEx(playerid));
        SendClientMessage(targetid, 0x55CCFFFF, incoming_msg);

        new notify_text[96];
        format(notify_text, sizeof(notify_text), "Предложение от %s", GetPlayerNameEx(playerid));
        ShowNotificationNew(targetid, 4, 6, playerid, 0, notify_text, ">>");

        return 1;
    }

    if(dialogid == DIALOG_INV11_TRADE_CONFIRM)
    {
        new inviter = g_inv11_trade_invite_from[playerid];
        if(inviter == -1)
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Предложение не найдено", " ");
            return 1;
        }

        if(!response)
        {
            if(IsPlayerConnected(inviter) && g_inv11_trade_invite_to[inviter] == playerid)
            {
                SendClientMessage(inviter, 0xFFFFFFFF, "Игрок отклонил предложение трейда.");
                g_inv11_trade_invite_to[inviter] = -1;
            }
            Inv11Trade_ResetInvite(playerid);
            return 1;
        }

        if(!IsPlayerConnected(inviter) || !IsPlayerLogged(inviter))
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Игрок недоступен", " ");
            Inv11Trade_ResetInvite(playerid);
            return 1;
        }

        if(gettime() - g_inv11_trade_invite_time[playerid] > INV11_TRADE_INVITE_TIMEOUT)
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Предложение трейда устарело", " ");
            if(g_inv11_trade_invite_to[inviter] == playerid) g_inv11_trade_invite_to[inviter] = -1;
            Inv11Trade_ResetInvite(playerid);
            return 1;
        }

        if(!Inv11Trade_IsNear(playerid, inviter, INV11_TRADE_NEAR_RANGE))
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Подойдите ближе к игроку", " ");
            if(g_inv11_trade_invite_to[inviter] == playerid) g_inv11_trade_invite_to[inviter] = -1;
            Inv11Trade_ResetInvite(playerid);
            return 1;
        }

        if(g_inv11_trade_invite_to[inviter] == playerid) g_inv11_trade_invite_to[inviter] = -1;
        Inv11Trade_ResetInvite(playerid);

        if(!Inv11Trade_StartSession(inviter, playerid))
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Не удалось начать трейд", " ");
            if(IsPlayerConnected(inviter))
            {
                ShowNotificationNew(inviter, 2, 6, 0, 0, "Не удалось начать трейд", " ");
            }
            return 1;
        }

        SendClientMessage(inviter, 0xFFFFFFFF, "Игрок принял предложение трейда.");
        SendClientMessage(playerid, 0xFFFFFFFF, "Вы приняли предложение трейда.");
        ShowNotificationNew(inviter, 3, 6, 0, 0, "Вы начали трейд, у Вас есть 5 минут.", " ");
        ShowNotificationNew(playerid, 3, 6, 0, 0, "Вы начали трейд, у Вас есть 5 минут.", " ");
        return 1;
    }
    if(dialogid == DIALOG_CONT_NATIVE_BID)
    {
        new contid = pInfo[playerid][BetUseCont];
        if(!response) return 1;
        if(!ContNewSystem_IsValidContainer(contid)) return 1;

        if(!IsPlayerInRangeOfPoint(playerid, ContNewSystem_GetInteractRange(),
            ContBuyTextPos[contid - 1][0],
            ContBuyTextPos[contid - 1][1],
            ContBuyTextPos[contid - 1][2]))
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Подойдите ближе к контейнеру", " ");
            return 1;
        }

        new bid_amount = strval(inputtext);
        if(bid_amount <= 0)
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Введите корректную сумму ставки", " ");
            return ContNewSystem_OpenNative(playerid, contid);
        }

        ContNewSystem_TryBid(playerid, contid, bid_amount);
        if(cInfo[contid][Saled]) return ContNewSystem_OpenNative(playerid, contid);
        return 1;
    }

    if(dialogid == DIALOG_CONT_NATIVE_REWARD)
    {
        new contid = pInfo[playerid][BuyUseCont];
        if(!response) return 1;
        if(!ContNewSystem_IsValidContainer(contid)) return 1;

        if(!IsPlayerInRangeOfPoint(playerid, ContNewSystem_GetInteractRange(),
            ContBuyTextPos[contid - 1][0],
            ContBuyTextPos[contid - 1][1],
            ContBuyTextPos[contid - 1][2]))
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Подойдите ближе к контейнеру", " ");
            return 1;
        }

        switch(listitem)
        {
            case 0: return ContNewSystem_ProcessRewardAction(playerid, contid, false);
            case 1: return ContNewSystem_ProcessRewardAction(playerid, contid, true);
        }
        return 1;
    }

	if(dialogid == DIALOG_CONT_BET)
{
    if(response)
    {
        new cont = pInfo[playerid][BetUseCont];
        if(cont == 0) return printf("ERROR PLAYERID: %d (contuse == 0)");
        if(cInfo[cont][Saled] == true)
        {
            if(cInfo[cont][BetedId] == playerid) return SendClientMessage(playerid, CLR_RED, "{ffffff}Ставка на контейнер уже ваша, вы не можете перебить свою ставку");
            if(0 < strval(inputtext) < 100000000)
            {
                if(GetPlayerMoneyEx(playerid) >= strval(inputtext))
                {
                    if(strval(inputtext)-99999 > cInfo[cont][BetPrice])
                    {
                        if(strval(inputtext) > cInfo[cont][ContPrice] && strval(inputtext) > cInfo[cont][BetPrice])
                        {
                            new strwerton[111];
                            new name[MAX_PLAYER_NAME]; GetPlayerName(playerid, name, MAX_PLAYER_NAME);
                            if(cInfo[cont][BetedId] != INVALID_PLAYER_ID)
                            {
                                format(strwerton, sizeof strwerton, "{ffffff}Ваша ставка была отменена в связи с тем, что игрок {FF6347}%s {ffffff}поставил больше!", name);
                                SendClientMessage(cInfo[cont][BetedId], CLR_RED, strwerton);

                                new return_str[64], return_money[32];
                                ConvertMoney(cInfo[cont][BetPrice], return_money);
                                format(return_str, sizeof(return_str), "Вы получили %s рублей", return_money);
                                ShowNotificationNew(cInfo[cont][BetedId], 1, 6, 0, 0, return_str, " ");

                                GivePlayerMoneyEx(cInfo[cont][BetedId], cInfo[cont][BetPrice]);
                            }

                            cInfo[cont][BetPrice] = strval(inputtext);
                            GivePlayerMoneyEx(playerid, -cInfo[cont][BetPrice], "Ставка за контейнер", true, true);
                            cInfo[cont][BetedId] = playerid;
                            format(cInfo[cont][BetedName], MAX_PLAYER_NAME, "%s", name);

                            new betstr[15];
                            ConvertMoney(cInfo[cont][BetPrice], betstr);
                            format(strwerton, sizeof strwerton, " {ffffff}Вы успешно сделали ставку в размере {FF5252}%s {ffffff}рублей за контейнер {FF5252}#%d", betstr, cont);
                            SendClientMessage(playerid, CLR_YELLOW, strwerton);

                            ShowNotificationNew(playerid, 3, 6, 0, 0, "Ставка принята успешно!", " ");

                            StartContBidding(cont);
                        }
					else
                        {
                            new strwerton[140], betstr[15];
                            new KASHON_title[128];
                            format(KASHON_title, sizeof KASHON_title, "{FF6347}%s {ffffff}| Битва за контейнер", SERVER_NAME);
                            ConvertMoney(cInfo[cont][BetPrice], betstr);
                            format(strwerton, sizeof strwerton, "Последняя сделанная ставка: %s рублей\n\nДля того, чтобы сделать свою ставку Вам необходимо\nбудет ввести ее в диалоговом поле ниже:", betstr);
                            SPD(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, KASHON_title, strwerton, "Готово", "Отмена");
                            SendClientMessage(playerid, CLR_RED, " {ffffff}Ваша ставка должна быть выше последней!");

                            ShowNotificationNew(playerid, 2, 6, 0, 0, "Ставка должна быть выше", " ");
                            pInfo[playerid][BetUseCont] = 0;
                        }
                    }
					else
                    {
                        new strwerton[140], betstr[15];
                        new KASHON_title[128];
                        format(KASHON_title, sizeof KASHON_title, "{FF6347}%s {ffffff}| Битва за контейнер", SERVER_NAME);
                        ConvertMoney(cInfo[cont][BetPrice], betstr);
                        format(strwerton, sizeof strwerton, "Последняя сделанная ставка: %s рублей\n\nДля того, чтобы сделать свою ставку Вам необходимо\nбудет ввести ее в диалоговом поле ниже:", betstr);
                        SPD(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, KASHON_title, strwerton, "Готово", "Отмена");
                        SendClientMessage(playerid, CLR_RED, "{ffffff}Минимальный подьем ставки 100.000 рублей!");

                        ShowNotificationNew(playerid, 2, 6, 0, 0, "Минимальный подъем 100.000 руб", " ");
                        pInfo[playerid][BetUseCont] = 0;
                    }
                }
					else
                {
                    new strwerton[140], betstr[15];
                    new KASHON_title[128];
                    format(KASHON_title, sizeof KASHON_title, "{FF6347}%s {ffffff}| Битва за контейнер", SERVER_NAME);
                    ConvertMoney(cInfo[cont][BetPrice], betstr);
                    format(strwerton, sizeof strwerton, "Последняя сделанная ставка: %s рублей\n\nДля того, чтобы сделать свою ставку Вам необходимо\nбудет ввести ее в диалоговом поле ниже:", betstr);
                    SPD(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, KASHON_title, strwerton, "Готово", "Отмена");
                    SendClientMessage(playerid, CLR_RED, "{ffffff}У вас недостаточно средств для такой ставки!");

                    ShowNotificationNew(playerid, 2, 6, 0, 0, "Недостаточно средств", " ");
                    pInfo[playerid][BetUseCont] = 0;
                }
            }
					else
            {
                new strwerton[140], betstr[15];
                new KASHON_title[128];
                format(KASHON_title, sizeof KASHON_title, "{FF6347}%s {ffffff}| Битва за контейнер", SERVER_NAME);
                ConvertMoney(cInfo[cont][BetPrice], betstr);
                format(strwerton, sizeof strwerton, "Последняя сделанная ставка: %s рублей\n\nДля того, чтобы сделать свою ставку Вам необходимо\nбудет ввести ее в диалоговом поле ниже:", betstr);
                SPD(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, KASHON_title, strwerton, "Готово", "Отмена");
                SendClientMessage(playerid, CLR_RED, "{ffffff}Введите корректную ставку!");

                ShowNotificationNew(playerid, 2, 6, 0, 0, "Введите корректную ставку", " ");
                pInfo[playerid][BetUseCont] = 0;
            }
        }
    }
}
    if(dialogid == DIALOG_CASINO_EMPLOYEES)
    {
        if(!response) return ShowPlayerBusinessDialog(playerid, BIZ_OPERATION_PARAMS);
        new businessid = GetSelectedBusiness(playerid);
        if(!(0 <= businessid < g_business_loaded) || GetBusinessData(businessid, B_TYPE) != BUSINESS_TYPE_CASINO || GetBusinessData(businessid, B_OWNER_ID) != GetPlayerAccountID(playerid))
            return SendClientMessage(playerid, 0xCECECEFF, "Управление сотрудниками доступно только владельцу казино.");

        switch(listitem)
        {
            case 0: Dialog(playerid, DIALOG_CASINO_HIRE_MANAGER, DIALOG_STYLE_INPUT, "Поставить на менеджера", "Введите ID игрока:", "Предложить", "Назад");
            case 1: Dialog(playerid, DIALOG_CASINO_HIRE_DEALER, DIALOG_STYLE_INPUT, "Поставить на крупье", "Введите ID игрока:", "Предложить", "Назад");
            case 2: Dialog(playerid, DIALOG_CASINO_FIRE_MANAGER, DIALOG_STYLE_INPUT, "Снять менеджера", "Введите ник менеджера:", "Уволить", "Назад");
            case 3: Dialog(playerid, DIALOG_CASINO_FIRE_DEALER, DIALOG_STYLE_INPUT, "Снять крупье", "Введите ник крупье:", "Уволить", "Назад");
            case 4: ShowCasinoEmployeeList(playerid, businessid);
            case 5:
            {
                new balance_text[96];
                format(balance_text, sizeof balance_text, "На балансе казино: {66CC33}%d руб.", GetBusinessData(businessid, B_BALANCE));
                Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "Баланс бизнеса", balance_text, "Закрыть", "");
            }
            case 6:
            {
                new withdraw_text[128];
                format(withdraw_text, sizeof withdraw_text, "На балансе казино: {66CC33}%d руб.{FFFFFF}\nВведите сумму для снятия:", GetBusinessData(businessid, B_BALANCE));
                Dialog(playerid, DIALOG_CASINO_WITHDRAW_PROFIT, DIALOG_STYLE_INPUT, "Снять прибыль казино", withdraw_text, "Снять", "Назад");
            }
        }
        return 1;
    }
    if(dialogid == DIALOG_CASINO_WITHDRAW_PROFIT)
    {
        if(!response) return ShowCasinoEmployeesDialog(playerid);
        new businessid = GetSelectedBusiness(playerid);
        if(!(0 <= businessid < g_business_loaded) || GetBusinessData(businessid, B_TYPE) != BUSINESS_TYPE_CASINO || GetBusinessData(businessid, B_OWNER_ID) != GetPlayerAccountID(playerid))
            return SendClientMessage(playerid, 0xCECECEFF, "Снять прибыль может только владелец этого казино.");
        if(!IsNumeric(inputtext))
        {
            SendClientMessage(playerid, 0xCECECEFF, "Введите корректную сумму.");
            return ShowCasinoEmployeesDialog(playerid);
        }
        new sum = strval(inputtext);
        if(sum <= 0 || sum > GetBusinessData(businessid, B_BALANCE))
        {
            SendClientMessage(playerid, 0xCECECEFF, "На балансе казино нет такой суммы.");
            return ShowCasinoEmployeesDialog(playerid);
        }
        new query[192];
        mysql_format(mysql, query, sizeof query, "UPDATE accounts a,business b SET a.money=%d,b.balance=%d WHERE a.id=%d AND b.id=%d", GetPlayerMoneyEx(playerid) + sum, GetBusinessData(businessid, B_BALANCE) - sum, GetPlayerAccountID(playerid), GetBusinessData(businessid, B_SQL_ID));
        mysql_query(mysql, query, false);
        if(mysql_errno()) return SendClientMessage(playerid, 0xFF6600FF, "Ошибка сохранения, повторите попытку.");
        AddBusinessData(businessid, B_BALANCE, -, sum);
        GivePlayerMoneyEx(playerid, sum, "+ Снятие прибыли казино", false, true);
        SendClientMessage(playerid, 0x66CC00FF, "Прибыль казино успешно снята.");
        return ShowCasinoEmployeesDialog(playerid);
    }    if(dialogid == DIALOG_CASINO_HIRE_MANAGER || dialogid == DIALOG_CASINO_HIRE_DEALER || dialogid == DIALOG_CASINO_MANAGER_HIRE)
    {
        if(!response) return dialogid == DIALOG_CASINO_MANAGER_HIRE ? ShowCasinoManagerDialog(playerid) : ShowCasinoEmployeesDialog(playerid);
        new businessid = dialogid == DIALOG_CASINO_MANAGER_HIRE ? GetPlayerManagedCasino(playerid) : GetSelectedBusiness(playerid);
        new to_player = strval(inputtext);
        new required_job = dialogid == DIALOG_CASINO_HIRE_MANAGER ? 2 : 1;
        if(!(0 <= businessid < g_business_loaded) || GetBusinessData(businessid, B_TYPE) != BUSINESS_TYPE_CASINO) return 1;
        if(required_job == 2 && GetBusinessData(businessid, B_OWNER_ID) != GetPlayerAccountID(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "Только владелец казино может назначать менеджеров.");
        if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "Такого игрока нет");
        if(!IsPlayerInRangeOfPlayer(playerid, to_player, 10.0)) return SendClientMessage(playerid, 0xCECECEFF, "Игрок находится слишком далеко");
        if(GetPlayerData(to_player, P_CASINO_JOB)) return SendClientMessage(playerid, 0xCECECEFF, "Этот игрок уже работает в казино");
        SendPlayerOffer(playerid, to_player, OFFER_TYPE_BUSINESS_MANAGER, businessid, required_job);
        return 1;
    }
    if(dialogid == DIALOG_CASINO_FIRE_MANAGER || dialogid == DIALOG_CASINO_FIRE_DEALER || dialogid == DIALOG_CASINO_MANAGER_FIRE)
    {
        if(!response) return dialogid == DIALOG_CASINO_MANAGER_FIRE ? ShowCasinoManagerDialog(playerid) : ShowCasinoEmployeesDialog(playerid);
        new businessid = dialogid == DIALOG_CASINO_MANAGER_FIRE ? GetPlayerManagedCasino(playerid) : GetSelectedBusiness(playerid);
        new to_player = GetPlayerID(inputtext);
        new required_job = dialogid == DIALOG_CASINO_FIRE_MANAGER ? 2 : 1;
        if(!(0 <= businessid < g_business_loaded)) return 1;
        if(dialogid != DIALOG_CASINO_MANAGER_FIRE && GetBusinessData(businessid, B_OWNER_ID) != GetPlayerAccountID(playerid)) return 1;
        if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
        {
            new query[192];
            mysql_format(mysql, query, sizeof query, "SELECT id,casino_job,casino_business FROM accounts WHERE name='%e' LIMIT 1", inputtext);
            new Cache:employee_cache = mysql_query(mysql, query, true);
            if(!cache_num_rows(employee_cache) || cache_get_field_content_int(0, "casino_business") != businessid || cache_get_field_content_int(0, "casino_job") != required_job)
            {
                cache_delete(employee_cache);
                return SendClientMessage(playerid, 0xCECECEFF, "Сотрудник с таким ником и должностью не найден");
            }
            new employee_account = cache_get_field_content_int(0, "id");
            cache_delete(employee_cache);
            mysql_format(mysql, query, sizeof query, "UPDATE accounts SET casino_job=0,casino_business=-1 WHERE id=%d LIMIT 1", employee_account);
            mysql_query(mysql, query, false);
            return SendClientMessage(playerid, 0x66CC00FF, "Сотрудник уволен из казино.");
        }
        if(GetPlayerData(to_player, P_CASINO_BUSINESS) != businessid || GetPlayerData(to_player, P_CASINO_JOB) != required_job) return SendClientMessage(playerid, 0xCECECEFF, "У игрока нет указанной должности в Вашем казино");
        SetCasinoEmployment(to_player, -1, 0);
        SendClientMessage(to_player, 0xFF9900FF, "Вы были уволены из казино.");
        SendClientMessage(playerid, 0x66CC00FF, "Сотрудник уволен из казино.");
        return 1;
    }
    if(dialogid == DIALOG_CASINO_MANAGER_MENU)
    {
        if(!response) return 1;
        new businessid = GetPlayerManagedCasino(playerid);
        if(businessid == -1) return SendClientMessage(playerid, 0xCECECEFF, "Вы не являетесь менеджером казино.");
        switch(listitem)
        {
            case 0: ShowCasinoEmployeeList(playerid, businessid);
            case 1: Dialog(playerid, DIALOG_CASINO_MANAGER_FIRE, DIALOG_STYLE_INPUT, "Увольнение крупье", "Введите ник крупье:", "Уволить", "Назад");
            case 2: Dialog(playerid, DIALOG_CASINO_MANAGER_HIRE, DIALOG_STYLE_INPUT, "Приём крупье", "Введите ID игрока:", "Предложить", "Назад");
        }
        return 1;
    }

    if(dialogid == DIALOG_CASINO_JOB_SELECT)
    {
        if(!response) return 1;

        pInfo[playerid][CasinoDiceBetPaid] = false;
        pInfo[playerid][CasinoDiceBetPaidTable] = 0;

        switch(GetPlayerData(playerid, P_CASINO_JOB))
        {
            case 1:
            {
                pInfo[playerid][CasinoDealerJob] = true;
                pInfo[playerid][CasinoManagerJob] = false;
                SetPlayerSkin(playerid, 173);
                ShowNotificationNew(playerid, 3, 6, 0, 0, "Вы надели форму крупье", " ");
            }
            case 2:
            {
                pInfo[playerid][CasinoDealerJob] = false;
                pInfo[playerid][CasinoManagerJob] = true;
                SetPlayerSkin(playerid, 170);
                ShowNotificationNew(playerid, 3, 6, 0, 0, "Вы надели форму менеджера", " ");
            }
            default: return SendClientMessage(playerid, 0xCECECEFF, "Вы не работаете в казино.");
        }
        return 1;
    }

    if(dialogid == DIALOG_CASINO_JOB_QUIT)
    {
        if(!response) return 1;

        if(pInfo[playerid][CasinoDealerJob] || pInfo[playerid][CasinoManagerJob])
        {
            for(new idx = 0; idx < sizeof g_casino_table_dealer; idx++)
            {
                if(g_casino_table_dealer[idx] != playerid) continue;

                g_casino_table_dealer[idx] = INVALID_PLAYER_ID;
                g_casino_table_bet[idx] = 1000;
                g_casino_table_bet_set[idx] = false;

                if(g_casino_round_active[idx]) StopCasinoDiceRound(idx);
            }
        }

        if(pInfo[playerid][CasinoDiceUiOpen])
        {
            HideCasinoDiceUi(playerid);
        }

        pInfo[playerid][CasinoDealerJob] = false;
        pInfo[playerid][CasinoManagerJob] = false;
        pInfo[playerid][CasinoDiceBetPaid] = false;
        pInfo[playerid][CasinoDiceBetPaidTable] = 0;

        SetPlayerSkin(playerid, GetPlayerSkinEx(playerid));
        ShowNotificationNew(playerid, 2, 6, 0, 0, "Вы сняли рабочую форму", " ");
        return 1;
    }
    if(dialogid == DIALOG_CASINO_TABLE_SETBET)
    {
        if(!response)
        {
            if(pInfo[playerid][CasinoDiceUiOpen]) SelectTextDraw(playerid, 0xFF5252FF);
            return 1;
        }

        if(!pInfo[playerid][CasinoDiceUiOpen]) return 1;

        new table_idx = pInfo[playerid][CasinoDiceTable] - 1;
        if(!(0 <= table_idx < sizeof g_casino_table_pos))
        {
            HideCasinoDiceUi(playerid);
            return ShowNotificationNew(playerid, 2, 6, 0, 0, "Стол больше недоступен", " ");
        }
        if(!IsPlayerCasinoDealer(playerid, table_idx))
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Только крупье или менеджер может установить ставку", " ");
            return 1;
        }

        if(g_casino_round_active[table_idx])
        {
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Игра уже началась", " ");
            return 1;
        }

        new bet = strval(inputtext);
        if(!(1000 <= bet <= 1000000000))
        {
            ShowPlayerDialog
            (
                playerid,
                DIALOG_CASINO_TABLE_SETBET,
                DIALOG_STYLE_INPUT,
                "{FF0000}Установки ставки для игры:",
                "Ставка должна быть не менее 1000 рублей и не более 1000000000",
                "Далее",
                "Отмена"
            );
            return 1;
        }

        g_casino_table_bet[table_idx] = bet;
        g_casino_table_bet_set[table_idx] = true;
        pInfo[playerid][CasinoDiceBet] = bet;
        ResetCasinoTablePaidPlayers(table_idx);

        RefreshCasinoDicePlayersListForTable(table_idx);
        ShowNotificationNew(playerid, 3, 6, 0, 0, "Ставка успешно установлена", " ");

        if(pInfo[playerid][CasinoDiceUiOpen]) SelectTextDraw(playerid, 0xFF5252FF);

        return 1;
    }

    if(dialogid == DIALOG_CASINO_TABLE_TARGET)
    {
        if(!response)
        {
            if(pInfo[playerid][CasinoDiceUiOpen]) SelectTextDraw(playerid, 0xFF5252FF);
            return 1;
        }

        if(!IsPlayerInRangeOfAnyCasinoTable(playerid))
        {
            HideCasinoDiceUi(playerid);
            return SendClientMessage(playerid, 0x999999FF, "You left the casino table area");
        }

        new target = strval(inputtext);
        if(!IsPlayerConnected(target) || target == playerid)
        {
            SendClientMessage(playerid, 0x999999FF, "Invalid player ID");
            ShowPlayerDialog(playerid, DIALOG_CASINO_TABLE_TARGET, DIALOG_STYLE_INPUT, "Casino: Opponent", "Enter player ID for invite", "Send", "Cancel");
            return 1;
        }

        if(!IsPlayerLogged(target))
        {
            SendClientMessage(playerid, 0x999999FF, "Player is not authorized");
            ShowPlayerDialog(playerid, DIALOG_CASINO_TABLE_TARGET, DIALOG_STYLE_INPUT, "Casino: Opponent", "Enter player ID for invite", "Send", "Cancel");
            return 1;
        }

        new lobby_bet = pInfo[playerid][CasinoDiceBet];
        if(!(1 <= lobby_bet <= 1000000)) lobby_bet = 1000;

        new cmd_params[32];
        format(cmd_params, sizeof cmd_params, "%d %d", target, lobby_bet);

        callcmd::dice(playerid, cmd_params);

        HideCasinoDiceUi(playerid);

        return 1;
    }

	if(dialogid == DIALOG_ID_EDITACS_SELECT)
    {
        if(!response) return 1;

        new slot = -1;
        new tmp = 0;

        for(new i = 0; i < MAX_PLAYER_ATTACHED_OBJECTS; i++)
        {
            if(IsPlayerAttachedObjectSlotUsed(playerid, i))
            {
                if(tmp == listitem)
                {
                    slot = i;
                    break;
                }
                tmp++;
            }
        }

        if(slot == -1 || !IsPlayerAttachedObjectSlotUsed(playerid, slot))
        {
            SendClientMessage(playerid, -1, "{FF0000}Ошибка: Неверный слот.");
            return 1;
        }

        SetPVarInt(playerid, "EditingAccSlot", slot);
        ShowEditAccessoryDialog(playerid, slot);
        return 1;
    }

    if(dialogid == DIALOG_ID_EDITACS_EDIT)
    {
        if(!response) return 1;

        new slot = GetPVarInt(playerid, "EditingAccSlot");
        if(!IsValidAccessorySlot(playerid, slot))
        {
            SendClientMessage(playerid, -1, "{FF0000}Ошибка: Неверный слот.");
            return 1;
        }

        if(listitem == 6)
        {
            if(SaveAccessoryChanges(playerid, slot))
            {
                SendClientMessage(playerid, -1, "{00FF00}Изменения успешно сохранены в базу данных!");
            }
            return 1;
        }

        SetPVarInt(playerid, "EditingAccParam", listitem);

        new param_names[6][] = {"Z", "Y", "X", "RotX", "RotY", "RotZ"};
        new dialog_text[512];

        format(dialog_text, sizeof(dialog_text),
            "Выбран параметр: %s\n\
            \n{FFFF00}=== Варианты изменения ===\n\
            Переместить в положительную сторону (+)\n\
