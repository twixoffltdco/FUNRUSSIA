            case DIALOG_ORG_CAR_GET:
	        {
	            if(!response) return 1;
	            new fmt_text[100];
	            new action_id = GetPlayerListitemValue(playerid, 0);

            if(g_lmenu_fleet_pick[playerid])
            {
                listitem = g_lmenu_fleet_slot[playerid];
                g_lmenu_fleet_pick[playerid] = false;
            }
            if(listitem < 0 || listitem >= 4 || g_org_car[action_id][O_MODEL][listitem] == 0) return 1;
            if(GetPlayerJob(playerid) < g_org_car_use_rank[action_id][listitem])
            {
                new access_msg[160];
                format(access_msg, sizeof(access_msg), "Для этого автомобиля нужен минимум %d ранг.", g_org_car_use_rank[action_id][listitem]);
                return SendClientMessage(playerid, -1, access_msg);
            }

            new selected_model_name[64];
            GetVehicleModelName(g_org_car[action_id][O_MODEL][listitem], selected_model_name, sizeof(selected_model_name));
	            format(fmt_text, sizeof fmt_text, ""SC"Вы взяли транспорт {ffff00}%s", selected_model_name);
	            SendClientMessage(playerid, -1, fmt_text);
	            SendClientMessage(playerid, -1, ""SC"Если вы не будете использовать транспорт в течении двух минут, он будет удален");

	            new buy_cars_count = 0;

            new Float: pos_x = org_car_pos_spawn[action_id][0][0];
            new Float: pos_y = org_car_pos_spawn[action_id][0][1];
            new Float: pos_z = org_car_pos_spawn[action_id][0][2];
            new Float: angle = org_car_pos_spawn[action_id][0][3];

            if(action_id == 4 && g_org_car[action_id][O_MODEL][listitem] == 2570 && GetPlayerJob(playerid) < 7)
            {
                return SendClientMessage(playerid, -1, "\xc2\xfb \xed\xe5 \xe8\xec\xe5\xe5\xf2\xe5 \xe4\xee\xf1\xf2\xf3\xef\xe0 \xea \xe0\xe2\xf2\xee\xec\xee\xe1\xe8\xeb\xfe Bugatti. \xcd\xf3\xe6\xe5\xed 7-\xe9 \xf0\xe0\xed\xe3 \xc3\xc8\xc1\xc4\xc4.");
            }

            new vehicleid = CreateVehicle(g_org_car[action_id][O_MODEL][listitem], pos_x, pos_y, pos_z, angle, g_org_car[action_id][O_COLOR][0], g_org_car[action_id][O_COLOR][1], 120, 0, VEHICLE_ACTION_ORG_CAR, g_org_car[action_id][O_FRAC_ID]);
            SetVehicleData(vehicleid, V_ACTION_OWNER, playerid);
            SetPVarInt(playerid, "gov_fleet_action", action_id);
            SetPVarInt(playerid, "gov_fleet_slot", listitem);

            if(action_id >= 4 && action_id <= 6 && g_gov_fleet_strobe[action_id][listitem] > 0)
            {
                vInfo[vehicleid][vStrob] = g_gov_fleet_strobe[action_id][listitem];
                vInfo[vehicleid][strab_current] = 27 + g_gov_fleet_strobe[action_id][listitem];
                EnableStrob[vehicleid] = true;
                SetVehicleStroboscope(vehicleid, g_gov_fleet_strobe[action_id][listitem] - 1, 0);
            }

            // Гос. организации получают синие гос. номера в стиле Silver/Amigo.
            // Тип 5 — синий номер, формат: B 9196 / регион 52.
            if(action_id >= 0 && action_id <= 6)
            {
                new gov_plate[16];
                RandomGovNumberPlate(gov_plate, sizeof(gov_plate));
                SetVehicleNumberPlateEx(vehicleid, 5, gov_plate, "52");
            }

            // Автопарк ОПГ получает номера по логике amigo.pwn.
            if(action_id >= 7 && action_id <= 9)
            {
                new opg_plate[16];
                RandomOPGNumberPlate(opg_plate, sizeof(opg_plate));
                SetVehicleNumberPlateEx(vehicleid, TYPE_RU, opg_plate, "52");
            }

	            // \xd4\xd1\xc1: \xe2\xe8\xed\xe8\xeb\xfb \xe8\xe7 amigo.pwn.
            if(action_id == 6)
            {
                new fsb_vinyl[32];
                fsb_vinyl[0] = EOS;
                switch(listitem)
                {
                    case 0: format(fsb_vinyl, sizeof(fsb_vinyl), "remapfbody4");
                    case 1: format(fsb_vinyl, sizeof(fsb_vinyl), "remapvehicles");
                    case 2: format(fsb_vinyl, sizeof(fsb_vinyl), "remapfbody3");
                    default: format(fsb_vinyl, sizeof(fsb_vinyl), "remapvehicles");
                }
                format(vInfo[vehicleid][vynil_name], 32, "%s", fsb_vinyl);
                format(vInfo[vehicleid][vVinylTexture], 16, "%s", fsb_vinyl);
                vInfo[vehicleid][vVinyl] = 1;
                for(new i = 0; i < MAX_PLAYERS; i++)
                {
                    if(IsPlayerConnected(i))
                        SetVehicleVinylForPlayer(i, vehicleid, fsb_vinyl);
                }
            }

            if(action_id == 4 && g_org_car[action_id][O_MODEL][listitem] == 2570)
	            {
	                format(vInfo[vehicleid][vynil_name], 32, "remapfbody2");
	                format(vInfo[vehicleid][vVinylTexture], 16, "remapfbody2");
	                vInfo[vehicleid][vVinyl] = 1;

	                for(new i = 0; i < MAX_PLAYERS; i++)
	                {
	                    if(IsPlayerConnected(i))
	                        SetVehicleVinylForPlayer(i, vehicleid, "remapfbody2");
	                }
	            }

	            SetPlayerData(playerid, P_FRACTION_CAR, vehicleid);

	        }
