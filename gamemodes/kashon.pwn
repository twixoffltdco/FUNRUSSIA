	Dialog
	(
		playerid, DIALOG_REPORT, DIALOG_STYLE_INPUT,
		"{FFCD00}Связь с администрацией",
		"{FFFFFF}Вы собираетесь написать Администрации сервера\n\
		{FFFFFF}Перед тем как отправить сообщение\n\
