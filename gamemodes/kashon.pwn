stock SilverOpgKppOpenGate(gateid)
{
    if(gateid < 0 || gateid >= sizeof g_silver_gates) return 0;
    if(g_silver_gates[gateid][sg_opened]) return 1;

    MoveDynamicObject(
        g_silver_gates[gateid][sg_object],
        g_silver_gates[gateid][sg_open_x],
        g_silver_gates[gateid][sg_open_y],
        g_silver_gates[gateid][sg_open_z],
        g_silver_gates[gateid][sg_open_speed],
        g_silver_gates[gateid][sg_open_rx],
        g_silver_gates[gateid][sg_open_ry],
        g_silver_gates[gateid][sg_open_rz]
    );
    g_silver_gates[gateid][sg_opened] = true;
    return 1;
}

stock SilverOpgKppCloseGate(gateid)
{
    if(gateid < 0 || gateid >= sizeof g_silver_gates) return 0;
    if(!g_silver_gates[gateid][sg_opened]) return 1;

    MoveDynamicObject(
        g_silver_gates[gateid][sg_object],
        g_silver_gates[gateid][sg_close_x],
        g_silver_gates[gateid][sg_close_y],
        g_silver_gates[gateid][sg_close_z],
        g_silver_gates[gateid][sg_close_speed],
        g_silver_gates[gateid][sg_close_rx],
        g_silver_gates[gateid][sg_close_ry],
        g_silver_gates[gateid][sg_close_rz]
    );
    g_silver_gates[gateid][sg_opened] = false;
    return 1;
}

stock bool:SilverOpgKppNearGate(playerid)
{
    for(new i = 0; i < 2; i++)
    {
        if(IsPlayerInRangeOfPoint(
            playerid,
            SILVER_OPG_KPP_RADIUS,
            g_silver_gates[i][sg_trigger_x],
            g_silver_gates[i][sg_trigger_y],
            g_silver_gates[i][sg_trigger_z]
        )) return true;
    }
    return false;
}

stock bool:SilverOpgKppCountPlayers(team, &players, &senior)
{
    players = 0;
    senior = 0;
    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i) || !IsPlayerLogged(i)) continue;
        if(GetPlayerTeamEx(i) != team) continue;
        if(!SilverOpgKppNearGate(i)) continue;
        players++;
        if(GetPlayerJob(i) >= SILVER_OPG_MAT_RAID_MIN_RANK) senior++;
    }
    return true;
}

stock SilverOpgKppStart(playerid)
{
    new team = GetPlayerTeamEx(playerid);
    if(!IsSilverOpgMaterialRaidTeam(team))
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Взлом КПП доступен только ОПГ."), 1;
    if(!SilverOpgMaterialRaidCheckTime(playerid)) return 1;
    if(g_opg_kpp_hacker != INVALID_PLAYER_ID)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}КПП уже взламывается. Дождитесь окончания."), 1;

    new now = gettime();
    if(g_opg_mat_raid_started && now > g_opg_mat_raid_until)
        SilverOpgMaterialRaidReset();
    if(g_opg_mat_raid_started)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Сейчас уже идёт ограбление ВЧ."), 1;
    if(g_opg_mat_raid_last > now)
    {
        new left = g_opg_mat_raid_last - now;
        new msg[120];
        format(msg, sizeof msg, "{FF5533}Следующее ограбление будет доступно через %d мин.", (left + 59) / 60);
        return SendClientMessage(playerid, 0x999999FF, msg), 1;
    }
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Взламывать КПП нужно пешком."), 1;
    if(!SilverOpgKppNearGate(playerid))
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}Подойдите к КПП военной части."), 1;

    new players, senior;
    SilverOpgKppCountPlayers(team, players, senior);
    if(GetPlayerJob(playerid) < 10 && players < SILVER_OPG_MAT_RAID_MIN_PLAYERS)
    {
        new msg[120];
        format(msg, sizeof msg, "{FF5533}Для ограбления нужно минимум %d участников ОПГ у КПП. Сейчас: %d.", SILVER_OPG_MAT_RAID_MIN_PLAYERS, players);
        return SendClientMessage(playerid, 0x999999FF, msg), 1;
    }
    if(GetPlayerJob(playerid) < 10 && senior < 1)
        return SendClientMessage(playerid, 0x999999FF, "{FF5533}У КПП должен находиться участник ОПГ с 6+ рангом."), 1;

    g_opg_kpp_hacker = playerid;
    ShowPlayerProgress(playerid, 0, 0, 100, 100, 1, 250, "ВЗЛОМ КПП.. ПОДОЖДИТЕ..");
    SetPVarInt(playerid, "opg_kpp_team", team);
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    SetPVarFloat(playerid, "opg_kpp_x", px);
    SetPVarFloat(playerid, "opg_kpp_y", py);
    SetPVarFloat(playerid, "opg_kpp_z", pz);

    new msg[180];
    format(msg, sizeof msg, "[ТРЕВОГА] ОПГ %s начала взлом КПП ВЧ. Взлом займёт %d секунд.", GetTeamName(team), SILVER_OPG_KPP_HACK_TIME);
    SilverOpgMaterialRaidNotify(team, msg);
    SendClientMessage(playerid, 0xFFCD00FF, "{FFCD00}Взлом КПП начат. Не отходите от КПП и не умирайте.");
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 1, 0, 1);
    SetTimerEx("SilverOpgKppFinish", SILVER_OPG_KPP_HACK_TIME * 1000, false, "i", playerid);
    return 1;
}

public SilverOpgKppFinish(playerid)
{
    if(g_opg_kpp_hacker != playerid) return 1;
    g_opg_kpp_hacker = INVALID_PLAYER_ID;
    if(!IsPlayerConnected(playerid)) return 1;
    ShowPlayerProgress(playerid, 1, 0, 0, 0, 0, 0, "");

    new team = GetPVarInt(playerid, "opg_kpp_team");
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    new Float:dx = px - GetPVarFloat(playerid, "opg_kpp_x");
    new Float:dy = py - GetPVarFloat(playerid, "opg_kpp_y");
    new Float:dz = pz - GetPVarFloat(playerid, "opg_kpp_z");
    new bool:ok = true;
    if(!IsSilverOpgMaterialRaidTeam(team) || GetPlayerTeamEx(playerid) != team) ok = false;
    if(GetPlayerState(playerid) == PLAYER_STATE_WASTED || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) ok = false;
    if(!SilverOpgKppNearGate(playerid)) ok = false;
    if((dx * dx + dy * dy + dz * dz) > 36.0) ok = false;

    DeletePVar(playerid, "opg_kpp_team");
    DeletePVar(playerid, "opg_kpp_x");
    DeletePVar(playerid, "opg_kpp_y");
    DeletePVar(playerid, "opg_kpp_z");
    ClearAnimations(playerid);

    if(!ok)
    {
        SendClientMessage(playerid, 0xFF5533FF, "{FF5533}Взлом КПП провален. Вы покинули точку взлома.");
        SilverOpgMaterialRaidNotify(team, "[ТРЕВОГА] Взлом КПП ВЧ провален.");
        return 1;
    }

    new now = gettime();
    g_opg_mat_raid_started = 1;
    g_opg_mat_raid_team = team;
    g_opg_mat_raid_total = 0;
    g_opg_mat_raid_until = now + SILVER_OPG_MAT_RAID_DURATION;
    g_opg_mat_raid_last = now + SILVER_OPG_MAT_RAID_COOLDOWN;
    g_opg_kpp_open_until = now + SILVER_OPG_KPP_OPEN_TIME;

    SilverOpgKppOpenGate(0);
    SilverOpgKppOpenGate(1);
    if(g_opg_kpp_close_timer != -1) KillTimer(g_opg_kpp_close_timer);
    g_opg_kpp_close_timer = SetTimer("SilverOpgKppClose", SILVER_OPG_KPP_OPEN_TIME * 1000, false);

    new msg[180];
    format(msg, sizeof msg, "[ТРЕВОГА] ОПГ %s взломала КПП ВЧ! Ворота открыты %d секунд.", GetTeamName(team), SILVER_OPG_KPP_OPEN_TIME);
    SilverOpgMaterialRaidNotify(team, msg);
    SendClientMessage(playerid, 0x66CC33FF, "{66CC33}КПП взломано! Можно проникать на ВЧ и грузить материалы.");
    return 1;
}

public SilverOpgKppClose()
{
    g_opg_kpp_close_timer = -1;
    SilverOpgKppCloseGate(0);
    SilverOpgKppCloseGate(1);
    g_opg_kpp_open_until = 0;
    if(g_opg_mat_raid_started)
        SilverOpgMaterialRaidNotify(g_opg_mat_raid_team, "[ВЧ] КПП военной части закрылось.");
    return 1;
}

stock SilverGateSystem_Init()
{
    for(new i = 0; i < sizeof g_silver_gates; i++)
    {
        g_silver_gates[i][sg_object] = CreateDynamicObject(
            g_silver_gates[i][sg_model],
            g_silver_gates[i][sg_close_x],
            g_silver_gates[i][sg_close_y],
            g_silver_gates[i][sg_close_z],
            g_silver_gates[i][sg_close_rx],
            g_silver_gates[i][sg_close_ry],
            g_silver_gates[i][sg_close_rz],
            -1, -1, -1
        );
        g_silver_gates[i][sg_label] = Text3D:INVALID_3DTEXT_ID;
    }

    for(new i = 0; i < sizeof g_silver_doors; i++)
    {
        g_silver_doors[i][sd_object] = CreateDynamicObject(
            g_silver_doors[i][sd_model],
            g_silver_doors[i][sd_close_x],
            g_silver_doors[i][sd_close_y],
            g_silver_doors[i][sd_close_z],
            g_silver_doors[i][sd_close_rx],
            g_silver_doors[i][sd_close_ry],
            g_silver_doors[i][sd_close_rz],
            -1, -1, -1
        );

        // Door interaction zones must work inside every interior/virtual world.
        // Streamer defaults to world 0, which prevented interaction in faction interiors.
        g_silver_doors[i][sd_area] = CreateDynamicSphere(
            g_silver_doors[i][sd_close_x],
            g_silver_doors[i][sd_close_y],
            g_silver_doors[i][sd_close_z],
            3.0,
            -1, -1, -1
        );
        CreateDynamic3DTextLabel(
            "{FFCC00}Склад\n{FFFFFF}Управление дверью: /door",
            0xFFFFFFFF,
            g_silver_doors[i][sd_close_x],
            g_silver_doors[i][sd_close_y],
            g_silver_doors[i][sd_close_z] + 1.0,
            8.0,
            INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1
        );
    }

    return 1;
}

stock SilverGate_Toggle(playerid, gateid)
{
    if(gateid < 0 || gateid >= sizeof g_silver_gates) return 0;
    new hacked_access = (gateid <= 1 && g_opg_kpp_open_until > gettime() && IsSilverOpgMaterialRaidTeam(GetPlayerTeamEx(playerid)));
    if(!hacked_access && !SilverGate_CanUse(playerid, g_silver_gates[gateid][sg_team], g_silver_gates[gateid][sg_minrank]))
        return 0;
    if(hacked_access && g_silver_gates[gateid][sg_opened]) return 1;

    if(!g_silver_gates[gateid][sg_opened])
    {
        MoveDynamicObject(
            g_silver_gates[gateid][sg_object],
            g_silver_gates[gateid][sg_open_x],
            g_silver_gates[gateid][sg_open_y],
            g_silver_gates[gateid][sg_open_z],
            g_silver_gates[gateid][sg_open_speed],
            g_silver_gates[gateid][sg_open_rx],
            g_silver_gates[gateid][sg_open_ry],
            g_silver_gates[gateid][sg_open_rz]
        );
        g_silver_gates[gateid][sg_opened] = true;
    }
    else
    {
        MoveDynamicObject(
            g_silver_gates[gateid][sg_object],
            g_silver_gates[gateid][sg_close_x],
            g_silver_gates[gateid][sg_close_y],
            g_silver_gates[gateid][sg_close_z],
            g_silver_gates[gateid][sg_close_speed],
            g_silver_gates[gateid][sg_close_rx],
            g_silver_gates[gateid][sg_close_ry],
            g_silver_gates[gateid][sg_close_rz]
        );
        g_silver_gates[gateid][sg_opened] = false;
    }

    return 1;
}

stock SilverDoor_Toggle(playerid, doorid)
{
    if(doorid < 0 || doorid >= sizeof g_silver_doors) return 0;
    if(!SilverGate_CanUse(playerid, g_silver_doors[doorid][sd_team], 1))
        return 0;

    if(!g_silver_doors[doorid][sd_opened])
    {
        MoveDynamicObject(
            g_silver_doors[doorid][sd_object],
            g_silver_doors[doorid][sd_open_x],
            g_silver_doors[doorid][sd_open_y],
            g_silver_doors[doorid][sd_open_z],
            g_silver_doors[doorid][sd_open_speed],
            g_silver_doors[doorid][sd_open_rx],
            g_silver_doors[doorid][sd_open_ry],
            g_silver_doors[doorid][sd_open_rz]
        );
        g_silver_doors[doorid][sd_opened] = true;
        SetTimerEx("SilverDoor_CloseLater", 5000, false, "i", doorid);
    }
    else
    {
        SilverDoor_Close(doorid);
    }

    return 1;
}

stock SilverDoor_Close(doorid)
{
    if(doorid < 0 || doorid >= sizeof g_silver_doors) return 0;

    MoveDynamicObject(
        g_silver_doors[doorid][sd_object],
        g_silver_doors[doorid][sd_close_x],
        g_silver_doors[doorid][sd_close_y],
        g_silver_doors[doorid][sd_close_z],
        g_silver_doors[doorid][sd_close_speed],
        g_silver_doors[doorid][sd_close_rx],
        g_silver_doors[doorid][sd_close_ry],
        g_silver_doors[doorid][sd_close_rz]
    );
    g_silver_doors[doorid][sd_opened] = false;
    return 1;
}

forward SilverDoor_CloseLater(doorid);
public SilverDoor_CloseLater(doorid)
{
    if(doorid < 0 || doorid >= sizeof g_silver_doors) return 1;
    if(g_silver_doors[doorid][sd_opened])
        SilverDoor_Close(doorid);
    return 1;
}

stock SilverGateSystem_OnKeyStateChange(playerid, newkeys)
{
    if(!(newkeys & KEY_CROUCH)) return 0;

    for(new i = 0; i < sizeof g_silver_gates; i++)
    {
        if(IsPlayerInRangeOfPoint(
            playerid,
            g_silver_gates[i][sg_trigger_radius],
            g_silver_gates[i][sg_trigger_x],
            g_silver_gates[i][sg_trigger_y],
            g_silver_gates[i][sg_trigger_z]
        ))
        {
            SilverGate_Toggle(playerid, i);
            return 1;
        }
    }

    return 0;
}

stock SilverGateSystem_OnEnterArea(playerid, areaid)
{
    for(new i = 0; i < sizeof g_silver_doors; i++)
    {
        if(areaid == g_silver_doors[i][sd_area])
        {
            // Door operation uses /door; do not show the mobile interaction button here.
            return 1;
        }
    }

    return 0;
}

CMD:door(playerid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
        return SendClientMessage(playerid, 0xFF5533FF, "Взаимодействовать с дверью можно только пешком."), 1;

    for(new i = 0; i < sizeof g_silver_doors; i++)
    {
        // Dynamic-area membership is preferred; coordinate fallback supports mobile clients
        // and doors inside streamed interiors where area callbacks may be unreliable.
        if(IsPlayerInDynamicArea(playerid, g_silver_doors[i][sd_area]) ||
            IsPlayerInRangeOfPoint(playerid, 3.0,
                g_silver_doors[i][sd_close_x],
                g_silver_doors[i][sd_close_y],
                g_silver_doors[i][sd_close_z]))
        {
            if(!SilverGate_CanUse(playerid, g_silver_doors[i][sd_team], 1))
                return SendClientMessage(playerid, 0xFF5533FF, "У вас нет доступа к этой двери."), 1;
            return SilverDoor_Toggle(playerid, i);
        }
    }

    SendClientMessage(playerid, 0xFF0000FF, "Подойдите ближе к двери и используйте /door.");
    return 1;
}

CMD:hackkpp(playerid)
{
    return SilverOpgKppStart(playerid);
}

stock ShowPlayerGUI(playerid, guiid, Node:json)
{
	JSON_SetInt(json, "o", 1);
	OnPacketIncoming(playerid, guiid, json);
}
stock UpdatePlayerGUI(playerid, guiid, Node:json)
{
	OnPacketIncoming(playerid, guiid, json);
}
stock HidePlayerGUI(playerid, guiid)
{
	new Node:json = JSON_Object();
	JSON_SetInt(json, "c", 1);
	OnPacketIncoming(playerid, guiid, json);
}

stock OnPacketIncoming(playerid, guiid, Node:json)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT8, PACKET_BLACKRRPC);

	BS_WriteValue(bitstream, PR_UINT16, guiid);

	static data[8192];
    JSON_Stringify(json, data, sizeof data);

    BS_WriteValue(bitstream, PR_UINT32, strlen(data));
    BS_WriteValue(bitstream, PR_STRING, data);

	PR_SendPacket(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);
	BS_Delete(bitstream);
}

stock ResetCarModes(playerid, vehicleid)
{
    if(!IsAOwnableCar(vehicleid)) return 0;
    static const modes[] = { 8, 9, 10, 11 };

    new JSON:tmp = JSON_Object();

    for (new i = 0; i < sizeof(modes); i++)
    {
        JSON_SetInt(tmp, "t", modes[i]);
        JSON_SetInt(tmp, "s", 0);
        OnPacketIncoming(playerid, GUIRadialMenuForCar, tmp);
    }

    JSON_Cleanup(tmp);
	new i = GetVehicleData(vehicleid, V_ACTION_ID);
    if(i < 0 || i >= sizeof(vInfo) || i >= MAX_OWNABLE_CARS) return 0;
    vInfo[i][vFstate] = FSTATE_NONE;
    vInfo[vehicleid][vFstate] = FSTATE_NONE;
    SetOwnableCarData(i, OC_FSTATE, FSTATE_NONE);
	SendCarFirmware(playerid, FSTATE_NONE);
    SetVehicleDriftForPlayer(playerid, vehicleid, 0);
	new query[75], Cache: result;
	new database_id = GetOwnableCarData(GetVehicleData(vehicleid, V_ACTION_ID), OC_SQL_ID);
	mysql_format(mysql, query, sizeof query,
        "UPDATE ownable_cars SET f_state = %d WHERE id = %d",
        FSTATE_NONE, database_id
    );
	mysql_query(mysql, query, false);
	printf("%d", database_id);
    TechCenter_ApplyPerformance(vehicleid);
    return 1;
}
stock CheckFirmwareLine(index, firmware_line)
{
    if(index < 0 || index >= MAX_OWNABLE_CARS) return 0;

    switch (firmware_line)
    {
        case FSTATE_COMFORT:
            return GetOwnableCarData(index, OC_COMFORT_PL) && GetOwnableCarData(index, OC_COMFORT1) && GetOwnableCarData(index, OC_COMFORT2) && GetOwnableCarData(index, OC_COMFORT3) && GetOwnableCarData(index, OC_COMFORT4);
        case FSTATE_SPORT:
            return GetOwnableCarData(index, OC_SPORT) && GetOwnableCarData(index, OC_SPORT1) && GetOwnableCarData(index, OC_SPORT2) && GetOwnableCarData(index, OC_SPORT3) && GetOwnableCarData(index, OC_SPORT4);
        case FSTATE_DRIFT:
            return GetOwnableCarData(index, OC_DRIFT) && GetOwnableCarData(index, OC_DRIFT1) && GetOwnableCarData(index, OC_DRIFT2) && GetOwnableCarData(index, OC_DRIFT3) && GetOwnableCarData(index, OC_DRIFT4);
        case FSTATE_SPORT_PLUS:
            return GetOwnableCarData(index, OC_SPORT_PL) && GetOwnableCarData(index, OC_SPORT_PL1) && GetOwnableCarData(index, OC_SPORT_PL2) && GetOwnableCarData(index, OC_SPORT_PL3) && GetOwnableCarData(index, OC_SPORT_PL4);
    }
    return 0;
}

stock TechCenter_SetFirmwareItemOwned(index, data_value)
{
    if(index < 0 || index >= MAX_OWNABLE_CARS) return 0;

    switch(data_value)
    {
        case 4:  { vInfo[index][vComfort] = 1;    SetOwnableCarData(index, OC_COMFORT_PL, 1); }
        case 5:  { vInfo[index][vSport] = 1;      SetOwnableCarData(index, OC_SPORT, 1); }
        case 6:  { vInfo[index][vDrift] = 1;      SetOwnableCarData(index, OC_DRIFT, 1); }
        case 7:  { vInfo[index][vSportPlus] = 1;  SetOwnableCarData(index, OC_SPORT_PL, 1); }

        case 9:  { vInfo[index][vComfort1] = 1;   SetOwnableCarData(index, OC_COMFORT1, 1); }
        case 10: { vInfo[index][vSport1] = 1;     SetOwnableCarData(index, OC_SPORT1, 1); }
        case 11: { vInfo[index][vDrift1] = 1;     SetOwnableCarData(index, OC_DRIFT1, 1); }
        case 12: { vInfo[index][vSportPlus1] = 1; SetOwnableCarData(index, OC_SPORT_PL1, 1); }

        case 14: { vInfo[index][vComfort2] = 1;   SetOwnableCarData(index, OC_COMFORT2, 1); }
        case 15: { vInfo[index][vSport2] = 1;     SetOwnableCarData(index, OC_SPORT2, 1); }
        case 16: { vInfo[index][vDrift2] = 1;     SetOwnableCarData(index, OC_DRIFT2, 1); }
        case 17: { vInfo[index][vSportPlus2] = 1; SetOwnableCarData(index, OC_SPORT_PL2, 1); }

        case 19: { vInfo[index][vComfort3] = 1;   SetOwnableCarData(index, OC_COMFORT3, 1); }
        case 20: { vInfo[index][vSport3] = 1;     SetOwnableCarData(index, OC_SPORT3, 1); }
        case 21: { vInfo[index][vDrift3] = 1;     SetOwnableCarData(index, OC_DRIFT3, 1); }
        case 22: { vInfo[index][vSportPlus3] = 1; SetOwnableCarData(index, OC_SPORT_PL3, 1); }

        case 24: { vInfo[index][vComfort4] = 1;   SetOwnableCarData(index, OC_COMFORT4, 1); }
        case 25: { vInfo[index][vSport4] = 1;     SetOwnableCarData(index, OC_SPORT4, 1); }
        case 26: { vInfo[index][vDrift4] = 1;     SetOwnableCarData(index, OC_DRIFT4, 1); }
        case 27: { vInfo[index][vSportPlus4] = 1; SetOwnableCarData(index, OC_SPORT_PL4, 1); }
        default: return 0;
    }
    return 1;
}

stock TechCenter_SyncFirmwareRuntime(index)
{
    if(index < 0 || index >= MAX_OWNABLE_CARS) return 0;

    vInfo[index][vComfort]    = GetOwnableCarData(index, OC_COMFORT_PL);
    vInfo[index][vSport]      = GetOwnableCarData(index, OC_SPORT);
    vInfo[index][vDrift]      = GetOwnableCarData(index, OC_DRIFT);
    vInfo[index][vSportPlus]  = GetOwnableCarData(index, OC_SPORT_PL);

    vInfo[index][vComfort1]   = GetOwnableCarData(index, OC_COMFORT1);
    vInfo[index][vSport1]     = GetOwnableCarData(index, OC_SPORT1);
    vInfo[index][vDrift1]     = GetOwnableCarData(index, OC_DRIFT1);
    vInfo[index][vSportPlus1] = GetOwnableCarData(index, OC_SPORT_PL1);

    vInfo[index][vComfort2]   = GetOwnableCarData(index, OC_COMFORT2);
    vInfo[index][vSport2]     = GetOwnableCarData(index, OC_SPORT2);
    vInfo[index][vDrift2]     = GetOwnableCarData(index, OC_DRIFT2);
    vInfo[index][vSportPlus2] = GetOwnableCarData(index, OC_SPORT_PL2);

    vInfo[index][vComfort3]   = GetOwnableCarData(index, OC_COMFORT3);
    vInfo[index][vSport3]     = GetOwnableCarData(index, OC_SPORT3);
    vInfo[index][vDrift3]     = GetOwnableCarData(index, OC_DRIFT3);
    vInfo[index][vSportPlus3] = GetOwnableCarData(index, OC_SPORT_PL3);

    vInfo[index][vComfort4]   = GetOwnableCarData(index, OC_COMFORT4);
    vInfo[index][vSport4]     = GetOwnableCarData(index, OC_SPORT4);
    vInfo[index][vDrift4]     = GetOwnableCarData(index, OC_DRIFT4);
    vInfo[index][vSportPlus4] = GetOwnableCarData(index, OC_SPORT_PL4);
    vInfo[index][vFstate]     = GetOwnableCarData(index, OC_FSTATE);
    return 1;
}

stock TechCenter_GetFirmwareLineByItem(data_value)
{
    switch(data_value)
    {
        case 4, 9, 14, 19, 24:  return FSTATE_COMFORT;
        case 5, 10, 15, 20, 25: return FSTATE_SPORT;
        case 6, 11, 16, 21, 26: return FSTATE_DRIFT;
        case 7, 12, 17, 22, 27: return FSTATE_SPORT_PLUS;
    }
    return FSTATE_NONE;
}

stock TechCenter_ActivateFirmwareIfComplete(playerid, vehicleid, database_id, data_value)
{
    if(!IsAOwnableCar(vehicleid)) return 0;
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index < 0 || index >= MAX_OWNABLE_CARS) return 0;

    new firmware_line = TechCenter_GetFirmwareLineByItem(data_value);
    if(firmware_line == FSTATE_NONE || !CheckFirmwareLine(index, firmware_line)) return 0;

    vInfo[index][vFstate] = firmware_line;
    vInfo[vehicleid][vFstate] = firmware_line;
    SetOwnableCarData(index, OC_FSTATE, firmware_line);

    new query[96];
    mysql_format(mysql, query, sizeof query,
        "UPDATE ownable_cars SET f_state = %d WHERE id = %d", firmware_line, database_id);
    mysql_query(mysql, query, false);

    SetVehicleDriftForPlayer(playerid, vehicleid, firmware_line == FSTATE_DRIFT);
    switch(firmware_line)
    {
        case FSTATE_COMFORT:    SendCarFirmware(playerid, FSTATE_COMFORT);
        case FSTATE_SPORT:      SendCarFirmware(playerid, FSTATE_SPORT);
        case FSTATE_SPORT_PLUS: SendCarFirmware(playerid, FSTATE_SPORT_PLUS);
    }

    TechCenter_ApplyPerformance(vehicleid);
    printf("[TECHCENTER][FIRMWARE] activated player=%d vehicle=%d car=%d item=%d state=%d", playerid, vehicleid, database_id, data_value, firmware_line);
    return 1;
}

#define PERCENT_COMFORT   4.25
#define PERCENT_SPORT     7.25
#define PERCENT_DRIFT     5.25
#define PERCENT_SPORTPLUS 0.53
stock GetFirmwarePrice(vehicleID, Float:percent)
{
    new car_price = GetVehiclePriceByModel(vInfo[vehicleID][vModelID]);
	printf("carprice %d", car_price);
	printf("carpriceper %d", floatround(car_price * (percent / 100.0)));
    return floatround(car_price * (percent / 100.0));
}

stock SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, bias)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, 1);
	new packed = _:bias;
BS_WriteValue(bs, PR_UINT32, packed);
    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}
stock SetVehicleSuspensionBiasFor(playerid, vehicleid, bias)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, 2);
	new packed = _:bias;
BS_WriteValue(bs, PR_UINT32, packed);
    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}
new bool:CarLights[MAX_VEHICLES];
new bool:CarLock[MAX_VEHICLES];
new bool:CarEngine[MAX_VEHICLES];
new bool:CarKey[MAX_VEHICLES];

// Do not parse or rewrite incoming PLAYER_SYNC (207), VEHICLE_SYNC (200) or

// Do not rewrite server -> client PLAYER/VEHICLE/PASSENGER sync here;

IRPC:115(playerid, BitStream:bs)
{
    new bool:take_damage;
    new targetid;
    new Float:damage;
    new weaponid;
    new bodypart;

    if(!BS_ReadBool(bs, take_damage)) return 0;
    if(!BS_ReadUint16(bs, targetid)) return 0;
    if(!BS_ReadFloat(bs, damage)) return 0;
    if(!BS_ReadUint32(bs, weaponid)) return 0;
    if(!BS_ReadUint32(bs, bodypart)) return 0;

    DamageRpc_Handle115(playerid, take_damage, targetid, damage, weaponid, bodypart);
    return 0;
}

