											"Стоимость:\t\t\t%d\n"\
											"Количество комнат:\t\t%d\n"\
											"Статус:\t\t\t\t%s\n\n"\
											"{FFFFFF}Вы можете посмотреть как выглядит дом\n"\
											"Для этого нажмите кнопку \"Фото\". {FFCD00}Услуга стоит 250 рублей",
											GetHouseData(houseid, H_NAME),
