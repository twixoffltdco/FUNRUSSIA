stock Market_GetSkinInternalId(modelid)
{
    // Full Fix's SkinMapping is modelId -> internalId.
    for(new i = 0; i < sizeof(SkinMapping); i++)
    {
        if(SkinMapping[i][0] == modelid) return SkinMapping[i][1];
    }

    // Compatibility with the compact catalog used by the old Marketplace.
    for(new i = 0; i < SKIN_CATALOG_COUNT; i++)
    {
        if(g_SkinCatalog[i][0] == modelid) return g_SkinCatalog[i][1];
    }
    return -1;
}

