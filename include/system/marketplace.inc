    stock GetItemName(item_id, name[], name_size)
    {
        name[0] = EOS;

        if(item_id == 134)
        {
            format(name, name_size, "\xd1\xea\xe8\xed");
            return 1;
        }

        if(Inventory11_IsAccessoryItem(item_id))
        {
            new canonical_id = Market_GetAccessoryCanonicalItemByStoredId(item_id);
            if(canonical_id > 0)
            {
                Market_GetAccessoryName(canonical_id, name, name_size);
                return 1;
            }
        }

        switch(item_id)
        {
            case 58: format(name, name_size, "SIM-") ;
            case 59: format(name, name_size, "SIM");
            case 81: format(name, name_size, "\xd0\xe5\xe4\xea\xe8\xe9 \xe1\xe8\xeb\xe5\xf2");
            case 82: format(name, name_size, "\xd0\xe5\xe4\xea\xe8\xe9 \xe1\xe8\xeb\xe5\xf2");
            case 83: format(name, name_size, "\xd0\xe5\xe4\xea\xe8\xe9 \xe1\xe8\xeb\xe5\xf2");
            default: format(name, name_size, "Item #%d", item_id);
        }
        return 1;
    }
#endif

