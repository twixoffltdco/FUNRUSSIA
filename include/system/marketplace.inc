stock Market_GetSkinName(modelid, name[], name_size)
{
    // Revix keeps the real skin names in the gamemode SkinNames[] table.
    // Use that bridge first so Marketplace shows the same names as the inventory.
    if(Market_GetSkinNameFromMod(modelid, name, name_size) && name[0] != EOS)
        return 1;

    // IMPORTANT: SkinNames[] is ordered by the position of the skin in the
    // donate catalog, not by the numeric internal id stored in SkinMapping.
    // Example: g_SkinCatalog contains {11588, 408}, but SkinNames[407] is
    // the actual "Одежда 11588" entry.
