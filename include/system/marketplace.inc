stock Marketplace_SendProfile(playerid)
{
    // ИСПРАВЛЕНО: status=1 в marketplace_history — это запись ПОКУПАТЕЛЯ,
    // а status=2 — запись ПРОДАВЦА (см. INSERT в Marketplace_ConfirmBuy).
    // "Всего продано товаров"/"Выручка" — это статистика ПРОДАЖ, поэтому
    // фильтруем по status=2, а не по status=1 (иначе считали покупки).
    // Также `price` уже хранит ПОЛНУЮ сумму сделки (price_за_шт*amount),
    // а не цену за единицу — умножать на `amount` ещё раз не нужно,
    // это давало переполнение/обнуление выручки.
    new query[384];
    mysql_format(mysql, query, sizeof(query),
        "SELECT COUNT(*) AS sold_count, IFNULL(SUM(`price`),0) AS total_revenue FROM `marketplace_history` WHERE `account_id`=%d AND `status`=2",
        GetPlayerAccountID(playerid));
    mysql_tquery(mysql, query, "Marketplace_OnProfileLoaded", "i", playerid);
    return 1;
}

