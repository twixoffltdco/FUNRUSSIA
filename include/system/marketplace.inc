stock MPReward_GetInvItemData(reward_item_id, &item_id, &item_count, item_plate[], plate_len, item_name[], name_len)
{
    if(reward_item_id <= 0) return 0;

    new query[192];
    mysql_format(mysql, query, sizeof(query),
        "SELECT `item_id`,`item_count`,`item_plate`,`item_name` FROM `marketplace_reward_items` WHERE `id`=%d LIMIT 1",
        reward_item_id);

    new Cache:result = mysql_query(mysql, query, true);
    if(!cache_num_rows())
    {
        cache_delete(result);
        return 0;
    }

    item_id = cache_get_field_content_int(0, "item_id", mysql);
    item_count = cache_get_field_content_int(0, "item_count", mysql);
    cache_get_field_content(0, "item_plate", item_plate, mysql, plate_len);
    cache_get_field_content(0, "item_name", item_name, mysql, name_len);
    cache_delete(result);

    if(item_count <= 0) item_count = 1;
    if(item_name[0] == EOS) GetItemName(item_id, item_name, name_len);
    return 1;
}

stock MPReward_DelInvItemData(reward_item_id)
{
    if(reward_item_id <= 0) return 0;

    // Remove both the reward payload and its /rewards row synchronously.
    // This prevents the GUI from immediately reloading an already claimed item
    // because the second DELETE was sent asynchronously.
    new query[256];
    mysql_format(mysql, query, sizeof(query), "DELETE FROM `marketplace_reward_items` WHERE `id`=%d LIMIT 1", reward_item_id);
    new Cache:item_result = mysql_query(mysql, query, true);
    new removed = cache_affected_rows(mysql);
    cache_delete(item_result);
    if(!removed) return 0;

    mysql_format(mysql, query, sizeof(query), "DELETE FROM `rewards` WHERE `award_id`=%d AND `case_id`=%d", reward_item_id, MARKETPLACE_REWARD_CASE_ID);
    new Cache:reward_result = mysql_query(mysql, query, true);
    cache_delete(reward_result);
    return 1;
}

stock bool:MPReward_GetCaseAwardData(award_index, &award_type, &internal_id, &award_count, award_name[], name_size, &spray_price)
{
    new plate[32];
    if(!MPReward_GetInvItemData(award_index, internal_id, award_count, plate, sizeof(plate), award_name, name_size)) return false;

    award_type = 11;
    spray_price = 0;
    return true;
}

stock MPReward_GiveToPlayer(playerid, reward_item_id)
{
    if(!IsPlayerLogged(playerid) || reward_item_id <= 0) return 0;

    new query[320];
    mysql_format(mysql, query, sizeof(query),
        "SELECT `item_id`,`item_count`,`item_plate`,`item_name` FROM `marketplace_reward_items` WHERE `id`=%d AND `account_id`=%d LIMIT 1",
        reward_item_id, GetPlayerAccountID(playerid));

    new Cache:result = mysql_query(mysql, query, true);
    if(!cache_num_rows())
    {
        cache_delete(result);
        return 0;
    }

    new item_id = cache_get_field_content_int(0, "item_id", mysql);
    new item_count = cache_get_field_content_int(0, "item_count", mysql);
    new item_plate[32], item_name[64];
    cache_get_field_content(0, "item_plate", item_plate, mysql, sizeof(item_plate));
    cache_get_field_content(0, "item_name", item_name, mysql, sizeof(item_name));
    cache_delete(result);

    if(item_count <= 0) item_count = 1;

    // Marketplace uses Inventory11 in Revix. Never call the old Inventory_AddItem here:
    // it writes to the legacy inventory and is the reason /reward could appear to do nothing.
    new add_slot = -1;
    new bool:added = false;

    if(item_id == 134)
    {
        new skin_model = Market_GetSkinModelByStoredId(item_count);
        if(skin_model <= 0) skin_model = item_count;

        if(!IsValidSkinModel(skin_model))
        {
            printf("[MPReward] Invalid skin model: reward=%d stored=%d", reward_item_id, item_count);
            return 0;
        }

        added = Inventory11_AddSkinToInventory(playerid, skin_model, 0);
    }
    else if(Inventory11_IsAccessoryItem(item_id))
    {
        new acc_model = item_count;
        if(acc_model <= 0) acc_model = Inv11_GetAccModelByItem(item_id);
        if(acc_model <= 0) return 0;

        add_slot = Inventory11_AddItemToDatabase(playerid, item_id, acc_model, 1, 0, 0);
        added = (add_slot != -1);
    }
    else
    {
        add_slot = Inventory11_AddItemToDatabase(playerid, item_id, 0, item_count, 0, 0);
        added = (add_slot != -1);
    }

    if(!added)
    {
        ShowNotificationSile(playerid, 2, 5, -1, -1, "\xcd\xe5 \xf3\xe4\xe0\xeb\xee\xf1\xfc \xe4\xee\xe1\xe0\xe2\xe8\xf2\xfc \xef\xf0\xe5\xe4\xec\xe5\xf2 \xe2 \xe8\xed\xe2\xe5\xed\xf2\xe0\xf0\xfc.", "");
        return 0;
    }

    if(!MPReward_DelInvItemData(reward_item_id))
    {
        // Do not leave a claimed reward duplicated. The Inventory11 insert is authoritative;
        // if deletion failed, keep the reward row so the player can retry after DB recovery.
        ShowNotificationSile(playerid, 2, 5, -1, -1, "\xcd\xe5 \xf3\xe4\xe0\xeb\xee\xf1\xfc \xef\xee\xeb\xf3\xf7\xe8\xf2\xfc \xed\xe0\xe3\xf0\xe0\xe4\xf3. \xcf\xee\xef\xf0\xee\xe1\xf3\xe9\xf2\xe5 \xef\xee\xe7\xe6\xe5.", "");
        return 0;
    }

    if(item_id == 134 && !strlen(item_name))
        Market_GetSkinName(item_count, item_name, sizeof(item_name));
    if(!strlen(item_name)) GetItemName(item_id, item_name, sizeof(item_name));

    new notify_text[144];
    format(notify_text, sizeof(notify_text), "Marketplace: \xef\xf0\xe5\xe4\xec\xe5\xf2 \xef\xee\xeb\xf3\xf7\xe5\xed: %s x%d.", item_name, (item_id == 134 || Inventory11_IsAccessoryItem(item_id)) ? 1 : item_count);
    ShowNotificationSile(playerid, 1, 5, -1, -1, notify_text, "");
    return 1;
}

stock MPReward_SendPage(playerid, packet_type, offset)
{
    if(!IsPlayerLogged(playerid)) return 0;
    if(offset < 0) offset = 0;

    SetPVarInt(playerid, REWARD_GUI_MODE_PVAR, REWARD_GUI_MODE_MARKETPLACE);
    SetPVarInt(playerid, "mpreward_offset", offset);

    // /:    -
    // (case_id=100).  UNION ALL  blackpass_reward_items
    // (case_id=99)       (REWARD_GUI_MODE_BPR), 
    //   .         /reward.
    new query[1024];
    mysql_format(mysql, query, sizeof(query),
        "SELECT r.`id` AS `reward_db_id`,m.`id` AS `reward_item_id`,m.`item_id`,m.`item_count`,m.`item_plate`,m.`item_name` FROM `rewards` r INNER JOIN `marketplace_reward_items` m ON m.`id`=r.`award_id` AND m.`account_id`=r.`uid` WHERE r.`uid`=%d AND r.`case_id`=%d "\
        "UNION ALL "\
        "SELECT r.`id` AS `reward_db_id`,b.`id` AS `reward_item_id`,b.`item_id`,b.`item_count`,b.`item_plate`,b.`item_name` FROM `rewards` r INNER JOIN `blackpass_reward_items` b ON b.`id`=r.`award_id` AND b.`account_id`=r.`uid` WHERE r.`uid`=%d AND r.`case_id`=%d "\
        "ORDER BY `reward_db_id` DESC LIMIT %d,%d",
        GetPlayerAccountID(playerid), MARKETPLACE_REWARD_CASE_ID,
        GetPlayerAccountID(playerid), BLACKPASS_REWARD_CASE_ID,
        offset, MP_REWARD_PAGE_SIZE + 1);
    mysql_tquery(mysql, query, "MPReward_OnGuiListLoaded", "iii", playerid, packet_type, offset);
    return 1;
}

public MPReward_OnGuiListLoaded(playerid, packet_type, offset)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 0;

    new rows = cache_num_rows();
    new display_rows = rows;
    if(display_rows > MP_REWARD_PAGE_SIZE) display_rows = MP_REWARD_PAGE_SIZE;

    new Node:reward_array = JSON_Array();
    new skin_count, item_count_total;

    for(new i = 0; i < display_rows; i++)
    {
        new reward_db_id = cache_get_field_content_int(i, "reward_db_id", mysql);
        new item_id = cache_get_field_content_int(i, "item_id", mysql);
        new stored_count = cache_get_field_content_int(i, "item_count", mysql);
        new item_name[64], item_plate[32];
        cache_get_field_content(i, "item_name", item_name, mysql, sizeof(item_name));
        cache_get_field_content(i, "item_plate", item_plate, mysql, sizeof(item_plate));
        if(!strlen(item_name)) GetItemName(item_id, item_name, sizeof(item_name));

        new display_count = Market_IsSingleInventoryEntity(item_id) ? 1 : stored_count;
        if(display_count < 1) display_count = 1;

        new rarity = 1;
        if(item_id == 134) rarity = 3;
        else if(item_id == 58 || item_id == 59 || item_id == 81 || item_id == 82 || item_id == 83) rarity = 2;

        new Node:item = JSON_Object();
        JSON_SetInt(item, "id", reward_db_id);
        JSON_SetString(item, "n", item_name, sizeof(item_name));
        JSON_SetInt(item, "td", 11);
        JSON_SetInt(item, "st", 1);
        JSON_SetInt(item, "el", item_id);
        JSON_SetInt(item, "c", item_id == 134 ? stored_count : -1);
        JSON_SetInt(item, "ds", 0);
        JSON_SetInt(item, "sp", 0);
        JSON_SetInt(item, "r", rarity);
        JSON_SetInt(item, "ct", display_count);

        new Node:plates = JSON_Array();
        if(strlen(item_plate))
        {
            plates = JSON_Append(plates, JSON_Array(JSON_String(item_plate)));
        }
        JSON_SetArray(item, "els", plates);

        reward_array = JSON_Append(reward_array, JSON_Array(item));
        if(item_id == 134) skin_count++;
        else item_count_total++;
    }

    new Node:json = JSON_Object();
    if(packet_type == 0) JSON_SetInt(json, "o", 1);
    JSON_SetInt(json, "t", packet_type);
    JSON_SetInt(json, "tn", 0);
    JSON_SetArray(json, "pr", reward_array);

    new Node:alarms = JSON_Array(
        JSON_Int(display_rows),
        JSON_Int(skin_count),
        JSON_Int(0),
        JSON_Int(item_count_total),
        JSON_Int(0),
        JSON_Int(0),
        JSON_Int(0)
    );
    JSON_SetArray(json, "fl", alarms);

    if(rows <= MP_REWARD_PAGE_SIZE && packet_type == 2) JSON_SetInt(json, "s", -1);
    SendPacketToClient(playerid, MP_REWARD_GUI_ID, json);
    JSON_Cleanup(json);

    #pragma unused offset
    return 1;
}

stock MPReward_OpenGUI(playerid)
{
    if(!IsPlayerLogged(playerid))
        return ShowNotificationSile(playerid, 2, 5, -1, -1, "\xd1\xed\xe0\xf7\xe0\xeb\xe0 \xe0\xe2\xf2\xee\xf0\xe8\xe7\xf3\xe9\xf2\xe5\xf1\xfc.", "");

    SetPVarInt(playerid, "mpreward_offset", 0);
    return MPReward_SendPage(playerid, 0, 0);
}

stock MPReward_GiveByDatabaseId(playerid, reward_db_id)
{
    if(reward_db_id <= 0) return 0;

    // /:    case_id .
    //         
    //  case_id     GiveToPlayer.
    new query[256];
    mysql_format(mysql, query, sizeof(query),
        "SELECT `award_id`,`case_id` FROM `rewards` WHERE `id`=%d AND `uid`=%d AND (`case_id`=%d OR `case_id`=%d) LIMIT 1",
        reward_db_id, GetPlayerAccountID(playerid), MARKETPLACE_REWARD_CASE_ID, BLACKPASS_REWARD_CASE_ID);

    new Cache:result = mysql_query(mysql, query, true);
    if(!cache_num_rows())
    {
        cache_delete(result);
        return 0;
    }

    new reward_item_id = cache_get_field_content_int(0, "award_id", mysql);
    new src_case_id = cache_get_field_content_int(0, "case_id", mysql);
    cache_delete(result);

    if(src_case_id == BLACKPASS_REWARD_CASE_ID) return BPReward_GiveToPlayer(playerid, reward_item_id);
    return MPReward_GiveToPlayer(playerid, reward_item_id);
}

stock bool:MPReward_TryRouteIncoming(playerid, Node:json)
{
    // RPC 77 is also used by Marketplace. Never treat Marketplace slot/lot
    // IDs as reward IDs just because the numbers happen to overlap.
    // Reward claims sent through RPC 77 are only valid while the reward GUI
    // is actually active.
    if(GetPVarInt(playerid, REWARD_GUI_MODE_PVAR) != REWARD_GUI_MODE_MARKETPLACE)
        return false;

    new probe_id;
    JSON_GetInt(json, "id", probe_id);
    if(probe_id <= 0) JSON_GetInt(json, "i", probe_id);
    if(probe_id <= 0) JSON_GetInt(json, "rid", probe_id);
    if(probe_id <= 0) JSON_GetInt(json, "award_id", probe_id);
    if(probe_id <= 0) return false;

    new query[256];
    mysql_format(mysql, query, sizeof(query),
        "SELECT id FROM rewards WHERE id=%d AND uid=%d AND case_id=%d LIMIT 1",
        probe_id, GetPlayerAccountID(playerid), MARKETPLACE_REWARD_CASE_ID);
    new Cache:result = mysql_query(mysql, query, true);
    new found = cache_num_rows() > 0;
    cache_delete(result);
    if(!found)
    {
        mysql_format(mysql, query, sizeof(query),
            "SELECT r.id FROM rewards r INNER JOIN marketplace_reward_items m ON m.id=r.award_id WHERE r.uid=%d AND r.case_id=%d AND m.id=%d LIMIT 1",
            GetPlayerAccountID(playerid), MARKETPLACE_REWARD_CASE_ID, probe_id);
        result = mysql_query(mysql, query, true);
        found = cache_num_rows() > 0;
        cache_delete(result);
    }
    if(!found) return false;

    new success = MPReward_GiveByDatabaseId(playerid, probe_id);
    if(!success)
    {
        mysql_format(mysql, query, sizeof(query),
            "SELECT award_id FROM rewards WHERE uid=%d AND case_id=%d AND award_id=%d LIMIT 1",
            GetPlayerAccountID(playerid), MARKETPLACE_REWARD_CASE_ID, probe_id);
        result = mysql_query(mysql, query, true);
        if(cache_num_rows() > 0)
        {
            new award_id = cache_get_field_content_int(0, "award_id", mysql);
            success = MPReward_GiveToPlayer(playerid, award_id);
        }
        cache_delete(result);
    }

    new Node:response = JSON_Object();
    JSON_SetInt(response, "t", 4);
    JSON_SetInt(response, "s", success ? 1 : 0);
    JSON_SetInt(response, "id", probe_id);
    SendPacketToClient(playerid, MP_REWARD_GUI_ID, response);
    JSON_Cleanup(response);
    if(success) MPReward_SendPage(playerid, 1, GetPVarInt(playerid, "mpreward_offset"));
    return true;
}

stock MPReward_OnPacket(playerid, Node:json)
{
    new close_gui;
    JSON_GetInt(json, "c", close_gui);
    if(close_gui == 1)
    {
        SetPVarInt(playerid, REWARD_GUI_MODE_PVAR, REWARD_GUI_MODE_NONE);
        HidePlayerGUI(playerid, MP_REWARD_GUI_ID);
        return 1;
    }

    new type;
    JSON_GetInt(json, "t", type);

    // Some mobile client revisions send the selected reward with a different t value.
    // If an id is present outside the paging packets, treat it as a claim request.
    new generic_reward_id;
    JSON_GetInt(json, "id", generic_reward_id);
    if(generic_reward_id > 0 && type != 1 && type != 2 && type != 3 && type != 4)
    {
        new generic_success = MPReward_GiveByDatabaseId(playerid, generic_reward_id);
        if(!generic_success)
        {
            new generic_query[256];
            mysql_format(mysql, generic_query, sizeof(generic_query),
                "SELECT `award_id` FROM `rewards` WHERE `uid`=%d AND `case_id`=%d AND `award_id`=%d LIMIT 1",
                GetPlayerAccountID(playerid), MARKETPLACE_REWARD_CASE_ID, generic_reward_id);
            new Cache:generic_cache = mysql_query(mysql, generic_query, true);
            if(cache_num_rows() > 0)
            {
                new generic_award_id = cache_get_field_content_int(0, "award_id", mysql);
                generic_success = MPReward_GiveToPlayer(playerid, generic_award_id);
            }
            cache_delete(generic_cache);
        }

        new Node:generic_response = JSON_Object();
        JSON_SetInt(generic_response, "t", 4);
        JSON_SetInt(generic_response, "s", generic_success ? 1 : 0);
        JSON_SetInt(generic_response, "id", generic_reward_id);
        SendPacketToClient(playerid, MP_REWARD_GUI_ID, generic_response);
        JSON_Cleanup(generic_response);
        if(generic_success) MPReward_SendPage(playerid, 1, GetPVarInt(playerid, "mpreward_offset"));
        return 1;
    }

    switch(type)
    {
        case 1:
        {
            SetPVarInt(playerid, "mpreward_offset", 0);
            MPReward_SendPage(playerid, 1, 0);
        }
        case 2:
        {
            new offset = GetPVarInt(playerid, "mpreward_offset") + MP_REWARD_PAGE_SIZE;
            MPReward_SendPage(playerid, 2, offset);
        }
        case 3, 4:
        {
            new reward_id, reward_action;
            JSON_GetInt(json, "id", reward_id);
            // Mobile clients can use different field names for the selected reward.
            if(reward_id <= 0) JSON_GetInt(json, "i", reward_id);
            if(reward_id <= 0) JSON_GetInt(json, "rid", reward_id);
            if(reward_id <= 0) JSON_GetInt(json, "award_id", reward_id);
            JSON_GetInt(json, "s", reward_action);

            // Some client builds send t=3, others t=4, and some send s=0/empty.
            // If an id is supplied, always try to resolve it as rewards.id first.
            new success = 0;
            if(reward_id > 0)
                success = MPReward_GiveByDatabaseId(playerid, reward_id);

            // Fallback: client may send marketplace_reward_items.id (award_id).
            if(!success && reward_id > 0)
            {
                new lookup_query[256];
                mysql_format(mysql, lookup_query, sizeof(lookup_query),
                    "SELECT `award_id` FROM `rewards` WHERE `uid`=%d AND `case_id`=%d AND `award_id`=%d LIMIT 1",
                    GetPlayerAccountID(playerid), MARKETPLACE_REWARD_CASE_ID, reward_id);
                new Cache:lookup = mysql_query(mysql, lookup_query, true);
                if(cache_num_rows() > 0)
                {
                    new award_id = cache_get_field_content_int(0, "award_id", mysql);
                    success = MPReward_GiveToPlayer(playerid, award_id);
                }
                cache_delete(lookup);
            }

            new Node:response = JSON_Object();
            JSON_SetInt(response, "t", 4);
            JSON_SetInt(response, "s", success ? 1 : 0);
            JSON_SetInt(response, "id", reward_id);
            SendPacketToClient(playerid, MP_REWARD_GUI_ID, response);
            JSON_Cleanup(response);

            if(success)
                MPReward_SendPage(playerid, 1, GetPVarInt(playerid, "mpreward_offset"));

            #pragma unused reward_action
        }
        default:
        {
            MPReward_OpenGUI(playerid);
        }
    }
    return 1;
}

CMD:mpreward(playerid, params[])
{
    #pragma unused params
    MPReward_OpenGUI(playerid);
    return 1;
}



