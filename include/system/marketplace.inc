        if(g_SkinCatalog[i][0] == modelid)
        {
            if(i >= 0 && i < sizeof(MarketSkinNames) && MarketSkinNames[i][0] != EOS)
            {
                format(name, name_size, "%s", MarketSkinNames[i]);
                return 1;
