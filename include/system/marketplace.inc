//  Market_GetAccessoryModelByStoredId,   : 
//   modelId (,    inv_itemCount)  internalId
//   (g_SkinCatalog,   skins.json)  
//  internalId   ,    modelId.  -1,
//   modelId     ( ).
stock Market_GetSkinModelByStoredId(stored_count)
{
    // Inventory11 stores the actual GTA skin model in model_id/old_skin and
    // Marketplace stores that same model in item_count. Do not convert it
    // through g_SkinCatalog here: that table is internalId -> modelId, while
    // the old code was reading it in the opposite direction.
    if(stored_count > 0 && IsValidSkinModel(stored_count))
        return stored_count;

    // Compatibility with old rows that contain a SkinMapping internal id.
    for(new i = 0; i < sizeof(SkinMapping); i++)
    {
        if(SkinMapping[i][1] == stored_count)
            return SkinMapping[i][0];
    }

    // Compatibility with the compact catalog used by the old Marketplace.
    for(new i = 0; i < SKIN_CATALOG_COUNT; i++)
    {
        if(g_SkinCatalog[i][0] == stored_count)
            return g_SkinCatalog[i][1];
    }
    return -1;
}


#define MARKET_V3_INV_SLOTS (40)
new g_MarketV3Item[MAX_PLAYERS][MARKET_V3_INV_SLOTS];
new g_MarketV3Model[MAX_PLAYERS][MARKET_V3_INV_SLOTS];
new g_MarketV3Count[MAX_PLAYERS][MARKET_V3_INV_SLOTS];
new g_MarketV3Slot[MAX_PLAYERS][MARKET_V3_INV_SLOTS];
new g_MarketV3Plate[MAX_PLAYERS][MARKET_V3_INV_SLOTS][32];

stock Market_RefreshV3Inventory(playerid)
{
    for(new i = 0; i < MARKET_V3_INV_SLOTS; i++)
    {
        g_MarketV3Item[playerid][i] = 0;
        g_MarketV3Model[playerid][i] = 0;
        g_MarketV3Count[playerid][i] = 0;
        g_MarketV3Slot[playerid][i] = i + 1;
        g_MarketV3Plate[playerid][i][0] = EOS;
    }

    if(!IsPlayerLogged(playerid)) return 0;
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0) return 0;

    new query[384];
    mysql_format(mysql, query, sizeof(query),
        "SELECT item_id,model_id,old_skin,extra_1,slot,amount FROM inventory WHERE account_id=%d AND slot BETWEEN 1 AND %d ORDER BY slot ASC",
        account_id, MARKET_V3_INV_SLOTS);
    new Cache:result = mysql_query(mysql, query, true);
    if(mysql_errno())
    {
        printf("[MARKET][V3] inventory load failed: player=%d account=%d errno=%d", playerid, account_id, mysql_errno());
        cache_delete(result);
        return 0;
    }

    new rows = cache_num_rows();
    for(new i = 0; i < rows; i++)
    {
        new db_slot = cache_get_field_content_int(i, "slot");
        new client_slot = InventoryV3_DbToClientSlot(db_slot);
        if(client_slot < 0 || client_slot >= MARKET_V3_INV_SLOTS) continue;

        new item_id = cache_get_field_content_int(i, "item_id");
        new model_id = cache_get_field_content_int(i, "model_id");
        new old_skin = cache_get_field_content_int(i, "old_skin");
        new extra_1 = cache_get_field_content_int(i, "extra_1");
        new amount = cache_get_field_content_int(i, "amount");
        g_MarketV3Item[playerid][client_slot] = item_id;
        g_MarketV3Model[playerid][client_slot] = model_id;
        g_MarketV3Count[playerid][client_slot] = amount > 0 ? amount : 1;
        g_MarketV3Slot[playerid][client_slot] = db_slot;
        // Plates are stored in inventory_plates, not in the inventory table.
        // Do not read a non-existent item_plate column here: that makes the
        // whole V3 query fail and leaves the Marketplace inventory empty.
        g_MarketV3Plate[playerid][client_slot][0] = EOS;

        if(item_id == 134)
        {
            // V3 inventory stores the real GTA/custom skin model in model_id.
            // old_skin is a legacy/source value and can contain the donate
            // internal id (for example 620 for model 11588). Never use that
            // value for Marketplace display or item_count when model_id is valid.
            new skin_model = model_id;
            if(!IsValidSkinModel(skin_model))
            {
                skin_model = old_skin;
            }
            if(skin_model <= 0) skin_model = model_id;
            g_MarketV3Count[playerid][client_slot] = skin_model;
            g_MarketV3Model[playerid][client_slot] = skin_model;
        }
        else if(Inventory11_IsAccessoryItem(item_id))
        {
            // V3 stores an accessory's real GTA model in model_id/old_skin.
            new acc_model = extra_1 > 0 ? extra_1 : old_skin;
            if(acc_model <= 0 && model_id > 1) acc_model = model_id;
            if(acc_model <= 0) acc_model = Inv11_GetAccModelByItem(item_id);
            g_MarketV3Count[playerid][client_slot] = acc_model > 0 ? acc_model : 1;
            g_MarketV3Model[playerid][client_slot] = acc_model;
        }
    }
    cache_delete(result);
    return 1;
}

stock Market_GetV3FreeSlot(playerid)
{
    Market_RefreshV3Inventory(playerid);
    for(new i = 0; i < MARKET_V3_INV_SLOTS; i++)
        if(g_MarketV3Item[playerid][i] <= 0) return i + 1;
    return -1;
}

// Marketplace client uses the inventory database slot (1..40) as source id,
// same as the original market.inc. V3 cache itself remains 0-based.
stock Market_SourceToV3Index(source_id)
{
    if(source_id < 1 || source_id > MARKET_V3_INV_SLOTS) return -1;
    return source_id - 1;
}

stock Market_AddV3Item(playerid, item_id, item_count, const plate[])
{
    if(item_id <= 0) return -1;
    if(item_count <= 0) item_count = 1;

    if(item_id == 134)
        return Inventory11_AddSkinToInventory(playerid, item_count, 0) ? 1 : -1;

    if(Inventory11_IsAccessoryItem(item_id))
        return Inventory11_AddItemToDatabase(playerid, item_id, 1, 1, item_count, 0);

    return Inventory11_AddItemToDatabase(playerid, item_id, 0, item_count, 0, 0);
}

new g_MarketAccessoryItem[MAX_PLAYERS][MARKET_SOURCE_ACCESSORY_SLOTS];
new g_MarketAccessoryModel[MAX_PLAYERS][MARKET_SOURCE_ACCESSORY_SLOTS];
new g_MarketAccessoryBone[MAX_PLAYERS][MARKET_SOURCE_ACCESSORY_SLOTS];

stock Market_IsAccessoryInventoryItem(item_id)
{
    // Inventory11 is the authoritative source for accessory IDs in Revix.
    // The old Marketplace-only mapping did not contain every accessory that
    // can exist in the inventory, which made valid accessories invisible
    // in the "create lot" list.
    if(item_id <= 0 || item_id == 58 || item_id == 134)
        return 0;

    if(Inventory11_IsAccessoryItem(item_id))
        return 1;

    return Market_GetAccessoryCanonicalItemByStoredId(item_id) > 0;
}

stock Market_ClearAccessoryCache(playerid)
{
    for(new i = 0; i < MARKET_SOURCE_ACCESSORY_SLOTS; i++)
    {
        g_MarketAccessoryItem[playerid][i] = 0;
        g_MarketAccessoryModel[playerid][i] = 0;
        g_MarketAccessoryBone[playerid][i] = 0;
    }
    return 1;
}

stock Market_RefreshAccessoryCache(playerid)
{
    Market_ClearAccessoryCache(playerid);
    if(!IsPlayerLogged(playerid)) return 0;

    new query[160];
    mysql_format(mysql, query, sizeof(query),
        "SELECT `slot`,`bone`,`acs_id` FROM `accessories_players` WHERE `player_id`=%d AND `slot` BETWEEN 1 AND 7 AND `slot`<>6 ORDER BY `slot` ASC",
        GetPlayerAccountID(playerid));

    new Cache:result = mysql_query(mysql, query, true);
    new rows = cache_num_rows();

    for(new i = 0; i < rows; i++)
    {
        new slot = cache_get_field_content_int(i, "slot", mysql);
        new acs_id = cache_get_field_content_int(i, "acs_id", mysql);
        new model_id = (acs_id > 0 && acs_id < sizeof(accessory)) ? accessory[acs_id][ID_ACCESSORY] : 0;
        new bone = cache_get_field_content_int(i, "bone", mysql);
        if(slot < 0 || slot >= MARKET_SOURCE_ACCESSORY_SLOTS) continue;

        new item_id = Inv11_GetAccItemByModel(model_id);
        if(item_id <= 0) continue;

        g_MarketAccessoryItem[playerid][slot] = item_id;
        g_MarketAccessoryModel[playerid][slot] = model_id;
        g_MarketAccessoryBone[playerid][slot] = bone;
    }

    cache_delete(result);
    return 1;
}

stock Market_IsAccessorySource(source_id)
{
    return source_id >= MARKET_SOURCE_ACCESSORY_BASE && source_id < (MARKET_SOURCE_ACCESSORY_BASE + MARKET_SOURCE_ACCESSORY_SLOTS);
}

stock Market_MakeAccessorySource(accessory_slot)
{
    return MARKET_SOURCE_ACCESSORY_BASE + accessory_slot;
}

stock Market_GetAccessorySlotFromSource(source_id)
{
    if(!Market_IsAccessorySource(source_id)) return -1;
    return source_id - MARKET_SOURCE_ACCESSORY_BASE;
}

stock Market_GetAccessoryModelFromSource(playerid, source_id)
{
    if(Market_IsAccessorySource(source_id))
    {
        new accessory_slot = Market_GetAccessorySlotFromSource(source_id);
        return g_MarketAccessoryModel[playerid][accessory_slot];
    }

    new v3_index = Market_SourceToV3Index(source_id);
    if(v3_index < 0) return -1;
    return g_MarketV3Model[playerid][v3_index];
}

stock Market_IsSingleInventoryEntity(item_id)
{
    switch(item_id)
    {
        // item_count stores metadata for these items, not a stack size.
        case 58, 59, 81, 82, 83, 134: return 1;
    }
    return Market_GetAccessoryCanonicalItemByStoredId(item_id) > 0;
}

stock Market_IsSellableInventoryItem(item_id)
{
    if(item_id == 58 || item_id == 134) return 1;
    return Market_IsAccessoryInventoryItem(item_id);
}

stock Market_IsActiveSource(source_id)
{
    return source_id >= MARKET_SOURCE_ACTIVE_BASE && source_id < (MARKET_SOURCE_ACTIVE_BASE + MAX_ACTIVE_SLOTS);
}

stock Market_MakeActiveSource(active_slot)
{
    return MARKET_SOURCE_ACTIVE_BASE + active_slot;
}

stock Market_GetActiveSlotFromSource(source_id)
{
    if(!Market_IsActiveSource(source_id)) return -1;
    return source_id - MARKET_SOURCE_ACTIVE_BASE;
}

stock Market_GetSourceItemId(playerid, source_id)
{
    if(Market_IsAccessorySource(source_id))
    {
        new accessory_slot = Market_GetAccessorySlotFromSource(source_id);
        return g_MarketAccessoryItem[playerid][accessory_slot];
    }

    if(Market_IsActiveSource(source_id))
    {
        new active_slot = Market_GetActiveSlotFromSource(source_id);
        new item_id = (active_slot == SKIN_SLOT) ? 134 : ((active_slot == SIM_SLOT) ? 58 : 0);

        if(active_slot == SIM_SLOT)
            return GetPlayerData(playerid, P_PHONE) > 0 ? 58 : 0;

        if(active_slot == SKIN_SLOT && item_id != 134)
        {
            new skin_model = GetPlayerData(playerid, P_SKIN);
            if(skin_model <= 0) skin_model = GetPlayerSkin(playerid);
            if(skin_model > 0) return 134;
        }

        return item_id;
    }

    new v3_index = Market_SourceToV3Index(source_id);
    if(v3_index < 0) return 0;
    return g_MarketV3Item[playerid][v3_index];
}

stock Market_GetSourceItemCount(playerid, source_id)
{
    if(Market_IsAccessorySource(source_id))
    {
        new accessory_slot = Market_GetAccessorySlotFromSource(source_id);
        return g_MarketAccessoryModel[playerid][accessory_slot] > 0 ? g_MarketAccessoryModel[playerid][accessory_slot] : 1;
    }

    if(Market_IsActiveSource(source_id))
    {
        new active_slot = Market_GetActiveSlotFromSource(source_id);
        new item_id = Market_GetSourceItemId(playerid, source_id);
        new stored_count = (active_slot == SKIN_SLOT) ? GetPlayerSkin(playerid) : ((active_slot == SIM_SLOT) ? GetPlayerData(playerid, P_PHONE) : 0);

        if(item_id == 58 && stored_count <= 0) return GetPlayerData(playerid, P_PHONE);
        if(item_id == 134 && (stored_count <= 0 || Market_GetSkinModelByStoredId(stored_count) <= 0))
        {
            // Slot 6 (SKIN_SLOT) can get clobbered by accessory data loaded into the
            // same g_PlayerActiveSlots array (see LoadPlayerAccessoriesToActiveSlots
            // in Inventory.inc), leaving a bone number here instead of a skin model.
            // Fall back to the player's real skin whenever stored_count isn't in SkinMapping
            // (same table-lookup approach used for accessories).
            stored_count = GetPlayerData(playerid, P_SKIN);
            if(stored_count <= 0 || !IsValidSkinModel(stored_count)) stored_count = GetPlayerSkin(playerid);
        }
        return stored_count;
    }

    new v3_index = Market_SourceToV3Index(source_id);
    if(v3_index < 0) return 0;
    return g_MarketV3Count[playerid][v3_index];
}

stock Market_GetSourcePlate(playerid, source_id, plate[], plate_size)
{
    plate[0] = EOS;

    if(Market_IsAccessorySource(source_id)) return 1;

    if(Market_IsActiveSource(source_id))
    {
        new active_slot = Market_GetActiveSlotFromSource(source_id);
        plate[0] = EOS;

        if(active_slot == SIM_SLOT && !strlen(plate) && GetPlayerData(playerid, P_PHONE) > 0)
            format(plate, plate_size, "%d", GetPlayerData(playerid, P_PHONE));
        return 1;
    }

    new v3_index = Market_SourceToV3Index(source_id);
    if(v3_index < 0) return 0;
    format(plate, plate_size, "%s", g_MarketV3Plate[playerid][v3_index]);
    return 1;
}

stock Market_FindReplacementSkinSlot(playerid)
{
    for(new i = 0; i < MARKET_V3_INV_SLOTS; i++)
    {
        if(g_MarketV3Item[playerid][i] == 134 && IsValidSkinModel(g_MarketV3Count[playerid][i]))
            return g_MarketV3Slot[playerid][i];
    }
    return -1;
}

stock Market_CanSellSource(playerid, source_id)
{
    new item_id = Market_GetSourceItemId(playerid, source_id);
    if(!Market_IsSellableInventoryItem(item_id)) return 0;

    if(Market_IsAccessorySource(source_id))
        return Market_GetAccessoryModelFromSource(playerid, source_id) > 0;

    if(Market_IsActiveSource(source_id))
    {
        // Accessories use their authoritative `accessories` table source below.
        if(item_id != 58 && item_id != 134) return 0;

        // The equipped skin can only be sold when another owned skin can replace it.
        if(item_id == 134) return Market_FindReplacementSkinSlot(playerid) != -1;
    }

    return 1;
}

stock Market_DeleteInventorySlot(playerid, slot)
{
    new v3_index = Market_SourceToV3Index(slot);
    if(v3_index < 0) return 0;
    if(g_MarketV3Item[playerid][v3_index] <= 0) return 0;
    return Inventory11_DeleteSlotFromDatabase(playerid, slot);
}

stock Market_DeleteActiveSource(playerid, active_slot)
{
    if(active_slot < 0 || active_slot >= MAX_ACTIVE_SLOTS) return 0;
    new item_id = Market_GetSourceItemId(playerid, Market_MakeActiveSource(active_slot));
    if(item_id == 134)
    {
        new replacement_slot = Market_FindReplacementSkinSlot(playerid);
        if(replacement_slot == -1) return 0;
        new replacement_model = g_MarketV3Count[playerid][replacement_slot];
        if(!IsValidSkinModel(replacement_model)) return 0;
        if(!Market_DeleteInventorySlot(playerid, replacement_slot)) return 0;
        SetPlayerSkin(playerid, replacement_model);
        SetPlayerData(playerid, P_SKIN, replacement_model);
        UpdatePlayerDatabaseInt(playerid, "skin", replacement_model);
        Inventory11_SendSkinUpdatePacket(playerid, replacement_model);
        return 1;
    }
    if(item_id == 58)
    {
        SetPlayerData(playerid, P_PHONE, 0);
        UpdatePlayerDatabaseInt(playerid, "phone", 0);
        return 1;
    }
    return 0;
}

stock Market_DeleteAccessorySource(playerid, accessory_slot)
{
    if(accessory_slot < 1 || accessory_slot > 7) return 0;
    new query[256];
    mysql_format(mysql, query, sizeof(query),
        "DELETE FROM `accessories_players` WHERE `player_id`=%d AND `slot`=%d LIMIT 1",
        GetPlayerAccountID(playerid), accessory_slot);
    new Cache:result = mysql_query(mysql, query, true);
    new deleted = cache_affected_rows(mysql);
    cache_delete(result);
    if(!deleted) return 0;
    RemovePlayerAttachedObject(playerid, accessory_slot);
    Market_RefreshAccessoryCache(playerid);
    return 1;
}

stock Market_RemoveV3Amount(playerid, source_id, amount)
{
    new v3_index = Market_SourceToV3Index(source_id);
    if(v3_index < 0 || amount <= 0) return 0;
    new item_id = g_MarketV3Item[playerid][v3_index];
    if(item_id <= 0) return 0;
    new have = g_MarketV3Count[playerid][v3_index];
    if(Market_IsSingleInventoryEntity(item_id) || amount >= have)
        return Market_DeleteInventorySlot(playerid, source_id);

    new db_slot = source_id;
    new left = have - amount;
    if(left < 1) return Market_DeleteInventorySlot(playerid, source_id);

    new query[256];
    mysql_format(mysql, query, sizeof(query),
        "UPDATE `inventory` SET `amount`=%d WHERE `account_id`=%d AND `slot`=%d AND `item_id`=%d LIMIT 1",
        left, GetPlayerAccountID(playerid), db_slot, item_id);
    new Cache:result = mysql_query(mysql, query, true);
    new changed = cache_affected_rows(mysql);
    cache_delete(result);
    return changed > 0;
}

stock Market_DeleteSource(playerid, source_id)
{
    if(Market_IsAccessorySource(source_id))
        return Market_DeleteAccessorySource(playerid, Market_GetAccessorySlotFromSource(source_id));

    if(Market_IsActiveSource(source_id))
        return Market_DeleteActiveSource(playerid, Market_GetActiveSlotFromSource(source_id));

    return Market_DeleteInventorySlot(playerid, source_id);
}


